---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Fraction Calculator",
    "url": "https://computezap.com/calculators/fraction-calculator",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Add, subtract, multiply, and divide fractions instantly. Shows simplified result, decimal equivalent, mixed number, and step-by-step work. Free fraction calculator.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://computezap.com/#calculators" },
      { "@type": "ListItem", "position": 3, "name": "Fraction Calculator", "item": "https://computezap.com/calculators/fraction-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do you add fractions with different denominators?", "acceptedAnswer": { "@type": "Answer", "text": "Find a common denominator by multiplying the two denominators (or using their LCM), convert each fraction, then add the numerators. Example: 1/2 + 1/3 = 3/6 + 2/6 = 5/6." } },
      { "@type": "Question", "name": "How do you subtract fractions?", "acceptedAnswer": { "@type": "Answer", "text": "Convert both fractions to a common denominator, then subtract the numerators and keep the denominator. Example: 3/4 − 1/8 = 6/8 − 1/8 = 5/8." } },
      { "@type": "Question", "name": "How do you multiply fractions?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply the numerators together and the denominators together, then simplify. Example: 2/3 × 3/5 = 6/15 = 2/5 after simplifying by GCD 3." } },
      { "@type": "Question", "name": "How do you divide fractions?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply the first fraction by the reciprocal (flip) of the second fraction. Example: 1/2 ÷ 3/4 = 1/2 × 4/3 = 4/6 = 2/3 after simplifying." } },
      { "@type": "Question", "name": "What is 1/2 + 1/3?", "acceptedAnswer": { "@type": "Answer", "text": "1/2 + 1/3 = 5/6. Common denominator is 6: 1/2 = 3/6 and 1/3 = 2/6, so 3/6 + 2/6 = 5/6, which is already in simplest form." } },
      { "@type": "Question", "name": "What is 3/4 minus 1/8?", "acceptedAnswer": { "@type": "Answer", "text": "3/4 − 1/8 = 5/8. Convert 3/4 to eighths: 6/8. Then 6/8 − 1/8 = 5/8." } },
      { "@type": "Question", "name": "How do you simplify a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "Find the greatest common divisor (GCD) of the numerator and denominator, then divide both by it. Example: 6/15 — GCD(6,15)=3, so 6÷3 / 15÷3 = 2/5." } },
      { "@type": "Question", "name": "How do you convert an improper fraction to a mixed number?", "acceptedAnswer": { "@type": "Answer", "text": "Divide the numerator by the denominator. The quotient is the whole number, and the remainder over the original denominator is the fraction part. Example: 11/4 = 2 remainder 3, so 11/4 = 2 3/4." } },
      { "@type": "Question", "name": "Can you add fractions with negative numerators?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Treat the negative sign as part of the numerator and follow the same common-denominator process. Example: -1/2 + 1/4 = -2/4 + 1/4 = -1/4." } },
      { "@type": "Question", "name": "What is a common denominator?", "acceptedAnswer": { "@type": "Answer", "text": "A common denominator is a shared multiple of two or more denominators that lets fractions be added or subtracted directly. The easiest common denominator is the product of both denominators, though the LCM gives smaller numbers." } },
      { "@type": "Question", "name": "Why do you flip the second fraction when dividing?", "acceptedAnswer": { "@type": "Answer", "text": "Dividing by a fraction is the same as multiplying by its reciprocal because a/b ÷ c/d = a/b × d/c. Flipping (inverting) the divisor converts division into multiplication, which is easier to compute." } },
      { "@type": "Question", "name": "What is 2/3 times 3/5?", "acceptedAnswer": { "@type": "Answer", "text": "2/3 × 3/5 = 6/15, which simplifies to 2/5 by dividing both numbers by their GCD of 3." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate Fractions",
    "description": "Step-by-step guide to adding, subtracting, multiplying, and dividing fractions.",
    "step": [
      { "@type": "HowToStep", "name": "Choose an operation", "text": "Select add, subtract, multiply, or divide." },
      { "@type": "HowToStep", "name": "Enter the first fraction", "text": "Type the numerator and denominator of the first fraction." },
      { "@type": "HowToStep", "name": "Enter the second fraction", "text": "Type the numerator and denominator of the second fraction." },
      { "@type": "HowToStep", "name": "Review your result", "text": "See the simplified fraction, decimal equivalent, mixed number, and step-by-step work." }
    ]
  }
]);
---
<Layout
  title="Fraction Calculator — Add, Subtract, Multiply, Divide | ComputeZap"
  description="Free fraction calculator. Add, subtract, multiply, or divide fractions instantly. Shows simplified result, decimal equivalent, mixed number, and step-by-step work."
  canonical="/calculators/fraction-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/#calculators">Calculators</a> › Fraction Calculator</nav>
  <h1>Fraction Calculator</h1>
  <p>Add, subtract, multiply, and divide fractions — simplified instantly with steps</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap" style="grid-template-columns:repeat(4,1fr)">
      <button class="mode-btn active" id="btn-add">+ Add</button>
      <button class="mode-btn" id="btn-sub">− Subtract</button>
      <button class="mode-btn" id="btn-mul">× Multiply</button>
      <button class="mode-btn" id="btn-div">÷ Divide</button>
    </div>

    <span class="preset-lbl">Fraction 1</span>
    <div class="two-col" style="gap:.5rem;margin-bottom:.5rem">
      <div class="input-group">
        <label for="n1">Numerator</label>
        <div class="input-wrap">
          <input type="number" id="n1" placeholder="1" step="1" oninput="calcFrac()" aria-label="First fraction numerator" />
        </div>
      </div>
      <div class="input-group">
        <label for="d1">Denominator</label>
        <div class="input-wrap">
          <input type="number" id="d1" placeholder="2" step="1" oninput="calcFrac()" aria-label="First fraction denominator" />
        </div>
      </div>
    </div>

    <span class="preset-lbl" id="op-symbol">Fraction 2</span>
    <div class="two-col" style="gap:.5rem">
      <div class="input-group">
        <label for="n2">Numerator</label>
        <div class="input-wrap">
          <input type="number" id="n2" placeholder="1" step="1" oninput="calcFrac()" aria-label="Second fraction numerator" />
        </div>
      </div>
      <div class="input-group">
        <label for="d2">Denominator</label>
        <div class="input-wrap">
          <input type="number" id="d2" placeholder="3" step="1" oninput="calcFrac()" aria-label="Second fraction denominator" />
        </div>
      </div>
    </div>

    <span class="preset-lbl">Common examples</span>
    <div class="preset-wrap">
      <a href="#" onclick="setPreset(1,2,'add',1,3);return false" class="preset-btn">1/2 + 1/3</a>
      <a href="#" onclick="setPreset(3,4,'sub',1,8);return false" class="preset-btn">3/4 − 1/8</a>
      <a href="#" onclick="setPreset(2,3,'mul',3,5);return false" class="preset-btn">2/3 × 3/5</a>
      <a href="#" onclick="setPreset(1,2,'div',3,4);return false" class="preset-btn">1/2 ÷ 3/4</a>
      <a href="#" onclick="setPreset(5,6,'add',1,6);return false" class="preset-btn">5/6 + 1/6</a>
      <a href="#" onclick="setPreset(7,8,'sub',1,4);return false" class="preset-btn">7/8 − 1/4</a>
    </div>

    <div class="answer-hero" id="res-hero">
      <div class="a-label">Result</div>
      <div class="a-value" id="res-frac">—</div>
      <div class="a-unit" id="res-mixed">—</div>
      <div class="a-sub" id="res-eq">—</div>
    </div>

    <div class="stats-row" id="res-stats">
      <div class="stat-box">
        <span class="stat-lbl">Decimal</span>
        <span class="stat-val" id="s-dec">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Unsimplified</span>
        <span class="stat-val" id="s-raw">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">GCD Used</span>
        <span class="stat-val" id="s-gcd">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Mixed Number</span>
        <span class="stat-val" id="s-mixed2">—</span>
      </div>
    </div>

    <div class="tip-box" id="steps-box" style="display:none">
      <span class="tip-icon">📐</span>
      <p id="steps-text">—</p>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Fraction Formulas Explained</h2>
    <div class="formula-box">
      <div class="formula-text">Add / Subtract: a/b ± c/d = (a×d ± c×b) / (b×d)</div>
      <div class="formula-sub">Example: 1/2 + 1/3 = (1×3 + 1×2) / (2×3) = 5/6</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Multiply: a/b × c/d = (a×c) / (b×d)</div>
      <div class="formula-sub">Example: 2/3 × 3/5 = 6/15 = 2/5</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Divide: a/b ÷ c/d = a/b × d/c = (a×d) / (b×c)</div>
      <div class="formula-sub">Example: 1/2 ÷ 3/4 = 1/2 × 4/3 = 4/6 = 2/3</div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Always simplify:</strong> after any operation, divide the numerator and denominator by their greatest common divisor (GCD) to get the simplest form.</p>
    </div>
  </div>

  <div class="card">
    <h2>Common Fraction Operations Reference</h2>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>Operation</th><th>Unsimplified</th><th>Simplified</th><th>Decimal</th></tr></thead>
        <tbody>
          {[
            ['1/2 + 1/3', '5/6', '5/6', '0.8333'],
            ['1/2 + 1/4', '6/8', '3/4', '0.75'],
            ['3/4 − 1/8', '5/8', '5/8', '0.625'],
            ['2/3 − 1/3', '1/3', '1/3', '0.3333'],
            ['2/3 × 3/5', '6/15', '2/5', '0.4'],
            ['1/2 × 1/2', '1/4', '1/4', '0.25'],
            ['1/2 ÷ 3/4', '4/6', '2/3', '0.6667'],
            ['3/4 ÷ 1/2', '6/4', '3/2', '1.5'],
          ].map(([op, raw, simp, dec]) => (
            <tr class={simp === '5/6' || simp === '2/5' || simp === '2/3' ? 'highlight-row' : ''}>
              <td><strong>{op}</strong></td>
              <td>{raw}</td>
              <td style="color:var(--blue);font-weight:700">{simp}</td>
              <td>{dec}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do you add fractions with different denominators?</h3>
      <p>Find a common denominator (multiply the two denominators, or use their LCM), convert each fraction, then add the numerators. Example: 1/2 + 1/3 = 3/6 + 2/6 = <strong>5/6</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do you subtract fractions?</h3>
      <p>Convert both fractions to a common denominator, then subtract the numerators and keep the denominator. Example: 3/4 − 1/8 = 6/8 − 1/8 = <strong>5/8</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do you multiply fractions?</h3>
      <p>Multiply the numerators together and the denominators together, then simplify. Example: 2/3 × 3/5 = 6/15 = <strong>2/5</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do you divide fractions?</h3>
      <p>Multiply the first fraction by the reciprocal (flip) of the second. Example: 1/2 ÷ 3/4 = 1/2 × 4/3 = 4/6 = <strong>2/3</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>What is 1/2 + 1/3?</h3>
      <p>1/2 + 1/3 = <strong>5/6</strong>. Common denominator is 6: 1/2 = 3/6 and 1/3 = 2/6, so 3/6 + 2/6 = 5/6, already in simplest form.</p>
    </div>
    <div class="faq-item">
      <h3>What is 3/4 minus 1/8?</h3>
      <p>3/4 − 1/8 = <strong>5/8</strong>. Convert 3/4 to eighths: 6/8. Then 6/8 − 1/8 = 5/8.</p>
    </div>
    <div class="faq-item">
      <h3>How do you simplify a fraction?</h3>
      <p>Find the greatest common divisor (GCD) of the numerator and denominator, then divide both by it. Example: 6/15 — GCD(6,15)=3, so 6÷3 / 15÷3 = <strong>2/5</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do you convert an improper fraction to a mixed number?</h3>
      <p>Divide the numerator by the denominator. The quotient is the whole number; the remainder over the original denominator is the fraction part. Example: 11/4 = 2 remainder 3, so 11/4 = <strong>2 3/4</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>Can you add fractions with negative numerators?</h3>
      <p>Yes. Treat the negative sign as part of the numerator and follow the same common-denominator process. Example: −1/2 + 1/4 = −2/4 + 1/4 = <strong>−1/4</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>What is a common denominator?</h3>
      <p>A shared multiple of two or more denominators that lets fractions be added or subtracted directly. The easiest one is the product of both denominators; the LCM gives smaller numbers.</p>
    </div>
    <div class="faq-item">
      <h3>Why do you flip the second fraction when dividing?</h3>
      <p>Dividing by a fraction equals multiplying by its reciprocal, since a/b ÷ c/d = a/b × d/c. Flipping the divisor turns division into easier-to-compute multiplication.</p>
    </div>
    <div class="faq-item">
      <h3>What is 2/3 times 3/5?</h3>
      <p>2/3 × 3/5 = 6/15, which simplifies to <strong>2/5</strong> by dividing both numbers by their GCD of 3.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/calculators/decimal-to-fraction" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Decimal to Fraction</h3>
        <p>Convert any decimal into a simplified fraction instantly</p>
      </a>
      <a href="/calculators/percentage-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Percentage Calculator</h3>
        <p>Find what % of a number is, or what number equals X%</p>
      </a>
      <a href="/calculators/pythagorean-theorem-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Pythagorean Theorem</h3>
        <p>Find any side of a right triangle with a² + b² = c²</p>
      </a>
      <a href="/calculators/square-footage-calculator" class="next-card">
        <span class="next-tag">Area</span>
        <h3>Square Footage Calculator</h3>
        <p>Calculate room area in square feet instantly</p>
      </a>
      <a href="/calculators/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the final price after any discount</p>
      </a>
      <a href="/calculators/concrete-calculator" class="next-card">
        <span class="next-tag">Construction</span>
        <h3>Concrete Calculator</h3>
        <p>Cubic yards and bags needed for slabs and footings</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var fracOp = 'add';
var opSymbols = { add: '+', sub: '−', mul: '×', div: '÷' };

document.getElementById('btn-add').addEventListener('click', function() { setOp('add'); });
document.getElementById('btn-sub').addEventListener('click', function() { setOp('sub'); });
document.getElementById('btn-mul').addEventListener('click', function() { setOp('mul'); });
document.getElementById('btn-div').addEventListener('click', function() { setOp('div'); });

function setOp(op) {
  fracOp = op;
  ['add','sub','mul','div'].forEach(function(o) {
    document.getElementById('btn-' + o).classList.toggle('active', o === op);
  });
  calcFrac();
}

function gcd(a, b) {
  a = Math.abs(a); b = Math.abs(b);
  return b === 0 ? a : gcd(b, a % b);
}

function fmtDec(n) {
  var r = parseFloat(n.toFixed(6));
  return r % 1 === 0 ? r.toLocaleString() : parseFloat(r.toFixed(4)).toLocaleString();
}

function mixedOf(num, den) {
  var neg = (num < 0) !== (den < 0);
  var an = Math.abs(num), ad = Math.abs(den);
  if (an < ad || ad === 1) return (neg ? '-' : '') + (ad === 1 ? an : an + '/' + ad);
  var whole = Math.floor(an / ad);
  var rem = an % ad;
  if (rem === 0) return (neg ? '-' : '') + whole;
  return (neg ? '-' : '') + whole + ' ' + rem + '/' + ad;
}

function calcFrac() {
  var n1 = parseInt(document.getElementById('n1').value);
  var d1 = parseInt(document.getElementById('d1').value);
  var n2 = parseInt(document.getElementById('n2').value);
  var d2 = parseInt(document.getElementById('d2').value);

  if (isNaN(n1) || isNaN(d1) || isNaN(n2) || isNaN(d2) || d1 === 0 || d2 === 0) return;
  if (fracOp === 'div' && n2 === 0) return;

  var rNum, rDen, rawText, stepText;

  if (fracOp === 'add') {
    rNum = n1 * d2 + n2 * d1;
    rDen = d1 * d2;
    rawText = rNum + '/' + rDen;
    stepText = '(' + n1 + '×' + d2 + ' + ' + n2 + '×' + d1 + ') / (' + d1 + '×' + d2 + ') = ' + rawText;
  } else if (fracOp === 'sub') {
    rNum = n1 * d2 - n2 * d1;
    rDen = d1 * d2;
    rawText = rNum + '/' + rDen;
    stepText = '(' + n1 + '×' + d2 + ' − ' + n2 + '×' + d1 + ') / (' + d1 + '×' + d2 + ') = ' + rawText;
  } else if (fracOp === 'mul') {
    rNum = n1 * n2;
    rDen = d1 * d2;
    rawText = rNum + '/' + rDen;
    stepText = '(' + n1 + '×' + n2 + ') / (' + d1 + '×' + d2 + ') = ' + rawText;
  } else {
    rNum = n1 * d2;
    rDen = d1 * n2;
    rawText = rNum + '/' + rDen;
    stepText = n1 + '/' + d1 + ' × ' + d2 + '/' + n2 + ' = ' + rawText;
  }

  if (rDen < 0) { rDen = -rDen; rNum = -rNum; }

  var g = gcd(rNum, rDen) || 1;
  var sNum = rNum / g;
  var sDen = rDen / g;

  var decVal = sNum / sDen;
  var mixed = mixedOf(sNum, sDen);
  var simpStr = sDen === 1 ? String(sNum) : sNum + '/' + sDen;

  document.getElementById('res-frac').textContent = simpStr;
  document.getElementById('res-mixed').textContent = sDen === 1 ? '' : 'mixed number: ' + mixed;
  document.getElementById('res-eq').textContent = n1 + '/' + d1 + ' ' + opSymbols[fracOp] + ' ' + n2 + '/' + d2 + ' = ' + simpStr;

  document.getElementById('s-dec').textContent = fmtDec(decVal);
  document.getElementById('s-raw').textContent = rawText;
  document.getElementById('s-gcd').textContent = g;
  document.getElementById('s-mixed2').textContent = mixed;

  document.getElementById('steps-text').innerHTML = '<strong>Steps:</strong> ' + stepText + (g > 1 ? ' → GCD(' + Math.abs(rNum) + ',' + Math.abs(rDen) + ')=' + g + ' → ' + simpStr : ' → already simplified');

  document.getElementById('res-hero').classList.add('show');
  document.getElementById('res-stats').classList.add('show');
  document.getElementById('steps-box').style.display = 'flex';
}

function setPreset(n1, d1, op, n2, d2) {
  document.getElementById('n1').value = n1;
  document.getElementById('d1').value = d1;
  document.getElementById('n2').value = n2;
  document.getElementById('d2').value = d2;
  setOp(op);
}

setPreset(1, 2, 'add', 1, 3);
</script>
</Layout>
