---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Percentage Increase Calculator",
    "url": "https://computezap.com/calculators/percentage-increase-calculator",
    "description": "Free percentage increase calculator. Find the percentage increase between two numbers, or calculate the new value after a percentage increase. Instant results.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Percentage Calculator", "item": "https://computezap.com/percentage-calculator" },
      { "@type": "ListItem", "position": 3, "name": "Percentage Increase Calculator", "item": "https://computezap.com/calculators/percentage-increase-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate percentage increase?",
        "acceptedAnswer": { "@type": "Answer", "text": "Percentage Increase = ((New Value - Old Value) ÷ Old Value) × 100. Example: from 80 to 100 → ((100 - 80) ÷ 80) × 100 = 25% increase." }
      },
      {
        "@type": "Question",
        "name": "What is a 10% increase on $500?",
        "acceptedAnswer": { "@type": "Answer", "text": "$500 × 1.10 = $550. The increase amount is $50. Use the Find New Value mode and enter 500 as the original value and 10 as the percentage." }
      },
      {
        "@type": "Question",
        "name": "How do I find the new value after a percentage increase?",
        "acceptedAnswer": { "@type": "Answer", "text": "New Value = Old Value × (1 + Percentage ÷ 100). Example: 500 with a 30% increase → 500 × 1.30 = 650." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between percentage increase and percentage points?",
        "acceptedAnswer": { "@type": "Answer", "text": "A percentage increase is relative — going from 50% to 60% is a 20% relative increase ((60-50)/50×100 = 20%). A percentage point change is absolute — going from 50% to 60% is 10 percentage points. These are often confused." }
      },
      {
        "@type": "Question",
        "name": "What is a 100% increase?",
        "acceptedAnswer": { "@type": "Answer", "text": "A 100% increase means the value doubled. If something costs $50 and increases by 100%, the new price is $100. A 200% increase means the value tripled." }
      }
    ]
  }
]);
---
<Layout
  title="Percentage Increase Calculator — % Growth Between Two Numbers | ComputeZap"
  description="Free percentage increase calculator. Find the percentage increase between two numbers, or calculate the new value after a percentage increase. Instant results."
  canonical="/calculators/percentage-increase-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › <a href="/percentage-calculator">Percentage</a> › Percentage Increase Calculator</nav>
  <h1>Percentage Increase Calculator</h1>
  <p>Find the % increase between two numbers, or calculate the new value after a % increase</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-m1">Find % Increase</button>
      <button class="mode-btn" id="btn-m2">Find New Value</button>
    </div>

    <div id="inputs-1">
      <div class="input-group">
        <label>Original Value</label>
        <div class="input-wrap">
          <input type="number" id="old1" placeholder="80" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>New Value</label>
        <div class="input-wrap">
          <input type="number" id="new1" placeholder="100" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
    </div>

    <div id="inputs-2" style="display:none">
      <div class="input-group">
        <label>Original Value</label>
        <div class="input-wrap">
          <input type="number" id="old2" placeholder="80" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Percentage Increase</label>
        <div class="input-wrap">
          <input type="number" id="pct2" placeholder="25" min="0" step="any" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">Percentage Increase</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit"></div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Original</span><span class="stat-val" id="s1-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s2-lbl">New Value</span><span class="stat-val" id="s2-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl">Change Amount</span><span class="stat-val" id="s3-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s4-lbl">Multiplier</span><span class="stat-val" id="s4-val">—</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Percentage Increase Formula</h2>
    <div class="formula-box">
      <div class="formula-text">% Increase = ((New − Old) ÷ Old) × 100</div>
      <div class="formula-sub">Example: 80 → 100 = ((100 − 80) ÷ 80) × 100 = <strong>25% increase</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">New Value = Old × (1 + % ÷ 100)</div>
      <div class="formula-sub">Example: 80 with 25% increase = 80 × 1.25 = <strong>100</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Quick rule:</strong> A 100% increase = doubling. A 50% increase = multiplying by 1.5. A 200% increase = tripling. A 10% increase = multiplying by 1.10.</p>
    </div>
  </div>

  <div class="card">
    <h2>Percentage Increase Reference Table</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>% Increase</th><th>On 100</th><th>On 500</th><th>On 1,000</th><th>On 10,000</th></tr></thead>
        <tbody>
          {[
            ['5%', '105', '525', '1,050', '10,500'],
            ['10%', '110', '550', '1,100', '11,000'],
            ['15%', '115', '575', '1,150', '11,500'],
            ['20%', '120', '600', '1,200', '12,000'],
            ['25%', '125', '625', '1,250', '12,500'],
            ['30%', '130', '650', '1,300', '13,000'],
            ['40%', '140', '700', '1,400', '14,000'],
            ['50%', '150', '750', '1,500', '15,000'],
            ['75%', '175', '875', '1,750', '17,500'],
            ['100%', '200', '1,000', '2,000', '20,000'],
            ['150%', '250', '1,250', '2,500', '25,000'],
            ['200%', '300', '1,500', '3,000', '30,000'],
          ].map(([pct, v100, v500, v1k, v10k]) => (
            <tr>
              <td class="acc">{pct}</td>
              <td>{v100}</td>
              <td>{v500}</td>
              <td>{v1k}</td>
              <td>{v10k}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Real-World Percentage Increase Examples</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Scenario</th><th>Old Value</th><th>New Value</th><th>% Increase</th></tr></thead>
        <tbody>
          <tr><td>Salary raise</td><td>$60,000</td><td>$66,000</td><td class="acc">10%</td></tr>
          <tr><td>Stock gain</td><td>$50</td><td>$75</td><td class="acc">50%</td></tr>
          <tr><td>Rent increase</td><td>$1,200/mo</td><td>$1,380/mo</td><td class="acc">15%</td></tr>
          <tr><td>Website traffic</td><td>10,000/mo</td><td>13,500/mo</td><td class="acc">35%</td></tr>
          <tr><td>Gas price</td><td>$3.00/gal</td><td>$3.60/gal</td><td class="acc">20%</td></tr>
          <tr><td>Revenue growth</td><td>$200,000</td><td>$300,000</td><td class="acc">50%</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do I calculate percentage increase?</h3>
      <p>Use the formula: <strong>((New − Old) ÷ Old) × 100</strong>. For example, if a price went from $80 to $100: ((100 − 80) ÷ 80) × 100 = <strong>25% increase</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>What is a 10% increase on $500?</h3>
      <p>$500 × 1.10 = <strong>$550</strong>. The increase amount is $50. Use "Find New Value" mode, enter 500 as original and 10 as the percentage.</p>
    </div>
    <div class="faq-item">
      <h3>What is the difference between percentage increase and percentage points?</h3>
      <p>A <strong>percentage increase</strong> is relative — going from 50% to 60% is a 20% relative increase ((60−50)÷50×100). A <strong>percentage point</strong> change is absolute — going from 50% to 60% is 10 percentage points. These are frequently confused in finance and news.</p>
    </div>
    <div class="faq-item">
      <h3>How do I reverse a percentage increase to find the original value?</h3>
      <p>Original = New Value ÷ (1 + % ÷ 100). If a price is $120 after a 20% increase: $120 ÷ 1.20 = <strong>$100</strong> original price.</p>
    </div>
    <div class="faq-item">
      <h3>What is a 100% increase?</h3>
      <p>A 100% increase means the value doubled. If something costs $50 and increases by 100%, the new price is $100. A 200% increase means it tripled to $150.</p>
    </div>
    <div class="faq-item">
      <h3>How is percentage increase different from percentage decrease?</h3>
      <p>Both use the same base formula but in opposite directions. An increase means the new value is higher than the original. A decrease means the new value is lower. The formula differs only in which value is subtracted from which.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/percentage-decrease-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Decrease Calculator</h3>
        <p>Find the percentage decrease between two values</p>
      </a>
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>Percentage Calculator</h3>
        <p>Find X% of Y, what % X is of Y, and more</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the sale price after a discount</p>
      </a>
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost</p>
      </a>
      <a href="/markup-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Markup Calculator</h3>
        <p>Find selling price from cost and markup %</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find original price before tax was added</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 1;

document.getElementById('btn-m1').addEventListener('click', function() { setMode(1); });
document.getElementById('btn-m2').addEventListener('click', function() { setMode(2); });
document.getElementById('calc-btn').addEventListener('click', calculate);
document.getElementById('old1').addEventListener('input', calculate);
document.getElementById('new1').addEventListener('input', calculate);
document.getElementById('old2').addEventListener('input', calculate);
document.getElementById('pct2').addEventListener('input', calculate);
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

function fmt(n) {
  return parseFloat(n.toFixed(4)).toLocaleString();
}
function fmtP(n) { return parseFloat(n.toFixed(2)) + '%'; }

function setMode(m) {
  mode = m;
  document.getElementById('btn-m1').classList.toggle('active', m === 1);
  document.getElementById('btn-m2').classList.toggle('active', m === 2);
  document.getElementById('inputs-1').style.display = m === 1 ? 'block' : 'none';
  document.getElementById('inputs-2').style.display = m === 2 ? 'block' : 'none';
  document.getElementById('answer').classList.remove('show');
  document.getElementById('stats').classList.remove('show');
}

function calculate() {
  if (mode === 1) calcIncrease();
  else calcNewVal();
}

function calcIncrease() {
  var oldV = parseFloat(document.getElementById('old1').value);
  var newV = parseFloat(document.getElementById('new1').value);
  if (isNaN(oldV) || isNaN(newV) || oldV === 0) return;
  var pct = ((newV - oldV) / oldV) * 100;
  var change = newV - oldV;
  var mult = newV / oldV;
  document.getElementById('ans-label').textContent = pct >= 0 ? 'Percentage Increase' : 'Percentage Decrease';
  document.getElementById('ans-value').textContent = fmtP(Math.abs(pct));
  document.getElementById('ans-unit').textContent = fmt(oldV) + ' → ' + fmt(newV);
  document.getElementById('ans-sub').textContent = (change >= 0 ? 'Increased by +' : 'Decreased by ') + fmt(Math.abs(change));
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmt(oldV);
  document.getElementById('s2-lbl').textContent = 'New Value';
  document.getElementById('s2-val').textContent = fmt(newV);
  document.getElementById('s3-val').textContent = (change >= 0 ? '+' : '') + fmt(change);
  document.getElementById('s4-lbl').textContent = 'Multiplier';
  document.getElementById('s4-val').textContent = parseFloat(mult.toFixed(4)) + '×';
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}

function calcNewVal() {
  var oldV = parseFloat(document.getElementById('old2').value);
  var pct = parseFloat(document.getElementById('pct2').value);
  if (isNaN(oldV) || isNaN(pct)) return;
  var newV = oldV * (1 + pct / 100);
  var change = newV - oldV;
  document.getElementById('ans-label').textContent = 'New Value After ' + fmtP(pct) + ' Increase';
  document.getElementById('ans-value').textContent = fmt(newV);
  document.getElementById('ans-unit').textContent = fmt(oldV) + ' + ' + fmtP(pct) + ' = ' + fmt(newV);
  document.getElementById('ans-sub').textContent = 'Increase amount: +' + fmt(change);
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmt(oldV);
  document.getElementById('s2-lbl').textContent = '% Increase';
  document.getElementById('s2-val').textContent = fmtP(pct);
  document.getElementById('s3-val').textContent = '+' + fmt(change);
  document.getElementById('s4-lbl').textContent = 'New Value';
  document.getElementById('s4-val').textContent = fmt(newV);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}
</script>
</Layout>
