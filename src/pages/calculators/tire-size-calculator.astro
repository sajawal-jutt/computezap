---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Tire Size Calculator",
    "url": "https://computezap.com/calculators/tire-size-calculator",
    "description": "Free tire size calculator — decode any tire size to get diameter, sidewall height, circumference, and revolutions per mile. Compare two sizes for speedometer correction.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com/" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://computezap.com/calculators/" },
      { "@type": "ListItem", "position": 3, "name": "Tire Size Calculator", "item": "https://computezap.com/calculators/tire-size-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I read a tire size like 225/65R17?", "acceptedAnswer": { "@type": "Answer", "text": "225 is the tire width in mm. 65 is the aspect ratio — sidewall height is 65% of 225mm = 146.25mm. R means radial construction. 17 is the wheel diameter in inches." } },
      { "@type": "Question", "name": "What is tire diameter and how is it calculated?", "acceptedAnswer": { "@type": "Answer", "text": "Tire diameter = (sidewall height × 2) + (wheel diameter in mm). For 225/65R17: sidewall = 146.25mm, diameter = 146.25 × 2 + 17 × 25.4 = 724.3mm (28.52 inches)." } },
      { "@type": "Question", "name": "How much tire size difference is acceptable?", "acceptedAnswer": { "@type": "Answer", "text": "Most manufacturers recommend keeping the overall diameter within 3% of the original. Beyond that, it can affect speedometer accuracy, ABS/traction control calibration, and clearance." } },
      { "@type": "Question", "name": "How does changing tire size affect the speedometer?", "acceptedAnswer": { "@type": "Answer", "text": "A larger tire has a bigger circumference, so it covers more ground per revolution. The speedometer reads low — you're going faster than it shows. A smaller tire makes the speedometer read high." } },
      { "@type": "Question", "name": "What is the aspect ratio on a tire?", "acceptedAnswer": { "@type": "Answer", "text": "The aspect ratio is the sidewall height expressed as a percentage of the tire width. A 225/65R17 has an aspect ratio of 65, meaning the sidewall height is 65% of 225mm = 146.25mm." } },
      { "@type": "Question", "name": "What is plus sizing?", "acceptedAnswer": { "@type": "Answer", "text": "Plus sizing means fitting a larger wheel diameter with a lower profile (lower aspect ratio) tire to keep the overall diameter the same. For example, going from 225/65R17 to 235/55R18 keeps a similar total diameter." } },
      { "@type": "Question", "name": "Can I replace 225/65R17 with 235/65R17?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — the overall diameter increases from 28.52\" to 28.98\", a difference of 1.6%. The speedometer will read about 1.6% low. This is within most acceptable ranges but always verify with your vehicle's manual." } },
      { "@type": "Question", "name": "How many revolutions per mile does a tire make?", "acceptedAnswer": { "@type": "Answer", "text": "Revolutions per mile = 63,360 / (tire circumference in inches). A 225/65R17 has a circumference of about 89.6 inches, so it makes approximately 707 revolutions per mile." } },
      { "@type": "Question", "name": "What is sidewall height?", "acceptedAnswer": { "@type": "Answer", "text": "Sidewall height is the distance from the wheel rim to the outer edge of the tire tread. It equals Width × (Aspect Ratio / 100). For 225/65R17: 225 × 0.65 = 146.25mm (5.76 inches)." } },
      { "@type": "Question", "name": "Does tire size affect fuel economy?", "acceptedAnswer": { "@type": "Answer", "text": "Yes. Wider tires have more rolling resistance and aerodynamic drag, which can reduce fuel economy. Taller tires require more energy to rotate. Narrower, smaller diameter tires are generally more fuel-efficient." } }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Use the Tire Size Calculator",
    "step": [
      { "@type": "HowToStep", "name": "Choose a mode", "text": "Select Decode to analyze a single tire size, or Compare to see the difference between two tire sizes." },
      { "@type": "HowToStep", "name": "Enter tire width", "text": "Enter the section width in millimeters — the first number in a tire size like 225/65R17." },
      { "@type": "HowToStep", "name": "Enter aspect ratio and wheel diameter", "text": "Enter the aspect ratio (65) and wheel diameter in inches (17) from your tire size." },
      { "@type": "HowToStep", "name": "Review results", "text": "See the tire diameter, sidewall height, circumference, and revolutions per mile. In Compare mode, see speedometer error and diameter difference." }
    ]
  }
]);

const commonSizes = [
  { size: '185/65R15', dia: '23.47', sw: '4.73', circ: '73.73', rpm: '860' },
  { size: '195/65R15', dia: '24.99', sw: '4.97', circ: '78.51', rpm: '807' },
  { size: '205/55R16', dia: '24.88', sw: '4.44', circ: '78.16', rpm: '811' },
  { size: '215/60R16', dia: '25.59', sw: '5.08', circ: '80.38', rpm: '788' },
  { size: '225/65R17', dia: '28.52', sw: '5.76', circ: '89.60', rpm: '707' },
  { size: '235/65R17', dia: '28.98', sw: '6.01', circ: '91.03', rpm: '696' },
  { size: '245/70R17', dia: '30.47', sw: '6.75', circ: '95.71', rpm: '662' },
  { size: '265/70R17', dia: '31.61', sw: '7.30', circ: '99.29', rpm: '638' },
  { size: '275/55R20', dia: '31.91', sw: '5.95', circ: '100.23', rpm: '632' },
  { size: '285/70R17', dia: '32.71', sw: '7.78', circ: '102.75', rpm: '616' },
];
---
<Layout
  title="Tire Size Calculator — Diameter, Sidewall & Speedometer Correction | ComputeZap"
  description="Free tire size calculator: decode 225/65R17 to get diameter, sidewall height, circumference, and revolutions per mile. Compare two sizes for speedometer error."
  canonical="/calculators/tire-size-calculator"
  schema={schema}
>
  <div class="page-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › <a href="/calculators/">Calculators</a> › <span>Tire Size Calculator</span>
    </nav>
    <h1>Tire Size Calculator</h1>
    <p class="hero-sub">Decode any tire size — or compare two sizes for speedometer correction and diameter difference.</p>
  </div>

  <div class="calc-center">
    <div class="calc-card">

      <div class="mode-wrap" style="grid-template-columns:1fr 1fr">
        <button class="mode-btn active" id="btn-decode" onclick="setMode('decode')">🔍 Decode Size</button>
        <button class="mode-btn" id="btn-compare" onclick="setMode('compare')">⚖️ Compare Sizes</button>
      </div>

      <!-- DECODE MODE -->
      <div id="decode-panel">
        <p style="font-size:.82rem;color:#64748b;margin:.25rem 0 1rem;text-align:center">Enter your tire size — found on the tire sidewall</p>
        <div class="two-col">
          <div class="input-group">
            <label for="d-w">Width (mm)</label>
            <div class="input-wrap">
              <input type="number" id="d-w" value="225" min="100" max="400" aria-label="Tire width in millimeters" oninput="calcDecode()" />
            </div>
          </div>
          <div class="input-group">
            <label for="d-r">Aspect Ratio (%)</label>
            <div class="input-wrap">
              <input type="number" id="d-r" value="65" min="20" max="100" aria-label="Aspect ratio percentage" oninput="calcDecode()" />
            </div>
          </div>
        </div>
        <div class="input-group">
          <label for="d-wh">Wheel Diameter (in)</label>
          <div class="input-wrap">
            <input type="number" id="d-wh" value="17" min="10" max="30" aria-label="Wheel diameter in inches" oninput="calcDecode()" />
          </div>
        </div>
        <div class="preset-wrap">
          <span class="preset-lbl">Common sizes:</span>
          <button class="preset-btn" onclick="setPreset(205,55,16)">205/55R16</button>
          <button class="preset-btn" onclick="setPreset(225,65,17)">225/65R17</button>
          <button class="preset-btn" onclick="setPreset(265,70,17)">265/70R17</button>
          <button class="preset-btn" onclick="setPreset(275,55,20)">275/55R20</button>
          <button class="preset-btn" onclick="setPreset(235,45,18)">235/45R18</button>
        </div>
      </div>

      <!-- COMPARE MODE -->
      <div id="compare-panel" style="display:none">
        <p style="font-size:.82rem;color:#64748b;margin:.25rem 0 1rem;text-align:center">Compare your current tire to a potential replacement</p>
        <div class="two-col">
          <div>
            <p style="font-size:.8rem;font-weight:700;color:#2563eb;margin:0 0 .5rem;text-transform:uppercase;letter-spacing:.05em">Tire 1 — Current</p>
            <div class="input-group">
              <label for="c-w1">Width (mm)</label>
              <div class="input-wrap"><input type="number" id="c-w1" value="225" min="100" max="400" aria-label="Tire 1 width" oninput="calcCompare()" /></div>
            </div>
            <div class="input-group">
              <label for="c-r1">Aspect Ratio (%)</label>
              <div class="input-wrap"><input type="number" id="c-r1" value="65" min="20" max="100" aria-label="Tire 1 aspect ratio" oninput="calcCompare()" /></div>
            </div>
            <div class="input-group">
              <label for="c-wh1">Wheel (in)</label>
              <div class="input-wrap"><input type="number" id="c-wh1" value="17" min="10" max="30" aria-label="Tire 1 wheel diameter" oninput="calcCompare()" /></div>
            </div>
          </div>
          <div>
            <p style="font-size:.8rem;font-weight:700;color:#16a34a;margin:0 0 .5rem;text-transform:uppercase;letter-spacing:.05em">Tire 2 — New</p>
            <div class="input-group">
              <label for="c-w2">Width (mm)</label>
              <div class="input-wrap"><input type="number" id="c-w2" value="235" min="100" max="400" aria-label="Tire 2 width" oninput="calcCompare()" /></div>
            </div>
            <div class="input-group">
              <label for="c-r2">Aspect Ratio (%)</label>
              <div class="input-wrap"><input type="number" id="c-r2" value="65" min="20" max="100" aria-label="Tire 2 aspect ratio" oninput="calcCompare()" /></div>
            </div>
            <div class="input-group">
              <label for="c-wh2">Wheel (in)</label>
              <div class="input-wrap"><input type="number" id="c-wh2" value="17" min="10" max="30" aria-label="Tire 2 wheel diameter" oninput="calcCompare()" /></div>
            </div>
          </div>
        </div>
      </div>

      <!-- RESULTS (shared) -->
      <div class="answer-hero" id="answer">
        <div class="a-label" id="res-label">225/65R17 Tire Diameter</div>
        <div><span class="a-value" id="res-val">28.52</span><span class="a-unit" id="res-unit">inches</span></div>
        <div class="a-sub" id="res-sub">724.3 mm</div>
      </div>

      <div class="stats-row" id="stats">
        <div class="stat-box">
          <div class="stat-lbl" id="lbl-1">Sidewall Height</div>
          <div class="stat-val" id="val-1">—</div>
        </div>
        <div class="stat-box">
          <div class="stat-lbl" id="lbl-2">Circumference</div>
          <div class="stat-val" id="val-2">—</div>
        </div>
        <div class="stat-box">
          <div class="stat-lbl" id="lbl-3">Revs / Mile</div>
          <div class="stat-val" id="val-3">—</div>
        </div>
        <div class="stat-box">
          <div class="stat-lbl" id="lbl-4">Revs / km</div>
          <div class="stat-val" id="val-4">—</div>
        </div>
      </div>

    </div>
  </div>

  <div class="content-wrap">

    <div class="formula-box">
      <div class="formula-text">Diameter = (Width × Ratio / 100 × 2) + (Wheel × 25.4)</div>
      <div class="formula-sub">All values in mm — divide by 25.4 for inches</div>
      <div class="formula-text" style="margin-top:.75rem">Speedometer Error = (New Circumference − Original) / Original × 100%</div>
      <div class="formula-sub">Positive = speedo reads LOW (bigger tire) &nbsp;|&nbsp; Negative = speedo reads HIGH (smaller tire)</div>
    </div>

    <div class="content-card">
      <h2>How to Read a Tire Size</h2>
      <p>Tire sizes are printed on the sidewall in the format <strong>Width/Ratio R Wheel</strong> — for example <strong>225/65R17</strong>:</p>
      <div style="overflow-x:auto;-webkit-overflow-scrolling:touch;margin-top:.75rem">
        <table class="payoff-table">
          <thead><tr><th>Part</th><th>Value</th><th>Meaning</th></tr></thead>
          <tbody>
            <tr><td><strong>225</strong></td><td>225 mm</td><td>Section width — widest point of the tire</td></tr>
            <tr><td><strong>65</strong></td><td>65%</td><td>Aspect ratio — sidewall height is 65% of width (146.25 mm)</td></tr>
            <tr><td><strong>R</strong></td><td>Radial</td><td>Construction type (radial is standard)</td></tr>
            <tr><td><strong>17</strong></td><td>17 inches</td><td>Wheel (rim) diameter</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="content-card">
      <h2>Common Tire Sizes — Quick Reference</h2>
      <div style="overflow-x:auto;-webkit-overflow-scrolling:touch">
        <table class="payoff-table">
          <thead>
            <tr>
              <th>Tire Size</th>
              <th>Diameter</th>
              <th>Sidewall</th>
              <th>Circumference</th>
              <th>Revs/Mile</th>
            </tr>
          </thead>
          <tbody>
            {commonSizes.map(s => (
              <tr>
                <td><strong>{s.size}</strong></td>
                <td>{s.dia}"</td>
                <td>{s.sw}"</td>
                <td>{s.circ}"</td>
                <td>{s.rpm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="content-card">
      <h2>Frequently Asked Questions</h2>

      <div class="faq-item">
        <h3>How do I read a tire size like 225/65R17?</h3>
        <p>225 is the tire width in mm. 65 is the aspect ratio — the sidewall height is 65% of 225mm = 146.25mm. R means radial construction. 17 is the wheel (rim) diameter in inches.</p>
      </div>

      <div class="faq-item">
        <h3>How is tire diameter calculated?</h3>
        <p>Tire diameter = (Sidewall height × 2) + (Wheel diameter in mm). Sidewall height = Width × Aspect ratio / 100. For 225/65R17: sidewall = 146.25mm, diameter = 146.25 × 2 + 17 × 25.4 = 724.3mm = 28.52".</p>
      </div>

      <div class="faq-item">
        <h3>How much tire size difference is acceptable?</h3>
        <p>Most manufacturers recommend keeping overall diameter within <strong>3% of the original</strong>. Beyond that, the difference can affect speedometer accuracy, ABS/traction control calibration, and tire clearance inside the wheel well.</p>
      </div>

      <div class="faq-item">
        <h3>How does changing tire size affect the speedometer?</h3>
        <p>A bigger tire covers more ground per revolution, so the speedometer reads lower than your actual speed. A smaller tire causes the speedometer to read high. Use Compare mode above to calculate the exact error for any two sizes.</p>
      </div>

      <div class="faq-item">
        <h3>Can I replace 225/65R17 with 235/65R17?</h3>
        <p>Yes — the overall diameter increases from 28.52" to 28.98" (+1.6%). The speedometer will read about 1.6% low at highway speeds. This is within most acceptable ranges but verify clearance and check your vehicle's manual.</p>
      </div>

      <div class="faq-item">
        <h3>What is plus sizing?</h3>
        <p>Plus sizing means fitting a larger wheel with a lower-profile tire to maintain the same overall diameter. For example, going from 225/65R17 to 235/55R18 keeps a similar diameter while fitting an 18" wheel — improving handling with more rim and less sidewall flex.</p>
      </div>

      <div class="faq-item">
        <h3>What is aspect ratio?</h3>
        <p>The aspect ratio is the sidewall height expressed as a percentage of the tire width. A lower aspect ratio (e.g., 45) means a shorter, stiffer sidewall — common on sports cars. A higher aspect ratio (e.g., 70) means a taller sidewall — common on trucks and SUVs for more cushioning.</p>
      </div>

      <div class="faq-item">
        <h3>How many revolutions per mile does a tire make?</h3>
        <p>Revolutions per mile = 63,360 ÷ circumference (in inches). A 225/65R17 has a 89.6" circumference, giving it approximately 707 revolutions per mile. Larger tires make fewer revolutions per mile.</p>
      </div>
    </div>

    <div class="content-card">
      <h2>Related Calculators</h2>
      <div class="next-grid">
        <a href="/calculators/pythagorean-theorem-calculator" class="next-card">
          <span class="next-tag">Math</span>
          Pythagorean Theorem Calculator
        </a>
        <a href="/calculators/square-footage-calculator" class="next-card">
          <span class="next-tag">Area</span>
          Square Footage Calculator
        </a>
        <a href="/finance/car-payoff-calculator" class="next-card">
          <span class="next-tag">Finance</span>
          Car Payoff Calculator
        </a>
        <a href="/calculators/percentage-calculator" class="next-card">
          <span class="next-tag">Math</span>
          Percentage Calculator
        </a>
        <a href="/converters/km-to-miles" class="next-card">
          <span class="next-tag">Converter</span>
          km to Miles
        </a>
        <a href="/calculators/" class="next-card">
          <span class="next-tag">All</span>
          All Math Calculators
        </a>
      </div>
    </div>

  </div>

  <script is:inline>
    var tireMode = 'decode';

    function setMode(m) {
      tireMode = m;
      document.querySelectorAll('.mode-btn').forEach(function(b) { b.classList.remove('active'); });
      document.getElementById('btn-' + m).classList.add('active');
      document.getElementById('decode-panel').style.display = m === 'decode' ? '' : 'none';
      document.getElementById('compare-panel').style.display = m === 'compare' ? '' : 'none';
      document.getElementById('answer').classList.remove('show');
      document.getElementById('stats').classList.remove('show');
      if (m === 'decode') calcDecode();
      else calcCompare();
    }

    function calcTire(w, r, wh) {
      var sw_mm = w * r / 100;
      var dia_mm = sw_mm * 2 + wh * 25.4;
      var dia_in = dia_mm / 25.4;
      var circ_in = Math.PI * dia_in;
      var circ_mm = Math.PI * dia_mm;
      var rpm = 63360 / circ_in;
      var rpk = 1000000 / circ_mm;
      return { sw_mm: sw_mm, dia_mm: dia_mm, dia_in: dia_in, circ_in: circ_in, circ_mm: circ_mm, rpm: rpm, rpk: rpk };
    }

    function fi(n, d) { return n.toFixed(d !== undefined ? d : 2) + '"'; }
    function fm(n) { return Math.round(n) + ' mm'; }

    function calcDecode() {
      var w = parseFloat(document.getElementById('d-w').value);
      var r = parseFloat(document.getElementById('d-r').value);
      var wh = parseFloat(document.getElementById('d-wh').value);
      if (!w || !r || !wh || w <= 0 || r <= 0 || wh <= 0) return;
      var t = calcTire(w, r, wh);
      document.getElementById('res-label').textContent = w + '/' + r + 'R' + wh + ' — Tire Diameter';
      document.getElementById('res-val').textContent = t.dia_in.toFixed(2);
      document.getElementById('res-unit').textContent = 'inches';
      document.getElementById('res-sub').textContent = Math.round(t.dia_mm) + ' mm diameter';
      document.getElementById('lbl-1').textContent = 'Sidewall Height';
      document.getElementById('val-1').textContent = fi(t.sw_mm / 25.4) + ' (' + Math.round(t.sw_mm) + ' mm)';
      document.getElementById('lbl-2').textContent = 'Circumference';
      document.getElementById('val-2').textContent = fi(t.circ_in) + ' (' + Math.round(t.circ_mm) + ' mm)';
      document.getElementById('lbl-3').textContent = 'Revs / Mile';
      document.getElementById('val-3').textContent = Math.round(t.rpm).toLocaleString();
      document.getElementById('lbl-4').textContent = 'Revs / km';
      document.getElementById('val-4').textContent = Math.round(t.rpk).toLocaleString();
      document.getElementById('answer').classList.add('show');
      document.getElementById('stats').classList.add('show');
    }

    function calcCompare() {
      var w1 = parseFloat(document.getElementById('c-w1').value);
      var r1 = parseFloat(document.getElementById('c-r1').value);
      var wh1 = parseFloat(document.getElementById('c-wh1').value);
      var w2 = parseFloat(document.getElementById('c-w2').value);
      var r2 = parseFloat(document.getElementById('c-r2').value);
      var wh2 = parseFloat(document.getElementById('c-wh2').value);
      if (!w1 || !r1 || !wh1 || !w2 || !r2 || !wh2) return;
      var t1 = calcTire(w1, r1, wh1);
      var t2 = calcTire(w2, r2, wh2);
      var diaDiff = t2.dia_in - t1.dia_in;
      var diaDiffPct = (diaDiff / t1.dia_in) * 100;
      var widthDiff = w2 - w1;
      var speedoErr = ((t2.circ_in - t1.circ_in) / t1.circ_in) * 100;
      var actualAt60 = 60 * (t2.circ_in / t1.circ_in);
      var errLabel, errDir;
      if (Math.abs(speedoErr) < 0.05) {
        errLabel = 'No speedometer change';
        errDir = 'same size';
      } else if (speedoErr > 0) {
        errLabel = 'Speedometer reads ' + speedoErr.toFixed(1) + '% LOW';
        errDir = 'Tire 2 is bigger — you\'re going faster than speedo shows';
      } else {
        errLabel = 'Speedometer reads ' + Math.abs(speedoErr).toFixed(1) + '% HIGH';
        errDir = 'Tire 2 is smaller — you\'re going slower than speedo shows';
      }
      document.getElementById('res-label').textContent = errLabel;
      document.getElementById('res-val').textContent = (diaDiff >= 0 ? '+' : '') + diaDiff.toFixed(2);
      document.getElementById('res-unit').textContent = 'in diameter difference';
      document.getElementById('res-sub').textContent = 'At 60 mph displayed → actual speed ' + actualAt60.toFixed(1) + ' mph  |  ' + errDir;
      document.getElementById('lbl-1').textContent = 'Tire 1 Diameter';
      document.getElementById('val-1').textContent = fi(t1.dia_in);
      document.getElementById('lbl-2').textContent = 'Tire 2 Diameter';
      document.getElementById('val-2').textContent = fi(t2.dia_in);
      document.getElementById('lbl-3').textContent = 'Diameter Diff';
      document.getElementById('val-3').textContent = (diaDiffPct >= 0 ? '+' : '') + diaDiffPct.toFixed(1) + '%';
      document.getElementById('lbl-4').textContent = 'Width Diff';
      document.getElementById('val-4').textContent = (widthDiff >= 0 ? '+' : '') + widthDiff + ' mm';
      document.getElementById('answer').classList.add('show');
      document.getElementById('stats').classList.add('show');
    }

    function setPreset(w, r, wh) {
      document.getElementById('d-w').value = w;
      document.getElementById('d-r').value = r;
      document.getElementById('d-wh').value = wh;
      calcDecode();
    }

    calcDecode();
  </script>

</Layout>
