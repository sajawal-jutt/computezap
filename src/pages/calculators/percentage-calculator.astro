---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Percentage Calculator",
    "url": "https://computezap.com/calculators/percentage-calculator",
    "description": "Free percentage calculator. Find what % of a number is, what percent one number is of another, or what number equals X percent. Three calculators in one.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Percentage Calculator", "item": "https://computezap.com/calculators/percentage-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is 15% of 200?",
        "acceptedAnswer": { "@type": "Answer", "text": "15% of 200 = (15 ÷ 100) × 200 = 30. Use the percentage calculator above — enter 15 in the % field and 200 in the number field." }
      },
      {
        "@type": "Question",
        "name": "30 is what percent of 200?",
        "acceptedAnswer": { "@type": "Answer", "text": "30 is 15% of 200. Formula: (30 ÷ 200) × 100 = 15%." }
      },
      {
        "@type": "Question",
        "name": "30 is 15% of what number?",
        "acceptedAnswer": { "@type": "Answer", "text": "30 is 15% of 200. Formula: 30 ÷ (15 ÷ 100) = 30 ÷ 0.15 = 200." }
      },
      {
        "@type": "Question",
        "name": "How do I calculate percentage?",
        "acceptedAnswer": { "@type": "Answer", "text": "To find X% of Y: multiply Y by X/100. To find what % X is of Y: divide X by Y and multiply by 100. To find a total when you know a part and its percentage: divide the part by the percentage/100." }
      },
      {
        "@type": "Question",
        "name": "What is 20% of $150?",
        "acceptedAnswer": { "@type": "Answer", "text": "20% of $150 = (20 ÷ 100) × 150 = $30. This is commonly used to calculate tips, discounts, and tax amounts." }
      }
    ]
  }
]);
---
<Layout
  title="Percentage Calculator — Find X% of Y, What % is X of Y | ComputeZap"
  description="Free percentage calculator. Find what % of a number is, what percent one number is of another, or find the total from a percent. Three calculators in one."
  canonical="/calculators/percentage-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › Percentage Calculator</nav>
  <h1>Percentage Calculator</h1>
  <p>Three percentage calculators in one — find amount, find percent, or find total</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap" style="grid-template-columns:repeat(3,1fr)">
      <button class="mode-btn active" id="btn-m1">Find Amount</button>
      <button class="mode-btn" id="btn-m2">Find Percent</button>
      <button class="mode-btn" id="btn-m3">Find Total</button>
    </div>

    <!-- Mode 1: What is X% of Y? -->
    <div id="inputs-1">
      <div class="input-group">
        <label id="lbl1a">Percentage</label>
        <div class="input-wrap">
          <input type="number" id="m1-pct" placeholder="15" min="0" step="any" />
          <span class="input-sfx">%</span>
        </div>
      </div>
      <div class="input-group">
        <label>of Number</label>
        <div class="input-wrap">
          <input type="number" id="m1-num" placeholder="200" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <p style="font-size:.82rem;color:#94a3b8;margin:-.5rem 0 .75rem;text-align:center">What is <strong>X%</strong> of <strong>Y</strong>?</p>
    </div>

    <!-- Mode 2: X is what % of Y? -->
    <div id="inputs-2" style="display:none">
      <div class="input-group">
        <label>Value (X)</label>
        <div class="input-wrap">
          <input type="number" id="m2-x" placeholder="30" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Total (Y)</label>
        <div class="input-wrap">
          <input type="number" id="m2-y" placeholder="200" min="0.001" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <p style="font-size:.82rem;color:#94a3b8;margin:-.5rem 0 .75rem;text-align:center"><strong>X</strong> is what <strong>%</strong> of <strong>Y</strong>?</p>
    </div>

    <!-- Mode 3: X is Y% of what? -->
    <div id="inputs-3" style="display:none">
      <div class="input-group">
        <label>Value (X)</label>
        <div class="input-wrap">
          <input type="number" id="m3-x" placeholder="30" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Percentage (Y%)</label>
        <div class="input-wrap">
          <input type="number" id="m3-pct" placeholder="15" min="0.001" step="any" />
          <span class="input-sfx">%</span>
        </div>
      </div>
      <p style="font-size:.82rem;color:#94a3b8;margin:-.5rem 0 .75rem;text-align:center"><strong>X</strong> is <strong>Y%</strong> of what number?</p>
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">Result</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit"></div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Value</span><span class="stat-val" id="s1-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s2-lbl">Remaining</span><span class="stat-val" id="s2-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s3-lbl">Decimal</span><span class="stat-val" id="s3-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s4-lbl">Double %</span><span class="stat-val" id="s4-val">—</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Percentage Formulas Explained</h2>
    <div class="formula-box">
      <div class="formula-text">Find Amount: Result = (X% ÷ 100) × Y</div>
      <div class="formula-sub">Example: 15% of 200 = (15 ÷ 100) × 200 = <strong>30</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Find Percent: Result = (X ÷ Y) × 100</div>
      <div class="formula-sub">Example: 30 is what % of 200 = (30 ÷ 200) × 100 = <strong>15%</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Find Total: Result = X ÷ (Y% ÷ 100)</div>
      <div class="formula-sub">Example: 30 is 15% of what = 30 ÷ 0.15 = <strong>200</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Mental math shortcut:</strong> To find 10% of any number, just move the decimal left one place. $350 → 10% = $35. Then multiply: 20% = $70, 5% = $17.50, 15% = $52.50.</p>
    </div>
  </div>

  <div class="card">
    <h2>Common Percentage Quick Reference</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Calculation</th><th>On $50</th><th>On $100</th><th>On $200</th><th>On $1,000</th></tr></thead>
        <tbody>
          {[
            ['5%', '$2.50', '$5', '$10', '$50'],
            ['10%', '$5', '$10', '$20', '$100'],
            ['15%', '$7.50', '$15', '$30', '$150'],
            ['20%', '$10', '$20', '$40', '$200'],
            ['25%', '$12.50', '$25', '$50', '$250'],
            ['30%', '$15', '$30', '$60', '$300'],
            ['40%', '$20', '$40', '$80', '$400'],
            ['50%', '$25', '$50', '$100', '$500'],
            ['75%', '$37.50', '$75', '$150', '$750'],
          ].map(([pct, v50, v100, v200, v1k]) => (
            <tr>
              <td class="acc">{pct}</td>
              <td>{v50}</td>
              <td>{v100}</td>
              <td>{v200}</td>
              <td>{v1k}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Everyday Percentage Examples</h2>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">15% tip on $60 dinner</span><span class="answer-val">$9.00</span></div>
      <div class="answer-row"><span class="answer-lbl">20% tip on $85 restaurant bill</span><span class="answer-val">$17.00</span></div>
      <div class="answer-row"><span class="answer-lbl">8.5% sales tax on $120 purchase</span><span class="answer-val">$10.20</span></div>
      <div class="answer-row"><span class="answer-lbl">30% off a $79.99 item</span><span class="answer-val">$24.00 savings</span></div>
      <div class="answer-row"><span class="answer-lbl">5% annual raise on $55,000 salary</span><span class="answer-val">$2,750 more/year</span></div>
      <div class="answer-row"><span class="answer-lbl">401k contribution: 6% of $80,000</span><span class="answer-val">$4,800/year</span></div>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is 15% of 200?</h3>
      <p>15% of 200 = (15 ÷ 100) × 200 = <strong>30</strong>. Quick method: 10% of 200 = 20, 5% of 200 = 10, so 15% = 20 + 10 = 30.</p>
    </div>
    <div class="faq-item">
      <h3>30 is what percent of 200?</h3>
      <p>(30 ÷ 200) × 100 = <strong>15%</strong>. Use the "Find Percent" mode above — enter 30 as X and 200 as Y.</p>
    </div>
    <div class="faq-item">
      <h3>What is 20% of $150?</h3>
      <p>(20 ÷ 100) × 150 = <strong>$30</strong>. Commonly used for tips, discounts, and tax calculations.</p>
    </div>
    <div class="faq-item">
      <h3>How do I calculate a percentage tip?</h3>
      <p>Multiply the bill by the tip percentage divided by 100. For a 20% tip on $75: 0.20 × $75 = <strong>$15</strong>. For 15%: 0.15 × $75 = $11.25.</p>
    </div>
    <div class="faq-item">
      <h3>How do I calculate sales tax?</h3>
      <p>Multiply the price by the tax rate divided by 100. For 8% tax on $50: 0.08 × $50 = <strong>$4</strong> tax → total = $54.</p>
    </div>
    <div class="faq-item">
      <h3>What does "percent" mean?</h3>
      <p>"Percent" means "per hundred." 25% means 25 out of every 100, or 0.25 as a decimal. To convert a decimal to a percent, multiply by 100. To convert a percent to a decimal, divide by 100.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate sale price after any discount percentage</p>
      </a>
      <a href="/percentage-increase-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Increase Calculator</h3>
        <p>Find the percentage increase between two values</p>
      </a>
      <a href="/percentage-decrease-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Decrease Calculator</h3>
        <p>Find the percentage decrease between two values</p>
      </a>
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost</p>
      </a>
      <a href="/markup-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Markup Calculator</h3>
        <p>Find selling price from cost and markup %</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find original price before tax was added</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 1;

document.getElementById('btn-m1').addEventListener('click', function() { setMode(1); });
document.getElementById('btn-m2').addEventListener('click', function() { setMode(2); });
document.getElementById('btn-m3').addEventListener('click', function() { setMode(3); });
document.getElementById('calc-btn').addEventListener('click', calculate);

['m1-pct','m1-num','m2-x','m2-y','m3-x','m3-pct'].forEach(function(id) {
  document.getElementById(id).addEventListener('input', calculate);
});
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

function fmt(n) {
  var r = parseFloat(n.toFixed(6));
  return r % 1 === 0 ? r.toLocaleString() : parseFloat(r.toFixed(4)).toLocaleString();
}

function setMode(m) {
  mode = m;
  [1,2,3].forEach(function(i) {
    document.getElementById('btn-m' + i).classList.toggle('active', m === i);
    document.getElementById('inputs-' + i).style.display = m === i ? 'block' : 'none';
  });
  document.getElementById('answer').classList.remove('show');
  document.getElementById('stats').classList.remove('show');
}

function calculate() {
  if (mode === 1) calc1();
  else if (mode === 2) calc2();
  else calc3();
}

function calc1() {
  var pct = parseFloat(document.getElementById('m1-pct').value);
  var num = parseFloat(document.getElementById('m1-num').value);
  if (isNaN(pct) || isNaN(num)) return;
  var result = (pct / 100) * num;
  var remaining = num - result;
  document.getElementById('ans-label').textContent = 'Result';
  document.getElementById('ans-value').textContent = fmt(result);
  document.getElementById('ans-unit').textContent = pct + '% of ' + fmt(num) + ' = ' + fmt(result);
  document.getElementById('ans-sub').textContent = '(' + pct + ' ÷ 100) × ' + fmt(num);
  document.getElementById('s1-lbl').textContent = 'Result';
  document.getElementById('s1-val').textContent = fmt(result);
  document.getElementById('s2-lbl').textContent = 'Remaining';
  document.getElementById('s2-val').textContent = fmt(remaining);
  document.getElementById('s3-lbl').textContent = 'As Decimal';
  document.getElementById('s3-val').textContent = parseFloat((pct/100).toFixed(4));
  document.getElementById('s4-lbl').textContent = 'Double (' + (pct*2) + '%)';
  document.getElementById('s4-val').textContent = fmt(result * 2);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}

function calc2() {
  var x = parseFloat(document.getElementById('m2-x').value);
  var y = parseFloat(document.getElementById('m2-y').value);
  if (isNaN(x) || isNaN(y) || y === 0) return;
  var pct = (x / y) * 100;
  var remaining = y - x;
  var complement = 100 - pct;
  document.getElementById('ans-label').textContent = 'Percentage';
  document.getElementById('ans-value').textContent = parseFloat(pct.toFixed(4)) + '%';
  document.getElementById('ans-unit').textContent = fmt(x) + ' is ' + parseFloat(pct.toFixed(2)) + '% of ' + fmt(y);
  document.getElementById('ans-sub').textContent = '(' + fmt(x) + ' ÷ ' + fmt(y) + ') × 100';
  document.getElementById('s1-lbl').textContent = 'Value (X)';
  document.getElementById('s1-val').textContent = fmt(x);
  document.getElementById('s2-lbl').textContent = 'Total (Y)';
  document.getElementById('s2-val').textContent = fmt(y);
  document.getElementById('s3-lbl').textContent = 'Remaining';
  document.getElementById('s3-val').textContent = fmt(remaining);
  document.getElementById('s4-lbl').textContent = 'Complement';
  document.getElementById('s4-val').textContent = parseFloat(complement.toFixed(2)) + '%';
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}

function calc3() {
  var x = parseFloat(document.getElementById('m3-x').value);
  var pct = parseFloat(document.getElementById('m3-pct').value);
  if (isNaN(x) || isNaN(pct) || pct === 0) return;
  var total = x / (pct / 100);
  var other = total - x;
  document.getElementById('ans-label').textContent = 'Total Number';
  document.getElementById('ans-value').textContent = fmt(total);
  document.getElementById('ans-unit').textContent = fmt(x) + ' is ' + pct + '% of ' + fmt(total);
  document.getElementById('ans-sub').textContent = fmt(x) + ' ÷ ' + (pct/100) + ' = ' + fmt(total);
  document.getElementById('s1-lbl').textContent = 'Value (X)';
  document.getElementById('s1-val').textContent = fmt(x);
  document.getElementById('s2-lbl').textContent = 'Percentage';
  document.getElementById('s2-val').textContent = pct + '%';
  document.getElementById('s3-lbl').textContent = 'Total';
  document.getElementById('s3-val').textContent = fmt(total);
  document.getElementById('s4-lbl').textContent = 'Remaining';
  document.getElementById('s4-val').textContent = fmt(other);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}
</script>
</Layout>
