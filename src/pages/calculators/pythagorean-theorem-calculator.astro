---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pythagorean Theorem Calculator",
    "url": "https://www.computezap.com/calculators/pythagorean-theorem-calculator",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Calculate any side of a right triangle using a² + b² = c². Find hypotenuse, legs, area, perimeter, and angles instantly.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Pythagorean Theorem Calculator", "item": "https://www.computezap.com/calculators/pythagorean-theorem-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the Pythagorean theorem?", "acceptedAnswer": { "@type": "Answer", "text": "The Pythagorean theorem states that in a right triangle, the square of the hypotenuse (c) equals the sum of squares of the two legs (a and b). Formula: a² + b² = c²." } },
      { "@type": "Question", "name": "How do I find the hypotenuse?", "acceptedAnswer": { "@type": "Answer", "text": "To find the hypotenuse c, use: c = √(a² + b²). For example, if a = 3 and b = 4, then c = √(9 + 16) = √25 = 5." } },
      { "@type": "Question", "name": "How do I find a missing leg?", "acceptedAnswer": { "@type": "Answer", "text": "To find leg a when you know b and c: a = √(c² − b²). Example: if b = 4 and c = 5, then a = √(25 − 16) = √9 = 3." } },
      { "@type": "Question", "name": "What are the most common Pythagorean triples?", "acceptedAnswer": { "@type": "Answer", "text": "Common Pythagorean triples (a, b, c) where all three are whole numbers: 3-4-5, 5-12-13, 8-15-17, 7-24-25, 20-21-29. Multiples of these also work: 6-8-10, 9-12-15." } },
      { "@type": "Question", "name": "Does the Pythagorean theorem work for all triangles?", "acceptedAnswer": { "@type": "Answer", "text": "No — only for right triangles (triangles with exactly one 90° angle). For other triangles, use the Law of Cosines: c² = a² + b² − 2ab·cos(C)." } },
      { "@type": "Question", "name": "What is the hypotenuse of a 45-45-90 triangle with legs of 1?", "acceptedAnswer": { "@type": "Answer", "text": "c = √(1² + 1²) = √2 ≈ 1.414. In a 45-45-90 triangle, the hypotenuse is always leg × √2." } }
    ]
  }
]);
---
<Layout
  title="Pythagorean Theorem Calculator — Find Any Triangle Side | ComputeZap"
  description="Calculate any side of a right triangle using a² + b² = c². Find hypotenuse or missing leg. Shows area, perimeter, and angles. Free Pythagorean theorem calculator."
  canonical="/calculators/pythagorean-theorem-calculator"
  schema={schema}
>
<style is:global>
.err-msg{display:none;background:#fef2f2;border:1px solid #fecaca;border-radius:8px;padding:.6rem 1rem;color:#dc2626;font-size:.85rem;margin:.5rem 0}
.err-msg.show{display:block}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › Pythagorean Theorem Calculator</nav>
  <h1>Pythagorean Theorem Calculator</h1>
  <p>a² + b² = c² — find any side of a right triangle instantly</p>
</div>

<div class="calc-center">
  <div class="card">

    <span class="preset-lbl">Solve for:</span>
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-c" onclick="setMode('c')">Find c</button>
      <button class="mode-btn" id="btn-a" onclick="setMode('a')">Find a</button>
      <button class="mode-btn" id="btn-b" onclick="setMode('b')">Find b</button>
    </div>

    <div class="input-group" id="grp-a">
      <label for="inp-a">Leg a</label>
      <div class="input-wrap">
        <input type="number" id="inp-a" value="3" min="0" step="any" oninput="convert()" />
      </div>
    </div>

    <div class="input-group" id="grp-b">
      <label for="inp-b">Leg b</label>
      <div class="input-wrap">
        <input type="number" id="inp-b" value="4" min="0" step="any" oninput="convert()" />
      </div>
    </div>

    <div class="input-group" id="grp-c" style="display:none">
      <label for="inp-c">Hypotenuse c</label>
      <div class="input-wrap">
        <input type="number" id="inp-c" value="" min="0" step="any" oninput="convert()" />
      </div>
    </div>

    <div class="err-msg" id="err-msg">Please enter valid positive numbers.</div>

    <span class="preset-lbl">Common triples</span>
    <div class="preset-wrap">
      <button class="preset-btn" onclick="setTriple(3,4)">3-4-5</button>
      <button class="preset-btn" onclick="setTriple(5,12)">5-12-13</button>
      <button class="preset-btn" onclick="setTriple(8,15)">8-15-17</button>
      <button class="preset-btn" onclick="setTriple(7,24)">7-24-25</button>
      <button class="preset-btn" onclick="setTriple(6,8)">6-8-10</button>
    </div>

    <div class="result-hero">
      <div class="r-label" id="res-lbl">Hypotenuse c</div>
      <div class="r-value"><span id="r-main">5</span></div>
      <div class="r-sub" id="r-sub">3² + 4² = 5²</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Result</span><span class="stat-val" id="s1-val">c = 5</span></div>
      <div class="stat-box"><span class="stat-lbl">Area</span><span class="stat-val" id="s-area">6 sq units</span></div>
      <div class="stat-box"><span class="stat-lbl">Perimeter</span><span class="stat-val" id="s-perim">12</span></div>
      <div class="stat-box"><span class="stat-lbl">Angles α / β</span><span class="stat-val" id="s-angle">36.87° / 53.13°</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>The Pythagorean Theorem: a² + b² = c²</h2>
    <p>In any right triangle, the square of the <strong>hypotenuse</strong> (the longest side, opposite the 90° angle) equals the sum of the squares of the two <strong>legs</strong>. This formula was known to ancient Babylonians, but is named after the Greek mathematician Pythagoras (c. 570–495 BC).</p>
    <div class="formula-box">
      c = √(a² + b²) — find hypotenuse<br />
      a = √(c² − b²) — find leg a<br />
      b = √(c² − a²) — find leg b
    </div>
    <div class="tip-box">
      <span class="tip-icon">📐</span>
      <p><strong>Real-world use:</strong> The 3-4-5 triangle is used in construction to ensure corners are exactly 90°. Measure 3 feet along one wall, 4 feet along the other — if the diagonal is 5 feet, the corner is perfectly square.</p>
    </div>
  </div>

  <div class="card">
    <h2>Common Pythagorean Triples</h2>
    <p>Pythagorean triples are sets of three positive integers (a, b, c) where a² + b² = c². Click any row to load it.</p>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>a</th><th>b</th><th>c (hyp.)</th><th>Notes</th></tr></thead>
        <tbody>
          {[
            [3,4,5,'Most common triple'],
            [6,8,10,'× 2 of 3-4-5'],
            [5,12,13,'Second most common'],
            [8,15,17,'—'],
            [7,24,25,'—'],
            [9,12,15,'× 3 of 3-4-5'],
            [20,21,29,'—'],
            [9,40,41,'—'],
            [12,35,37,'—'],
            [11,60,61,'—'],
          ].map(([a, b, c, note]) => (
            <tr onclick={`setTriple(${a},${b})`} style="cursor:pointer" class={a === 3 ? 'highlight-row' : ''}>
              <td>{a}</td><td>{b}</td><td style="color:var(--blue);font-weight:700">{c}</td><td>{note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>How to Use This Calculator</h2>
    <p>Select which side you want to find using the buttons at the top of the calculator:</p>
    <ul>
      <li><strong>Find c</strong> — enter legs a and b, calculator finds hypotenuse c</li>
      <li><strong>Find a</strong> — enter leg b and hypotenuse c, calculator finds leg a</li>
      <li><strong>Find b</strong> — enter leg a and hypotenuse c, calculator finds leg b</li>
    </ul>
    <h3>Triangle measurements also shown:</h3>
    <ul>
      <li><strong>Area</strong> = (a × b) / 2</li>
      <li><strong>Perimeter</strong> = a + b + c</li>
      <li><strong>Angle α</strong> = arctan(a / b) — the angle opposite leg a</li>
      <li><strong>Angle β</strong> = 90° − α (since angles in a triangle sum to 180°)</li>
    </ul>
  </div>

  <div class="card">
    <h2>Real-World Applications of the Pythagorean Theorem</h2>
    <ul>
      <li><strong>Construction & carpentry</strong> — checking square corners, calculating rafter lengths, staircase design, and diagonal bracing.</li>
      <li><strong>Navigation</strong> — finding the straight-line distance between two points on a map using the distance formula (derived from the Pythagorean theorem).</li>
      <li><strong>Screen & display dimensions</strong> — a TV's diagonal size is calculated from width and height using a² + b² = c².</li>
      <li><strong>Physics & engineering</strong> — calculating resultant forces, velocity components, and vector magnitudes in 2D space.</li>
      <li><strong>Computer graphics</strong> — calculating the distance between two points in a 2D or 3D coordinate system.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is the Pythagorean theorem?</h3>
      <p>In a right triangle with legs a and b and hypotenuse c: <strong>a² + b² = c²</strong>. The hypotenuse is always the side opposite the 90° angle.</p>
    </div>
    <div class="faq-item">
      <h3>How do I find the hypotenuse?</h3>
      <p>Use: <strong>c = √(a² + b²)</strong>. Example: a = 3, b = 4 → c = √(9 + 16) = √25 = <strong>5</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do I find a missing leg?</h3>
      <p>Use: <strong>a = √(c² − b²)</strong> or <strong>b = √(c² − a²)</strong>. Example: c = 5, b = 4 → a = √(25 − 16) = √9 = <strong>3</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>What are Pythagorean triples?</h3>
      <p>Sets of three integers where a² + b² = c². Most common: <strong>3-4-5</strong>, 5-12-13, 8-15-17, 7-24-25. Multiples work too: 6-8-10, 9-12-15.</p>
    </div>
    <div class="faq-item">
      <h3>Does the theorem work for all triangles?</h3>
      <p>No — only for <strong>right triangles</strong> (exactly one 90° angle). For other triangles, use the Law of Cosines: c² = a² + b² − 2ab·cos(C).</p>
    </div>
    <div class="faq-item">
      <h3>What is the hypotenuse of a 45-45-90 triangle with legs of 1?</h3>
      <p>c = √(1² + 1²) = √2 ≈ <strong>1.414</strong>. In a 45-45-90 triangle, the hypotenuse is always leg × √2.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/square-footage-calculator" class="next-card">
        <span class="next-tag">Area</span>
        <h3>Square Footage Calculator</h3>
        <p>Calculate area in square feet for any room or space.</p>
      </a>
      <a href="/decimal-to-fraction" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Decimal to Fraction</h3>
        <p>Convert any decimal to a simplified fraction instantly.</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the final price after any discount.</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Length</span>
        <h3>cm to Inches</h3>
        <p>Convert centimeters to inches instantly.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Calculate Certificate of Deposit interest earnings.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 'c';

function fmt(v, d) {
  if (d === undefined) d = 4;
  return parseFloat(v.toFixed(d)).toString();
}

function convert() {
  var a = parseFloat(document.getElementById('inp-a').value);
  var b = parseFloat(document.getElementById('inp-b').value);
  var c = parseFloat(document.getElementById('inp-c').value);
  var err = document.getElementById('err-msg');
  var result, aFin, bFin, cFin;

  try {
    if (mode === 'c') {
      if (isNaN(a) || isNaN(b) || a <= 0 || b <= 0) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(a * a + b * b);
      aFin = a; bFin = b; cFin = result;
    } else if (mode === 'a') {
      if (isNaN(b) || isNaN(c) || b <= 0 || c <= 0 || c <= b) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(c * c - b * b);
      aFin = result; bFin = b; cFin = c;
    } else {
      if (isNaN(a) || isNaN(c) || a <= 0 || c <= 0 || c <= a) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(c * c - a * a);
      aFin = a; bFin = result; cFin = c;
    }

    var area = (aFin * bFin) / 2;
    var perim = aFin + bFin + cFin;
    var alpha = Math.atan(aFin / bFin) * (180 / Math.PI);
    var beta = 90 - alpha;

    var label = mode === 'c' ? 'Hypotenuse c' : (mode === 'a' ? 'Leg a' : 'Leg b');
    var varName = mode === 'c' ? 'c' : (mode === 'a' ? 'a' : 'b');

    document.getElementById('r-main').textContent = fmt(result);
    document.getElementById('res-lbl').textContent = label;
    document.getElementById('r-sub').textContent = fmt(aFin) + '² + ' + fmt(bFin) + '² = ' + fmt(cFin) + '²';
    document.getElementById('s1-lbl').textContent = label;
    document.getElementById('s1-val').textContent = varName + ' = ' + fmt(result);
    document.getElementById('s-area').textContent = fmt(area, 2) + ' sq units';
    document.getElementById('s-perim').textContent = fmt(perim, 2);
    document.getElementById('s-angle').textContent = fmt(alpha, 2) + '° / ' + fmt(beta, 2) + '°';
  } catch(e) {
    err.classList.add('show');
  }
}

function setMode(m) {
  mode = m;
  ['c','a','b'].forEach(function(x){
    document.getElementById('btn-'+x).classList.toggle('active', x === m);
  });
  var showA = m !== 'a';
  var showB = m !== 'b';
  var showC = m !== 'c';

  document.getElementById('grp-a').style.display = showA ? '' : 'none';
  document.getElementById('grp-b').style.display = showB ? '' : 'none';
  document.getElementById('grp-c').style.display = showC ? '' : 'none';

  if (m === 'c') { document.getElementById('inp-a').value = 3; document.getElementById('inp-b').value = 4; }
  else if (m === 'a') { document.getElementById('inp-b').value = 4; document.getElementById('inp-c').value = 5; }
  else { document.getElementById('inp-a').value = 3; document.getElementById('inp-c').value = 5; }
  convert();
}

function setTriple(a, b) {
  setMode('c');
  document.getElementById('inp-a').value = a;
  document.getElementById('inp-b').value = b;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
