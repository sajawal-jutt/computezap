---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Percentage Decrease Calculator",
    "url": "https://computezap.com/percentage-decrease-calculator",
    "description": "Free percentage decrease calculator. Find the percentage decrease between two numbers, or calculate the new value after a percentage decrease. Instant results.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Percentage Calculator", "item": "https://computezap.com/percentage-calculator" },
      { "@type": "ListItem", "position": 3, "name": "Percentage Decrease Calculator", "item": "https://computezap.com/percentage-decrease-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate percentage decrease?",
        "acceptedAnswer": { "@type": "Answer", "text": "Percentage Decrease = ((Old Value - New Value) ÷ Old Value) × 100. Example: from 200 to 150 → ((200 - 150) ÷ 200) × 100 = 25% decrease." }
      },
      {
        "@type": "Question",
        "name": "What is a 20% decrease on $500?",
        "acceptedAnswer": { "@type": "Answer", "text": "$500 × (1 - 0.20) = $500 × 0.80 = $400. The new value after a 20% decrease on $500 is $400. The decrease amount is $100." }
      },
      {
        "@type": "Question",
        "name": "How do I find the new value after a percentage decrease?",
        "acceptedAnswer": { "@type": "Answer", "text": "New Value = Old Value × (1 - Percentage ÷ 100). Example: 600 with a 25% decrease → 600 × 0.75 = 450." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between percentage decrease and a discount?",
        "acceptedAnswer": { "@type": "Answer", "text": "They use the same formula. A 30% discount on a $100 item means a 30% decrease: new price = $100 × 0.70 = $70. Percentage decrease is the math; discount is the retail context." }
      },
      {
        "@type": "Question",
        "name": "How do I reverse a percentage decrease to find the original price?",
        "acceptedAnswer": { "@type": "Answer", "text": "Original = New Value ÷ (1 - % ÷ 100). If an item now costs $70 after a 30% decrease: $70 ÷ 0.70 = $100 original price." }
      }
    ]
  }
]);
---
<Layout
  title="Percentage Decrease Calculator — Find % Drop Between Two Numbers | ComputeZap"
  description="Free percentage decrease calculator. Find the percentage decrease between two numbers, or calculate the new value after a percentage decrease. Instant results."
  canonical="/percentage-decrease-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › <a href="/percentage-calculator">Percentage</a> › Percentage Decrease Calculator</nav>
  <h1>Percentage Decrease Calculator</h1>
  <p>Find the % decrease between two numbers, or calculate the new value after a % decrease</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-m1">Find % Decrease</button>
      <button class="mode-btn" id="btn-m2">Find New Value</button>
    </div>

    <div id="inputs-1">
      <div class="input-group">
        <label>Original Value</label>
        <div class="input-wrap">
          <input type="number" id="old1" placeholder="200" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>New Value</label>
        <div class="input-wrap">
          <input type="number" id="new1" placeholder="150" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
    </div>

    <div id="inputs-2" style="display:none">
      <div class="input-group">
        <label>Original Value</label>
        <div class="input-wrap">
          <input type="number" id="old2" placeholder="200" min="0" step="any" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Percentage Decrease</label>
        <div class="input-wrap">
          <input type="number" id="pct2" placeholder="25" min="0" max="100" step="any" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">Percentage Decrease</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit"></div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Original</span><span class="stat-val" id="s1-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s2-lbl">New Value</span><span class="stat-val" id="s2-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl">Decrease Amount</span><span class="stat-val" id="s3-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s4-lbl">You Retain</span><span class="stat-val" id="s4-val">—</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Percentage Decrease Formula</h2>
    <div class="formula-box">
      <div class="formula-text">% Decrease = ((Old − New) ÷ Old) × 100</div>
      <div class="formula-sub">Example: 200 → 150 = ((200 − 150) ÷ 200) × 100 = <strong>25% decrease</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">New Value = Old × (1 − % ÷ 100)</div>
      <div class="formula-sub">Example: 200 with 25% decrease = 200 × 0.75 = <strong>150</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Quick rule:</strong> A 50% decrease = halving. A 25% decrease = multiply by 0.75. A 10% decrease = multiply by 0.90. A 100% decrease = zero.</p>
    </div>
  </div>

  <div class="card">
    <h2>Percentage Decrease Reference Table</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>% Decrease</th><th>On 100</th><th>On 500</th><th>On 1,000</th><th>On 10,000</th></tr></thead>
        <tbody>
          {[
            ['5%', '95', '475', '950', '9,500'],
            ['10%', '90', '450', '900', '9,000'],
            ['15%', '85', '425', '850', '8,500'],
            ['20%', '80', '400', '800', '8,000'],
            ['25%', '75', '375', '750', '7,500'],
            ['30%', '70', '350', '700', '7,000'],
            ['40%', '60', '300', '600', '6,000'],
            ['50%', '50', '250', '500', '5,000'],
            ['60%', '40', '200', '400', '4,000'],
            ['75%', '25', '125', '250', '2,500'],
            ['90%', '10', '50', '100', '1,000'],
          ].map(([pct, v100, v500, v1k, v10k]) => (
            <tr>
              <td class="acc">{pct}</td>
              <td>{v100}</td>
              <td>{v500}</td>
              <td>{v1k}</td>
              <td>{v10k}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Real-World Percentage Decrease Examples</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Scenario</th><th>Old Value</th><th>New Value</th><th>% Decrease</th></tr></thead>
        <tbody>
          <tr><td>Sale discount</td><td>$120</td><td>$90</td><td class="acc">25%</td></tr>
          <tr><td>Stock loss</td><td>$80</td><td>$56</td><td class="acc">30%</td></tr>
          <tr><td>Calorie cut</td><td>2,500 cal</td><td>2,000 cal</td><td class="acc">20%</td></tr>
          <tr><td>Budget reduction</td><td>$50,000</td><td>$35,000</td><td class="acc">30%</td></tr>
          <tr><td>Interest rate drop</td><td>6.5%</td><td>5.2%</td><td class="acc">20%</td></tr>
          <tr><td>Weight loss goal</td><td>220 lbs</td><td>187 lbs</td><td class="acc">15%</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do I calculate percentage decrease?</h3>
      <p>Use the formula: <strong>((Old − New) ÷ Old) × 100</strong>. For example, if a price went from $200 to $150: ((200 − 150) ÷ 200) × 100 = <strong>25% decrease</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>What is a 20% decrease on $500?</h3>
      <p>$500 × 0.80 = <strong>$400</strong>. The decrease amount is $100. Use "Find New Value" mode, enter 500 as original and 20 as the percentage.</p>
    </div>
    <div class="faq-item">
      <h3>What is the difference between percentage decrease and a discount?</h3>
      <p>They use the same formula. A 30% discount on a $100 item means a 30% decrease: new price = $100 × 0.70 = $70. "Percentage decrease" is the math; "discount" is the retail context.</p>
    </div>
    <div class="faq-item">
      <h3>How do I reverse a percentage decrease to find the original value?</h3>
      <p>Original = New Value ÷ (1 − % ÷ 100). If an item costs $70 after a 30% decrease: $70 ÷ 0.70 = <strong>$100</strong> original price.</p>
    </div>
    <div class="faq-item">
      <h3>Can a percentage decrease be more than 100%?</h3>
      <p>No — a 100% decrease brings a value to zero. You cannot have more than a 100% decrease. However, you can have more than a 100% increase (a 200% increase means tripling the original).</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/percentage-increase-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Increase Calculator</h3>
        <p>Find the percentage increase between two values</p>
      </a>
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>Percentage Calculator</h3>
        <p>Find X% of Y, what % X is of Y, and more</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the sale price after a discount</p>
      </a>
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost</p>
      </a>
      <a href="/markup-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Markup Calculator</h3>
        <p>Find selling price from cost and markup %</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find original price before tax was added</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 1;

document.getElementById('btn-m1').addEventListener('click', function() { setMode(1); });
document.getElementById('btn-m2').addEventListener('click', function() { setMode(2); });
document.getElementById('calc-btn').addEventListener('click', calculate);
document.getElementById('old1').addEventListener('input', calculate);
document.getElementById('new1').addEventListener('input', calculate);
document.getElementById('old2').addEventListener('input', calculate);
document.getElementById('pct2').addEventListener('input', calculate);
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

function fmt(n) {
  return parseFloat(n.toFixed(4)).toLocaleString();
}
function fmtP(n) { return parseFloat(n.toFixed(2)) + '%'; }

function setMode(m) {
  mode = m;
  document.getElementById('btn-m1').classList.toggle('active', m === 1);
  document.getElementById('btn-m2').classList.toggle('active', m === 2);
  document.getElementById('inputs-1').style.display = m === 1 ? 'block' : 'none';
  document.getElementById('inputs-2').style.display = m === 2 ? 'block' : 'none';
  document.getElementById('answer').classList.remove('show');
  document.getElementById('stats').classList.remove('show');
}

function calculate() {
  if (mode === 1) calcDecrease();
  else calcNewVal();
}

function calcDecrease() {
  var oldV = parseFloat(document.getElementById('old1').value);
  var newV = parseFloat(document.getElementById('new1').value);
  if (isNaN(oldV) || isNaN(newV) || oldV === 0) return;
  var pct = ((oldV - newV) / oldV) * 100;
  var change = oldV - newV;
  var retainPct = (newV / oldV) * 100;
  document.getElementById('ans-label').textContent = pct >= 0 ? 'Percentage Decrease' : 'Percentage Increase';
  document.getElementById('ans-value').textContent = fmtP(Math.abs(pct));
  document.getElementById('ans-unit').textContent = fmt(oldV) + ' → ' + fmt(newV);
  document.getElementById('ans-sub').textContent = (change >= 0 ? 'Decreased by −' : 'Increased by +') + fmt(Math.abs(change));
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmt(oldV);
  document.getElementById('s2-lbl').textContent = 'New Value';
  document.getElementById('s2-val').textContent = fmt(newV);
  document.getElementById('s3-val').textContent = '−' + fmt(Math.abs(change));
  document.getElementById('s4-lbl').textContent = 'You Retain';
  document.getElementById('s4-val').textContent = fmtP(retainPct);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}

function calcNewVal() {
  var oldV = parseFloat(document.getElementById('old2').value);
  var pct = parseFloat(document.getElementById('pct2').value);
  if (isNaN(oldV) || isNaN(pct)) return;
  var newV = oldV * (1 - pct / 100);
  var change = oldV - newV;
  document.getElementById('ans-label').textContent = 'New Value After ' + fmtP(pct) + ' Decrease';
  document.getElementById('ans-value').textContent = fmt(newV);
  document.getElementById('ans-unit').textContent = fmt(oldV) + ' − ' + fmtP(pct) + ' = ' + fmt(newV);
  document.getElementById('ans-sub').textContent = 'Decrease amount: −' + fmt(change);
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmt(oldV);
  document.getElementById('s2-lbl').textContent = '% Decrease';
  document.getElementById('s2-val').textContent = fmtP(pct);
  document.getElementById('s3-val').textContent = '−' + fmt(change);
  document.getElementById('s4-lbl').textContent = 'New Value';
  document.getElementById('s4-val').textContent = fmt(newV);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}
</script>
</Layout>
