@media(max-width:768px){.calc-wrap{grid-template-columns:1fr}.calc-left{position:static}.hero h1{font-size:1.65rem}.res-val{font-size:1.6rem}.next-grid{grid-template-columns:1fr}}
</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Cups to Gallons Converter</nav>
  <h1>Cups to Gallons Converter</h1>
  <p class="hero-sub">1 gallon = 16 cups — convert any volume instantly</p>
</div>

<div class="calc-wrap">
  <div class="calc-left">
    <div class="card">
      <div class="mode-wrap">
        <button class="mode-btn active" id="btn-c2g" onclick="setMode('c2g')">Cups → Gallons</button>
        <button class="mode-btn" id="btn-g2c" onclick="setMode('g2c')">Gallons → Cups</button>
      </div>
      <label class="fld-lbl" id="inp-lbl">Cups</label>
      <div class="fld-wrap">
        <input type="number" id="amount" class="txt-input" value="16" min="0" step="1" oninput="convert()" />
        <span class="fld-sfx" id="inp-sfx">cups</span>
      </div>
      <span class="preset-lbl">Quick values</span>
      <div class="preset-wrap" id="preset-wrap">
        <button class="preset-btn" onclick="setVal(1)">1</button>
        <button class="preset-btn" onclick="setVal(2)">2</button>
        <button class="preset-btn" onclick="setVal(4)">4</button>
        <button class="preset-btn" onclick="setVal(8)">8</button>
        <button class="preset-btn" onclick="setVal(12)">12</button>
        <button class="preset-btn" onclick="setVal(16)">16</button>
        <button class="preset-btn" onclick="setVal(32)">32</button>
      </div>
    </div>
    <div class="card">
      <div class="result-box">
        <div class="res-lbl" id="res-lbl">Gallons</div>
        <div class="res-val"><span id="r-main">1</span> <span style="font-size:1.1rem;opacity:.85" id="r-unit">gal</span></div>
        <div class="res-sub" id="r-sub">16 cups = 1 gallon</div>
      </div>
      <div class="stat-primary">
        <span class="stat-lbl" id="s1-lbl">Gallons</span>
        <span class="stat-big" id="s1-val">1 gal</span>
      </div>
      <div class="stat-secondary">
        <span class="stat-lbl" id="s2-lbl">Quarts</span>
        <span class="stat-med" id="s2-val">4 qt</span>
      </div>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-lbl" id="s3-lbl">Pints</span>
          <span class="stat-val" id="s3-val">8 pt</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl" id="s4-lbl">Fluid Ounces</span>
          <span class="stat-val" id="s4-val">128 fl oz</span>
        </div>
      </div>
    </div>
  </div>

  <div class="calc-right">
    <div class="card">
      <h2>How Many Cups in a Gallon?</h2>
      <p>There are <strong>16 cups in 1 US gallon</strong>. This is the standard US measurement used in cooking and liquid volume. The full breakdown of volume units:</p>
      <div class="answer-box">
        <div class="answer-row"><span class="answer-lbl">1 gallon</span><span class="answer-val">= 16 cups</span></div>
        <div class="answer-row"><span class="answer-lbl">1 gallon</span><span class="answer-val">= 4 quarts</span></div>
        <div class="answer-row"><span class="answer-lbl">1 gallon</span><span class="answer-val">= 8 pints</span></div>
        <div class="answer-row"><span class="answer-lbl">1 gallon</span><span class="answer-val">= 128 fluid ounces</span></div>
        <div class="answer-row"><span class="answer-lbl">1 gallon</span><span class="answer-val">= 3.785 liters</span></div>
      </div>
      <div class="formula-box">gallons = cups ÷ 16 &nbsp;|&nbsp; cups = gallons × 16</div>
    </div>

    <div class="card">
      <h2>Cups to Gallons Conversion Chart</h2>
      <p>Click any row to load into the converter above.</p>
      <table class="ref-tbl">
        <thead><tr><th>Cups</th><th>Gallons</th><th>Quarts</th><th>Pints</th></tr></thead>
        <tbody>
          {[
            [1,'0.0625 gal','¼ qt','½ pt'],
            [2,'0.125 gal','½ qt','1 pt'],
            [4,'0.25 gal','1 qt','2 pt'],
            [8,'0.5 gal','2 qt','4 pt'],
            [12,'0.75 gal','3 qt','6 pt'],
            [16,'1 gal','4 qt','8 pt'],
            [20,'1.25 gal','5 qt','10 pt'],
            [24,'1.5 gal','6 qt','12 pt'],
            [32,'2 gal','8 qt','16 pt'],
            [48,'3 gal','12 qt','24 pt'],
            [64,'4 gal','16 qt','32 pt'],
          ].map(([cups, gal, qt, pt]) => (
            <tr onclick={`setVal(${cups})`} class={cups === 16 ? 'hi' : ''}>
              <td>{cups} cups</td><td class="acc">{gal}</td><td>{qt}</td><td>{pt}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>US Volume Measurement Hierarchy</h2>
      <p>The US liquid volume system is based on doubling — each unit is exactly twice the previous one. This makes mental math easy once you memorize the base relationship of 16 cups per gallon.</p>
      <div class="tip-box">
        <span class="tip-icon">🥛</span>
        <p><strong>Memory trick:</strong> 1 gallon = 4 quarts = 8 pints = 16 cups. Each step doubles: go from cups to pints (÷2), pints to quarts (÷2), quarts to gallons (÷4).</p>
      </div>
      <h3>Common cooking volume conversions</h3>
      <ul>
        <li><strong>1 cup</strong> = ½ pint = ¼ quart = 8 fluid ounces = 236.6 ml</li>
        <li><strong>8 cups</strong> = ½ gallon = 4 pints = 2 quarts = 64 fl oz</li>
        <li><strong>16 cups</strong> = 1 gallon = 8 pints = 4 quarts = 128 fl oz</li>
        <li><strong>Water jug (1 gallon)</strong> = 16 cups of water per day target</li>
      </ul>
    </div>

    <div class="content-card">
      <h2>When You Need Cups to Gallons Conversion</h2>
      <ul>
        <li><strong>Recipe scaling</strong> — scaling up a recipe from serving 4 to serving 64 means converting cups of broth, sauce, or liquid into gallons for large-batch cooking.</li>
        <li><strong>Punch & beverage prep</strong> — party drink recipes often list gallons; most home measuring tools use cups. Convert to fill the right container.</li>
        <li><strong>Garden & cleaning chemicals</strong> — dilution ratios for fertilizers and cleaning concentrates are often per gallon; your measuring cup is in cups or ounces.</li>
        <li><strong>Aquariums</strong> — fish tank volumes are listed in gallons; water conditioner dosing is per cup or liter. Convert to dose accurately.</li>
        <li><strong>Hydration tracking</strong> — some fitness goals target 1 gallon of water per day. Knowing that equals 16 cups helps track intake throughout the day.</li>
      </ul>
    </div>

    <div class="card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-item">
        <h3>How many cups in a gallon?</h3>
        <p>There are <strong>16 cups</strong> in 1 US gallon. 1 gallon = 16 cups = 4 quarts = 8 pints = 128 fluid ounces.</p>
      </div>
      <div class="faq-item">
        <h3>How many cups in a half gallon?</h3>
        <p>There are <strong>8 cups</strong> in a half gallon. Half of 16 cups = 8 cups = 4 pints = 2 quarts = 64 fl oz.</p>
      </div>
      <div class="faq-item">
        <h3>How many cups is 2 gallons?</h3>
        <p>2 gallons = <strong>32 cups</strong>. Multiply 2 × 16 = 32 cups.</p>
      </div>
      <div class="faq-item">
        <h3>How do I convert cups to gallons?</h3>
        <p>Divide cups by 16. Formula: <strong>gallons = cups ÷ 16</strong>. Example: 4 cups ÷ 16 = 0.25 gallons (1 quart).</p>
      </div>
      <div class="faq-item">
        <h3>How many cups in a quart?</h3>
        <p>There are <strong>4 cups</strong> in 1 US quart. 1 quart = 4 cups = 2 pints = 32 fluid ounces = 0.946 liters.</p>
      </div>
      <div class="faq-item">
        <h3>Is a US gallon the same as a UK gallon?</h3>
        <p>No. A US gallon = 3.785 liters (16 US cups). A UK (imperial) gallon = 4.546 liters, which equals about 19.22 US cups. The UK gallon is about 20% larger than the US gallon.</p>
      </div>
    </div>

    <div class="content-card">
      <h2>Related Converters</h2>
      <div class="next-grid">
        <a href="/oz-to-quarts" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Oz to Quarts</h3>
          <p>Convert fluid ounces to quarts — 1 quart = 32 oz.</p>
        </a>
        <a href="/cups-to-tablespoons" class="next-card">
          <span class="next-tag">Kitchen</span>
          <h3>Cups to Tablespoons</h3>
          <p>How many tablespoons in a cup — all fractions covered.</p>
        </a>
        <a href="/liters-to-gallons" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Liters to Gallons</h3>
          <p>Convert liters to US or Imperial gallons.</p>
        </a>
        <a href="/kg-to-lbs" class="next-card">
          <span class="next-tag">Weight</span>
          <h3>kg to lbs</h3>
          <p>Convert kilograms to pounds instantly.</p>
        </a>
        <a href="/cm-to-inches" class="next-card">
          <span class="next-tag">Length</span>
          <h3>cm to Inches</h3>
          <p>Convert centimeters to inches instantly.</p>
        </a>
        <a href="/percent-off-calculator" class="next-card">
          <span class="next-tag">Shopping</span>
          <h3>Percent Off Calculator</h3>
          <p>Calculate the final price after any discount.</p>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
var mode = 'c2g';

function fmt(v, d) {
  return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString();
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value) || 0;
  var gal, cups, qt, pt, floz, liters;
  if (mode === 'c2g') {
    cups = val; gal = val / 16; qt = val / 4; pt = val / 2; floz = val * 8; liters = val * 0.2366;
    document.getElementById('r-main').textContent = fmt(gal, 4);
    document.getElementById('r-unit').textContent = 'gal';
    document.getElementById('r-sub').textContent = fmt(val, 1) + ' cups = ' + fmt(gal, 4) + ' gallons';
    document.getElementById('res-lbl').textContent = 'Gallons';
    document.getElementById('s1-lbl').textContent = 'Gallons';
    document.getElementById('s1-val').textContent = fmt(gal, 4) + ' gal';
    document.getElementById('s2-lbl').textContent = 'Quarts';
    document.getElementById('s2-val').textContent = fmt(qt, 2) + ' qt';
    document.getElementById('s3-lbl').textContent = 'Pints';
    document.getElementById('s3-val').textContent = fmt(pt, 2) + ' pt';
    document.getElementById('s4-lbl').textContent = 'Fluid Ounces';
    document.getElementById('s4-val').textContent = fmt(floz, 0) + ' fl oz';
  } else {
    gal = val; cups = val * 16; qt = val * 4; pt = val * 8; floz = val * 128; liters = val * 3.785;
    document.getElementById('r-main').textContent = fmt(cups, 0);
    document.getElementById('r-unit').textContent = 'cups';
    document.getElementById('r-sub').textContent = fmt(val, 2) + ' gallons = ' + fmt(cups, 0) + ' cups';
    document.getElementById('res-lbl').textContent = 'Cups';
    document.getElementById('s1-lbl').textContent = 'Cups';
    document.getElementById('s1-val').textContent = fmt(cups, 0) + ' cups';
    document.getElementById('s2-lbl').textContent = 'Quarts';
    document.getElementById('s2-val').textContent = fmt(qt, 2) + ' qt';
    document.getElementById('s3-lbl').textContent = 'Pints';
    document.getElementById('s3-val').textContent = fmt(pt, 2) + ' pt';
    document.getElementById('s4-lbl').textContent = 'Fluid Ounces';
    document.getElementById('s4-val').textContent = fmt(floz, 0) + ' fl oz';
  }
}

function setMode(m) {
  mode = m;
  var isC = m === 'c2g';
  document.getElementById('btn-c2g').classList.toggle('active', isC);
  document.getElementById('btn-g2c').classList.toggle('active', !isC);
  document.getElementById('inp-lbl').textContent = isC ? 'Cups' : 'Gallons';
  document.getElementById('inp-sfx').textContent = isC ? 'cups' : 'gal';
  var presets = document.getElementById('preset-wrap');
  presets.innerHTML = (isC ? [1,2,4,8,12,16,32] : [0.25,0.5,1,2,5,10])
    .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
  document.getElementById('amount').value = isC ? 16 : 1;
  convert();
}

function setVal(v) {
  document.getElementById('amount').value = v;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
