<script is:inline>
var mode = 'c2t';

function fmt(v) {
  if (v === Math.round(v)) return v.toString();
  return parseFloat(v.toFixed(4)).toString();
}

function fmtCups(v) {
  var fracs = [[0.125,'⅛'],[0.25,'¼'],[0.333,'⅓'],[0.5,'½'],[0.667,'⅔'],[0.75,'¾']];
  var whole = Math.floor(v);
  var frac = parseFloat((v - whole).toFixed(3));
  var fracStr = '';
  for (var i = 0; i < fracs.length; i++) {
    if (Math.abs(frac - fracs[i][0]) < 0.005) { fracStr = fracs[i][1]; break; }
  }
  if (!fracStr) return fmt(v) + ' cups';
  if (whole === 0) return fracStr + ' cup';
  return whole + ' ' + fracStr + ' cups';
}

function fracHint(tbsp) {
  var hints = {
    5.333: '= 5 tablespoons + 1 teaspoon',
    10.667: '= 10 tablespoons + 2 teaspoons',
    2.667: '= 2 tablespoons + 2 teaspoons',
    1.333: '= 1 tablespoon + 1 teaspoon',
  };
  for (var k in hints) {
    if (Math.abs(tbsp - parseFloat(k)) < 0.005) return hints[k];
  }
  return null;
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value) || 0;
  var hint = document.getElementById('frac-hint');

  if (mode === 'c2t') {
    var tbsp = val * 16;
    var tsp  = val * 48;
    var floz = val * 8;
    var ml   = val * 236.588;

    document.getElementById('r-main').textContent = fmt(tbsp);
    document.getElementById('r-unit').textContent = tbsp === 1 ? 'tbsp' : 'tbsp';
    document.getElementById('r-sub').textContent  = fmtCups(val) + ' = ' + fmt(tbsp) + ' tablespoons';

    document.getElementById('s1-lbl').textContent = 'Tablespoons';
    document.getElementById('s1-val').textContent = fmt(tbsp);
    document.getElementById('s2-lbl').textContent = 'Teaspoons';
    document.getElementById('s2-val').textContent = fmt(tsp);
    document.getElementById('s3-lbl').textContent = 'Fluid Ounces';
    document.getElementById('s3-val').textContent = fmt(floz) + ' fl oz';
    document.getElementById('s4-lbl').textContent = 'Milliliters';
    document.getElementById('s4-val').textContent = parseFloat(ml.toFixed(1)) + ' ml';

    var h = fracHint(tbsp);
    if (h) { hint.textContent = '💡 ' + h; hint.classList.add('show'); }
    else hint.classList.remove('show');
  } else {
    var cups   = val / 16;
    var tspR   = val * 3;
    var flozR  = val / 2;
    var mlR    = val * 14.787;

    document.getElementById('r-main').textContent = fmt(cups);
    document.getElementById('r-unit').textContent = cups === 1 ? 'cup' : 'cups';
    document.getElementById('r-sub').textContent  = fmt(val) + ' tbsp = ' + fmtCups(cups);

    document.getElementById('s1-lbl').textContent = 'Cups';
    document.getElementById('s1-val').textContent = fmt(cups);
    document.getElementById('s2-lbl').textContent = 'Teaspoons';
    document.getElementById('s2-val').textContent = fmt(tspR);
    document.getElementById('s3-lbl').textContent = 'Fluid Ounces';
    document.getElementById('s3-val').textContent = fmt(flozR) + ' fl oz';
    document.getElementById('s4-lbl').textContent = 'Milliliters';
    document.getElementById('s4-val').textContent = parseFloat(mlR.toFixed(1)) + ' ml';

    hint.classList.remove('show');
  }
}

function setMode(m) {
  mode = m;
  var isCups = m === 'c2t';
  document.getElementById('mode-c2t').classList.toggle('active', isCups);
  document.getElementById('mode-t2c').classList.toggle('active', !isCups);
  document.getElementById('input-lbl').textContent  = isCups ? 'Cups' : 'Tablespoons';
  document.getElementById('input-unit').textContent = isCups ? 'cups' : 'tbsp';
  document.getElementById('res-lbl').textContent    = isCups ? 'Tablespoons' : 'Cups';
  document.getElementById('preset-lbl').textContent = isCups ? 'Common Fractions' : 'Quick Values';

  var presets = document.getElementById('preset-wrap');
  if (isCups) {
    presets.innerHTML = [
      [0.25,'¼'],[0.333,'⅓'],[0.5,'½'],[0.667,'⅔'],
      [0.75,'¾'],[1,'1'],[1.5,'1½'],[2,'2'],[3,'3'],[4,'4']
    ].map(function(x){ return '<button class="preset-btn" onclick="setVal('+x[0]+',\''+x[1]+'\')">'+x[1]+'</button>'; }).join('');
  } else {
    presets.innerHTML = [1,2,3,4,6,8,10,12,16,24,32,48]
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+',\''+v+'\')">'+v+'</button>'; }).join('');
  }

  document.getElementById('amount').value = isCups ? 1 : 16;
  convert();
}

function setVal(v, label) {
  document.getElementById('amount').value = v;
  document.querySelectorAll('.preset-btn').forEach(function(b){ b.classList.remove('active'); });
  convert();
}

function clearActive() {
  document.querySelectorAll('.preset-btn').forEach(function(b){ b.classList.remove('active'); });
}

window.addEventListener('load', convert);
</script>

</Layout>
