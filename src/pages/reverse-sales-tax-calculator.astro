---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Reverse Sales Tax Calculator",
    "url": "https://computezap.com/reverse-sales-tax-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Free reverse sales tax calculator. Find the original pre-tax price from any total amount paid. All 50 US state tax rates included — California, Texas, New York, Florida, and more.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Reverse Sales Tax Calculator", "item": "https://computezap.com/reverse-sales-tax-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate the pre-tax price from a total?",
        "acceptedAnswer": { "@type": "Answer", "text": "Divide the total price by (1 + tax rate ÷ 100). For example, if you paid $107.50 with a 7.5% sales tax rate: $107.50 ÷ 1.075 = $100.00 pre-tax price. The tax amount is $107.50 - $100.00 = $7.50." }
      },
      {
        "@type": "Question",
        "name": "What is reverse sales tax?",
        "acceptedAnswer": { "@type": "Answer", "text": "Reverse sales tax (also called backwards tax calculation) is the process of finding the original price before tax was added, given the final total price. It is used in accounting, expense reports, and VAT reclaims." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in California?",
        "acceptedAnswer": { "@type": "Answer", "text": "California's combined average sales tax rate is approximately 8.68% (7.25% state rate plus average local taxes). Rates vary by city — Los Angeles is 10.25%, San Francisco is 8.625%." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Texas?",
        "acceptedAnswer": { "@type": "Answer", "text": "Texas has a 6.25% state sales tax rate. With local taxes, the combined average rate is 8.19%. Cities like Houston, Dallas, and Austin typically charge the maximum combined rate of 8.25%." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Tennessee?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tennessee has one of the highest sales tax rates in the US. The state rate is 7.00% and the combined average including local taxes is 9.55%. Groceries are taxed at a reduced 4% rate." }
      },
      {
        "@type": "Question",
        "name": "Which states have no sales tax?",
        "acceptedAnswer": { "@type": "Answer", "text": "Five states have no statewide sales tax: Oregon, Montana, New Hampshire, Delaware, and Alaska. However, Alaska allows local jurisdictions to impose sales taxes, so some Alaskan cities do charge sales tax." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Florida?",
        "acceptedAnswer": { "@type": "Answer", "text": "Florida's state sales tax rate is 6.00%. With local discretionary sales surtax, the combined average rate is 7.08%. Miami-Dade County charges 7%, while some counties charge up to 7.5%." }
      },
      {
        "@type": "Question",
        "name": "Can I use this calculator for VAT (Value Added Tax)?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — the reverse VAT calculation uses the same formula. Enter the VAT-inclusive price and the VAT rate (e.g., 20% in the UK, 19% in Germany) to find the pre-VAT price instantly." }
      }
    ]
  }
]);
---
<Layout
  title="Reverse Sales Tax Calculator — All 50 US States | ComputeZap"
  description="Free reverse sales tax calculator. Enter any total price and find the original pre-tax price instantly. All 50 US state sales tax rates included — CA, TX, NY, FL, TN, WA, and more."
  canonical="/reverse-sales-tax-calculator"
  schema={schema}
>
<style is:global>
.receipt-box{background:#f8fafc;border:1px solid #e5e7eb;border-radius:10px;padding:1rem;margin-top:.75rem}
.rec-row{display:flex;justify-content:space-between;padding:.45rem 0;border-bottom:1px solid #f3f4f6;font-size:.875rem;color:#444}
.rec-row:last-child{border-bottom:none;border-top:2px solid #e2e8f0;margin-top:.25rem;padding-top:.6rem;font-weight:800;color:#111}
.rec-val{font-weight:600}
.rec-val.red{color:#dc2626}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › Reverse Sales Tax Calculator</nav>
  <h1>Reverse Sales Tax Calculator</h1>
  <p>Find the original pre-tax price from any total — all 50 US states included</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="input-group">
      <label>Total Price Paid (with tax)</label>
      <div class="input-wrap">
        <input type="number" id="total" placeholder="107.50" value="107.50" min="0" step="0.01" style="padding-right:.9rem" />
      </div>
    </div>
    <div class="input-group">
      <label>Sales Tax Rate</label>
      <div class="input-wrap">
        <input type="number" id="taxrate" placeholder="7.5" value="7.5" min="0" max="30" step="0.01" />
        <span class="input-sfx">%</span>
      </div>
    </div>

    <span class="preset-lbl">Select Your State</span>
    <div class="preset-wrap">
      {[
        ['CA','8.68'],['TX','8.19'],['NY','8.52'],['FL','7.08'],
        ['WA','10.25'],['IL','8.82'],['PA','6.34'],['OH','7.22'],
        ['GA','7.35'],['NC','6.98'],['NJ','6.60'],['VA','5.73'],
        ['AZ','8.37'],['TN','9.55'],['CO','7.81'],['MI','6.00'],
        ['IN','7.00'],['MO','8.29'],['MN','7.49'],['NV','8.23'],
        ['SC','7.43'],['AL','9.24'],['LA','9.55'],['MA','6.25'],
        ['KY','6.00'],['WI','5.43'],['OR','0.00'],['NH','0.00'],
        ['MT','0.00'],['DE','0.00']
      ].map(([s,r]) => (
        <button class="preset-btn" id={`sb-${s}`} onclick={`setState('${s}',${r})`}>{s}</button>
      ))}
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label">Pre-Tax Price</div>
      <div class="a-value">$<span id="r-pretax">100.00</span></div>
      <div class="a-unit">Tax paid: $<span id="r-taxamt-sub">7.50</span></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl">Pre-Tax Price</span><span class="stat-val">$<span id="r-pretax2">100.00</span></span></div>
      <div class="stat-box"><span class="stat-lbl">Tax Amount</span><span class="stat-val" id="r-taxamt">$7.50</span></div>
      <div class="stat-box"><span class="stat-lbl">Tax Rate</span><span class="stat-val" id="r-rate">7.50%</span></div>
      <div class="stat-box"><span class="stat-lbl">Total Paid</span><span class="stat-val" id="r-total">$107.50</span></div>
    </div>

    <div class="receipt-box" id="receipt" style="display:none">
      <div class="rec-row"><span>Pre-tax price</span><span class="rec-val">$<span id="rec-pretax">100.00</span></span></div>
      <div class="rec-row"><span>Sales tax (<span id="rec-rate">7.50%</span>)</span><span class="rec-val red" id="rec-tax">+ $7.50</span></div>
      <div class="rec-row"><span>Total paid</span><span class="rec-val" id="rec-total">$107.50</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>What Is Reverse Sales Tax?</h2>
    <p>Reverse sales tax (also called backwards tax calculation) finds the <strong>original price before tax</strong> when you only know the final total you paid.</p>
    <div class="formula-box">
      <div class="formula-text">Pre-Tax Price = Total ÷ (1 + Tax Rate ÷ 100)</div>
      <div class="formula-sub">Example: Paid $107.50 with 7.5% tax → $107.50 ÷ 1.075 = <strong>$100.00 pre-tax</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Tax Amount = Total − Pre-Tax Price</div>
      <div class="formula-sub">Example: $107.50 − $100.00 = <strong>$7.50 tax paid</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">🧾</span>
      <p><strong>Common mistake:</strong> Don't use "Total × (1 − rate)" — this is wrong. Always divide by (1 + rate). Example: $107.50 ÷ 1.075 = $100, not $107.50 × 0.925 = $99.44.</p>
    </div>
  </div>

  <div class="card">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:.5rem">
      <h2 style="margin:0">Sales Tax Rates — All 50 States (2026)</h2>
      <button id="states-toggle" onclick="toggleStates()" style="background:var(--blue);color:#fff;border:none;border-radius:8px;padding:.35rem .85rem;font-size:.8rem;font-weight:700;cursor:pointer;white-space:nowrap;flex-shrink:0;margin-left:.5rem">Show All ▼</button>
    </div>
    <p style="font-size:.85rem;color:#64748b;margin:0 0 .75rem">Click any row to auto-fill the tax rate above. Rates include state + average local taxes.</p>
    <div id="states-table-wrap" style="display:none">
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead><tr><th>State</th><th>Combined Avg</th><th>State Rate</th></tr></thead>
          <tbody>
            {[
              ['Alabama','9.24%','4.00%','AL'],
              ['Alaska','1.76%','0.00%','AK'],
              ['Arizona','8.37%','5.60%','AZ'],
              ['Arkansas','9.47%','6.50%','AR'],
              ['California','8.68%','7.25%','CA'],
              ['Colorado','7.81%','2.90%','CO'],
              ['Connecticut','6.35%','6.35%','CT'],
              ['Delaware','0.00%','0.00%','DE'],
              ['Florida','7.08%','6.00%','FL'],
              ['Georgia','7.35%','4.00%','GA'],
              ['Hawaii','4.44%','4.00%','HI'],
              ['Idaho','6.03%','6.00%','ID'],
              ['Illinois','8.82%','6.25%','IL'],
              ['Indiana','7.00%','7.00%','IN'],
              ['Iowa','6.94%','6.00%','IA'],
              ['Kansas','8.70%','6.50%','KS'],
              ['Kentucky','6.00%','6.00%','KY'],
              ['Louisiana','9.55%','4.45%','LA'],
              ['Maine','5.50%','5.50%','ME'],
              ['Maryland','6.00%','6.00%','MD'],
              ['Massachusetts','6.25%','6.25%','MA'],
              ['Michigan','6.00%','6.00%','MI'],
              ['Minnesota','7.49%','6.875%','MN'],
              ['Mississippi','7.07%','7.00%','MS'],
              ['Missouri','8.29%','4.225%','MO'],
              ['Montana','0.00%','0.00%','MT'],
              ['Nebraska','6.94%','5.50%','NE'],
              ['Nevada','8.23%','6.85%','NV'],
              ['New Hampshire','0.00%','0.00%','NH'],
              ['New Jersey','6.60%','6.625%','NJ'],
              ['New Mexico','7.83%','5.00%','NM'],
              ['New York','8.52%','4.00%','NY'],
              ['North Carolina','6.98%','4.75%','NC'],
              ['North Dakota','5.96%','5.00%','ND'],
              ['Ohio','7.22%','5.75%','OH'],
              ['Oklahoma','8.99%','4.50%','OK'],
              ['Oregon','0.00%','0.00%','OR'],
              ['Pennsylvania','6.34%','6.00%','PA'],
              ['Rhode Island','7.00%','7.00%','RI'],
              ['South Carolina','7.43%','6.00%','SC'],
              ['South Dakota','6.40%','4.50%','SD'],
              ['Tennessee','9.55%','7.00%','TN'],
              ['Texas','8.19%','6.25%','TX'],
              ['Utah','7.19%','4.85%','UT'],
              ['Vermont','6.24%','6.00%','VT'],
              ['Virginia','5.73%','4.30%','VA'],
              ['Washington','10.25%','6.50%','WA'],
              ['West Virginia','6.50%','6.00%','WV'],
              ['Wisconsin','5.43%','5.00%','WI'],
              ['Wyoming','5.44%','4.00%','WY'],
            ].map(([state, combined, stateRate, abbr]) => (
              <tr onclick={`setState('${abbr}',${parseFloat(combined)})`} style="cursor:pointer">
                <td><strong>{abbr}</strong> — {state}</td>
                <td class="acc">{combined}</td>
                <td>{stateRate}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>When to Use This Calculator</h2>
    <ul>
      <li><strong>Expense reports</strong> — separate tax from the total for accounting records.</li>
      <li><strong>Business bookkeeping</strong> — record the net purchase amount excluding tax.</li>
      <li><strong>VAT refunds</strong> — calculate the taxable base amount when claiming a refund.</li>
      <li><strong>Price verification</strong> — confirm the correct tax rate was applied to your purchase.</li>
      <li><strong>Receipt analysis</strong> — when the pre-tax price is not printed on your receipt.</li>
      <li><strong>Cross-state shopping</strong> — compare real costs when buying in high-tax vs. low-tax states.</li>
      <li><strong>Online sales</strong> — verify destination-state tax was correctly applied to your order.</li>
    </ul>
    <div class="tip-box" style="margin-top:.75rem">
      <span class="tip-icon">💡</span>
      <p><strong>No-tax states:</strong> Oregon, Montana, New Hampshire, Delaware, and Alaska have 0% state sales tax. Shopping in these states? Enter 0% or click OR / MT / NH / DE buttons above.</p>
    </div>
  </div>

  <div class="card">
    <h2>Common Reverse Sales Tax Mistakes</h2>
    <ul>
      <li><strong>Using state rate only</strong> — most areas have state + local/county taxes combined. Always use the combined rate shown on your receipt.</li>
      <li><strong>Using wrong formula</strong> — the correct formula is: pre-tax = total ÷ (1 + rate). A common error is: total × (1 − rate), which underestimates the pre-tax amount.</li>
      <li><strong>Applying tax to tip in restaurants</strong> — in most states, tax applies before the tip. Calculate pre-tax on the food subtotal only.</li>
      <li><strong>Using outdated tax rates</strong> — sales tax rates change. Always verify your state's current combined rate before calculating for official reports.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is the formula for reverse sales tax?</h3>
      <p>Pre-Tax Price = Total Paid ÷ (1 + Tax Rate ÷ 100). For a $215 total with 7.75% tax: $215 ÷ 1.0775 = <strong>$199.54</strong> pre-tax.</p>
    </div>
    <div class="faq-item">
      <h3>Which US states have no sales tax?</h3>
      <p>Five states have no statewide sales tax: <strong>Oregon, Montana, New Hampshire, Delaware, and Alaska</strong>. Alaska allows local taxes so some cities do charge sales tax. Enter 0% in the calculator for these states.</p>
    </div>
    <div class="faq-item">
      <h3>What is the sales tax rate in Texas?</h3>
      <p>Texas has a 6.25% state rate with a combined average of <strong>8.19%</strong>. Cities like Houston, Dallas, Austin, and San Antonio typically charge the maximum 8.25% combined rate.</p>
    </div>
    <div class="faq-item">
      <h3>What is the sales tax rate in California?</h3>
      <p>California's combined average rate is <strong>8.68%</strong> (7.25% state + local). Los Angeles is 10.25%, San Jose is 9.375%, San Francisco is 8.625%.</p>
    </div>
    <div class="faq-item">
      <h3>What is the sales tax in Washington state?</h3>
      <p>Washington's state rate is 6.5% with a combined average of <strong>10.25%</strong> — among the highest in the country. Seattle's combined rate is 10.25%.</p>
    </div>
    <div class="faq-item">
      <h3>Can I use this for VAT (Value Added Tax)?</h3>
      <p>Yes — reverse VAT uses the same formula. Enter the VAT-inclusive price and the VAT rate (e.g., 20% UK, 19% Germany, 10% Australia GST) to find the pre-tax price.</p>
    </div>
    <div class="faq-item">
      <h3>Is the combined rate or state rate used on receipts?</h3>
      <p>Receipts use the <strong>combined rate</strong> — both the state rate plus local/county taxes. Always use the combined rate in this calculator for accurate pre-tax results.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate exact savings from any discount percentage.</p>
      </a>
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>Percentage Calculator</h3>
        <p>Find X% of Y — three calculators in one.</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Grow your savings with Certificate of Deposit rates.</p>
      </a>
      <a href="/mortgage-payoff-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Mortgage Payoff</h3>
        <p>See how extra payments save on interest costs.</p>
      </a>
      <a href="/debt-snowball-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Debt Snowball</h3>
        <p>Pay off all your debts — see your exact debt-free date.</p>
      </a>
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function fmt(v) { return v.toLocaleString('en-US', { minimumFractionDigits:2, maximumFractionDigits:2 }); }

function calcTax() {
  var total = parseFloat(document.getElementById('total').value) || 0;
  var rate  = parseFloat(document.getElementById('taxrate').value) || 0;
  if (total <= 0) return;

  var pretax = total / (1 + rate / 100);
  var taxAmt = total - pretax;

  document.getElementById('r-pretax').textContent     = fmt(pretax);
  document.getElementById('r-pretax2').textContent    = fmt(pretax);
  document.getElementById('r-taxamt-sub').textContent = fmt(taxAmt);
  document.getElementById('r-taxamt').textContent     = '$' + fmt(taxAmt);
  document.getElementById('r-rate').textContent       = rate.toFixed(2) + '%';
  document.getElementById('r-total').textContent      = '$' + fmt(total);
  document.getElementById('rec-pretax').textContent   = fmt(pretax);
  document.getElementById('rec-rate').textContent     = rate.toFixed(2) + '%';
  document.getElementById('rec-tax').textContent      = '+ $' + fmt(taxAmt);
  document.getElementById('rec-total').textContent    = '$' + fmt(total);

  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
  document.getElementById('receipt').style.display = 'block';
}

function toggleStates() {
  var wrap = document.getElementById('states-table-wrap');
  var btn  = document.getElementById('states-toggle');
  var open = wrap.style.display === 'block';
  wrap.style.display = open ? 'none' : 'block';
  btn.textContent = open ? 'Show All ▼' : 'Hide ▲';
}

function setState(state, rate) {
  document.getElementById('taxrate').value = rate;
  document.querySelectorAll('.preset-btn').forEach(function(b) { b.classList.remove('active'); });
  var btn = document.getElementById('sb-' + state);
  if (btn) btn.classList.add('active');
  calcTax();
}

document.getElementById('total').addEventListener('input', calcTax);
document.getElementById('taxrate').addEventListener('input', function() {
  document.querySelectorAll('.preset-btn').forEach(function(b) { b.classList.remove('active'); });
  calcTax();
});
document.getElementById('calc-btn').addEventListener('click', calcTax);
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calcTax(); });

window.addEventListener('load', calcTax);
</script>
</Layout>
