---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Reverse Sales Tax Calculator",
    "url": "https://computezap.com/reverse-sales-tax-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Free reverse sales tax calculator. Find the original pre-tax price from any total amount paid. All 50 US state tax rates included — California, Texas, New York, Florida, and more.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Reverse Sales Tax Calculator", "item": "https://computezap.com/reverse-sales-tax-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate the pre-tax price from a total?",
        "acceptedAnswer": { "@type": "Answer", "text": "Divide the total price by (1 + tax rate ÷ 100). For example, if you paid $107.50 with a 7.5% sales tax rate: $107.50 ÷ 1.075 = $100.00 pre-tax price. The tax amount is $107.50 - $100.00 = $7.50." }
      },
      {
        "@type": "Question",
        "name": "What is reverse sales tax?",
        "acceptedAnswer": { "@type": "Answer", "text": "Reverse sales tax (also called backwards tax calculation) is the process of finding the original price before tax was added, given the final total price. It's used in accounting, expense reports, and VAT reclaims." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in California?",
        "acceptedAnswer": { "@type": "Answer", "text": "California's combined average sales tax rate is approximately 8.68% (7.25% state rate plus average local taxes). Rates vary by city — Los Angeles is 10.25%, San Francisco is 8.625%." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Texas?",
        "acceptedAnswer": { "@type": "Answer", "text": "Texas has a 6.25% state sales tax rate. With local taxes, the combined average rate is 8.19%. Cities like Houston, Dallas, and Austin typically charge the maximum combined rate of 8.25%." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Tennessee?",
        "acceptedAnswer": { "@type": "Answer", "text": "Tennessee has one of the highest sales tax rates in the US. The state rate is 7.00% and the combined average including local taxes is 9.55%. Groceries are taxed at a reduced 4% rate." }
      },
      {
        "@type": "Question",
        "name": "Which states have no sales tax?",
        "acceptedAnswer": { "@type": "Answer", "text": "Five states have no statewide sales tax: Oregon, Montana, New Hampshire, Delaware, and Alaska. However, Alaska allows local jurisdictions to impose sales taxes, so some Alaskan cities do charge sales tax." }
      },
      {
        "@type": "Question",
        "name": "What is the sales tax rate in Florida?",
        "acceptedAnswer": { "@type": "Answer", "text": "Florida's state sales tax rate is 6.00%. With local discretionary sales surtax, the combined average rate is 7.08%. Miami-Dade County charges 7%, while some counties charge up to 7.5%." }
      },
      {
        "@type": "Question",
        "name": "Can I use this calculator for VAT (Value Added Tax)?",
        "acceptedAnswer": { "@type": "Answer", "text": "Yes — the reverse VAT calculation uses the same formula. Enter the VAT-inclusive price and the VAT rate (e.g., 20% in the UK, 19% in Germany) to find the pre-VAT price instantly." }
      }
    ]
  }
]);
---
<Layout
  title="Reverse Sales Tax Calculator — All 50 US States | ComputeZap"
  description="Free reverse sales tax calculator. Enter any total price and find the original pre-tax price instantly. All 50 US state sales tax rates included — CA, TX, NY, FL, TN, WA, and more."
  canonical="/reverse-sales-tax-calculator"
  schema={schema}
>
<style is:global>
.hero { text-align:center; padding:2rem 1rem 1.25rem; }
.hero h1 { font-size:2rem; color:#111; margin:.5rem 0 .35rem; font-weight:800; }
.hero-sub { color:#555; margin:0; font-size:1rem; }
.breadcrumb { font-size:.85rem; color:#888; margin-bottom:.75rem; }
.breadcrumb a { color:var(--blue); text-decoration:none; }

.calc-wrap { display:grid; grid-template-columns:360px 1fr; gap:1.5rem; max-width:1100px; margin:0 auto; padding:0 1rem 3rem; align-items:start; }
.calc-left { position:sticky; top:1rem; }
.card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem; margin-bottom:1rem; }
.card:last-child { margin-bottom:0; }

.result-box { background:var(--blue); border-radius:14px; padding:1.75rem 1.5rem; text-align:center; margin-bottom:1.25rem; box-shadow:0 4px 20px rgba(37,99,235,.18); }
.res-lbl { font-size:.72rem; color:rgba(255,255,255,.7); text-transform:uppercase; letter-spacing:.09em; margin-bottom:.5rem; }
.res-val { font-size:2.1rem; font-weight:800; color:#fff; line-height:1.2; }
.res-sub { font-size:.95rem; color:rgba(255,255,255,.8); margin-top:.3rem; }

.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; margin-bottom:1rem; }
.stat-item { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:.9rem .75rem; text-align:center; }
.stat-lbl { display:block; font-size:.68rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.3rem; font-weight:600; }
.stat-val { display:block; font-size:1.1rem; font-weight:800; color:#1e293b; }
.stat-val.red { color:#dc2626; }

.receipt-box { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:1rem; }
.rec-row { display:flex; justify-content:space-between; padding:.45rem 0; border-bottom:1px solid #f3f4f6; font-size:.875rem; color:#444; }
.rec-row:last-child { border-bottom:none; border-top:2px solid #e5e7eb; margin-top:.25rem; padding-top:.6rem; font-weight:800; color:#111; }
.rec-row .rec-val { font-weight:600; }
.rec-row .rec-val.red { color:#dc2626; }

.fld-lbl { display:block; font-size:.8rem; font-weight:700; color:#374151; margin-bottom:.4rem; text-transform:uppercase; letter-spacing:.04em; }
.fld-wrap { position:relative; margin-bottom:1rem; }
.fld-pfx { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600; pointer-events:none; }
.fld-sfx { position:absolute; right:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600; pointer-events:none; }
.txt-input { width:100%; font-size:1rem; padding:.65rem 1rem; border:1.5px solid #e2e8f0; border-radius:8px; color:#111; box-sizing:border-box; }
.txt-input:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(37,99,235,.1); }
.txt-pfx { padding-left:1.75rem; }
.txt-sfx { padding-right:2rem; }

.state-lbl { font-size:.7rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; display:block; }
.state-wrap { display:flex; flex-wrap:wrap; gap:.4rem; }
.state-btn { background:#fff; color:var(--blue); border:1.5px solid #dbeafe; border-radius:20px; padding:.28rem .7rem; font-size:.8rem; font-weight:700; cursor:pointer; transition:all .15s; }
.state-btn:hover, .state-btn.active { background:var(--blue); color:#fff; border-color:var(--blue); }

.card h2 { font-size:1.1rem; font-weight:700; color:#111; margin:0 0 .8rem; }
.card h3 { font-size:.95rem; font-weight:700; color:#111; margin:0 0 .4rem; }
.card p { color:#444; line-height:1.75; font-size:.95rem; margin:0 0 .7rem; }
.card p:last-child { margin-bottom:0; }
.card ul { color:#444; line-height:1.85; font-size:.95rem; padding-left:1.25rem; margin:0 0 .7rem; }
.formula-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:.75rem 1rem; font-family:monospace; font-size:.88rem; color:#1e293b; margin:.6rem 0; }
.tip-box { display:flex; gap:.75rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:.9rem 1rem; margin:.75rem 0; }
.tip-icon { font-size:1.1rem; flex-shrink:0; margin-top:.1rem; }
.tip-box p { margin:0; font-size:.875rem; color:#1e40af; }

.ref-tbl { width:100%; border-collapse:collapse; font-size:.875rem; }
.ref-tbl th { background:#f8fafc; padding:.45rem .75rem; text-align:left; font-size:.72rem; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:.04em; border-bottom:1px solid #e5e7eb; }
.ref-tbl td { padding:.45rem .75rem; border-bottom:1px solid #f3f4f6; color:#444; }
.ref-tbl tr:last-child td { border-bottom:none; }
.ref-tbl tr:hover td { background:#f8fafc; cursor:pointer; }
.ref-tbl .acc { color:var(--blue); font-weight:700; }

.faq-item { border-bottom:1px solid #f3f4f6; padding:.85rem 0; }
.faq-item:last-child { border-bottom:none; padding-bottom:0; }
.faq-item h3 { font-size:.92rem; color:#111; margin:0 0 .35rem; font-weight:600; }
.faq-item p { color:#555; font-size:.875rem; margin:0; line-height:1.65; }

.next-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.75rem; }
.next-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:1rem; border-top:3px solid var(--blue); text-decoration:none; display:block; transition:box-shadow .15s; }
.next-card:hover { box-shadow:0 4px 12px rgba(0,0,0,.08); }
.next-tag { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--blue); margin-bottom:.3rem; display:block; }
.next-card h3 { font-size:.88rem; font-weight:700; color:#111; margin:0 0 .25rem; }
.next-card p { font-size:.78rem; color:#64748b; margin:0; line-height:1.5; }

@media (max-width:768px) {
  .calc-wrap { grid-template-columns:1fr; }
  .calc-left { position:static; }
  .next-grid { grid-template-columns:1fr; }
  .hero h1 { font-size:1.65rem; }
  .res-val { font-size:1.6rem; }
}
</style>

