<script is:inline>
function gcd(a, b) { return b === 0 ? a : gcd(b, a % b); }

function convert() {
  var raw = document.getElementById('dec-input').value.trim();
  var val = parseFloat(raw);
  if (raw === '' || isNaN(val)) return;

  var neg = val < 0;
  var abs = Math.abs(val);

  var num, den;
  var dotIdx = raw.replace('-','').indexOf('.');
  if (dotIdx === -1) {
    num = Math.round(abs);
    den = 1;
  } else {
    var decPart = raw.replace('-','').split('.')[1] || '';
    den = Math.pow(10, decPart.length);
    num = Math.round(abs * den);
  }

  var g = gcd(num, den);
  var sNum = num / g;
  var sDen = den / g;

  /* Mixed number */
  var mixedStr;
  if (abs >= 1 && sDen !== 1) {
    var whole = Math.floor(abs);
    var remNum = sNum - whole * sDen;
    mixedStr = (neg ? '-' : '') + whole + ' ' + remNum + '/' + sDen;
  } else if (sDen === 1) {
    mixedStr = (neg ? '-' : '') + sNum;
  } else {
    mixedStr = (neg ? '-' : '') + sNum + '/' + sDen;
  }

  var displayNum = (neg ? '-' : '') + sNum;

  /* Update DOM */
  document.getElementById('r-num').textContent = displayNum;
  document.getElementById('r-den').textContent = sDen;
  document.getElementById('r-sub').textContent = (neg ? '-' : '') + abs + ' = ' + displayNum + '/' + sDen;
  document.getElementById('r-orig').textContent = (neg ? '-' : '') + num + '/' + den;
  document.getElementById('r-pct').textContent = (val * 100).toFixed(4).replace(/\.?0+$/, '') + '%';
  document.getElementById('r-mixed').textContent = mixedStr;
  document.getElementById('r-gcd').textContent = g;

  /* Show/hide denominator row */
  var bar = document.getElementById('frac-bar');
  var denEl = document.getElementById('r-den');
  if (sDen === 1) {
    bar.style.display = 'none';
    denEl.style.display = 'none';
  } else {
    bar.style.display = '';
    denEl.style.display = '';
  }

  /* Live steps */
  var stepsText;
  if (den === 1) {
    stepsText = abs + ' is already a whole number → ' + sNum + '/1';
  } else if (g === 1) {
    stepsText = abs + ' × ' + den + '/' + den + ' = ' + num + '/' + den + ' → GCD(' + num + ',' + den + ')=1 → Already simplified: ' + sNum + '/' + sDen;
  } else {
    stepsText = abs + ' × ' + den + '/' + den + ' = ' + num + '/' + den + ' → GCD(' + num + ',' + den + ')=' + g + ' → ' + num + '÷' + g + ' / ' + den + '÷' + g + ' = ' + sNum + '/' + sDen;
  }
  document.getElementById('steps-live').textContent = stepsText;
}

function setVal(v) {
  document.getElementById('dec-input').value = v;
  convert();
}

/* Run on load */
convert();
</script>
