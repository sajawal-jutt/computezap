---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Decimal to Fraction Calculator",
    "url": "https://computezap.com/decimal-to-fraction",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert any decimal to a simplified fraction instantly. Shows numerator, denominator, mixed number, and step-by-step process. Free decimal to fraction calculator.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Decimal to Fraction", "item": "https://computezap.com/decimal-to-fraction" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is 0.5 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.5 as a fraction is 1/2. To convert: 0.5 = 5/10, then simplify by dividing both by GCD(5,10)=5, giving 1/2. In percentage, 0.5 = 50%." } },
      { "@type": "Question", "name": "What is 0.75 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.75 as a fraction is 3/4. To convert: 0.75 = 75/100, then simplify by dividing both by GCD(75,100)=25, giving 3/4. In percentage, 0.75 = 75%." } },
      { "@type": "Question", "name": "What is 0.625 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.625 as a fraction is 5/8. To convert: 0.625 = 625/1000, then simplify by dividing both by GCD(625,1000)=125, giving 5/8. In percentage, 0.625 = 62.5%." } },
      { "@type": "Question", "name": "What is 0.25 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.25 as a fraction is 1/4. To convert: 0.25 = 25/100, then simplify by dividing both by GCD(25,100)=25, giving 1/4. In percentage, 0.25 = 25%." } },
      { "@type": "Question", "name": "What is 0.125 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.125 as a fraction is 1/8. To convert: 0.125 = 125/1000, then simplify by dividing both by GCD(125,1000)=125, giving 1/8. In percentage, 0.125 = 12.5%." } },
      { "@type": "Question", "name": "How do you convert a decimal to a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "To convert a decimal to a fraction: (1) Count the decimal places. (2) Write it over a power of 10. (3) Find the GCD of numerator and denominator. (4) Divide both by GCD. Example: 0.625 = 625/1000, GCD=125, simplified = 5/8." } },
      { "@type": "Question", "name": "What is 0.6875 as a fraction?", "acceptedAnswer": { "@type": "Answer", "text": "0.6875 as a fraction is 11/16. To convert: 0.6875 = 6875/10000, then simplify by dividing both by GCD(6875,10000)=625, giving 11/16. In percentage, 0.6875 = 68.75%." } },
      { "@type": "Question", "name": "What is a mixed number?", "acceptedAnswer": { "@type": "Answer", "text": "A mixed number combines a whole number with a proper fraction. For example, 1.75 = 7/4 as an improper fraction, but as a mixed number it is 1 3/4. Mixed numbers are easier to read when the value is greater than 1." } }
    ]
  }
]);
---
<Layout
  title="Decimal to Fraction Calculator — Convert Instantly | ComputeZap"
  description="Convert any decimal to a simplified fraction instantly. 0.5 = 1/2, 0.625 = 5/8, 0.75 = 3/4. Shows mixed number, steps, and common fractions table. Free and instant."
  canonical="/decimal-to-fraction"
  schema={schema}
>
<style is:global>
.frac-visual{display:inline-flex;flex-direction:column;align-items:center;gap:0;margin:.25rem 0}
.frac-num{font-size:2.4rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.frac-bar{width:100%;min-width:3rem;height:3px;background:rgba(255,255,255,.8);margin:.2rem 0;border-radius:2px}
.frac-den{font-size:2.4rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.step-list{display:flex;flex-direction:column;gap:.6rem;margin:.5rem 0 0}
.step-item{display:flex;gap:.75rem;align-items:flex-start}
.step-num{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;min-width:20px;background:#eff6ff;color:var(--blue);border-radius:50%;font-size:.7rem;font-weight:800;flex-shrink:0;margin-top:.1rem}
.step-text{font-size:.875rem;color:#374151;line-height:1.55}
.step-code{font-family:monospace;font-size:.8rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:5px;padding:.1rem .4rem;color:#1e293b}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › Decimal to Fraction Calculator</nav>
  <h1>Decimal to Fraction Calculator</h1>
  <p>Convert any decimal to a simplified fraction — instantly and free</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="input-group">
      <label for="dec-input">Decimal Number</label>
      <div class="input-wrap">
        <input type="number" id="dec-input" value="0.5" step="any" oninput="convert()" placeholder="0.625" />
      </div>
    </div>

    <span class="preset-lbl">Common decimals</span>
    <div class="preset-wrap">
      <button class="preset-btn" onclick="setVal('0.5')">0.5</button>
      <button class="preset-btn" onclick="setVal('0.25')">0.25</button>
      <button class="preset-btn" onclick="setVal('0.75')">0.75</button>
      <button class="preset-btn" onclick="setVal('0.125')">0.125</button>
      <button class="preset-btn" onclick="setVal('0.333')">0.333</button>
      <button class="preset-btn" onclick="setVal('0.667')">0.667</button>
      <button class="preset-btn" onclick="setVal('0.625')">0.625</button>
      <button class="preset-btn" onclick="setVal('0.875')">0.875</button>
      <button class="preset-btn" onclick="setVal('0.1')">0.1</button>
      <button class="preset-btn" onclick="setVal('0.2')">0.2</button>
      <button class="preset-btn" onclick="setVal('0.6875')">0.6875</button>
      <button class="preset-btn" onclick="setVal('0.3125')">0.3125</button>
    </div>

    <div class="result-hero">
      <div class="r-label">Simplified Fraction</div>
      <div class="frac-visual">
        <span class="frac-num" id="r-num">1</span>
        <div class="frac-bar" id="frac-bar"></div>
        <span class="frac-den" id="r-den">2</span>
      </div>
      <div class="r-sub" id="r-sub">0.5 = 1/2</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Percent</span><span class="stat-val" id="r-pct">50%</span></div>
      <div class="stat-box"><span class="stat-lbl">Original Fraction</span><span class="stat-val" id="r-orig">5/10</span></div>
      <div class="stat-box"><span class="stat-lbl">Mixed Number</span><span class="stat-val" id="r-mixed">1/2</span></div>
      <div class="stat-box"><span class="stat-lbl">GCD Used</span><span class="stat-val" id="r-gcd">5</span></div>
    </div>

    <div class="tip-box" style="margin-top:1rem">
      <span class="tip-icon">📐</span>
      <p><strong>Your steps:</strong> <span id="steps-live">0.5 × 10/10 = 5/10 → GCD(5,10)=5 → 1/2</span></p>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Convert Decimal to Fraction</h2>
    <div class="formula-box">
      <div style="font-weight:800">Fraction = Decimal × 10ⁿ / 10ⁿ → Simplify by GCD</div>
      <div style="font-size:.8rem;color:#64748b;margin-top:.35rem">where n = number of decimal places</div>
    </div>
    <div class="step-list">
      <div class="step-item">
        <span class="step-num">1</span>
        <span class="step-text">Count decimal places — e.g., <span class="step-code">0.625</span> has <strong>3</strong> decimal places</span>
      </div>
      <div class="step-item">
        <span class="step-num">2</span>
        <span class="step-text">Multiply top and bottom by <span class="step-code">10³ = 1000</span> → <strong>625/1000</strong></span>
      </div>
      <div class="step-item">
        <span class="step-num">3</span>
        <span class="step-text">Find GCD of 625 and 1000 → <strong>GCD = 125</strong></span>
      </div>
      <div class="step-item">
        <span class="step-num">4</span>
        <span class="step-text">Divide both by GCD → <span class="step-code">625÷125 / 1000÷125</span> = <strong>5/8</strong></span>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Common Decimal to Fraction Chart</h2>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>Decimal</th><th>Fraction</th><th>Simplified</th><th>Percent</th></tr></thead>
        <tbody>
          <tr><td>0.1</td><td>1/10</td><td>1/10</td><td>10%</td></tr>
          <tr><td>0.111…</td><td>≈ 111/1000</td><td><strong>1/9</strong></td><td>11.11%</td></tr>
          <tr class="highlight-row"><td><strong>0.125</strong></td><td>125/1000</td><td><strong>1/8</strong></td><td>12.5%</td></tr>
          <tr><td>0.2</td><td>2/10</td><td>1/5</td><td>20%</td></tr>
          <tr class="highlight-row"><td><strong>0.25</strong></td><td>25/100</td><td><strong>1/4</strong></td><td>25%</td></tr>
          <tr><td>0.333…</td><td>≈ 333/1000</td><td><strong>≈ 1/3</strong></td><td>33.33%</td></tr>
          <tr class="highlight-row"><td><strong>0.375</strong></td><td>375/1000</td><td><strong>3/8</strong></td><td>37.5%</td></tr>
          <tr class="highlight-row"><td><strong>0.5</strong></td><td>5/10</td><td><strong>1/2</strong></td><td>50%</td></tr>
          <tr class="highlight-row"><td><strong>0.625</strong></td><td>625/1000</td><td><strong>5/8</strong></td><td>62.5%</td></tr>
          <tr><td>0.666…</td><td>≈ 666/1000</td><td><strong>≈ 2/3</strong></td><td>66.67%</td></tr>
          <tr class="highlight-row"><td><strong>0.6875</strong></td><td>6875/10000</td><td><strong>11/16</strong></td><td>68.75%</td></tr>
          <tr class="highlight-row"><td><strong>0.75</strong></td><td>75/100</td><td><strong>3/4</strong></td><td>75%</td></tr>
          <tr class="highlight-row"><td><strong>0.875</strong></td><td>875/1000</td><td><strong>7/8</strong></td><td>87.5%</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Fractions in Sixteenths — Popular in Engineering</h2>
    <p>The 16ths series is commonly searched for machining, woodworking, and measurement conversions.</p>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>Decimal</th><th>Fraction</th><th>Percent</th></tr></thead>
        <tbody>
          {[
            ['0.0625','1/16','6.25%'],
            ['0.125','2/16 = 1/8','12.5%'],
            ['0.1875','3/16','18.75%'],
            ['0.25','4/16 = 1/4','25%'],
            ['0.3125','5/16','31.25%'],
            ['0.375','6/16 = 3/8','37.5%'],
            ['0.4375','7/16','43.75%'],
            ['0.5','8/16 = 1/2','50%'],
            ['0.5625','9/16','56.25%'],
            ['0.625','10/16 = 5/8','62.5%'],
            ['0.6875','11/16','68.75%'],
            ['0.75','12/16 = 3/4','75%'],
            ['0.8125','13/16','81.25%'],
            ['0.875','14/16 = 7/8','87.5%'],
            ['0.9375','15/16','93.75%'],
          ].map(([d, f, p]) => (
            <tr>
              <td>{d}</td>
              <td style="color:var(--blue);font-weight:700">{f}</td>
              <td>{p}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is 0.5 as a fraction?</h3>
      <p>0.5 as a fraction is <strong>1/2</strong>. Write 0.5 as 5/10, then simplify: GCD(5,10)=5, so 5÷5 / 10÷5 = 1/2. In other words, 0.5 is exactly one half.</p>
    </div>
    <div class="faq-item">
      <h3>What is 0.75 as a fraction?</h3>
      <p>0.75 as a fraction is <strong>3/4</strong>. Write as 75/100, GCD(75,100)=25, so 75÷25 / 100÷25 = 3/4. That's three-quarters, or 75%.</p>
    </div>
    <div class="faq-item">
      <h3>What is 0.625 as a fraction?</h3>
      <p>0.625 as a fraction is <strong>5/8</strong>. Write as 625/1000, GCD(625,1000)=125, so 625÷125 / 1000÷125 = 5/8. This equals 62.5%.</p>
    </div>
    <div class="faq-item">
      <h3>What is 0.6875 as a fraction?</h3>
      <p>0.6875 as a fraction is <strong>11/16</strong>. Write as 6875/10000, GCD=625, so 11/16. This is 68.75% and a standard fractional inch in engineering.</p>
    </div>
    <div class="faq-item">
      <h3>What is 0.333 as a fraction?</h3>
      <p>0.333 (not repeating) = <strong>333/1000</strong>. The true repeating 0.333… = exactly 1/3. Since 1/3 cannot be written as a finite decimal, entering 0.333 gives the closest finite approximation.</p>
    </div>
    <div class="faq-item">
      <h3>How do you simplify a fraction using GCD?</h3>
      <p>GCD is the largest number that divides both top and bottom evenly. Example: GCD(625,1000)=125. Divide both: 625÷125=5, 1000÷125=8. Result: 5/8. Our calculator uses the Euclidean algorithm automatically.</p>
    </div>
    <div class="faq-item">
      <h3>What is a mixed number?</h3>
      <p>A mixed number combines a whole number with a fraction. 1.75 = 7/4 as an improper fraction, but <strong>1 3/4</strong> as a mixed number. Easier to read when the value is greater than 1.</p>
    </div>
    <div class="faq-item">
      <h3>What is 0.25 as a fraction?</h3>
      <p>0.25 as a fraction is <strong>1/4</strong>. Write as 25/100, GCD=25, so 25÷25 / 100÷25 = 1/4. That's one-quarter, or 25%.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/pythagorean-theorem-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Pythagorean Theorem</h3>
        <p>Find any side of a right triangle with a² + b² = c².</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the final price after any discount.</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Convert</span>
        <h3>cm to Inches</h3>
        <p>Convert centimeters to inches instantly.</p>
      </a>
      <a href="/celsius-to-fahrenheit" class="next-card">
        <span class="next-tag">Temp</span>
        <h3>Celsius to Fahrenheit</h3>
        <p>Temperature conversion with formula.</p>
      </a>
      <a href="/square-footage-calculator" class="next-card">
        <span class="next-tag">Area</span>
        <h3>Square Footage</h3>
        <p>Calculate room area in square feet instantly.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function gcd(a, b) { return b === 0 ? a : gcd(b, a % b); }

function convert() {
  var raw = document.getElementById('dec-input').value.trim();
  var val = parseFloat(raw);
  if (raw === '' || isNaN(val)) return;

  var neg = val < 0;
  var abs = Math.abs(val);

  var num, den;
  var dotIdx = raw.replace('-','').indexOf('.');
  if (dotIdx === -1) {
    num = Math.round(abs);
    den = 1;
  } else {
    var decPart = raw.replace('-','').split('.')[1] || '';
    den = Math.pow(10, decPart.length);
    num = Math.round(abs * den);
  }

  var g = gcd(num, den);
  var sNum = num / g;
  var sDen = den / g;

  var mixedStr;
  if (abs >= 1 && sDen !== 1) {
    var whole = Math.floor(abs);
    var remNum = sNum - whole * sDen;
    mixedStr = (neg ? '-' : '') + whole + ' ' + remNum + '/' + sDen;
  } else if (sDen === 1) {
    mixedStr = (neg ? '-' : '') + sNum;
  } else {
    mixedStr = (neg ? '-' : '') + sNum + '/' + sDen;
  }

  var displayNum = (neg ? '-' : '') + sNum;

  document.getElementById('r-num').textContent = displayNum;
  document.getElementById('r-den').textContent = sDen;
  document.getElementById('r-sub').textContent = (neg ? '-' : '') + abs + ' = ' + displayNum + '/' + sDen;
  document.getElementById('r-orig').textContent = (neg ? '-' : '') + num + '/' + den;
  document.getElementById('r-pct').textContent = (val * 100).toFixed(4).replace(/\.?0+$/, '') + '%';
  document.getElementById('r-mixed').textContent = mixedStr;
  document.getElementById('r-gcd').textContent = g;

  var bar = document.getElementById('frac-bar');
  var denEl = document.getElementById('r-den');
  if (sDen === 1) {
    bar.style.display = 'none'; denEl.style.display = 'none';
  } else {
    bar.style.display = ''; denEl.style.display = '';
  }

  var stepsText;
  if (den === 1) {
    stepsText = abs + ' is already a whole number → ' + sNum + '/1';
  } else if (g === 1) {
    stepsText = abs + ' × ' + den + '/' + den + ' = ' + num + '/' + den + ' → GCD=' + g + ' → Already simplified: ' + sNum + '/' + sDen;
  } else {
    stepsText = abs + ' × ' + den + '/' + den + ' = ' + num + '/' + den + ' → GCD(' + num + ',' + den + ')=' + g + ' → ' + sNum + '/' + sDen;
  }
  document.getElementById('steps-live').textContent = stepsText;
}

function setVal(v) {
  document.getElementById('dec-input').value = v;
  convert();
}

convert();
</script>
</Layout>
