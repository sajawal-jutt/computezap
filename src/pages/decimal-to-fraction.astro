---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Decimal to Fraction Calculator",
    "url": "https://computezap.com/decimal-to-fraction",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert any decimal to a simplified fraction instantly. Shows numerator, denominator, mixed number, and step-by-step process. Free decimal to fraction calculator.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Decimal to Fraction", "item": "https://computezap.com/decimal-to-fraction" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is 0.5 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.5 as a fraction is 1/2. To convert: 0.5 = 5/10, then simplify by dividing both by GCD(5,10)=5, giving 1/2. In percentage, 0.5 = 50%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.75 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.75 as a fraction is 3/4. To convert: 0.75 = 75/100, then simplify by dividing both by GCD(75,100)=25, giving 3/4. In percentage, 0.75 = 75%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.625 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.625 as a fraction is 5/8. To convert: 0.625 = 625/1000, then simplify by dividing both by GCD(625,1000)=125, giving 5/8. In percentage, 0.625 = 62.5%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.6875 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.6875 as a fraction is 11/16. To convert: 0.6875 = 6875/10000, then simplify by dividing both by GCD(6875,10000)=625, giving 11/16. In percentage, 0.6875 = 68.75%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.3125 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.3125 as a fraction is 5/16. To convert: 0.3125 = 3125/10000, then simplify by dividing both by GCD(3125,10000)=625, giving 5/16. In percentage, 0.3125 = 31.25%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.25 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.25 as a fraction is 1/4. To convert: 0.25 = 25/100, then simplify by dividing both by GCD(25,100)=25, giving 1/4. In percentage, 0.25 = 25%." }
      },
      {
        "@type": "Question",
        "name": "What is 0.125 as a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "0.125 as a fraction is 1/8. To convert: 0.125 = 125/1000, then simplify by dividing both by GCD(125,1000)=125, giving 1/8. In percentage, 0.125 = 12.5%." }
      },
      {
        "@type": "Question",
        "name": "How do you convert a decimal to a fraction?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert a decimal to a fraction: (1) Count the decimal places — e.g., 0.625 has 3 decimal places. (2) Write it over a power of 10: 625/1000. (3) Find the GCD of numerator and denominator: GCD(625,1000)=125. (4) Divide both by GCD: 625÷125 / 1000÷125 = 5/8. That's your simplified fraction." }
      }
    ]
  }
]);
---
<Layout
  title="Decimal to Fraction Calculator — Convert Instantly | ComputeZap"
  description="Convert any decimal to a simplified fraction instantly. 0.5 = 1/2, 0.625 = 5/8, 0.75 = 3/4. Shows mixed number, steps, and common fractions table. Free and instant."
  canonical="/decimal-to-fraction"
  schema={schema}
>
<style is:global>
/* ── Layout ─────────────────────────────────────── */
.hero{text-align:center;padding:2rem 1rem 1.5rem}
.hero h1{font-size:2rem;color:#111;margin:.5rem 0 .4rem;font-weight:800;letter-spacing:-.02em}
.hero-sub{color:#64748b;margin:0;font-size:1.05rem}
.breadcrumb{font-size:.82rem;color:#94a3b8;margin-bottom:.75rem}
.breadcrumb a{color:var(--blue);text-decoration:none}
.calc-wrap{display:grid;grid-template-columns:390px 1fr;gap:1.75rem;max-width:1120px;margin:0 auto;padding:0 1rem 3.5rem;align-items:start}
.calc-left{position:sticky;top:1rem}

/* ── Cards ──────────────────────────────────────── */
.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.card:last-child{margin-bottom:0}
.card-header{display:flex;align-items:center;gap:.6rem;margin-bottom:1.1rem}
.card-step{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:var(--blue);color:#fff;border-radius:50%;font-size:.7rem;font-weight:800;flex-shrink:0}
.card-title{font-size:1rem;font-weight:700;color:#111;margin:0}
.card h2{font-size:1.05rem;font-weight:700;color:#111;margin:0 0 .9rem}
.card p{color:#444;line-height:1.75;font-size:.93rem;margin:0 0 .7rem}
.card p:last-child{margin-bottom:0}
.content-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.content-card h2{font-size:1.05rem;font-weight:700;color:#111;margin:0 0 .8rem}
.content-card p{color:#444;line-height:1.75;font-size:.93rem;margin:0 0 .7rem}
.content-card p:last-child{margin-bottom:0}
.content-card ul{color:#444;line-height:1.85;font-size:.93rem;padding-left:1.25rem;margin:0}

/* ── Input ───────────────────────────────────────── */
.field-group{margin-bottom:1rem}
.field-group:last-child{margin-bottom:0}
.field-lbl{display:block;font-size:.75rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem}
.input-wrap{position:relative;display:flex;align-items:center}
.input-sfx{position:absolute;right:.9rem;font-size:.85rem;font-weight:700;color:#94a3b8;pointer-events:none}
.field-input{width:100%;font-size:1.5rem;font-weight:800;padding:.65rem 4rem .65rem .9rem;border:2px solid #e2e8f0;border-radius:10px;color:#111;box-sizing:border-box;font-family:inherit;background:#f8fafc;outline:none;transition:all .15s}
.field-input:focus{border-color:#93c5fd;background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.07)}

/* ── Presets ─────────────────────────────────────── */
.preset-wrap{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:.75rem}
.preset-btn{padding:.3rem .65rem;font-size:.8rem;font-weight:700;background:#f1f5f9;border:1.5px solid #e2e8f0;border-radius:7px;cursor:pointer;color:#334155;font-family:inherit;transition:all .15s}
.preset-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}

/* ── Result Box ──────────────────────────────────── */
.result-hero{background:linear-gradient(135deg,#1d4ed8 0%,#2563eb 60%,#3b82f6 100%);border-radius:14px;padding:1.5rem 1.5rem 1.25rem;text-align:center;margin-bottom:1rem;box-shadow:0 6px 24px rgba(37,99,235,.22)}
.r-label{font-size:.68rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.5rem;font-weight:700}
.frac-visual{display:inline-flex;flex-direction:column;align-items:center;gap:0}
.frac-num{font-size:2.6rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.frac-bar{width:100%;min-width:3rem;height:3px;background:rgba(255,255,255,.8);margin:.2rem 0;border-radius:2px}
.frac-den{font-size:2.6rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.r-sub{font-size:.88rem;color:rgba(255,255,255,.75);margin-top:.5rem}
.stats-row{display:grid;grid-template-columns:1fr 1fr;gap:.55rem;margin-bottom:0}
.stat-box{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.85rem .75rem;text-align:center}
.stat-lbl{display:block;font-size:.62rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem;font-weight:700}
.stat-val{display:block;font-size:.95rem;font-weight:800;color:#1e293b}

/* ── Steps Card ──────────────────────────────────── */
.step-list{display:flex;flex-direction:column;gap:.6rem;margin:.5rem 0 0}
.step-item{display:flex;gap:.75rem;align-items:flex-start}
.step-num{display:inline-flex;align-items:center;justify-content:center;width:20px;height:20px;background:#eff6ff;color:var(--blue);border-radius:50%;font-size:.7rem;font-weight:800;flex-shrink:0;margin-top:.1rem}
.step-text{font-size:.875rem;color:#374151;line-height:1.55}
.step-code{font-family:monospace;font-size:.8rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:5px;padding:.1rem .4rem;color:#1e293b}

/* ── Formula Box ─────────────────────────────────── */
.formula-box{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:12px;padding:1.1rem 1.25rem;margin:.75rem 0;text-align:center}
.formula-text{font-size:1rem;font-weight:800;color:#1e293b;font-family:monospace;letter-spacing:.02em}
.formula-sub{font-size:.8rem;color:#64748b;margin-top:.35rem}

/* ── Tip Box ─────────────────────────────────────── */
.tip-box{display:flex;gap:.75rem;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:.9rem 1rem;margin:.85rem 0}
.tip-icon{font-size:1.1rem;flex-shrink:0;margin-top:.05rem}
.tip-box p{margin:0;font-size:.875rem;color:#1e40af;line-height:1.6}

/* ── Reference Table ─────────────────────────────── */
.ref-tbl{width:100%;border-collapse:collapse;font-size:.875rem}
.ref-tbl th{background:#f8fafc;padding:.6rem .85rem;text-align:left;font-size:.68rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid #e2e8f0}
.ref-tbl td{padding:.65rem .85rem;border-bottom:1px solid #f3f4f6;color:#374151}
.ref-tbl tr:last-child td{border-bottom:none}
.ref-tbl tbody tr:hover td{background:#f8faff}
.ref-tbl .hl td{background:#eff6ff;font-weight:700;color:#1d4ed8}
.ref-tbl .hl:hover td{background:#dbeafe}

/* ── FAQ ─────────────────────────────────────────── */
.faq-item{border-bottom:1px solid #f3f4f6;padding:.9rem 0}
.faq-item:last-child{border-bottom:none;padding-bottom:0}
.faq-item h3{font-size:.9rem;color:#111;margin:0 0 .35rem;font-weight:700}
.faq-item p{color:#555;font-size:.865rem;margin:0;line-height:1.65}

/* ── Related Tools ───────────────────────────────── */
.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}
.next-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1rem;border-top:3px solid var(--blue);text-decoration:none;display:block;transition:box-shadow .15s}
.next-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.08)}
.next-tag{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--blue);margin-bottom:.3rem;display:block}
.next-card h3{font-size:.88rem;font-weight:700;color:#111;margin:0 0 .25rem}
.next-card p{font-size:.78rem;color:#64748b;margin:0;line-height:1.5}

/* ── Responsive ──────────────────────────────────── */
@media(max-width:768px){
  .calc-wrap{grid-template-columns:1fr}
  .calc-left{position:static}
  .hero h1{font-size:1.65rem}
  .frac-num,.frac-den{font-size:2rem}
  .next-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){
  .next-grid{grid-template-columns:1fr}
  .stats-row{grid-template-columns:1fr 1fr}
}
</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Decimal to Fraction Calculator</nav>
  <h1>Decimal to Fraction Calculator</h1>
  <p class="hero-sub">Convert any decimal to a simplified fraction — instantly and free</p>
</div>

<div class="calc-wrap">

  <!-- ══ LEFT PANEL ══ -->
  <div class="calc-left">

    <div class="card">
      <div class="card-header">
        <span class="card-step">1</span>
        <h2 class="card-title">Enter a Decimal</h2>
      </div>
      <div class="field-group">
        <label class="field-lbl" for="dec-input">Decimal Number</label>
        <div class="input-wrap">
          <input type="number" id="dec-input" class="field-input" value="0.5" step="any" oninput="convert()" placeholder="0.625" />
          <span class="input-sfx">decimal</span>
        </div>
      </div>
      <div class="preset-wrap">
        <button class="preset-btn" onclick="setVal('0.5')">0.5</button>
        <button class="preset-btn" onclick="setVal('0.25')">0.25</button>
        <button class="preset-btn" onclick="setVal('0.75')">0.75</button>
        <button class="preset-btn" onclick="setVal('0.125')">0.125</button>
        <button class="preset-btn" onclick="setVal('0.333')">0.333</button>
        <button class="preset-btn" onclick="setVal('0.667')">0.667</button>
        <button class="preset-btn" onclick="setVal('0.625')">0.625</button>
        <button class="preset-btn" onclick="setVal('0.875')">0.875</button>
        <button class="preset-btn" onclick="setVal('0.1')">0.1</button>
        <button class="preset-btn" onclick="setVal('0.2')">0.2</button>
        <button class="preset-btn" onclick="setVal('0.6875')">0.6875</button>
        <button class="preset-btn" onclick="setVal('0.3125')">0.3125</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-step">2</span>
        <h2 class="card-title">Result</h2>
      </div>

      <div class="result-hero">
        <div class="r-label">Simplified Fraction</div>
        <div class="frac-visual">
          <span class="frac-num" id="r-num">1</span>
          <div class="frac-bar" id="frac-bar"></div>
          <span class="frac-den" id="r-den">2</span>
        </div>
        <div class="r-sub" id="r-sub">0.5 = 1/2</div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-lbl">Percent</span>
          <span class="stat-val" id="r-pct">50%</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">Original Fraction</span>
          <span class="stat-val" id="r-orig">5/10</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">Mixed Number</span>
          <span class="stat-val" id="r-mixed">1/2</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">GCD Used</span>
          <span class="stat-val" id="r-gcd">5</span>
        </div>
      </div>
    </div>

  </div>

  <!-- ══ RIGHT PANEL ══ -->
  <div class="calc-right">

    <!-- How it works -->
    <div class="content-card">
      <h2>How to Convert Decimal to Fraction</h2>
      <div class="formula-box">
        <div class="formula-text">Fraction = Decimal × 10ⁿ / 10ⁿ → Simplify by GCD</div>
        <div class="formula-sub">where n = number of decimal places</div>
      </div>
      <div class="step-list">
        <div class="step-item">
          <span class="step-num">1</span>
          <span class="step-text">Count decimal places — e.g., <span class="step-code">0.625</span> has <strong>3</strong> decimal places</span>
        </div>
        <div class="step-item">
          <span class="step-num">2</span>
          <span class="step-text">Multiply top and bottom by <span class="step-code">10³ = 1000</span> → <strong>625/1000</strong></span>
        </div>
        <div class="step-item">
          <span class="step-num">3</span>
          <span class="step-text">Find GCD of 625 and 1000 → <strong>GCD = 125</strong></span>
        </div>
        <div class="step-item">
          <span class="step-num">4</span>
          <span class="step-text">Divide both by GCD → <span class="step-code">625÷125 / 1000÷125</span> = <strong>5/8</strong></span>
        </div>
      </div>
      <div class="tip-box" style="margin-top:.9rem">
        <span class="tip-icon">💡</span>
        <p><strong>Your current steps:</strong> <span id="steps-live">0.5 × 10/10 = 5/10 → GCD(5,10)=5 → 5÷5 / 10÷5 = 1/2</span></p>
      </div>
    </div>

    <!-- Common Decimals Table -->
    <div class="content-card">
      <h2>Common Decimal to Fraction Chart</h2>
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead>
            <tr><th>Decimal</th><th>Fraction</th><th>Simplified</th><th>Percent</th></tr>
          </thead>
          <tbody>
            <tr><td>0.1</td><td>1/10</td><td>1/10</td><td>10%</td></tr>
            <tr><td>0.111...</td><td>≈ 111/1000</td><td><strong>1/9</strong></td><td>11.11%</td></tr>
