---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Free Online Calculators and Unit Converters",
  "description": "ComputeZap offers free online calculators and unit converters including CD calculator, square footage calculator, percent off calculator, time to decimal converter, and more.",
  "url": "https://computezap.com",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "CD Calculator", "url": "https://computezap.com/cd-calculator" },
    { "@type": "ListItem", "position": 2, "name": "Days From Today Calculator", "url": "https://computezap.com/days-from-today" },
    { "@type": "ListItem", "position": 3, "name": "Square Footage Calculator", "url": "https://computezap.com/square-footage-calculator" },
    { "@type": "ListItem", "position": 4, "name": "Percent Off Calculator", "url": "https://computezap.com/percent-off-calculator" },
    { "@type": "ListItem", "position": 5, "name": "Time to Decimal Calculator", "url": "https://computezap.com/time-to-decimal-calculator" },
    { "@type": "ListItem", "position": 6, "name": "Reverse Sales Tax Calculator", "url": "https://computezap.com/reverse-sales-tax-calculator" },
    { "@type": "ListItem", "position": 7, "name": "Cups to Tablespoons Converter", "url": "https://computezap.com/cups-to-tablespoons" },
    { "@type": "ListItem", "position": 8, "name": "Liters to Gallons Converter", "url": "https://computezap.com/liters-to-gallons" }
  ]
});
---
<Layout
  title="Free Online Calculators & Unit Converters | ComputeZap"
  description="Free online calculators and unit converters — CD calculator, days from today, percent off, time to decimal, square footage, and more. Fast & accurate."
  canonical="/"
  schema={schema}
>
  <div class="hero">
    <h1>Free Online Calculators<br />& Unit Converters</h1>
    <p>Fast, accurate tools — no signup needed</p>
  </div>

  <div class="site-intro">
    <p>ComputeZap offers free online calculators and unit converters for finance, math, cooking, and everyday use. Every tool works instantly in your browser — no downloads, no account required. Whether you need to calculate CD interest, convert liters to gallons, find a sale price, or measure square footage, we have a fast and accurate tool for it.</p>
  </div>

  <!-- FINANCE TOOLS -->
  <h2 class="section-title" id="finance">Finance Calculators</h2>
  <div class="tool-grid">
    <a href="/cd-calculator" class="tool-card">
      <span class="icon">🏦</span>
      <h3>CD Calculator</h3>
      <p>Calculate Certificate of Deposit earnings with compound interest</p>
      <span class="badge">High Yield</span>
    </a>
    <a href="/mortgage-payoff-calculator" class="tool-card">
      <span class="icon">🏠</span>
      <h3>Mortgage Payoff Calculator</h3>
      <p>See how early payments reduce your mortgage term and interest</p>
    </a>
    <a href="/reverse-sales-tax-calculator" class="tool-card">
      <span class="icon">🧾</span>
      <h3>Reverse Sales Tax Calculator</h3>
      <p>Find original price before tax from the final amount paid</p>
      <span class="badge new">Easy</span>
    </a>
    <a href="/debt-snowball-calculator" class="tool-card">
      <span class="icon">❄️</span>
      <h3>Debt Snowball Calculator</h3>
      <p>Pay off debt faster — see payoff order, interest saved, and debt-free date</p>
      <span class="badge new">Popular</span>
    </a>
    <a href="/biweekly-mortgage-calculator" class="tool-card">
      <span class="icon">🏠</span>
      <h3>Biweekly Mortgage Calculator</h3>
      <p>Save years and thousands — see how biweekly payments cut your mortgage short</p>
      <span class="badge new">New</span>
    </a>
  </div>

  <!-- DATE & TIME TOOLS -->
  <h2 class="section-title" id="date-time">Date & Time Tools</h2>
  <div class="tool-grid">
    <a href="/days-from-today" class="tool-card">
      <span class="icon">📅</span>
      <h3>Days From Today Calculator</h3>
      <p>Find the exact date any number of days from today — 30, 60, 90 days and more</p>
      <span class="badge new">Popular</span>
    </a>
    <a href="/30-days-from-today" class="tool-card">
      <span class="icon">🗓️</span>
      <h3>30 Days From Today</h3>
      <p>What date is exactly 30 days from today? Net 30 payment deadline calculator</p>
    </a>
    <a href="/90-days-from-today" class="tool-card">
      <span class="icon">📆</span>
      <h3>90 Days From Today</h3>
      <p>Find the date 90 days (3 months / one quarter) from today's date</p>
    </a>
  </div>

  <!-- MATH CALCULATORS -->
  <h2 class="section-title" id="calculators">Math Calculators</h2>
  <div class="tool-grid">
    <a href="/percent-off-calculator" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>Percent Off Calculator</h3>
      <p>Calculate discounted price — great for shopping deals</p>
      <span class="badge new">Popular</span>
    </a>
    <a href="/20-percent-off-100" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>20% Off $100</h3>
      <p>What is 20% off $100? Sale price is $80 — you save $20</p>
    </a>
    <a href="/30-percent-off-50" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>30% Off $50</h3>
      <p>What is 30% off $50? Sale price is $35 — you save $15</p>
    </a>
    <a href="/50-percent-off-200" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>50% Off $200</h3>
      <p>What is 50% off $200? Sale price is $100 — you save $100</p>
    </a>
    <a href="/25-percent-off-100" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>25% Off $100</h3>
      <p>What is 25% off $100? Sale price is $75 — you save $25</p>
    </a>
    <a href="/10-percent-off-50" class="tool-card">
      <span class="icon">🏷️</span>
      <h3>10% Off $50</h3>
      <p>What is 10% off $50? Sale price is $45 — you save $5</p>
    </a>
    <a href="/pythagorean-theorem-calculator" class="tool-card">
      <span class="icon">📐</span>
      <h3>Pythagorean Theorem Calculator</h3>
      <p>Find any side of a right triangle using a² + b² = c²</p>
    </a>
    <a href="/time-to-decimal-calculator" class="tool-card">
      <span class="icon">⏱️</span>
      <h3>Time to Decimal Calculator</h3>
      <p>Convert hours & minutes to decimal format for timesheets</p>
      <span class="badge new">Fast</span>
    </a>
  </div>

  <!-- UNIT CONVERTERS -->
  <h2 class="section-title" id="converters">Unit Converters</h2>
  <div class="tool-grid">
    <a href="/square-footage-calculator" class="tool-card">
      <span class="icon">📏</span>
      <h3>Square Footage Calculator</h3>
      <p>Calculate area in sq ft for rooms, land, or any space</p>
    </a>
    <a href="/kg-to-lbs" class="tool-card">
      <span class="icon">⚖️</span>
      <h3>kg to lbs Converter</h3>
      <p>Convert kilograms to pounds instantly</p>
    </a>
    <a href="/cm-to-inches" class="tool-card">
      <span class="icon">📐</span>
      <h3>cm to inches Converter</h3>
      <p>Convert centimeters to inches — most searched converter</p>
    </a>
    <a href="/celsius-to-fahrenheit" class="tool-card">
      <span class="icon">🌡️</span>
      <h3>Celsius to Fahrenheit</h3>
      <p>Temperature conversion — °C to °F formula applied instantly</p>
    </a>
    <a href="/knots-to-mph" class="tool-card">
      <span class="icon">🚤</span>
      <h3>Knots to MPH Converter</h3>
      <p>Convert nautical speed — knots to miles per hour</p>
    </a>
    <a href="/oz-to-quarts" class="tool-card">
      <span class="icon">🧃</span>
      <h3>Oz to Quarts Converter</h3>
      <p>Convert fluid ounces to quarts instantly — 1 quart = 32 fl oz</p>
      <span class="badge new">New</span>
    </a>
    <a href="/cups-to-gallons" class="tool-card">
      <span class="icon">🥛</span>
      <h3>Cups to Gallons Converter</h3>
      <p>Kitchen & cooking volume conversion</p>
    </a>
    <a href="/cups-to-tablespoons" class="tool-card">
      <span class="icon">🥄</span>
      <h3>Cups to Tablespoons</h3>
      <p>How many tablespoons in a cup? 1 cup = 16 tbsp — all fractions covered</p>
      <span class="badge new">New</span>
    </a>
    <a href="/liters-to-gallons" class="tool-card">
      <span class="icon">🪣</span>
      <h3>Liters to Gallons</h3>
      <p>Convert liters to US or Imperial gallons instantly. 1 gallon = 3.785 liters</p>
      <span class="badge new">New</span>
    </a>
    <a href="/ounces-in-a-pound" class="tool-card">
      <span class="icon">⚖️</span>
      <h3>Ounces in a Pound</h3>
      <p>How many ounces in a pound? 1 lb = 16 oz — instant lbs to oz converter</p>
      <span class="badge new">New</span>
    </a>
    <a href="/km-to-miles" class="tool-card">
      <span class="icon">🛣️</span>
      <h3>km to Miles</h3>
      <p>Convert kilometers to miles instantly — includes race distance table</p>
      <span class="badge new">New</span>
    </a>
    <a href="/meters-to-feet" class="tool-card">
      <span class="icon">📏</span>
      <h3>Meters to Feet</h3>
      <p>Convert meters to feet and inches — includes height conversion table</p>
      <span class="badge new">New</span>
    </a>
    <a href="/fahrenheit-to-celsius" class="tool-card">
      <span class="icon">🌡️</span>
      <h3>Fahrenheit to Celsius</h3>
      <p>Convert °F to °C instantly — body temp, freezing, boiling and more</p>
      <span class="badge new">New</span>
    </a>
  </div>

  <!-- DATE & TIME TOOLS (add hours in a month) -->
  <h2 class="section-title" id="time">Time Tools</h2>
  <div class="tool-grid">
    <a href="/hours-in-a-month" class="tool-card">
      <span class="icon">🕐</span>
      <h3>Hours in a Month</h3>
      <p>How many hours per month? 730 avg — get exact hours for any month</p>
      <span class="badge new">New</span>
    </a>
  </div>

  <h2 class="section-title">How Our Tools Help You</h2>
  <div class="info-section">
    <div class="info-card">
      <h2>Finance Calculators — Make Smarter Money Decisions</h2>
      <p>Our finance calculators handle the math so you can focus on the decision. The CD calculator computes exact interest earnings using the compound interest formula — enter your principal, APY, and term to see your final balance. The mortgage payoff calculator shows how much interest you save by making extra payments each month. The reverse sales tax calculator works backwards from a receipt total to find the original pre-tax price, which is useful for expense reports, business accounting, and budgeting.</p>
    </div>
    <div class="info-card">
      <h2>Days From Today Calculator — Track Dates & Deadlines</h2>
      <p>Knowing the exact date that falls 30, 60, or 90 days from today matters for contracts, invoices, and project planning. Our days from today calculator works for any number of days — just enter a number and get the future date instantly. Use 30 days from today for net-30 payment terms, 60 days for supplier lead times, and 90 days from today for quarterly reviews and filing deadlines. All calculations account for the correct calendar date including month lengths and leap years.</p>
    </div>
    <div class="info-card">
      <h2>Unit Converters — Cooking, Science & Everyday Measurements</h2>
      <p>Unit conversion should be fast and error-free. Our cups to tablespoons converter covers every fraction — ¼ cup, ⅓ cup, ½ cup, and 1 cup equals exactly 16 tablespoons. The liters to gallons converter supports both US gallons (1 gallon = 3.785 liters) and Imperial UK gallons (1 gallon = 4.546 liters). Whether you are scaling a recipe, converting fuel economy, or working with international measurements, our converters deliver accurate results instantly with no rounding errors.</p>
    </div>
  </div>
</Layout>
