---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Free Online Calculators and Unit Converters",
  "description": "ComputeZap — free online calculators and unit converters for finance, math, cooking, and everyday use. Fast, accurate, no signup needed.",
  "url": "https://computezap.com",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "cm to Inches Converter", "url": "https://computezap.com/cm-to-inches" },
    { "@type": "ListItem", "position": 2, "name": "Debt Snowball Calculator", "url": "https://computezap.com/debt-snowball-calculator" },
    { "@type": "ListItem", "position": 3, "name": "CD Calculator", "url": "https://computezap.com/cd-calculator" },
    { "@type": "ListItem", "position": 4, "name": "Percent Off Calculator", "url": "https://computezap.com/percent-off-calculator" },
    { "@type": "ListItem", "position": 5, "name": "kg to lbs Converter", "url": "https://computezap.com/kg-to-lbs" },
    { "@type": "ListItem", "position": 6, "name": "Days From Today Calculator", "url": "https://computezap.com/days-from-today" },
    { "@type": "ListItem", "position": 7, "name": "Mortgage Payoff Calculator", "url": "https://computezap.com/mortgage-payoff-calculator" },
    { "@type": "ListItem", "position": 8, "name": "Celsius to Fahrenheit", "url": "https://computezap.com/celsius-to-fahrenheit" }
  ]
});
---
<Layout
  title="Free Online Calculators & Unit Converters | ComputeZap"
  description="Free online calculators and unit converters — cm to inches, kg to lbs, percent off, CD calculator, days from today, and more. Fast, accurate, no signup."
  canonical="/"
  schema={schema}
>
<style is:global>
.home-hero{text-align:center;padding:2.5rem 1rem 1.75rem}
.home-hero h1{font-size:2.2rem;font-weight:800;color:#111;line-height:1.2;margin:0 0 .5rem;letter-spacing:-.5px}
.home-hero>.hero-sub{color:#555;font-size:1.05rem;margin:0 0 .4rem}
.hero-tagline{font-size:.85rem;font-weight:700;color:#94a3b8;letter-spacing:.06em;margin:0 0 1.25rem}

.srch-wrap{position:relative;max-width:560px;margin:0 auto .85rem}
.srch-icon{position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1rem;pointer-events:none}
.srch-input{width:100%;padding:.8rem 1rem .8rem 2.75rem;border:2px solid #e2e8f0;border-radius:12px;font-size:1rem;font-family:inherit;color:#111;box-sizing:border-box;background:#fff;transition:border-color .15s;box-shadow:0 2px 8px rgba(0,0,0,.06)}
.srch-input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.1)}

.browse-btn{display:inline-block;margin-bottom:1.1rem;padding:.55rem 1.4rem;background:var(--blue);color:#fff;border-radius:8px;font-size:.88rem;font-weight:700;text-decoration:none;transition:background .15s}
.browse-btn:hover{background:#1d4ed8;text-decoration:none;color:#fff}

.stats-strip{display:flex;justify-content:center;flex-wrap:wrap;gap:.5rem 1.5rem;font-size:.8rem;color:#64748b;font-weight:600}
.stats-strip span{display:flex;align-items:center;gap:.3rem}

.no-res{text-align:center;padding:2rem 1rem;color:#64748b;font-size:.95rem;display:none}
.no-res a{color:var(--blue);font-weight:600}

.pop-card{border-top:3px solid var(--blue) !important}

.sec-head{display:flex;align-items:center;margin:2rem 0 .85rem;gap:.75rem}
.section-title{font-size:.85rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin:0;display:flex;align-items:center;gap:.5rem;flex:1}
.section-title::after{content:'';flex:1;height:1px;background:#e5e7eb}
.sec-viewall{font-size:.78rem;font-weight:700;color:var(--blue);text-decoration:none;white-space:nowrap;flex-shrink:0}
.sec-viewall:hover{text-decoration:underline}

.tool-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:.85rem}
.tool-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.1rem 1.25rem;display:flex;flex-direction:column;gap:.3rem;text-decoration:none;transition:transform .15s,box-shadow .15s,border-color .15s}
.tool-card:hover{transform:translateY(-3px);box-shadow:0 6px 20px rgba(0,0,0,.09);border-color:#bfdbfe;text-decoration:none}
.tool-card .icon{font-size:1.4rem}
.tool-card h3{font-size:.95rem;font-weight:700;color:#111;margin:0}
.tool-card p{font-size:.82rem;color:#64748b;margin:0;line-height:1.5}
.badge{display:inline-block;font-size:.68rem;font-weight:700;padding:.18rem .55rem;border-radius:99px;margin-top:.2rem;background:#fef3c7;color:#92400e;width:fit-content}
.badge.new{background:#dcfce7;color:#166534}
.badge.hot{background:#fee2e2;color:#991b1b}
.see-all{font-size:.72rem;font-weight:700;color:var(--blue);margin-top:.1rem}

.info-section{display:flex;flex-direction:column;gap:1rem;margin-bottom:2rem}
.info-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.25rem 1.5rem}
.info-card h2{font-size:1rem;font-weight:700;margin:0 0 .5rem}
.info-card p{color:#555;font-size:.88rem;line-height:1.75;margin:0}

@media(max-width:600px){.home-hero h1{font-size:1.7rem}.stats-strip{gap:.4rem 1rem}.tool-grid{grid-template-columns:1fr 1fr}}
@media(max-width:400px){.tool-grid{grid-template-columns:1fr}}
</style>

<!-- HERO + SEARCH -->
<div class="home-hero">
