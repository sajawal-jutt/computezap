<script is:inline>
(function () {
  var input = document.getElementById('tool-search');
  var noRes = document.getElementById('no-res');

  input.addEventListener('input', function () {
    var q = this.value.toLowerCase().trim();
    var cards = document.querySelectorAll('.tool-card, .browse-card');
    var totalVisible = 0;

    cards.forEach(function (card) {
      var text = (card.textContent || '').toLowerCase();
      var show = !q || text.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) totalVisible++;
    });

    document.querySelectorAll('.section-title').forEach(function (title) {
      var next = title.nextElementSibling;
      if (next && next.classList.contains('tool-grid')) {
        var vis = Array.from(next.querySelectorAll('.tool-card, .browse-card')).some(function (c) {
          return c.style.display !== 'none';
        });
        title.style.display = vis ? '' : 'none';
        next.style.display = vis ? '' : 'none';
      }
    });

    noRes.style.display = (q && totalVisible === 0) ? 'block' : 'none';
  });
})();
</script>

