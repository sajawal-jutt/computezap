<script is:inline>
(function () {
  /* see-all links — navigate to browse page without triggering card link */
  document.querySelectorAll('.see-all[data-href]').forEach(function (el) {
    el.style.cursor = 'pointer';
    el.addEventListener('click', function (e) {
      e.preventDefault();
      e.stopPropagation();
      window.location.href = el.getAttribute('data-href');
    });
  });

  /* search */
  var input = document.getElementById('tool-search');
  var noRes = document.getElementById('no-res');

  input.addEventListener('input', function () {
    var q = this.value.toLowerCase().trim();
    var cards = document.querySelectorAll('.tool-card');
    var totalVisible = 0;

    cards.forEach(function (card) {
      var text = (card.textContent || '').toLowerCase();
      var show = !q || text.includes(q);
      card.style.display = show ? '' : 'none';
      if (show) totalVisible++;
    });

    /* hide/show sec-head + tool-grid pairs */
    document.querySelectorAll('.sec-head').forEach(function (head) {
      var grid = head.nextElementSibling;
      if (grid && grid.classList.contains('tool-grid')) {
        var vis = Array.from(grid.querySelectorAll('.tool-card')).some(function (c) {
          return c.style.display !== 'none';
        });
        head.style.display = vis ? '' : 'none';
        grid.style.display = vis ? '' : 'none';
      }
    });

    noRes.style.display = (q && totalVisible === 0) ? 'block' : 'none';
  });
})();
</script>

