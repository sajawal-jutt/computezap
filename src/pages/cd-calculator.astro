---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "CD Calculator",
    "url": "https://computezap.com/cd-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Free CD calculator. Calculate Certificate of Deposit earnings with compound interest. See maturity value, interest earned, and growth chart instantly.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "CD Calculator", "item": "https://computezap.com/cd-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate CD interest?",
        "acceptedAnswer": { "@type": "Answer", "text": "Use the compound interest formula: A = P(1 + r/n)^(nt), where P is the principal, r is the annual rate, n is compounding frequency per year, and t is time in years. Our CD calculator does this automatically." }
      },
      {
        "@type": "Question",
        "name": "What is a good CD interest rate in 2026?",
        "acceptedAnswer": { "@type": "Answer", "text": "In 2026, competitive CD rates range from 4.5% to 5.5% APY for 12-month CDs at online banks. The national average is around 0.61% APY. Always compare APY, not just the stated rate." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between APY and APR on a CD?",
        "acceptedAnswer": { "@type": "Answer", "text": "APY (Annual Percentage Yield) includes the effect of compounding, so it reflects your actual annual return. APR does not account for compounding. CDs are always quoted in APY." }
      },
      {
        "@type": "Question",
        "name": "Can I add money to a CD after opening it?",
        "acceptedAnswer": { "@type": "Answer", "text": "Standard CDs do not allow additional deposits after opening. However, some banks offer add-on CDs that permit additional deposits during the term. Check with your specific bank." }
      },
      {
        "@type": "Question",
        "name": "What happens if I withdraw from a CD early?",
        "acceptedAnswer": { "@type": "Answer", "text": "Early withdrawal from a CD triggers a penalty — typically 3 to 6 months of interest for short-term CDs, and up to 12 months of interest for longer terms. This can eat into your principal if you haven't earned enough interest yet." }
      }
    ]
  }
]);
---
<Layout
  title="CD Calculator — Certificate of Deposit Interest Calculator | ComputeZap"
  description="Free CD calculator. Calculate Certificate of Deposit earnings with compound interest — daily, monthly, or quarterly. See maturity value, interest earned, and a growth chart instantly."
  canonical="/cd-calculator"
  schema={schema}
>
<style is:global>
.hero { text-align:center; padding:2rem 1rem 1.25rem; }
.hero h1 { font-size:2rem; color:#111; margin:.5rem 0 .35rem; font-weight:800; }
.hero-sub { color:#555; margin:0; font-size:1rem; }
.breadcrumb { font-size:.85rem; color:#888; margin-bottom:.75rem; }
.breadcrumb a { color:var(--blue); text-decoration:none; }

.calc-wrap { display:grid; grid-template-columns:360px 1fr; gap:1.5rem; max-width:1100px; margin:0 auto; padding:0 1rem 3rem; align-items:start; }
.calc-left { position:sticky; top:1rem; }
.card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem; margin-bottom:1rem; }
.card:last-child { margin-bottom:0; }

.result-box { background:var(--blue); border-radius:14px; padding:1.75rem 1.5rem; text-align:center; margin-bottom:1.25rem; box-shadow:0 4px 20px rgba(37,99,235,.18); }
.res-lbl { font-size:.72rem; color:rgba(255,255,255,.7); text-transform:uppercase; letter-spacing:.09em; margin-bottom:.5rem; }
.res-val { font-size:2.1rem; font-weight:800; color:#fff; line-height:1.2; }
.res-sub { font-size:.95rem; color:rgba(255,255,255,.8); margin-top:.3rem; }

.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; margin-bottom:1rem; }
.stat-item { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:.9rem .75rem; text-align:center; }
.stat-lbl { display:block; font-size:.68rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.3rem; font-weight:600; }
.stat-val { display:block; font-size:1.1rem; font-weight:800; color:#1e293b; }
.stat-val.green { color:#16a34a; }

.fld-lbl { display:block; font-size:.8rem; font-weight:700; color:#374151; margin-bottom:.4rem; text-transform:uppercase; letter-spacing:.04em; }
.fld-wrap { position:relative; margin-bottom:1rem; }
.fld-pfx { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600; pointer-events:none; }
.fld-sfx { position:absolute; right:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600; pointer-events:none; }
.txt-input { width:100%; font-size:1rem; padding:.65rem 1rem; border:1.5px solid #e2e8f0; border-radius:8px; color:#111; box-sizing:border-box; font-family:inherit; background:#fff; appearance:none; }
.txt-input:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(37,99,235,.1); }
.txt-pfx { padding-left:1.75rem; }
.txt-sfx { padding-right:2rem; }
.term-row { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; }

/* Chart */
.chart-box { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:.75rem; margin-bottom:1rem; }
.chart-title { font-size:.72rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; }
canvas#growth-chart { width:100%; height:130px; display:block; }

/* Comparison */
.cmp-row { display:flex; align-items:center; justify-content:space-between; font-size:.82rem; color:#444; margin-bottom:.3rem; }
.cmp-dot { width:8px; height:8px; border-radius:50%; display:inline-block; margin-right:.4rem; flex-shrink:0; }
.cmp-bar-wrap { height:5px; background:#e2e8f0; border-radius:99px; margin-bottom:.6rem; overflow:hidden; }
.cmp-bar { height:100%; border-radius:99px; transition:width .4s; }

.card h2 { font-size:1.1rem; font-weight:700; color:#111; margin:0 0 .8rem; }
.card h3 { font-size:.95rem; font-weight:700; color:#111; margin:0 0 .4rem; }
.card p { color:#444; line-height:1.75; font-size:.95rem; margin:0 0 .7rem; }
.card p:last-child { margin-bottom:0; }
.card ul { color:#444; line-height:1.85; font-size:.95rem; padding-left:1.25rem; margin:0 0 .7rem; }
.card ol { color:#444; line-height:1.85; font-size:.95rem; padding-left:1.25rem; margin:0 0 .7rem; }
.formula-box { background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px; padding:.75rem 1rem; font-family:monospace; font-size:.88rem; color:#1e293b; margin:.6rem 0; }
.tip-box { display:flex; gap:.75rem; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px; padding:.9rem 1rem; margin:.75rem 0; }
.tip-icon { font-size:1.1rem; flex-shrink:0; margin-top:.1rem; }
.tip-box p { margin:0; font-size:.875rem; color:#1e40af; }

.rates-table { width:100%; border-collapse:collapse; font-size:.875rem; margin-top:.5rem; }
.rates-table th { background:#f8fafc; padding:.45rem .75rem; text-align:left; font-size:.72rem; color:#64748b; font-weight:700; text-transform:uppercase; letter-spacing:.04em; border-bottom:1px solid #e5e7eb; }
.rates-table td { padding:.45rem .75rem; border-bottom:1px solid #f3f4f6; color:#444; }
.rates-table tr:last-child td { border-bottom:none; }
.rates-table .acc { color:var(--blue); font-weight:700; }
.rates-table tr:hover td { background:#f8fafc; cursor:pointer; }

.faq-item { border-bottom:1px solid #f3f4f6; padding:.85rem 0; }
.faq-item:last-child { border-bottom:none; padding-bottom:0; }
.faq-item h3 { font-size:.92rem; color:#111; margin:0 0 .35rem; font-weight:600; }
.faq-item p { color:#555; font-size:.875rem; margin:0; line-height:1.65; }

.next-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:.75rem; }
.next-card { background:#fff; border:1px solid #e5e7eb; border-radius:10px; padding:1rem; border-top:3px solid var(--blue); text-decoration:none; display:block; transition:box-shadow .15s; }
.next-card:hover { box-shadow:0 4px 12px rgba(0,0,0,.08); }
.next-tag { font-size:.68rem; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:var(--blue); margin-bottom:.3rem; display:block; }
.next-card h3 { font-size:.88rem; font-weight:700; color:#111; margin:0 0 .25rem; }
.next-card p { font-size:.78rem; color:#64748b; margin:0; line-height:1.5; }

@media (max-width:768px) {
  .calc-wrap { grid-template-columns:1fr; }
  .calc-left { position:static; }
  .next-grid { grid-template-columns:1fr; }
  .hero h1 { font-size:1.65rem; }
  .res-val { font-size:1.6rem; }
}
</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › CD Calculator</nav>
  <h1>CD Calculator</h1>
  <p class="hero-sub">Calculate Certificate of Deposit earnings with compound interest</p>
</div>

<div class="calc-wrap">
  <!-- LEFT: Inputs + Result -->
  <div class="calc-left">
    <div class="card">
      <label class="fld-lbl" for="principal">Initial Deposit</label>
      <div class="fld-wrap">
        <span class="fld-pfx">$</span>
