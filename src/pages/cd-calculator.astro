      </div>

      <label class="fld-lbl" for="rate">Annual Percentage Yield (APY)</label>
      <div class="fld-wrap">
        <input type="number" id="rate" class="txt-input txt-sfx" value="5.00" min="0" max="30" step="0.01" oninput="calcCD()" />
        <span class="fld-sfx">%</span>
      </div>

      <label class="fld-lbl">Term</label>
      <div class="term-row" style="margin-bottom:1rem;">
        <input type="number" id="term" class="txt-input" value="12" min="1" oninput="calcCD()" />
        <select id="term-unit" class="txt-input" onchange="calcCD()">
          <option value="months" selected>Months</option>
          <option value="years">Years</option>
        </select>
      </div>

      <label class="fld-lbl" for="compound">Compounding Frequency</label>
      <div class="fld-wrap" style="margin-bottom:0">
        <select id="compound" class="txt-input" onchange="calcCD()">
          <option value="365">Daily</option>
          <option value="12" selected>Monthly</option>
          <option value="4">Quarterly</option>
          <option value="2">Semi-Annually</option>
          <option value="1">Annually</option>
        </select>
      </div>
    </div>

    <div class="card">
      <div class="result-box">
        <div class="res-lbl">Total at Maturity</div>
        <div class="res-val">$<span id="r-maturity">10,512.67</span></div>
        <div class="res-sub">Interest earned: $<span id="r-interest-sub">512.67</span></div>
      </div>

      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-lbl">Interest Earned</span>
          <span class="stat-val green" id="r-interest">$512.67</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl">Effective APY</span>
          <span class="stat-val" id="r-apy">5.116%</span>
        </div>
