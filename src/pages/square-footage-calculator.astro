---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Square Footage Calculator",
    "url": "https://computezap.com/square-footage-calculator",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "description": "Free square footage calculator. Calculate area in square feet for rooms, floors, walls, and land. Supports rectangle, triangle, circle, and L-shaped rooms with instant unit conversion.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Square Footage Calculator", "item": "https://computezap.com/square-footage-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I calculate square footage of a room?", "acceptedAnswer": { "@type": "Answer", "text": "Measure the length and width of the room in feet, then multiply them together. Formula: Square Footage = Length (ft) × Width (ft). For a 12 ft × 10 ft room, the square footage is 120 sq ft." } },
      { "@type": "Question", "name": "How many square feet is a 12x12 room?", "acceptedAnswer": { "@type": "Answer", "text": "A 12x12 room is 144 square feet. Calculation: 12 feet × 12 feet = 144 square feet." } },
      { "@type": "Question", "name": "How do I convert square feet to square meters?", "acceptedAnswer": { "@type": "Answer", "text": "To convert square feet to square meters, multiply by 0.0929. For example, 300 sq ft × 0.0929 = 27.87 square meters. Our calculator automatically shows the conversion." } },
      { "@type": "Question", "name": "How much flooring do I need for a room?", "acceptedAnswer": { "@type": "Answer", "text": "Calculate the square footage of the room, then add 10% for waste and cuts. For example, a 200 sq ft room needs approximately 220 sq ft of flooring material." } },
      { "@type": "Question", "name": "How many square feet are in an acre?", "acceptedAnswer": { "@type": "Answer", "text": "There are 43,560 square feet in 1 acre. To convert acres to square feet, multiply by 43,560. For example, 0.5 acres = 21,780 sq ft." } },
      { "@type": "Question", "name": "How many square feet is a 10x10 room?", "acceptedAnswer": { "@type": "Answer", "text": "A 10x10 room is 100 square feet. Calculation: 10 ft × 10 ft = 100 sq ft. This is a typical small bedroom or large bathroom size." } }
    ]
  }
]);
---
<Layout
  title="Square Footage Calculator — Calculate Sq Ft Free | ComputeZap"
  description="Free square footage calculator. Instantly calculate room area in sq ft, sq meters, and sq yards. Supports rectangle, triangle, circle, and L-shaped rooms."
  canonical="/square-footage-calculator"
  schema={schema}
>
<style is:global>
.canvas-box{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.75rem;text-align:center;margin-top:1rem}
canvas#shape-canvas{max-width:100%;display:block;margin:0 auto}
.uses-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.use-item{background:#f8fafc;border-radius:8px;padding:.75rem}
.use-icon{font-size:1.1rem;margin-bottom:.25rem}
.use-lbl{font-size:.85rem;font-weight:700;color:#111;display:block}
.use-desc{font-size:.78rem;color:#64748b;margin-top:.1rem}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › Square Footage Calculator</nav>
  <h1>Square Footage Calculator</h1>
  <p>Calculate room area in sq ft, sq meters, and sq yards</p>
</div>

<div class="calc-center">
  <div class="card">

    <span class="preset-lbl">Shape</span>
    <div class="mode-wrap">
      <button class="mode-btn active" id="tab-rect" onclick="setShape('rect')">Rectangle</button>
      <button class="mode-btn" id="tab-tri" onclick="setShape('tri')">Triangle</button>
      <button class="mode-btn" id="tab-circle" onclick="setShape('circle')">Circle</button>
      <button class="mode-btn" id="tab-lshape" onclick="setShape('lshape')">L-Shape</button>
    </div>

    <!-- Rectangle -->
    <div id="inp-rect">
      <div class="input-group">
        <label for="rect-l">Length</label>
        <div class="input-wrap">
          <input type="number" id="rect-l" value="20" min="0" step="0.1" oninput="calcSF()" />
          <span class="input-sfx">ft</span>
        </div>
      </div>
      <div class="input-group">
        <label for="rect-w">Width</label>
        <div class="input-wrap">
          <input type="number" id="rect-w" value="15" min="0" step="0.1" oninput="calcSF()" />
          <span class="input-sfx">ft</span>
        </div>
      </div>
    </div>

    <!-- Triangle -->
    <div id="inp-tri" style="display:none">
      <div class="input-group">
        <label for="tri-b">Base</label>
        <div class="input-wrap">
          <input type="number" id="tri-b" value="20" min="0" step="0.1" oninput="calcSF()" />
          <span class="input-sfx">ft</span>
        </div>
      </div>
      <div class="input-group">
        <label for="tri-h">Height</label>
        <div class="input-wrap">
          <input type="number" id="tri-h" value="10" min="0" step="0.1" oninput="calcSF()" />
          <span class="input-sfx">ft</span>
        </div>
      </div>
    </div>

    <!-- Circle -->
    <div id="inp-circle" style="display:none">
      <div class="input-group">
        <label for="circ-r">Radius</label>
        <div class="input-wrap">
          <input type="number" id="circ-r" value="10" min="0" step="0.1" oninput="calcSF()" />
          <span class="input-sfx">ft</span>
        </div>
      </div>
    </div>

    <!-- L-Shape -->
    <div id="inp-lshape" style="display:none">
      <div class="input-group">
        <label>Rectangle A — Length × Width</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
          <div class="input-wrap">
            <input type="number" id="la" value="20" min="0" step="0.1" oninput="calcSF()" />
            <span class="input-sfx">ft</span>
          </div>
          <div class="input-wrap">
            <input type="number" id="wa" value="10" min="0" step="0.1" oninput="calcSF()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
      </div>
      <div class="input-group">
        <label>Rectangle B — Length × Width</label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.5rem">
          <div class="input-wrap">
            <input type="number" id="lb" value="15" min="0" step="0.1" oninput="calcSF()" />
            <span class="input-sfx">ft</span>
          </div>
          <div class="input-wrap">
            <input type="number" id="wb" value="8" min="0" step="0.1" oninput="calcSF()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
      </div>
    </div>

    <div class="result-hero">
      <div class="r-label">Total Area</div>
      <div class="r-value"><span id="r-sqft">300.00</span> ft²</div>
      <div class="r-sub" id="r-sub-line">20 × 15 ft rectangle</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Sq Feet</span><span class="stat-val"><span id="r-sqft2">300.00</span> ft²</span></div>
      <div class="stat-box"><span class="stat-lbl">Sq Meters</span><span class="stat-val" id="r-sqm">27.87 m²</span></div>
      <div class="stat-box"><span class="stat-lbl">Sq Yards</span><span class="stat-val" id="r-sqyd">33.33 yd²</span></div>
      <div class="stat-box"><span class="stat-lbl">Sq Inches</span><span class="stat-val" id="r-sqin">43,200 in²</span></div>
    </div>

    <div class="canvas-box">
      <canvas id="shape-canvas" width="300" height="130"></canvas>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Measure Square Footage</h2>
    <p>Use a tape measure to find the length and width of the room in feet. Measure from wall to wall at the widest points. Multiply length × width for the area in square feet.</p>
    <div class="tip-box">
      <span class="tip-icon">📏</span>
      <p><strong>Flooring tip:</strong> Always add 10% extra to your square footage for cuts, waste, and pattern matching. For a 300 sq ft room, order 330 sq ft of flooring.</p>
    </div>
    <p>For irregular rooms, break the space into rectangles and add the areas together — use <strong>L-Shape mode</strong> above for rooms with one corner cutout.</p>
  </div>

  <div class="card">
    <h2>Formulas by Shape</h2>
    <div class="formula-box">Rectangle: Area = Length × Width</div>
    <div class="formula-box">Triangle: Area = ½ × Base × Height</div>
    <div class="formula-box">Circle: Area = π × Radius² (π ≈ 3.14159)</div>
    <div class="formula-box">L-Shape: Area = Rectangle A + Rectangle B</div>
  </div>

  <div class="card">
    <h2>Common Room Sizes</h2>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>Room Type</th><th>Typical Size</th><th>Square Footage</th></tr></thead>
        <tbody>
          {[
            ['Small Bedroom','10×10 ft','100 ft²'],
            ['Standard Bedroom','12×12 ft','144 ft²'],
            ['Master Bedroom','14×16 ft','224 ft²'],
            ['Living Room','15×18 ft','270 ft²'],
            ['Large Living Room','20×20 ft','400 ft²'],
            ['Kitchen','10×12 ft','120 ft²'],
            ['Bathroom','5×8 ft','40 ft²'],
            ['Garage (1-car)','12×20 ft','240 ft²'],
            ['Garage (2-car)','20×22 ft','440 ft²'],
          ].map(([room, size, sqft]) => (
            <tr><td>{room}</td><td>{size}</td><td style="color:var(--blue);font-weight:700">{sqft}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Unit Conversions</h2>
    <div style="overflow-x:auto">
      <table class="payoff-table">
        <thead><tr><th>From</th><th>To</th><th>Multiply By</th></tr></thead>
        <tbody>
          <tr><td>Square feet (ft²)</td><td>Square meters (m²)</td><td style="color:var(--blue);font-weight:700">× 0.0929</td></tr>
          <tr><td>Square feet (ft²)</td><td>Square yards (yd²)</td><td style="color:var(--blue);font-weight:700">÷ 9</td></tr>
          <tr><td>Square feet (ft²)</td><td>Square inches (in²)</td><td style="color:var(--blue);font-weight:700">× 144</td></tr>
          <tr><td>Square feet (ft²)</td><td>Acres</td><td style="color:var(--blue);font-weight:700">÷ 43,560</td></tr>
          <tr><td>Square meters (m²)</td><td>Square feet (ft²)</td><td style="color:var(--blue);font-weight:700">× 10.764</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>What Can You Calculate?</h2>
    <div class="uses-grid">
      <div class="use-item"><span class="use-icon">🪵</span><span class="use-lbl">Flooring</span><span class="use-desc">Hardwood, tile, or carpet</span></div>
      <div class="use-item"><span class="use-icon">🎨</span><span class="use-lbl">Painting</span><span class="use-desc">1 gallon ≈ 350 sq ft wall</span></div>
      <div class="use-item"><span class="use-icon">🏡</span><span class="use-lbl">Real Estate</span><span class="use-desc">Compare home sizes</span></div>
      <div class="use-item"><span class="use-icon">☀️</span><span class="use-lbl">Solar Panels</span><span class="use-desc">Roof coverage planning</span></div>
      <div class="use-item"><span class="use-icon">🌱</span><span class="use-lbl">Garden / Lawn</span><span class="use-desc">Fertilizer & grass seed</span></div>
      <div class="use-item"><span class="use-icon">📦</span><span class="use-lbl">Storage</span><span class="use-desc">Furniture layout planning</span></div>
    </div>
  </div>

  <div class="card">
    <h2>Common Square Footage Mistakes to Avoid</h2>
    <ul>
      <li><strong>Not adding 10% waste factor</strong> — always order 10–15% extra flooring for cuts, mistakes, and future repairs.</li>
      <li><strong>Mixing inches and feet</strong> — a room that is 12 feet 6 inches wide is 12.5 feet, NOT 12.6. Convert: inches ÷ 12.</li>
      <li><strong>Measuring to the wrong point</strong> — for flooring, measure wall to wall at the widest point.</li>
      <li><strong>Forgetting odd-shaped rooms</strong> — break L-shaped or irregular rooms into rectangles, calculate each separately, then add.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many square feet is a 12×12 room?</h3>
      <p>A 12×12 room is <strong>144 square feet</strong>. Calculation: 12 ft × 12 ft = 144 ft².</p>
    </div>
    <div class="faq-item">
      <h3>How much flooring do I need for a 300 sq ft room?</h3>
      <p>Buy approximately <strong>330 sq ft</strong> of flooring (300 × 1.10). Always add 10% for waste, cuts, and future repairs.</p>
    </div>
    <div class="faq-item">
      <h3>How do I convert square feet to square meters?</h3>
      <p>Multiply by 0.0929. Example: 300 ft² × 0.0929 = <strong>27.87 m²</strong>. The calculator shows this automatically.</p>
    </div>
    <div class="faq-item">
      <h3>How many square feet are in an acre?</h3>
      <p>There are <strong>43,560 square feet</strong> in 1 acre. An acre is roughly the size of a football field without the end zones.</p>
    </div>
    <div class="faq-item">
      <h3>How many square feet is a 10×10 room?</h3>
      <p>A 10×10 room is <strong>100 square feet</strong>. Typical small bedroom or large bathroom size.</p>
    </div>
    <div class="faq-item">
      <h3>How do I calculate square footage from inches?</h3>
      <p>Multiply length × width in inches to get square inches, then divide by 144. Formula: sq ft = (in × in) ÷ 144. Or enter measurements in decimal feet (6 inches = 0.5 ft).</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/pythagorean-theorem-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Pythagorean Theorem</h3>
        <p>Find diagonal measurements for rooms and layouts.</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off</h3>
        <p>Calculate material cost savings during sales.</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Convert</span>
        <h3>cm to Inches</h3>
        <p>Convert metric measurements for US flooring.</p>
      </a>
      <a href="/decimal-to-fraction" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Decimal to Fraction</h3>
        <p>Convert measurements like 0.5 ft to 1/2 foot.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Plan project completion dates from today.</p>
      </a>
      <a href="/liters-to-gallons" class="next-card">
        <span class="next-tag">Convert</span>
        <h3>Liters to Gallons</h3>
        <p>Convert paint coverage from liters to gallons.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var currentShape = 'rect';

function setShape(s) {
  currentShape = s;
  ['rect','tri','circle','lshape'].forEach(function(id) {
    document.getElementById('inp-' + id).style.display = id === s ? 'block' : 'none';
    var tab = document.getElementById('tab-' + id);
    if (tab) tab.classList.toggle('active', id === s);
  });
  calcSF();
}

function fmt(v, dec) { return v.toLocaleString('en-US', { minimumFractionDigits: dec||2, maximumFractionDigits: dec||2 }); }

function calcSF() {
  var sqft = 0;
  var subLine = '';
  if (currentShape === 'rect') {
    var l = parseFloat(document.getElementById('rect-l').value) || 0;
    var w = parseFloat(document.getElementById('rect-w').value) || 0;
    sqft = l * w;
    subLine = l + ' × ' + w + ' ft rectangle';
  } else if (currentShape === 'tri') {
    var b = parseFloat(document.getElementById('tri-b').value) || 0;
    var h = parseFloat(document.getElementById('tri-h').value) || 0;
    sqft = 0.5 * b * h;
    subLine = 'Triangle: ½ × ' + b + ' × ' + h;
  } else if (currentShape === 'circle') {
    var r = parseFloat(document.getElementById('circ-r').value) || 0;
    sqft = Math.PI * r * r;
    subLine = 'Circle: r = ' + r + ' ft';
  } else if (currentShape === 'lshape') {
    var la = parseFloat(document.getElementById('la').value) || 0;
    var wa = parseFloat(document.getElementById('wa').value) || 0;
    var lb = parseFloat(document.getElementById('lb').value) || 0;
    var wb = parseFloat(document.getElementById('wb').value) || 0;
    sqft = la * wa + lb * wb;
    subLine = 'L-Shape: A + B combined';
  }

  document.getElementById('r-sqft').textContent  = fmt(sqft);
  document.getElementById('r-sqft2').textContent = fmt(sqft);
  document.getElementById('r-sqm').textContent   = fmt(sqft * 0.0929) + ' m²';
  document.getElementById('r-sqyd').textContent  = fmt(sqft / 9) + ' yd²';
  document.getElementById('r-sqin').textContent  = Math.round(sqft * 144).toLocaleString() + ' in²';
  document.getElementById('r-sub-line').textContent = subLine;

  drawShape(sqft);
}

function drawShape(sqft) {
  var canvas = document.getElementById('shape-canvas');
  if (!canvas) return;
  var ctx = canvas.getContext('2d');
  var W = canvas.offsetWidth || 300;
  var H = 130;
  canvas.width = W; canvas.height = H;
  ctx.clearRect(0, 0, W, H);

  ctx.fillStyle = 'rgba(37,99,235,0.08)';
  ctx.strokeStyle = '#2563eb';
  ctx.lineWidth = 2;
  var pad = 24;

  if (currentShape === 'rect') {
    var l = parseFloat(document.getElementById('rect-l').value) || 1;
    var w = parseFloat(document.getElementById('rect-w').value) || 1;
    var ratio = Math.min((W-pad*2) / l, (H-pad*2) / w);
    var rw = l * ratio, rh = w * ratio;
    var x = (W - rw) / 2, y = (H - rh) / 2;
    ctx.fillRect(x, y, rw, rh); ctx.strokeRect(x, y, rw, rh);
    ctx.fillStyle = '#2563eb'; ctx.font = 'bold 11px system-ui'; ctx.textAlign = 'center';
    ctx.fillText(l + ' ft', W/2, y - 6);
    ctx.save(); ctx.translate(x - 10, H/2); ctx.rotate(-Math.PI/2);
    ctx.fillText(w + ' ft', 0, 0); ctx.restore();
  } else if (currentShape === 'tri') {
    var b2 = parseFloat(document.getElementById('tri-b').value) || 1;
    var h2 = parseFloat(document.getElementById('tri-h').value) || 1;
    var ratio2 = Math.min((W-pad*2) / b2, (H-pad*2) / h2);
    var bw = b2 * ratio2, bh = h2 * ratio2;
    var bx = (W - bw) / 2, by = (H - bh) / 2;
    ctx.beginPath();
    ctx.moveTo(bx + bw/2, by); ctx.lineTo(bx + bw, by + bh); ctx.lineTo(bx, by + bh);
    ctx.closePath(); ctx.fill(); ctx.stroke();
  } else if (currentShape === 'circle') {
    var cr = Math.min((W-pad*2)/2, (H-pad*2)/2);
    ctx.beginPath(); ctx.arc(W/2, H/2, cr, 0, Math.PI*2);
    ctx.fill(); ctx.stroke();
    ctx.fillStyle = '#2563eb'; ctx.font = 'bold 11px system-ui'; ctx.textAlign = 'center';
    ctx.fillText('r = ' + (parseFloat(document.getElementById('circ-r').value)||0) + ' ft', W/2, H/2 + 4);
  } else {
    ctx.fillStyle = 'rgba(37,99,235,0.08)';
    ctx.fillRect(40, 20, 60, 50); ctx.strokeRect(40, 20, 60, 50);
    ctx.fillRect(40, 70, 40, 35); ctx.strokeRect(40, 70, 40, 35);
    ctx.fillStyle = '#2563eb'; ctx.font = '10px system-ui'; ctx.textAlign = 'center';
    ctx.fillText('A', 70, 48); ctx.fillText('B', 60, 90);
  }

  ctx.fillStyle = '#64748b'; ctx.font = '11px system-ui'; ctx.textAlign = 'center';
  ctx.fillText(fmt(sqft) + ' ft²', W/2, H - 4);
}

window.addEventListener('load', calcSF);
</script>
</Layout>
