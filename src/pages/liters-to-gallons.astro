<script is:inline>
(function () {
  var mode = 'ltg';
  var galType = 'us';
  var US_FACTOR = 3.78541;
  var IMP_FACTOR = 4.54609;

  function getFactor() {
    return galType === 'us' ? US_FACTOR : IMP_FACTOR;
  }

  function doConvert() {
    var raw = parseFloat(document.getElementById('amount').value);
    var val = isNaN(raw) || raw < 0 ? 0 : raw;
    var factor = getFactor();
    var liters, gallons;

    if (mode === 'ltg') {
      liters = val;
      gallons = val / factor;
    } else {
      gallons = val;
      liters = val * factor;
    }

    var galLabel = galType === 'us' ? 'US Gallons' : 'Imperial Gallons';
    var galAbbr  = galType === 'us' ? 'gal (US)' : 'gal (imp)';

    // Result box
    if (mode === 'ltg') {
      document.getElementById('res-label').textContent = '= ' + galLabel;
      document.getElementById('res-main').textContent = fmt(gallons, 4) + ' gal';
      document.getElementById('res-sub').textContent = fmt(liters, 4) + ' L';
    } else {
      document.getElementById('res-label').textContent = '= Liters';
      document.getElementById('res-main').textContent = fmt(liters, 4) + ' L';
      document.getElementById('res-sub').textContent = fmt(gallons, 4) + ' ' + galAbbr;
    }

    // Primary stat
    document.getElementById('sp-label').textContent = 'Gallons (' + (galType === 'us' ? 'US' : 'Imperial') + ')';
    document.getElementById('sp-val').textContent = fmt(gallons, 4);

    // Secondary stats (US liquid units from liters)
    document.getElementById('stat-qt').textContent   = fmt(liters * 1.05669, 3);
    document.getElementById('stat-pt').textContent   = fmt(liters * 2.11338, 3);
    document.getElementById('stat-floz').textContent = fmt(liters * 33.8140, 2);
    document.getElementById('stat-ml').textContent   = fmt(liters * 1000, 0);
  }

  function fmt(n, dec) {
    if (n === 0) return '0';
    return n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: dec });
  }

  function setMode(m) {
    mode = m;
    document.getElementById('btn-ltg').classList.toggle('active', m === 'ltg');
    document.getElementById('btn-gtl').classList.toggle('active', m === 'gtl');

    if (m === 'ltg') {
      document.getElementById('input-label').textContent = 'Liters (L)';
      document.getElementById('input-unit').textContent = 'L';
    } else {
      var g = galType === 'us' ? 'Gallons (US)' : 'Gallons (Imperial)';
      document.getElementById('input-label').textContent = g;
      document.getElementById('input-unit').textContent = 'gal';
    }
    doConvert();
  }

  function setGalType(t) {
    galType = t;
    document.getElementById('btn-us').classList.toggle('active', t === 'us');
    document.getElementById('btn-imp').classList.toggle('active', t === 'imperial');
    if (mode === 'gtl') {
      var g = t === 'us' ? 'Gallons (US)' : 'Gallons (Imperial)';
      document.getElementById('input-label').textContent = g;
    }
    doConvert();
  }

  function setVal(v) {
    document.getElementById('amount').value = v;
    doConvert();
  }

  // Expose to onclick
  window.doConvert = doConvert;
  window.setMode   = setMode;
  window.setGalType = setGalType;
  window.setVal    = setVal;

  window.addEventListener('load', doConvert);
})();
</script>

