---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Liters to Gallons Converter",
    "url": "https://computezap.com/liters-to-gallons",
    "description": "Convert liters to gallons instantly. 1 US gallon = 3.785 liters. Free converter supporting US and Imperial gallons.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Any",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Liters to Gallons", "item": "https://computezap.com/liters-to-gallons" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many liters are in a gallon?",
        "acceptedAnswer": { "@type": "Answer", "text": "1 US gallon = 3.785 liters. 1 Imperial (UK) gallon = 4.546 liters. The Imperial gallon is about 20% larger than the US gallon." }
      },
      {
        "@type": "Question",
        "name": "How many liters in a half gallon?",
        "acceptedAnswer": { "@type": "Answer", "text": "A half US gallon = 1.893 liters. A half Imperial gallon = 2.273 liters." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is 5 liters?",
        "acceptedAnswer": { "@type": "Answer", "text": "5 liters = 1.321 US gallons, or 1.100 Imperial gallons." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is 10 liters?",
        "acceptedAnswer": { "@type": "Answer", "text": "10 liters = 2.642 US gallons, or 2.200 Imperial gallons." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is 2 liters?",
        "acceptedAnswer": { "@type": "Answer", "text": "2 liters = 0.528 US gallons. A standard 2-liter soda bottle is about half a US gallon." }
      },
      {
        "@type": "Question",
        "name": "How do you convert liters to gallons?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert liters to US gallons, divide by 3.78541. Formula: gallons = liters ÷ 3.78541. Example: 10 liters ÷ 3.785 = 2.642 US gallons." }
      },
      {
        "@type": "Question",
        "name": "What is the difference between US and Imperial gallons?",
        "acceptedAnswer": { "@type": "Answer", "text": "A US gallon = 3.785 liters (128 fl oz). A UK Imperial gallon = 4.546 liters (160 fl oz). The Imperial gallon is 20% larger and is used in the UK, Canada, and some other countries." }
      },
      {
        "@type": "Question",
        "name": "How many liters in a gallon of gas?",
        "acceptedAnswer": { "@type": "Answer", "text": "In the US, 1 gallon of gas = 3.785 liters. This is why US gas prices per gallon look lower than European per-liter prices." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is a liter?",
        "acceptedAnswer": { "@type": "Answer", "text": "1 liter = 0.2642 US gallons, or 0.2200 Imperial gallons." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is 20 liters?",
        "acceptedAnswer": { "@type": "Answer", "text": "20 liters = 5.283 US gallons, or 4.399 Imperial gallons." }
      },
      {
        "@type": "Question",
        "name": "How many gallons is 50 liters?",
        "acceptedAnswer": { "@type": "Answer", "text": "50 liters = 13.209 US gallons, or 10.998 Imperial gallons. A typical car gas tank in the US holds about 50–70 liters (13–18 gallons)." }
      }
    ]
  }
]);
---
<Layout
  title="Liters to Gallons Converter — L to Gal | ComputeZap"
  description="Convert liters to gallons instantly. 1 US gallon = 3.785 liters. Free converter for US and Imperial gallons with full conversion chart."
  canonical="/liters-to-gallons"
  schema={schema}
>
<style is:global>
.hero{text-align:center;padding:2rem 1rem 1.25rem}
.hero h1{font-size:2rem;color:#111;margin:.5rem 0 .35rem;font-weight:800}
.hero-sub{color:#555;margin:0;font-size:1rem}
.breadcrumb{font-size:.85rem;color:#888;margin-bottom:.75rem}
.breadcrumb a{color:var(--blue);text-decoration:none}
.calc-wrap{display:grid;grid-template-columns:360px 1fr;gap:1.5rem;max-width:1100px;margin:0 auto;padding:0 1rem 3rem;align-items:start}
.calc-left{position:sticky;top:1rem}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.5rem;margin-bottom:1rem}
.card:last-child{margin-bottom:0}
.mode-wrap{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin-bottom:1rem}
.mode-btn{background:#f8fafc;color:#64748b;border:1.5px solid #e2e8f0;border-radius:8px;padding:.5rem;font-size:.82rem;font-weight:700;cursor:pointer;text-align:center;transition:all .15s}
.mode-btn.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.fld-lbl{display:block;font-size:.8rem;font-weight:700;color:#374151;margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.04em}
.fld-wrap{position:relative;margin-bottom:1rem}
.fld-sfx{position:absolute;right:.9rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-weight:600;pointer-events:none;font-size:.9rem}
.txt-input{width:100%;font-size:1.1rem;padding:.7rem 3rem .7rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;color:#111;box-sizing:border-box;font-family:inherit;background:#fff}
.txt-input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.preset-lbl{font-size:.7rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem;display:block}
.preset-wrap{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:1rem}
.preset-btn{background:#fff;color:var(--blue);border:1.5px solid #dbeafe;border-radius:20px;padding:.28rem .75rem;font-size:.82rem;font-weight:700;cursor:pointer;transition:all .15s}
.preset-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}
.result-box{display:block;background:var(--blue);border-radius:14px;padding:1.5rem;text-align:center;margin-bottom:1rem;box-shadow:0 4px 20px rgba(37,99,235,.18)}
.res-lbl{font-size:.72rem;color:rgba(255,255,255,.7);text-transform:uppercase;letter-spacing:.09em;margin-bottom:.4rem}
.res-val{font-size:2rem;font-weight:800;color:#fff;line-height:1.2}
.res-sub{font-size:.9rem;color:rgba(255,255,255,.8);margin-top:.3rem}
.stat-primary{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;padding:.9rem 1.25rem;text-align:center;margin-bottom:.6rem}
.stat-lbl{display:block;font-size:.68rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem;font-weight:600}
.stat-primary .stat-lbl{color:#2563eb}
.stat-big{display:block;font-size:1.9rem;font-weight:900;color:#2563eb;line-height:1.1}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem}
.stat-item{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.8rem .75rem;text-align:center}
.stat-val{display:block;font-size:1.05rem;font-weight:800;color:#1e293b}
.content-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.5rem;margin-bottom:1rem}
.content-card h2{font-size:1.1rem;font-weight:700;color:#111;margin:0 0 .8rem}
.content-card p{color:#444;line-height:1.75;font-size:.95rem;margin:0 0 .7rem}
.content-card p:last-child{margin-bottom:0}
.content-card ul{color:#444;line-height:1.85;font-size:.95rem;padding-left:1.25rem;margin:0}
.answer-box{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:.75rem 1rem;margin:.75rem 0}
.answer-row{display:flex;justify-content:space-between;align-items:center;padding:.35rem 0;border-bottom:1px solid #f1f5f9;font-size:.95rem}
.answer-row:last-child{border-bottom:none}
.answer-lbl{color:#64748b;font-weight:600}
.answer-val{color:#2563eb;font-weight:800}
.conv-table{width:100%;border-collapse:collapse;font-size:.875rem}
.conv-table th{background:#f8fafc;padding:.45rem .75rem;text-align:left;font-size:.72rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid #e5e7eb}
.conv-table td{padding:.5rem .75rem;border-bottom:1px solid #f3f4f6;color:#444}
.conv-table tr:last-child td{border-bottom:none}
.conv-table .highlight{color:var(--blue);font-weight:700}
.formula-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:.75rem 1rem;font-family:monospace;font-size:.88rem;color:#1e293b;margin:.6rem 0}
.formula-box code{display:block;padding:.2rem 0}
.faq-item{border-bottom:1px solid #f3f4f6;padding:.85rem 0}
.faq-item:last-child{border-bottom:none;padding-bottom:0}
.faq-q{font-size:.92rem;color:#111;margin:0 0 .35rem;font-weight:600}
.faq-a{color:#555;font-size:.875rem;margin:0;line-height:1.65}
.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}
.next-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1rem;border-top:3px solid var(--blue);text-decoration:none;display:block}
.next-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.08)}
.next-tag{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--blue);margin-bottom:.3rem;display:block}
.next-card h3{font-size:.88rem;font-weight:700;color:#111;margin:0 0 .25rem}
.next-card p{font-size:.78rem;color:#64748b;margin:0;line-height:1.5}
@media(max-width:768px){.calc-wrap{grid-template-columns:1fr}.calc-left{position:static}.hero h1{font-size:1.65rem}.res-val{font-size:1.6rem}.next-grid{grid-template-columns:1fr}}
</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Liters to Gallons Converter</nav>
  <h1>Liters to Gallons Converter</h1>
  <p class="hero-sub">Convert liters to US or Imperial gallons — includes quarts, pints, and fl oz</p>
</div>

<div class="calc-wrap">

  <!-- ===== LEFT PANEL ===== -->
  <div class="calc-left">
    <div class="card">

      <!-- Direction Toggle -->
      <div class="mode-wrap">
        <button class="mode-btn active" id="btn-ltg" onclick="setMode('ltg')">L → Gallons</button>
        <button class="mode-btn" id="btn-gtl" onclick="setMode('gtl')">Gallons → L</button>
      </div>

      <!-- Gallon Type Toggle -->
      <div class="mode-wrap">
        <button class="mode-btn active" id="btn-us" onclick="setGalType('us')">US Gallon</button>
        <button class="mode-btn" id="btn-imp" onclick="setGalType('imperial')">Imperial (UK)</button>
      </div>

      <!-- Input -->
      <label class="fld-lbl" id="input-label">Liters (L)</label>
      <div class="fld-wrap">
        <input type="number" id="amount" class="txt-input" value="1" min="0" step="any" oninput="doConvert()" />
        <span class="fld-sfx" id="input-unit">L</span>
      </div>

      <!-- Preset Buttons -->
      <span class="preset-lbl">Quick Values</span>
      <div class="preset-wrap">
        <button class="preset-btn" onclick="setVal(1)">1</button>
        <button class="preset-btn" onclick="setVal(2)">2</button>
        <button class="preset-btn" onclick="setVal(5)">5</button>
        <button class="preset-btn" onclick="setVal(10)">10</button>
        <button class="preset-btn" onclick="setVal(20)">20</button>
        <button class="preset-btn" onclick="setVal(50)">50</button>
        <button class="preset-btn" onclick="setVal(100)">100</button>
      </div>

      <!-- Result Box -->
      <div class="result-box">
        <div class="res-lbl" id="res-label">= US GALLONS</div>
        <div class="res-val" id="res-main">0.2642 gal</div>
        <div class="res-sub" id="res-sub">1 L</div>
      </div>

      <!-- Primary stat: gallons -->
      <div class="stat-primary">
        <span class="stat-lbl" id="sp-label">Gallons (US)</span>
        <span class="stat-big" id="sp-val">0.2642</span>
      </div>

      <!-- Secondary stats -->
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-lbl">Quarts</span>
          <span class="stat-val" id="stat-qt">1.057</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl">Pints</span>
          <span class="stat-val" id="stat-pt">2.113</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl">Fluid Oz</span>
          <span class="stat-val" id="stat-floz">33.81</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl">Milliliters</span>
          <span class="stat-val" id="stat-ml">1000</span>
        </div>
      </div>

    </div>
  </div>

  <!-- ===== RIGHT PANEL ===== -->
  <div class="calc-right">

    <!-- Featured Snippet -->
    <div class="content-card">
      <h2>How Many Liters Are in a Gallon?</h2>
      <div class="answer-box">
        <div class="answer-row">
          <span class="answer-lbl">1 US gallon</span>
          <span class="answer-val">= 3.785 liters</span>
        </div>
        <div class="answer-row">
          <span class="answer-lbl">1 Imperial gallon</span>
          <span class="answer-val">= 4.546 liters</span>
        </div>
        <div class="answer-row">
          <span class="answer-lbl">1 liter</span>
          <span class="answer-val">= 0.2642 US gallons</span>
        </div>
        <div class="answer-row">
          <span class="answer-lbl">½ gallon (US)</span>
          <span class="answer-val">= 1.893 liters</span>
        </div>
      </div>
    </div>

    <!-- L to Gal Chart -->
    <div class="content-card">
      <h2>Liters to Gallons Conversion Chart</h2>
      <div style="overflow-x:auto">
      <table class="conv-table">
        <thead>
          <tr><th>Liters</th><th>US Gallons</th><th>Imperial Gallons</th></tr>
        </thead>
        <tbody>
          <tr><td>1 L</td><td>0.264 gal</td><td>0.220 gal</td></tr>
          <tr><td>2 L</td><td>0.528 gal</td><td>0.440 gal</td></tr>
          <tr><td>3 L</td><td>0.793 gal</td><td>0.660 gal</td></tr>
          <tr><td>4 L</td><td>1.057 gal</td><td>0.880 gal</td></tr>
          <tr><td>5 L</td><td class="highlight">1.321 gal</td><td>1.100 gal</td></tr>
          <tr><td>10 L</td><td class="highlight">2.642 gal</td><td>2.200 gal</td></tr>
          <tr><td>15 L</td><td>3.963 gal</td><td>3.300 gal</td></tr>
          <tr><td>20 L</td><td>5.283 gal</td><td>4.399 gal</td></tr>
          <tr><td>25 L</td><td>6.604 gal</td><td>5.499 gal</td></tr>
          <tr><td>30 L</td><td>7.925 gal</td><td>6.599 gal</td></tr>
          <tr><td>50 L</td><td class="highlight">13.209 gal</td><td>10.998 gal</td></tr>
          <tr><td>100 L</td><td>26.417 gal</td><td>21.997 gal</td></tr>
        </tbody>
      </table>
      </div>
    </div>

    <!-- Gal to L Chart -->
    <div class="content-card">
      <h2>Gallons to Liters Conversion Chart</h2>
      <div style="overflow-x:auto">
      <table class="conv-table">
        <thead>
          <tr><th>US Gallons</th><th>Liters</th><th>Imperial Gallons</th><th>Liters</th></tr>
        </thead>
        <tbody>
          <tr><td>¼ gal</td><td>0.946 L</td><td>¼ gal (imp)</td><td>1.137 L</td></tr>
          <tr><td>½ gal</td><td class="highlight">1.893 L</td><td>½ gal (imp)</td><td>2.273 L</td></tr>
          <tr><td>1 gal</td><td class="highlight">3.785 L</td><td>1 gal (imp)</td><td>4.546 L</td></tr>
          <tr><td>2 gal</td><td>7.571 L</td><td>2 gal (imp)</td><td>9.092 L</td></tr>
          <tr><td>5 gal</td><td>18.927 L</td><td>5 gal (imp)</td><td>22.730 L</td></tr>
          <tr><td>10 gal</td><td>37.854 L</td><td>10 gal (imp)</td><td>45.461 L</td></tr>
          <tr><td>15 gal</td><td>56.781 L</td><td>15 gal (imp)</td><td>68.191 L</td></tr>
          <tr><td>20 gal</td><td>75.708 L</td><td>20 gal (imp)</td><td>90.922 L</td></tr>
        </tbody>
      </table>
      </div>
    </div>

    <!-- Formula -->
    <div class="content-card">
      <h2>How to Convert Liters to Gallons — Formula</h2>
      <div class="formula-box">
        <code><strong>Liters → US Gallons:</strong> gallons = liters ÷ 3.78541</code>
        <code><strong>Liters → Imperial Gallons:</strong> gallons = liters ÷ 4.54609</code>
      </div>
      <p><strong>Example:</strong> 10 liters ÷ 3.785 = <strong>2.642 US gallons</strong></p>
      <p><strong>Quick trick:</strong> Divide by 4 for a rough estimate — 10 L ÷ 4 ≈ 2.5 gallons (within 5%).</p>
    </div>

    <!-- US vs Imperial -->
    <div class="content-card">
      <h2>US Gallon vs Imperial Gallon — Key Differences</h2>
      <div style="overflow-x:auto">
      <table class="conv-table">
        <thead>
          <tr><th></th><th>US Gallon</th><th>Imperial Gallon</th></tr>
        </thead>
        <tbody>
          <tr><td>In Liters</td><td>3.785 L</td><td>4.546 L</td></tr>
          <tr><td>In Fluid Oz</td><td>128 fl oz</td><td>160 fl oz</td></tr>
          <tr><td>In Quarts</td><td>4 quarts</td><td>4 quarts</td></tr>
          <tr><td>Used in</td><td>USA, Latin America</td><td>UK, Canada, India</td></tr>
          <tr><td>Relative size</td><td>Base</td><td>~20% larger</td></tr>
        </tbody>
      </table>
      </div>
      <p style="margin-top:.75rem">The Imperial gallon is used in the United Kingdom, Canada, and several Commonwealth countries. Always check which gallon is meant when reading fuel economy (mpg) or recipe conversions.</p>
    </div>

    <!-- Real-world examples -->
    <div class="content-card">
      <h2>Real-World Liters to Gallons Examples</h2>
      <ul>
        <li><strong>2-liter soda bottle</strong> = 0.528 US gallons (just over ½ gallon)</li>
        <li><strong>Car gas tank (50 L)</strong> = 13.2 US gallons — typical sedan</li>
        <li><strong>Water bottle (500 mL)</strong> = 0.132 US gallons</li>
        <li><strong>Bathtub (150 L)</strong> = 39.6 US gallons</li>
        <li><strong>1-gallon milk jug</strong> = 3.785 liters</li>
        <li><strong>Swimming pool (2,500,000 L)</strong> = 660,430 US gallons</li>
        <li><strong>Fuel economy: 10 L/100km</strong> = 23.5 mpg (US)</li>
      </ul>
    </div>

    <div class="content-card">
      <h2>Common Mistakes When Converting Liters to Gallons</h2>
      <ul>
        <li><strong>Confusing US and Imperial gallons</strong> — 1 US gallon = 3.785 L, but 1 Imperial gallon = 4.546 L. A 20% difference that matters in fuel and recipe conversions.</li>
        <li><strong>Using 4 as the conversion factor</strong> — dividing by 4 gives a rough estimate (within 5%), but for large volumes like aquariums or fuel tanks, always use 3.785.</li>
        <li><strong>Mixing metric and imperial mid-calculation</strong> — if you start in liters, finish in liters. Switching units partway through causes compounding errors.</li>
        <li><strong>Comparing fuel economy across countries</strong> — US mpg uses US gallons; UK mpg uses Imperial gallons. European L/100km is entirely different — always convert the same unit.</li>
      </ul>
    </div>

    <div class="content-card">
      <h2>Why Liters to Gallons Conversion Matters</h2>
      <ul>
        <li><strong>Fuel economy</strong> — comparing car fuel efficiency between the US and Europe requires converting L/100km to mpg or vice versa.</li>
        <li><strong>Travel and purchases abroad</strong> — gas stations in most of the world price fuel per liter; knowing the gallon equivalent helps you budget.</li>
        <li><strong>Cooking and recipes</strong> — international recipes often use liters for large quantities (soups, drinks, sauces) that US recipes list in gallons.</li>
        <li><strong>Aquariums and tanks</strong> — aquarium sizes and dosing instructions are often in liters in Europe and gallons in the US.</li>
      </ul>
    </div>

    <!-- FAQs -->
    <div class="content-card">
      <h2>Frequently Asked Questions</h2>

      <div class="faq-item">
        <div class="faq-q">How many liters are in a gallon?</div>
        <div class="faq-a">1 US gallon = 3.785 liters. 1 Imperial (UK) gallon = 4.546 liters. The Imperial gallon is about 20% larger than the US gallon.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many gallons is 5 liters?</div>
        <div class="faq-a">5 liters = 1.321 US gallons (or 1.100 Imperial gallons).</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many gallons is 10 liters?</div>
        <div class="faq-a">10 liters = 2.642 US gallons (or 2.200 Imperial gallons).</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many gallons is 2 liters?</div>
        <div class="faq-a">2 liters = 0.528 US gallons. A standard 2-liter soda bottle is just over half a US gallon.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many liters in a half gallon?</div>
        <div class="faq-a">Half a US gallon = 1.893 liters. Half an Imperial gallon = 2.273 liters.</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many gallons is 20 liters?</div>
        <div class="faq-a">20 liters = 5.283 US gallons (or 4.399 Imperial gallons).</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">How many gallons is 50 liters?</div>
        <div class="faq-a">50 liters = 13.209 US gallons. A typical sedan gas tank holds 13–18 US gallons (50–68 liters).</div>
      </div>
      <div class="faq-item">
        <div class="faq-q">What's an easy way to convert liters to gallons?</div>
        <div class="faq-a">Divide liters by 4 for a quick approximation (within 5% accuracy). For exact: divide by 3.785 for US gallons, or 4.546 for Imperial gallons.</div>
      </div>

    </div>

    <div class="content-card">
      <h2>Related Converters &amp; Calculators</h2>
      <div class="next-grid">
        <a href="/oz-to-quarts" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Oz to Quarts</h3>
          <p>Convert fluid ounces to quarts — 1 quart = 32 oz.</p>
        </a>
