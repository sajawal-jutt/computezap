---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Weeks in a Year Calculator",
    "url": "https://computezap.com/weeks-in-a-year",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "How many weeks in a year? A regular year has 52 weeks and 1 day. A leap year has 52 weeks and 2 days. Free calculator with work weeks, school weeks, and full reference table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Weeks in a Year", "item": "https://computezap.com/weeks-in-a-year" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many weeks in a year?",
        "acceptedAnswer": { "@type": "Answer", "text": "A regular year has 52 weeks and 1 day (365 days ÷ 7 = 52.142857 weeks). A leap year has 52 weeks and 2 days (366 ÷ 7 = 52.285714 weeks). For most purposes, the answer is simply 52 weeks." }
      },
      {
        "@type": "Question",
        "name": "How many work weeks in a year?",
        "acceptedAnswer": { "@type": "Answer", "text": "A standard work year has 52 work weeks. With US federal holidays (10 days) and 2 weeks vacation (10 days), a full-time employee works about 50 weeks per year. Total work hours: 2,080 (52 weeks × 40 hours)." }
      },
      {
        "@type": "Question",
        "name": "How many weeks in a leap year?",
        "acceptedAnswer": { "@type": "Answer", "text": "A leap year has 366 days, which equals 52 weeks and 2 extra days (52.285714 weeks). Leap years occur every 4 years: 2024, 2028, 2032, 2036, etc. The 2 extra days mean a leap year starts and ends on a different day of the week." }
      },
      {
        "@type": "Question",
        "name": "Is there ever 53 weeks in a year?",
        "acceptedAnswer": { "@type": "Answer", "text": "Technically no — there are always 52 full weeks plus 1 or 2 extra days. However, in the ISO week numbering system (used in Europe and business), some years have 53 numbered weeks because the partial week at the end gets counted as week 53. This happens in years where January 1 falls on a Thursday (regular year) or Wednesday/Thursday (leap year)." }
      },
      {
        "@type": "Question",
        "name": "How many biweekly pay periods are in a year?",
        "acceptedAnswer": { "@type": "Answer", "text": "Most years have 26 biweekly pay periods (52 weeks ÷ 2). However, some years have 27 biweekly pay periods if your pay schedule alignment creates an extra period — this happens roughly every 11 years for a given company's payroll cycle." }
      },
      {
        "@type": "Question",
        "name": "How many school weeks are in a year?",
        "acceptedAnswer": { "@type": "Answer", "text": "A typical US school year has 36 weeks (180 school days ÷ 5 days/week). This runs from late August/early September to May/June. The remaining 16 weeks are summer, winter, and spring breaks." }
      }
    ]
  }
]);
---
