  title="Weeks in a Year — How Many Weeks? | ComputeZap"
  description="How many weeks in a year? Regular year: 52 weeks + 1 day. Leap year: 52 weeks + 2 days. Free calculator with work weeks, pay periods, school weeks, and full table."
  canonical="/weeks-in-a-year"
  schema={schema}
>
