---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Seconds in a Year Calculator",
    "url": "https://computezap.com/seconds-in-a-year",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "How many seconds are in a year? A standard 365-day year has 31,536,000 seconds. A leap year has 31,622,400 seconds. Full breakdown with minutes and hours.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Seconds in a Year", "item": "https://computezap.com/seconds-in-a-year" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many seconds are in a year?", "acceptedAnswer": { "@type": "Answer", "text": "A standard 365-day year has exactly 31,536,000 seconds. Calculation: 365 days x 24 hours x 60 minutes x 60 seconds = 31,536,000. A leap year (366 days) has 31,622,400 seconds." } },
      { "@type": "Question", "name": "How many seconds are in a leap year?", "acceptedAnswer": { "@type": "Answer", "text": "A leap year (366 days) has 31,622,400 seconds. Calculation: 366 x 24 x 60 x 60 = 31,622,400. A leap year has 86,400 more seconds than a standard year." } },
      { "@type": "Question", "name": "How many seconds are in a day?", "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 86,400 seconds in a day. Calculation: 24 hours x 60 minutes x 60 seconds = 86,400." } },
      { "@type": "Question", "name": "How many seconds are in a month?", "acceptedAnswer": { "@type": "Answer", "text": "A 30-day month has 2,592,000 seconds. A 31-day month has 2,678,400 seconds. The average month has approximately 2,629,800 seconds (31,536,000 / 12)." } },
      { "@type": "Question", "name": "How many seconds are in a week?", "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 604,800 seconds in a week. Calculation: 7 days x 86,400 seconds/day = 604,800 seconds." } }
    ]
  }
]);
---
<Layout
  title="Seconds in a Year — 31,536,000 | ComputeZap"
  description="How many seconds are in a year? A 365-day year has 31,536,000 seconds. A leap year has 31,622,400 seconds. Includes seconds in a day, week, and month."
  canonical="/seconds-in-a-year"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › Seconds in a Year</nav>
  <h1>Seconds in a Year</h1>
  <p>How many seconds are in a year? 31,536,000 — here's exactly how it adds up</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="quick-answer">
      <span class="qa-big">31,536,000 seconds/year</span>
      <span class="qa-sub">365 days x 24 x 60 x 60 (standard year)</span>
    </div>

    <div class="input-group">
      <label for="year-type">Year Type</label>
      <div class="input-wrap">
        <select id="year-type" onchange="calc()" style="width:100%;padding:.65rem 1rem;border:1.5px solid #d1d5db;border-radius:8px;font-size:1rem;font-family:inherit;background:#fff;color:#111">
          <option value="365" selected>Standard year (365 days)</option>
          <option value="366">Leap year (366 days)</option>
        </select>
      </div>
    </div>

    <div class="result-hero">
      <div class="r-label">Seconds in This Year</div>
      <div class="r-value"><span id="r-secs">31,536,000</span></div>
      <div class="r-sub" id="r-sub">365 x 24 x 60 x 60</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Total Days</span><span class="stat-val" id="r-days">365</span></div>
      <div class="stat-box"><span class="stat-lbl">Total Hours</span><span class="stat-val" id="r-hours">8,760</span></div>
      <div class="stat-box"><span class="stat-lbl">Total Minutes</span><span class="stat-val" id="r-mins">525,600</span></div>
      <div class="stat-box"><span class="stat-lbl">vs. Standard</span><span class="stat-val" id="r-diff">—</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Seconds Per Year: The Formula</h2>
    <div class="formula-box">Seconds = Days x 24 x 60 x 60</div>
    <div class="formula-box">31,536,000 = 365 x 24 x 60 x 60 (standard year)</div>
    <div class="formula-box">31,622,400 = 366 x 24 x 60 x 60 (leap year)</div>
    <p>The formula multiplies the number of days by 86,400 (seconds per day). One extra day in a leap year adds exactly 86,400 more seconds.</p>
  </div>

  <div class="card">
    <h2>Seconds Per Time Period</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Time Period</th><th>Seconds</th><th>Scientific Notation</th></tr></thead>
        <tbody>
          {[
            ['1 minute','60','6 x 10^1'],
            ['1 hour','3,600','3.6 x 10^3'],
            ['1 day','86,400','8.64 x 10^4'],
            ['1 week','604,800','6.048 x 10^5'],
            ['1 month (30 days)','2,592,000','2.592 x 10^6'],
            ['1 month (31 days)','2,678,400','2.678 x 10^6'],
            ['1 year (365 days)','31,536,000','3.154 x 10^7'],
            ['1 year (366 days)','31,622,400','3.162 x 10^7'],
            ['10 years','315,360,000','3.15 x 10^8'],
            ['100 years (1 century)','3,153,600,000','3.15 x 10^9'],
          ].map(([p, s, sci]) => (
            <tr>
              <td>{p}</td>
              <td style="color:var(--blue);font-weight:700">{s}</td>
              <td style="font-family:monospace;font-size:.8rem">{sci}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>What Can Happen in a Second?</h2>
    <ul>
      <li><strong>Light travels</strong> 299,792 kilometers (186,282 miles) in one second.</li>
      <li><strong>A hummingbird</strong> beats its wings 50-80 times per second.</li>
      <li><strong>Your computer</strong> (3 GHz CPU) executes 3 billion cycles per second.</li>
      <li><strong>The human heart</strong> beats approximately once per second at rest.</li>
      <li><strong>Sound travels</strong> ~343 meters (1,125 feet) per second in air at 20 degrees C.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Why Does a Year Have 365.25 Days?</h2>
    <p>The Earth takes approximately <strong>365.2422 days</strong> to orbit the sun (a tropical year). We handle this with:</p>
    <ul>
      <li><strong>Leap years</strong> — every 4 years we add a day (February 29), giving 365.25 days on average.</li>
      <li><strong>Century exception</strong> — years divisible by 100 are NOT leap years (except divisible by 400), fixing the overcorrection.</li>
      <li><strong>Gregorian calendar</strong> — the system we use since 1582, accurate to within 1 day every 3,030 years.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many seconds are in a year?</h3>
      <p>A standard 365-day year has exactly <strong>31,536,000 seconds</strong> (365 x 86,400). A leap year has 31,622,400 seconds (366 x 86,400).</p>
    </div>
    <div class="faq-item">
      <h3>How many seconds are in a day?</h3>
      <p>Exactly <strong>86,400 seconds</strong> per day (24 x 60 x 60 = 86,400). This constant is used widely in computing, particularly in Unix timestamps.</p>
    </div>
    <div class="faq-item">
      <h3>How many seconds are in a month?</h3>
      <p>A 30-day month has <strong>2,592,000 seconds</strong>. A 31-day month has 2,678,400 seconds. Average: about 2,629,800 per month.</p>
    </div>
    <div class="faq-item">
      <h3>How many seconds are in a week?</h3>
      <p>Exactly <strong>604,800 seconds</strong> per week (7 x 86,400 = 604,800).</p>
    </div>
    <div class="faq-item">
      <h3>How does a leap year affect the second count?</h3>
      <p>A leap year adds exactly <strong>86,400 extra seconds</strong> (one extra day). Standard: 31,536,000. Leap year: 31,622,400. Difference: 86,400.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/hours-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Year</h3>
        <p>8,760 hours in a year — work hours and salary.</p>
      </a>
      <a href="/minutes-in-a-day" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Minutes in a Day</h3>
        <p>1,440 minutes in a 24-hour day.</p>
      </a>
      <a href="/hours-in-a-month" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Month</h3>
        <p>720-744 hours per month depending on the month.</p>
      </a>
      <a href="/weeks-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Weeks in a Year</h3>
        <p>52 weeks per year — explained fully.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
      <a href="/time-to-decimal-calculator" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Time to Decimal</h3>
        <p>Convert hours and minutes to decimal for payroll.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function calc() {
  var days = parseInt(document.getElementById('year-type').value) || 365;
  var secs = days * 24 * 60 * 60;
  var mins = days * 24 * 60;
  var hrs  = days * 24;
  var diff = days === 365 ? '—' : '+86,400 vs. standard';

  document.getElementById('r-secs').textContent  = secs.toLocaleString();
  document.getElementById('r-sub').textContent   = days + ' x 24 x 60 x 60';
  document.getElementById('r-days').textContent  = days.toLocaleString();
  document.getElementById('r-hours').textContent = hrs.toLocaleString();
  document.getElementById('r-mins').textContent  = mins.toLocaleString();
  document.getElementById('r-diff').textContent  = diff;
}

calc();
</script>
</Layout>
