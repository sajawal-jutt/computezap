<script is:inline>
var currentMode = 'km';

function setMode(mode) {
  currentMode = mode;
  document.getElementById('btn-km').classList.toggle('active', mode === 'km');
  document.getElementById('btn-mi').classList.toggle('active', mode === 'mi');
  document.getElementById('input-lbl').textContent = mode === 'km' ? 'Kilometers (km)' : 'Miles (mi)';
  document.getElementById('input-sfx').textContent = mode === 'km' ? 'km' : 'mi';
  document.getElementById('main-input').value = mode === 'km' ? '1' : '1';
  convert();
}

function fmt(n, dec) {
  if (n === 0) return '0';
  return parseFloat(n.toFixed(dec !== undefined ? dec : 4)).toLocaleString('en-US');
}

function convert() {
  var val = parseFloat(document.getElementById('main-input').value);
  if (isNaN(val) || val < 0) return;

  var km, miles;
  if (currentMode === 'km') {
    km    = val;
    miles = val * 0.621371;
  } else {
    miles = val;
    km    = val * 1.60934;
  }

  var meters = km * 1000;
  var feet   = km * 3280.84;
  var yards  = km * 1093.61;
  var cm     = km * 100000;

  if (currentMode === 'km') {
    document.getElementById('r-label').textContent = 'Miles';
    document.getElementById('r-value').textContent = fmt(miles, 4);
    document.getElementById('r-unit').textContent  = 'miles';
    document.getElementById('r-sub').textContent   = val + ' km = ' + fmt(miles, 6) + ' miles';
  } else {
    document.getElementById('r-label').textContent = 'Kilometers';
    document.getElementById('r-value').textContent = fmt(km, 4);
    document.getElementById('r-unit').textContent  = 'km';
    document.getElementById('r-sub').textContent   = val + ' mi = ' + fmt(km, 5) + ' km';
  }

  document.getElementById('r-meters').textContent = fmt(meters, 2);
  document.getElementById('r-feet').textContent   = fmt(feet, 0);
  document.getElementById('r-yards').textContent  = fmt(yards, 0);
  document.getElementById('r-cm').textContent     = fmt(cm, 0);
}

convert();
</script>
</Layout>
