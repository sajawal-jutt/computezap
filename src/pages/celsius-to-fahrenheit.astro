          <p>Convert kilograms to pounds instantly.</p>
        </a>
        <a href="/cm-to-inches" class="next-card">
          <span class="next-tag">Length</span>
          <h3>cm to Inches</h3>
          <p>Convert centimeters to inches instantly.</p>
        </a>
        <a href="/knots-to-mph" class="next-card">
          <span class="next-tag">Speed</span>
          <h3>Knots to MPH</h3>
          <p>Convert nautical speed to miles per hour.</p>
        </a>
        <a href="/liters-to-gallons" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Liters to Gallons</h3>
          <p>Convert liters to US or Imperial gallons.</p>
        </a>
        <a href="/cups-to-tablespoons" class="next-card">
          <span class="next-tag">Kitchen</span>
          <h3>Cups to Tablespoons</h3>
          <p>How many tablespoons in a cup — all fractions covered.</p>
        </a>
        <a href="/percent-off-calculator" class="next-card">
          <span class="next-tag">Shopping</span>
          <h3>Percent Off Calculator</h3>
          <p>Calculate the final price after any discount.</p>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
var mode = 'c';

function fmt(v, d) {
  return parseFloat(v.toFixed(d !== undefined ? d : 2)).toString();
}

function getLabel(c) {
  if (c <= -40) return 'Extreme cold';
  if (c <= 0) return 'Below freezing';
  if (c <= 10) return 'Cold';
  if (c <= 20) return 'Cool / Room temp';
  if (c <= 30) return 'Warm';
  if (c <= 37) return 'Body temperature';
  if (c <= 40) return 'Hot / Fever';
  if (c >= 100) return 'Boiling point';
  return 'Very hot';
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value);
  if (isNaN(val)) val = 0;
  var c, f, k, r;
  if (mode === 'c') {
    c = val; f = c * 1.8 + 32; k = c + 273.15; r = (f + 459.67);
    document.getElementById('r-main').textContent = fmt(f);
    document.getElementById('r-unit').textContent = '°F';
    document.getElementById('r-sub').textContent = fmt(c) + '°C = ' + fmt(f) + '°F';
    document.getElementById('res-lbl').textContent = 'Fahrenheit';
    document.getElementById('s1-lbl').textContent = 'Fahrenheit';
    document.getElementById('s1-val').textContent = fmt(f) + ' °F';
    document.getElementById('s2-lbl').textContent = 'Kelvin';
    document.getElementById('s2-val').textContent = fmt(k) + ' K';
    document.getElementById('s3-lbl').textContent = 'Rankine';
    document.getElementById('s3-val').textContent = fmt(r) + ' °R';
    document.getElementById('s4-lbl').textContent = 'Scale';
    document.getElementById('s4-val').textContent = getLabel(c);
  } else {
    f = val; c = (f - 32) / 1.8; k = c + 273.15; r = f + 459.67;
    document.getElementById('r-main').textContent = fmt(c);
    document.getElementById('r-unit').textContent = '°C';
    document.getElementById('r-sub').textContent = fmt(f) + '°F = ' + fmt(c) + '°C';
    document.getElementById('res-lbl').textContent = 'Celsius';
    document.getElementById('s1-lbl').textContent = 'Celsius';
    document.getElementById('s1-val').textContent = fmt(c) + ' °C';
    document.getElementById('s2-lbl').textContent = 'Kelvin';
    document.getElementById('s2-val').textContent = fmt(k) + ' K';
    document.getElementById('s3-lbl').textContent = 'Rankine';
    document.getElementById('s3-val').textContent = fmt(r) + ' °R';
    document.getElementById('s4-lbl').textContent = 'Scale';
    document.getElementById('s4-val').textContent = getLabel(c);
  }
}

function setMode(m) {
  mode = m;
  var isC = m === 'c';
  document.getElementById('btn-c').classList.toggle('active', isC);
  document.getElementById('btn-f').classList.toggle('active', !isC);
  document.getElementById('inp-lbl').textContent = isC ? 'Celsius (°C)' : 'Fahrenheit (°F)';
  document.getElementById('inp-sfx').textContent = isC ? '°C' : '°F';
  var presets = document.getElementById('preset-wrap');
  presets.innerHTML = (isC ? [-40,0,20,37,100] : [-40,32,68,98.6,212])
    .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
  document.getElementById('amount').value = isC ? 100 : 212;
  convert();
}

function setVal(v) {
  document.getElementById('amount').value = v;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
