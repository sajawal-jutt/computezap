const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Celsius to Fahrenheit Converter",
    "url": "https://computezap.com/celsius-to-fahrenheit",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert Celsius to Fahrenheit instantly. Formula: °F = (°C × 9/5) + 32. Free temperature converter with reference chart.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Celsius to Fahrenheit", "item": "https://computezap.com/celsius-to-fahrenheit" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I convert Celsius to Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply °C by 9/5 (1.8) and add 32. Formula: °F = (°C × 1.8) + 32. Example: 100°C × 1.8 + 32 = 212°F." } },
      { "@type": "Question", "name": "What is 37°C in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "37°C = 98.6°F. This is normal human body temperature. Formula: 37 × 1.8 + 32 = 98.6°F." } },
      { "@type": "Question", "name": "What is 100°C in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "100°C = 212°F. This is the boiling point of water at sea level." } },
      { "@type": "Question", "name": "What is 0°C in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "0°C = 32°F. This is the freezing point of water." } },
      { "@type": "Question", "name": "What temperature is the same in Celsius and Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "-40° is the same in both Celsius and Fahrenheit. At -40°, both scales read the same value." } },
      { "@type": "Question", "name": "How do I convert Fahrenheit to Celsius?", "acceptedAnswer": { "@type": "Answer", "text": "Subtract 32 from °F, then multiply by 5/9. Formula: °C = (°F - 32) × 5/9. Example: (98.6 - 32) × 5/9 = 37°C." } }
    ]
  }
]);
