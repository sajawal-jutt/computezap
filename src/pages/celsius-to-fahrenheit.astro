<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Celsius to Fahrenheit</nav>
  <h1>Celsius to Fahrenheit Converter</h1>
  <p class="hero-sub">°F = (°C × 9/5) + 32 — convert any temperature instantly</p>
</div>

<div class="calc-wrap">
  <div class="calc-left">
    <div class="card">
      <div class="mode-wrap">
        <button class="mode-btn active" id="btn-c" onclick="setMode('c')">°C → °F</button>
        <button class="mode-btn" id="btn-f" onclick="setMode('f')">°F → °C</button>
      </div>
      <label class="fld-lbl" id="inp-lbl">Celsius (°C)</label>
      <div class="fld-wrap">
        <input type="number" id="amount" class="txt-input" value="100" step="1" oninput="convert()" />
        <span class="fld-sfx" id="inp-sfx">°C</span>
      </div>
      <span class="preset-lbl">Common temperatures</span>
      <div class="preset-wrap" id="preset-wrap">
        <button class="preset-btn" onclick="setVal(-40)">-40</button>
        <button class="preset-btn" onclick="setVal(0)">0</button>
        <button class="preset-btn" onclick="setVal(20)">20</button>
        <button class="preset-btn" onclick="setVal(37)">37</button>
        <button class="preset-btn" onclick="setVal(100)">100</button>
      </div>
    </div>
    <div class="card">
      <div class="result-box">
        <div class="res-lbl" id="res-lbl">Fahrenheit</div>
        <div class="res-val"><span id="r-main">212</span><span style="font-size:1.1rem;opacity:.85" id="r-unit">°F</span></div>
        <div class="res-sub" id="r-sub">100°C = 212°F</div>
      </div>
      <div class="stat-primary">
        <span class="stat-lbl" id="s1-lbl">Fahrenheit</span>
        <span class="stat-big" id="s1-val">212 °F</span>
      </div>
      <div class="stat-secondary">
        <span class="stat-lbl" id="s2-lbl">Kelvin</span>
        <span class="stat-med" id="s2-val">373.15 K</span>
      </div>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-lbl" id="s3-lbl">Rankine</span>
