      </div>
      <span class="preset-lbl">Quick values</span>
      <div class="preset-wrap" id="preset-wrap">
        <button class="preset-btn" onclick="setVal(1)">1</button>
        <button class="preset-btn" onclick="setVal(5)">5</button>
        <button class="preset-btn" onclick="setVal(10)">10</button>
        <button class="preset-btn" onclick="setVal(20)">20</button>
        <button class="preset-btn" onclick="setVal(30)">30</button>
        <button class="preset-btn" onclick="setVal(50)">50</button>
        <button class="preset-btn" onclick="setVal(100)">100</button>
        <button class="preset-btn" onclick="setVal(200)">200</button>
        <button class="preset-btn" onclick="setVal(500)">500</button>
      </div>
    </div>
