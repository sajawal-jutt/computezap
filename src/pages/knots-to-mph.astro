  </div>
</div>

<script is:inline>
var mode = 'kt';

function fmt(v, d) {
  return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString();
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value) || 0;
  var mph, kn, kmh, ms, fts;
  if (mode === 'kt') {
    kn = val; mph = val * 1.15078; kmh = val * 1.852; ms = val * 0.514444; fts = ms * 3.28084;
    document.getElementById('r-main').textContent = fmt(mph, 2);
    document.getElementById('r-unit').textContent = 'mph';
    document.getElementById('r-sub').textContent = fmt(val, 1) + ' knots = ' + fmt(mph, 2) + ' mph';
    document.getElementById('res-lbl').textContent = 'Miles Per Hour';
    document.getElementById('s1-lbl').textContent = 'Miles Per Hour';
    document.getElementById('s1-val').textContent = fmt(mph, 2) + ' mph';
    document.getElementById('s2-lbl').textContent = 'Kilometers Per Hour';
    document.getElementById('s2-val').textContent = fmt(kmh, 2) + ' km/h';
    document.getElementById('s3-lbl').textContent = 'Meters / Second';
    document.getElementById('s3-val').textContent = fmt(ms, 3) + ' m/s';
    document.getElementById('s4-lbl').textContent = 'Feet / Second';
    document.getElementById('s4-val').textContent = fmt(fts, 2) + ' ft/s';
  } else {
    mph = val; kn = val / 1.15078; kmh = val * 1.60934; ms = mph * 0.44704; fts = ms * 3.28084;
    document.getElementById('r-main').textContent = fmt(kn, 2);
    document.getElementById('r-unit').textContent = 'kn';
    document.getElementById('r-sub').textContent = fmt(val, 1) + ' mph = ' + fmt(kn, 2) + ' knots';
    document.getElementById('res-lbl').textContent = 'Knots';
    document.getElementById('s1-lbl').textContent = 'Knots';
    document.getElementById('s1-val').textContent = fmt(kn, 2) + ' kn';
    document.getElementById('s2-lbl').textContent = 'Kilometers Per Hour';
    document.getElementById('s2-val').textContent = fmt(kmh, 2) + ' km/h';
    document.getElementById('s3-lbl').textContent = 'Meters / Second';
    document.getElementById('s3-val').textContent = fmt(ms, 3) + ' m/s';
    document.getElementById('s4-lbl').textContent = 'Feet / Second';
    document.getElementById('s4-val').textContent = fmt(fts, 2) + ' ft/s';
  }
}

function setMode(m) {
  mode = m;
  var isKt = m === 'kt';
  document.getElementById('btn-kt').classList.toggle('active', isKt);
  document.getElementById('btn-mp').classList.toggle('active', !isKt);
  document.getElementById('inp-lbl').textContent = isKt ? 'Knots (kn)' : 'Miles Per Hour (mph)';
  document.getElementById('inp-sfx').textContent = isKt ? 'kn' : 'mph';
  var presets = document.getElementById('preset-wrap');
  presets.innerHTML = (isKt ? [1,5,10,20,30,50,100,200,500] : [1,5,10,25,50,60,100,200])
    .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
  document.getElementById('amount').value = isKt ? 20 : 23;
  convert();
}

function setVal(v) {
  document.getElementById('amount').value = v;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
