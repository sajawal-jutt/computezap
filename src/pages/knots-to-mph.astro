---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Knots to MPH Converter",
    "url": "https://computezap.com/knots-to-mph",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert knots to mph instantly. 1 knot = 1.15078 mph. Free nautical speed converter. Also shows km/h and m/s.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Knots to MPH", "item": "https://computezap.com/knots-to-mph" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many mph is 1 knot?", "acceptedAnswer": { "@type": "Answer", "text": "1 knot = 1.15078 mph. To convert knots to miles per hour, multiply by 1.15078." } },
      { "@type": "Question", "name": "How do I convert knots to mph?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply knots by 1.15078. Formula: mph = knots × 1.15078. Example: 20 knots × 1.15078 = 23.016 mph." } },
      { "@type": "Question", "name": "What is a knot in speed?", "acceptedAnswer": { "@type": "Answer", "text": "A knot is one nautical mile per hour. 1 nautical mile = 1.852 kilometers = 1.15078 statute miles. Knots are used in aviation, maritime navigation, and meteorology." } },
      { "@type": "Question", "name": "How many knots is 30 mph?", "acceptedAnswer": { "@type": "Answer", "text": "30 mph = 26.07 knots. Divide mph by 1.15078 to get knots: 30 ÷ 1.15078 = 26.07 knots." } },
      { "@type": "Question", "name": "Why do boats and planes use knots?", "acceptedAnswer": { "@type": "Answer", "text": "Knots are tied to the nautical mile, which is based on the Earth's geometry (1 minute of latitude = 1 nautical mile). This makes navigation charts much easier to use — distance on a chart corresponds directly to nautical miles." } }
    ]
  }
]);
---
<Layout
  title="Knots to MPH Converter — Nautical Speed | ComputeZap"
  description="Convert knots to mph instantly. 1 knot = 1.15078 miles per hour. Free knots to mph converter. Also shows km/h and m/s. Used in sailing, aviation, and weather."
  canonical="/knots-to-mph"
  schema={schema}
>
<style is:global>
