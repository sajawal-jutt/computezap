</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Knots to MPH Converter</nav>
  <h1>Knots to MPH Converter</h1>
  <p class="hero-sub">1 knot = 1.15078 mph — convert nautical speed instantly</p>
</div>

<div class="calc-wrap">
  <div class="calc-left">
    <div class="card">
      <div class="mode-wrap">
        <button class="mode-btn active" id="btn-kt" onclick="setMode('kt')">Knots → MPH</button>
