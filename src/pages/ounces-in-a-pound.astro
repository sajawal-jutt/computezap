<script is:inline>
var currentMode = 'lbs';

function setMode(mode) {
  currentMode = mode;
  document.getElementById('btn-lbs').classList.toggle('active', mode === 'lbs');
  document.getElementById('btn-oz').classList.toggle('active', mode === 'oz');
  document.getElementById('input-lbl').textContent = mode === 'lbs' ? 'Pounds (lb)' : 'Ounces (oz)';
  document.getElementById('input-sfx').textContent = mode === 'lbs' ? 'lb' : 'oz';
  document.getElementById('main-input').value = mode === 'lbs' ? '1' : '16';
  convert();
}

function fmt(n, dec) {
  if (n === 0) return '0';
  var fixed = parseFloat(n.toFixed(dec !== undefined ? dec : 4));
  return fixed.toLocaleString('en-US');
}

function convert() {
  var val = parseFloat(document.getElementById('main-input').value);
  if (isNaN(val) || val < 0) return;

  var lbs, oz;
  if (currentMode === 'lbs') {
    lbs = val;
    oz  = val * 16;
  } else {
    oz  = val;
    lbs = val / 16;
  }

  var grams = lbs * 453.59237;
  var kg    = lbs * 0.45359237;
  var mg    = lbs * 453592.37;

  if (currentMode === 'lbs') {
    document.getElementById('r-label').textContent = 'Ounces';
    document.getElementById('r-value').textContent = fmt(oz, 4);
    document.getElementById('r-unit').textContent  = 'oz';
    document.getElementById('r-sub').textContent   = val + ' lb = ' + fmt(oz, 4) + ' oz';
    document.getElementById('r-alt-lbl').textContent = 'Pounds';
    document.getElementById('r-alt').textContent   = fmt(lbs, 4);
  } else {
    document.getElementById('r-label').textContent = 'Pounds';
    document.getElementById('r-value').textContent = fmt(lbs, 6);
    document.getElementById('r-unit').textContent  = 'lb';
    document.getElementById('r-sub').textContent   = val + ' oz = ' + fmt(lbs, 6) + ' lb';
    document.getElementById('r-alt-lbl').textContent = 'Ounces';
    document.getElementById('r-alt').textContent   = fmt(oz, 2);
  }

  document.getElementById('r-grams').textContent = fmt(grams, 2);
  document.getElementById('r-kg').textContent    = fmt(kg, 4);
  document.getElementById('r-mg').textContent    = Math.round(mg).toLocaleString('en-US');
}

convert();
</script>
</Layout>
