    "operatingSystem": "Web",
    "description": "How many ounces in a pound? 1 pound = 16 ounces. Free oz to lbs and lbs to oz converter with full conversion table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Ounces in a Pound", "item": "https://computezap.com/ounces-in-a-pound" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many ounces in a pound?",
        "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 16 ounces in 1 pound. This is a fixed US customary and Imperial measurement. So 1 lb = 16 oz, 2 lbs = 32 oz, 0.5 lbs = 8 oz." }
      },
      {
        "@type": "Question",
        "name": "How do you convert pounds to ounces?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert pounds to ounces, multiply the number of pounds by 16. Formula: ounces = pounds × 16. Example: 2.5 lbs × 16 = 40 oz." }
      },
      {
        "@type": "Question",
        "name": "How do you convert ounces to pounds?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert ounces to pounds, divide the number of ounces by 16. Formula: pounds = ounces ÷ 16. Example: 24 oz ÷ 16 = 1.5 lbs." }
      },
      {
        "@type": "Question",
        "name": "How many ounces in a half pound?",
        "acceptedAnswer": { "@type": "Answer", "text": "There are 8 ounces in a half pound (0.5 lb). Since 1 pound = 16 ounces, half of 16 = 8 ounces. A quarter pound = 4 ounces, and three-quarter pound = 12 ounces." }
      },
      {
        "@type": "Question",
        "name": "Is a fluid ounce the same as an ounce?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. A fluid ounce (fl oz) measures volume and is used for liquids. A regular ounce (oz) measures weight/mass and is used for solids. When converting to pounds, always use weight ounces (oz), not fluid ounces (fl oz)." }
      },
      {
        "@type": "Question",
        "name": "How many ounces in a pound of gold?",
        "acceptedAnswer": { "@type": "Answer", "text": "Gold and other precious metals use Troy weight, not standard (avoirdupois) weight. 1 Troy pound = 12 Troy ounces. However, 1 standard pound = 16 standard ounces. For everyday cooking, shipping, and body weight, 1 pound = 16 ounces always applies." }
      }
    ]
  }
]);
