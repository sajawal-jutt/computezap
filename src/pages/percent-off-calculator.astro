---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Percent Off Calculator",
    "url": "https://computezap.com/percent-off-calculator",
    "description": "Free percent off calculator. Find the sale price after any discount percentage, or find the original price from a sale price and discount. Visual savings bar included.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Percentage Calculator", "item": "https://computezap.com/percentage-calculator" },
      { "@type": "ListItem", "position": 3, "name": "Percent Off Calculator", "item": "https://computezap.com/percent-off-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate percent off?",
        "acceptedAnswer": { "@type": "Answer", "text": "Sale Price = Original Price × (1 - Discount% ÷ 100). For 30% off $80: $80 × 0.70 = $56 sale price. Savings = $80 - $56 = $24." }
      },
      {
        "@type": "Question",
        "name": "What is 20% off $50?",
        "acceptedAnswer": { "@type": "Answer", "text": "$50 × 0.80 = $40. You save $10 with a 20% discount on $50." }
      },
      {
        "@type": "Question",
        "name": "What is 30% off $100?",
        "acceptedAnswer": { "@type": "Answer", "text": "$100 × 0.70 = $70. You save $30 with a 30% discount on $100." }
      },
      {
        "@type": "Question",
        "name": "How do I find the original price from a sale price?",
        "acceptedAnswer": { "@type": "Answer", "text": "Original Price = Sale Price ÷ (1 - Discount% ÷ 100). If an item is $70 after a 30% discount: $70 ÷ 0.70 = $100 original price." }
      },
      {
        "@type": "Question",
        "name": "What is 50% off $200?",
        "acceptedAnswer": { "@type": "Answer", "text": "$200 × 0.50 = $100. You save $100 with a 50% discount on a $200 item." }
      }
    ]
  }
]);
---
<Layout
  title="Percent Off Calculator — Find Sale Price After Any Discount | ComputeZap"
  description="Free percent off calculator. Find the sale price after any discount %, or find the original price from a sale price. Visual savings bar shows what you pay vs save."
  canonical="/percent-off-calculator"
  schema={schema}
>
<style is:global>
.disc-bar-wrap{margin:.75rem 0 0;display:none}
.disc-bar-wrap.show{display:block}
.disc-bar-labels{display:flex;justify-content:space-between;font-size:.78rem;margin-bottom:.35rem;font-weight:700}
.disc-bar-labels .pay-lbl{color:#2563eb}
.disc-bar-labels .save-lbl{color:#16a34a}
.disc-bar{height:26px;border-radius:20px;overflow:hidden;display:flex;background:#f1f5f9}
.bar-pay{background:linear-gradient(90deg,#2563eb,#3b82f6);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.72rem;font-weight:700;transition:width .35s ease;white-space:nowrap;overflow:hidden}
.bar-save{background:linear-gradient(90deg,#16a34a,#22c55e);display:flex;align-items:center;justify-content:center;color:#fff;font-size:.72rem;font-weight:700;transition:width .35s ease;white-space:nowrap;overflow:hidden}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › <a href="/percentage-calculator">Percentage</a> › Percent Off Calculator</nav>
  <h1>Percent Off Calculator</h1>
  <p>Find sale price after a discount, or calculate the original price from a discounted price</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-m1">Find Sale Price</button>
      <button class="mode-btn" id="btn-m2">Find Original Price</button>
    </div>

    <div id="inputs-1">
      <div class="input-group">
        <label>Original Price ($)</label>
        <div class="input-wrap">
          <input type="number" id="price1" placeholder="100" min="0" step="0.01" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Discount</label>
        <div class="input-wrap">
          <input type="number" id="disc1" placeholder="30" min="0" max="100" step="0.1" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <div id="inputs-2" style="display:none">
      <div class="input-group">
        <label>Sale Price ($)</label>
        <div class="input-wrap">
          <input type="number" id="price2" placeholder="70" min="0" step="0.01" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Discount Applied</label>
        <div class="input-wrap">
          <input type="number" id="disc2" placeholder="30" min="0" max="99.9" step="0.1" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <span class="preset-lbl">Quick discounts</span>
    <div class="preset-wrap" id="preset-wrap">
      <button class="preset-btn" onclick="setDiscount(5)">5%</button>
      <button class="preset-btn" onclick="setDiscount(10)">10%</button>
      <button class="preset-btn" onclick="setDiscount(15)">15%</button>
      <button class="preset-btn" onclick="setDiscount(20)">20%</button>
      <button class="preset-btn" onclick="setDiscount(25)">25%</button>
      <button class="preset-btn" onclick="setDiscount(30)">30%</button>
      <button class="preset-btn" onclick="setDiscount(40)">40%</button>
      <button class="preset-btn" onclick="setDiscount(50)">50%</button>
      <button class="preset-btn" onclick="setDiscount(70)">70%</button>
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">Sale Price</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit"></div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="disc-bar-wrap" id="bar-wrap">
      <div class="disc-bar-labels">
        <span class="pay-lbl" id="bar-pay-lbl">You pay: —</span>
        <span class="save-lbl" id="bar-save-lbl">You save: —</span>
      </div>
      <div class="disc-bar">
        <div id="bar-pay" class="bar-pay" style="width:70%">70%</div>
        <div id="bar-save" class="bar-save" style="width:30%">30%</div>
      </div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Original Price</span><span class="stat-val" id="s1-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s2-lbl">Sale Price</span><span class="stat-val" id="s2-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl">You Save</span><span class="stat-val" id="s3-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl">You Pay</span><span class="stat-val" id="s4-val">—</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Percent Off Formula</h2>
    <div class="formula-box">
      <div class="formula-text">Sale Price = Original × (1 − Discount% ÷ 100)</div>
      <div class="formula-sub">Example: 30% off $100 = $100 × 0.70 = <strong>$70 sale price</strong> (save $30)</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Original Price = Sale Price ÷ (1 − Discount% ÷ 100)</div>
      <div class="formula-sub">Example: $70 sale price with 30% discount = $70 ÷ 0.70 = <strong>$100 original</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Quick math:</strong> To find 20% off, multiply by 0.80. For 30% off, multiply by 0.70. For 50% off, divide by 2. The multiplier is always (1 − discount as decimal).</p>
    </div>
  </div>

  <div class="card">
    <h2>Discount Reference Table — Common Prices</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Discount</th><th>On $25</th><th>On $50</th><th>On $100</th><th>On $200</th><th>On $500</th></tr></thead>
        <tbody>
          {[
            ['5%', '$23.75', '$47.50', '$95', '$190', '$475'],
            ['10%', '$22.50', '$45', '$90', '$180', '$450'],
            ['15%', '$21.25', '$42.50', '$85', '$170', '$425'],
            ['20%', '$20', '$40', '$80', '$160', '$400'],
            ['25%', '$18.75', '$37.50', '$75', '$150', '$375'],
            ['30%', '$17.50', '$35', '$70', '$140', '$350'],
            ['40%', '$15', '$30', '$60', '$120', '$300'],
            ['50%', '$12.50', '$25', '$50', '$100', '$250'],
            ['60%', '$10', '$20', '$40', '$80', '$200'],
            ['70%', '$7.50', '$15', '$30', '$60', '$150'],
          ].map(([disc, v25, v50, v100, v200, v500]) => (
            <tr>
              <td class="acc">{disc}</td>
              <td>{v25}</td>
              <td>{v50}</td>
              <td>{v100}</td>
              <td>{v200}</td>
              <td>{v500}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do I calculate percent off?</h3>
      <p>Sale Price = Original Price × (1 − Discount% ÷ 100). For 30% off $80: $80 × 0.70 = <strong>$56</strong> sale price. Savings = $80 − $56 = $24.</p>
    </div>
    <div class="faq-item">
      <h3>What is 20% off $50?</h3>
      <p>$50 × 0.80 = <strong>$40</strong>. You save $10. To check: 20% of $50 = $10, and $50 − $10 = $40.</p>
    </div>
    <div class="faq-item">
      <h3>What is 30% off $100?</h3>
      <p>$100 × 0.70 = <strong>$70</strong>. You save $30. This is the most commonly looked-up discount calculation.</p>
    </div>
    <div class="faq-item">
      <h3>How do I find the original price from a sale price?</h3>
      <p>Original Price = Sale Price ÷ (1 − Discount% ÷ 100). If an item is $70 after a 30% discount: $70 ÷ 0.70 = <strong>$100</strong> original price. Use the "Find Original Price" mode above.</p>
    </div>
    <div class="faq-item">
      <h3>What is 50% off $200?</h3>
      <p>$200 × 0.50 = <strong>$100</strong>. A 50% discount always halves the price. You save $100.</p>
    </div>
    <div class="faq-item">
      <h3>Is 40% off better than buy-one-get-one (BOGO)?</h3>
      <p>BOGO free on two identical items = 50% off each. BOGO 50% off two items = 25% off each. Compare: 40% off beats BOGO 50%, but BOGO free beats 40% off. Always check which deal gives you the lower price per unit.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>Percentage Calculator</h3>
        <p>Find X% of Y, what % X is of Y, and more</p>
      </a>
      <a href="/percentage-decrease-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Decrease Calculator</h3>
        <p>Find the percentage decrease between two values</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find original price before tax was added</p>
      </a>
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost</p>
      </a>
      <a href="/markup-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Markup Calculator</h3>
        <p>Find selling price from cost and markup %</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Calculate certificate of deposit earnings</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 1;

document.getElementById('btn-m1').addEventListener('click', function() { setMode(1); });
document.getElementById('btn-m2').addEventListener('click', function() { setMode(2); });
document.getElementById('calc-btn').addEventListener('click', calculate);
document.getElementById('price1').addEventListener('input', calculate);
document.getElementById('disc1').addEventListener('input', calculate);
document.getElementById('price2').addEventListener('input', calculate);
document.getElementById('disc2').addEventListener('input', calculate);
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

function fmtD(n) {
  return '$' + parseFloat(n.toFixed(2)).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
}

function setMode(m) {
  mode = m;
  document.getElementById('btn-m1').classList.toggle('active', m === 1);
  document.getElementById('btn-m2').classList.toggle('active', m === 2);
  document.getElementById('inputs-1').style.display = m === 1 ? 'block' : 'none';
  document.getElementById('inputs-2').style.display = m === 2 ? 'block' : 'none';
  document.getElementById('answer').classList.remove('show');
  document.getElementById('bar-wrap').classList.remove('show');
  document.getElementById('stats').classList.remove('show');
}

function setDiscount(pct) {
  if (mode === 1) document.getElementById('disc1').value = pct;
  else document.getElementById('disc2').value = pct;
  calculate();
}

function updateBar(payPct, savePct, payAmt, saveAmt) {
  var payEl = document.getElementById('bar-pay');
  var saveEl = document.getElementById('bar-save');
  payEl.style.width = payPct + '%';
  payEl.textContent = payPct >= 15 ? Math.round(payPct) + '%' : '';
  saveEl.style.width = savePct + '%';
  saveEl.textContent = savePct >= 10 ? Math.round(savePct) + '%' : '';
  document.getElementById('bar-pay-lbl').textContent = 'You pay: ' + fmtD(payAmt);
  document.getElementById('bar-save-lbl').textContent = 'You save: ' + fmtD(saveAmt);
  document.getElementById('bar-wrap').classList.add('show');
}

function calculate() {
  if (mode === 1) calcPct();
  else calcOriginal();
}

function calcPct() {
  var price = parseFloat(document.getElementById('price1').value);
  var disc = parseFloat(document.getElementById('disc1').value);
  if (isNaN(price) || isNaN(disc)) return;
  var sale = price * (1 - disc / 100);
  var saving = price - sale;
  var payPct = 100 - disc;
  document.getElementById('ans-label').textContent = 'Sale Price';
  document.getElementById('ans-value').textContent = fmtD(sale);
  document.getElementById('ans-unit').textContent = disc + '% off ' + fmtD(price);
  document.getElementById('ans-sub').textContent = 'You save ' + fmtD(saving) + ' (' + disc + '% off)';
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmtD(price);
  document.getElementById('s2-lbl').textContent = 'Sale Price';
  document.getElementById('s2-val').textContent = fmtD(sale);
  document.getElementById('s3-val').textContent = fmtD(saving);
  document.getElementById('s4-val').textContent = fmtD(sale);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
  updateBar(payPct, disc, sale, saving);
}

function calcOriginal() {
  var sale = parseFloat(document.getElementById('price2').value);
  var disc = parseFloat(document.getElementById('disc2').value);
  if (isNaN(sale) || isNaN(disc) || disc >= 100) return;
  var original = sale / (1 - disc / 100);
  var saving = original - sale;
  var payPct = 100 - disc;
  document.getElementById('ans-label').textContent = 'Original Price';
  document.getElementById('ans-value').textContent = fmtD(original);
  document.getElementById('ans-unit').textContent = fmtD(sale) + ' sale price + ' + disc + '% discount';
  document.getElementById('ans-sub').textContent = 'You saved ' + fmtD(saving) + ' (' + disc + '% off)';
  document.getElementById('s1-lbl').textContent = 'Original';
  document.getElementById('s1-val').textContent = fmtD(original);
  document.getElementById('s2-lbl').textContent = 'Sale Price';
  document.getElementById('s2-val').textContent = fmtD(sale);
  document.getElementById('s3-val').textContent = fmtD(saving);
  document.getElementById('s4-val').textContent = fmtD(sale);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
  updateBar(payPct, disc, sale, saving);
}
</script>
</Layout>
