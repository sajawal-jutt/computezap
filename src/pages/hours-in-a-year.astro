---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Hours in a Year Calculator",
    "url": "https://computezap.com/hours-in-a-year",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Calculate hours in a year. A standard 365-day year has 8,760 hours. A leap year has 8,784 hours. Includes work hours per year at any weekly schedule.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Hours in a Year", "item": "https://computezap.com/hours-in-a-year" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many hours are in a year?", "acceptedAnswer": { "@type": "Answer", "text": "A standard 365-day year has exactly 8,760 hours (365 x 24). A leap year (366 days) has 8,784 hours (366 x 24). For work hours, a 40-hour/week job produces 2,080 work hours per year." } },
      { "@type": "Question", "name": "How many work hours are in a year?", "acceptedAnswer": { "@type": "Answer", "text": "A standard full-time 40-hour work week produces 2,080 work hours per year (52 weeks x 40 hours). This assumes no overtime, vacation, or holidays." } },
      { "@type": "Question", "name": "How many hours are in a leap year?", "acceptedAnswer": { "@type": "Answer", "text": "A leap year (366 days) has 8,784 hours (366 x 24 = 8,784). Leap years occur every 4 years: 2024, 2028, 2032, etc." } },
      { "@type": "Question", "name": "How do I convert annual salary to hourly rate?", "acceptedAnswer": { "@type": "Answer", "text": "Divide your annual salary by 2,080 (standard work hours). Example: $60,000/year / 2,080 hours = $28.85/hour. This assumes a 40-hour work week with no overtime." } },
      { "@type": "Question", "name": "How many minutes are in a year?", "acceptedAnswer": { "@type": "Answer", "text": "A year has 525,600 minutes (8,760 hours x 60 minutes). A leap year has 527,040 minutes. This figure is famously referenced in the song from the musical Rent." } }
    ]
  }
]);
---
<Layout
  title="Hours in a Year — 8,760 Hours | ComputeZap"
  description="How many hours are in a year? A standard year has 8,760 hours. A leap year has 8,784 hours. Calculate work hours per year for any weekly schedule. Free calculator."
  canonical="/hours-in-a-year"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › Hours in a Year</nav>
  <h1>Hours in a Year</h1>
  <p>How many hours are in a year? 8,760 for standard, 8,784 for a leap year</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="quick-answer">
      <span class="qa-big">8,760 hours/year</span>
      <span class="qa-sub">365 days x 24 hours/day (standard year)</span>
    </div>

    <div class="input-group">
      <label for="year-type">Year Type</label>
      <div class="input-wrap">
        <select id="year-type" onchange="calc()" style="width:100%;padding:.65rem 1rem;border:1.5px solid #d1d5db;border-radius:8px;font-size:1rem;font-family:inherit;background:#fff;color:#111">
          <option value="365" selected>Standard year (365 days)</option>
          <option value="366">Leap year (366 days)</option>
        </select>
      </div>
    </div>

    <div class="input-group">
      <label for="work-hrs">Work Hours per Week</label>
      <div class="input-wrap">
        <input type="number" id="work-hrs" value="40" min="1" max="168" step="1" oninput="calc()" />
        <span class="input-sfx">hrs/wk</span>
      </div>
    </div>

    <div class="result-hero">
      <div class="r-label">Total Hours in This Year</div>
      <div class="r-value"><span id="r-total">8,760</span> hrs</div>
      <div class="r-sub" id="r-sub">365 days x 24 hrs/day</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Work Hours</span><span class="stat-val" id="r-work">2,080 hrs</span></div>
      <div class="stat-box"><span class="stat-lbl">Minutes</span><span class="stat-val" id="r-mins">525,600</span></div>
      <div class="stat-box"><span class="stat-lbl">Seconds</span><span class="stat-val" id="r-secs">31.5M</span></div>
      <div class="stat-box"><span class="stat-lbl">Weeks</span><span class="stat-val" id="r-weeks">52.14</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Hours Per Year: The Simple Math</h2>
    <div class="formula-box">Total Hours = Days x 24</div>
    <div class="formula-box">8,760 = 365 x 24 (standard year)</div>
    <div class="formula-box">8,784 = 366 x 24 (leap year)</div>
    <p>Work hours are based on 52 weeks per year multiplied by your weekly hours. The US standard for a full-time employee is 2,080 hours per year (52 x 40).</p>
  </div>

  <div class="card">
    <h2>Work Hours Per Year by Schedule</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Schedule</th><th>Hours/Week</th><th>Work Hours/Year</th><th>Hourly Rate on $60K</th></tr></thead>
        <tbody>
          {[
            ['Part-time','20 hrs','1,040 hrs','$57.69/hr'],
            ['Part-time (30 hrs)','30 hrs','1,560 hrs','$38.46/hr'],
            ['Full-time (standard)','40 hrs','2,080 hrs','$28.85/hr'],
            ['Extended hours','45 hrs','2,340 hrs','$25.64/hr'],
            ['Overtime','50 hrs','2,600 hrs','$23.08/hr'],
          ].map(([s,w,y,r]) => (
            <tr>
              <td>{s}</td><td>{w}</td>
              <td style="color:var(--blue);font-weight:700">{y}</td>
              <td>{r}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="tip-box" style="margin-top:1rem">
      <span class="tip-icon">💰</span>
      <p><strong>Salary to hourly:</strong> Divide annual salary by 2,080 for a quick conversion. $50,000 / 2,080 = $24.04/hr.</p>
    </div>
  </div>

  <div class="card">
    <h2>Hours Per Year — By Month, Week, Day</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Period</th><th>Total Hours</th><th>Work Hours (40hr/wk)</th></tr></thead>
        <tbody>
          {[
            ['Per Day','24 hrs','8 hrs'],
            ['Per Week','168 hrs','40 hrs'],
            ['Per Month (avg)','730 hrs','~173 hrs'],
            ['Per Quarter','2,190 hrs','~520 hrs'],
            ['Per Year (365 days)','8,760 hrs','2,080 hrs'],
            ['Per Year (leap, 366)','8,784 hrs','2,080 hrs'],
          ].map(([p,t,w]) => (
            <tr>
              <td>{p}</td>
              <td style="color:var(--blue);font-weight:700">{t}</td>
              <td>{w}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Fun Facts About Hours in a Year</h2>
    <ul>
      <li>The musical <em>Rent</em> made "525,600 minutes" famous — that's 365 x 24 x 60 minutes.</li>
      <li>A leap year adds exactly 24 hours (8,784 - 8,760 = 24 extra hours).</li>
      <li>If you slept 8 hours per night, you'd sleep 2,920 hours in a year — about a third of all hours.</li>
      <li>The US average person watches about 1,642 hours of TV per year (~4.5 hrs/day).</li>
      <li>Paid vacation of 2 weeks removes 80 hours from the 2,080-hour standard, leaving 2,000 paid work hours.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many hours are in a year?</h3>
      <p>A standard 365-day year has exactly <strong>8,760 hours</strong> (365 x 24). A leap year has <strong>8,784 hours</strong> (366 x 24).</p>
    </div>
    <div class="faq-item">
      <h3>How many work hours are in a year?</h3>
      <p>A standard 40-hour workweek produces <strong>2,080 work hours per year</strong> (52 weeks x 40 hours). Adjust the calculator above for your actual schedule.</p>
    </div>
    <div class="faq-item">
      <h3>How do I convert salary to hourly?</h3>
      <p>Divide annual salary by 2,080. Example: $62,400 / 2,080 = <strong>$30/hour</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How many minutes are in a year?</h3>
      <p>A year has <strong>525,600 minutes</strong> (8,760 x 60). A leap year has 527,040 minutes.</p>
    </div>
    <div class="faq-item">
      <h3>How many seconds are in a year?</h3>
      <p>A standard year has <strong>31,536,000 seconds</strong> (8,760 x 3,600). A leap year has 31,622,400 seconds.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/hours-in-a-month" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Month</h3>
        <p>720-744 hours per month depending on the month.</p>
      </a>
      <a href="/seconds-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Seconds in a Year</h3>
        <p>31,536,000 seconds per year — fully explained.</p>
      </a>
      <a href="/minutes-in-a-day" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Minutes in a Day</h3>
        <p>1,440 minutes in a day — interactive calculator.</p>
      </a>
      <a href="/weeks-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Weeks in a Year</h3>
        <p>52 weeks per year — plus the extra days.</p>
      </a>
      <a href="/time-to-decimal-calculator" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Time to Decimal</h3>
        <p>Convert hours and minutes for payroll timesheets.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function calc() {
  var days   = parseInt(document.getElementById('year-type').value) || 365;
  var wkHrs  = parseFloat(document.getElementById('work-hrs').value) || 40;
  var total  = days * 24;
  var workYr = Math.round(52 * wkHrs);
  var mins   = total * 60;
  var secs   = total * 3600;
  var weeks  = (days / 7).toFixed(2);

  document.getElementById('r-total').textContent = total.toLocaleString();
  document.getElementById('r-sub').textContent   = days + ' days x 24 hrs/day';
  document.getElementById('r-work').textContent  = workYr.toLocaleString() + ' hrs';
  document.getElementById('r-mins').textContent  = mins.toLocaleString();
  document.getElementById('r-secs').textContent  = (secs >= 1000000) ? (secs/1000000).toFixed(2) + 'M' : secs.toLocaleString();
  document.getElementById('r-weeks').textContent = weeks;
}

calc();
</script>
</Layout>
