.qa-big{font-size:1.5rem;font-weight:900;color:#15803d;display:block;margin-bottom:.2rem}
.qa-sub{font-size:.82rem;color:#166534}
.conv-table{width:100%;border-collapse:collapse;font-size:.875rem}
