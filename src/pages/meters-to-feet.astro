<script is:inline>
var currentMode = 'm';

function setMode(mode) {
  currentMode = mode;
  document.getElementById('btn-m').classList.toggle('active', mode === 'm');
  document.getElementById('btn-ft').classList.toggle('active', mode === 'ft');
  document.getElementById('input-lbl').textContent = mode === 'm' ? 'Meters (m)' : 'Feet (ft)';
  document.getElementById('input-sfx').textContent = mode === 'm' ? 'm' : 'ft';
  document.getElementById('main-input').value = '1';
  convert();
}

function fmt(n, dec) {
  if (n === 0) return '0';
  return parseFloat(n.toFixed(dec !== undefined ? dec : 4)).toLocaleString('en-US');
}

function toFeetInches(totalFeet) {
  var feet = Math.floor(totalFeet);
  var inches = (totalFeet - feet) * 12;
  return feet + ' ft ' + fmt(inches, 2) + ' in';
}

function convert() {
  var val = parseFloat(document.getElementById('main-input').value);
  if (isNaN(val) || val < 0) return;

  var m, ft;
  if (currentMode === 'm') {
    m  = val;
    ft = val * 3.28084;
  } else {
    ft = val;
    m  = val * 0.3048;
  }

  var inches = m * 39.3701;
  var yards  = m * 1.09361;
  var cm     = m * 100;

  if (currentMode === 'm') {
    document.getElementById('r-label').textContent = 'Feet';
    document.getElementById('r-value').textContent = fmt(ft, 4);
    document.getElementById('r-unit').textContent  = 'feet';
    document.getElementById('r-sub').textContent   = '= ' + toFeetInches(ft);
    document.getElementById('r-alt-lbl').textContent = 'Meters';
    document.getElementById('r-alt').textContent   = fmt(m, 4);
  } else {
    document.getElementById('r-label').textContent = 'Meters';
    document.getElementById('r-value').textContent = fmt(m, 4);
    document.getElementById('r-unit').textContent  = 'meters';
    document.getElementById('r-sub').textContent   = fmt(ft, 4) + ' ft = ' + fmt(m, 4) + ' m';
    document.getElementById('r-alt-lbl').textContent = 'Feet';
    document.getElementById('r-alt').textContent   = fmt(ft, 4);
  }

  document.getElementById('r-inches').textContent = fmt(inches, 2);
  document.getElementById('r-cm').textContent     = fmt(cm, 2);
  document.getElementById('r-yards').textContent  = fmt(yards, 4);
}

convert();
</script>
</Layout>
