import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Meters to Feet Converter",
    "url": "https://computezap.com/meters-to-feet",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert meters to feet instantly. 1 meter = 3.28084 feet. Free m to ft converter with feet and inches output and full conversion table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Meters to Feet", "item": "https://computezap.com/meters-to-feet" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many feet in a meter?",
        "acceptedAnswer": { "@type": "Answer", "text": "1 meter = 3.28084 feet. To convert meters to feet, multiply by 3.28084. So 2 m = 6.562 ft, 5 m = 16.404 ft, 10 m = 32.808 ft." }
      },
      {
        "@type": "Question",
        "name": "How do you convert meters to feet?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert meters to feet, multiply by 3.28084. Formula: feet = meters × 3.28084. For feet and inches: take the whole number as feet, then multiply the decimal by 12 to get inches. Example: 1.8 m = 5.906 ft = 5 ft 10.87 in." }
      },
      {
        "@type": "Question",
        "name": "How many meters in a foot?",
        "acceptedAnswer": { "@type": "Answer", "text": "1 foot = 0.3048 meters exactly. To convert feet to meters, multiply by 0.3048. So 5 ft = 1.524 m, 6 ft = 1.829 m, 10 ft = 3.048 m." }
      },
      {
        "@type": "Question",
        "name": "How many feet is 1.8 meters?",
        "acceptedAnswer": { "@type": "Answer", "text": "1.8 meters = 5 feet 10.87 inches (approximately 5'11\"). This is calculated as: 1.8 × 3.28084 = 5.906 feet. The 0.906 decimal × 12 = 10.87 inches." }
      },
      {
        "@type": "Question",
        "name": "How many feet is 2 meters?",
        "acceptedAnswer": { "@type": "Answer", "text": "2 meters = 6 feet 6.74 inches (approximately 6'7\"). Calculated as: 2 × 3.28084 = 6.562 feet. The 0.562 × 12 = 6.74 inches." }
      },
      {
        "@type": "Question",
        "name": "What is 5 feet in meters?",
        "acceptedAnswer": { "@type": "Answer", "text": "5 feet = 1.524 meters. Multiply 5 × 0.3048 = 1.524 m. Common height conversions: 5'0\" = 1.524 m, 5'6\" = 1.676 m, 5'10\" = 1.778 m, 6'0\" = 1.829 m." }
      }
    ]
  }
]);
