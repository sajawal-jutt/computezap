</div>

<script is:inline>
function calculate() {
  var days    = parseInt(document.getElementById('month-select').value);
  var hrsDay  = parseFloat(document.getElementById('hours-per-day').value) || 8;

  var total   = days * 24;
  var weekdays = Math.round(days * 5 / 7);
  var workHrs  = Math.round(weekdays * hrsDay);
  var minutes  = total * 60;
  var seconds  = total * 3600;

  document.getElementById('r-total').textContent    = total.toLocaleString('en-US');
  document.getElementById('r-sub').textContent      = days + ' days × 24 hours';
  document.getElementById('r-work').textContent     = workHrs.toLocaleString('en-US');
  document.getElementById('r-minutes').textContent  = minutes.toLocaleString('en-US');
  document.getElementById('r-seconds').textContent  = (seconds / 1000000).toFixed(2) + 'M';
  document.getElementById('r-weekdays').textContent = weekdays;
}

calculate();
</script>
</Layout>
