---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Hours in a Month Calculator",
    "url": "https://computezap.com/hours-in-a-month",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "How many hours in a month? A standard month has 730 hours (average). Calculate exact hours for any month — 28, 29, 30, or 31 days.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Hours in a Month", "item": "https://computezap.com/hours-in-a-month" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many hours in a month?",
        "acceptedAnswer": { "@type": "Answer", "text": "A standard month has 730 hours on average (365 days ÷ 12 months × 24 hours). Exact hours depend on the month: 28-day month = 672 hours, 29-day month = 696 hours (leap February), 30-day month = 720 hours, 31-day month = 744 hours." }
      },
      {
        "@type": "Question",
        "name": "How many work hours in a month?",
        "acceptedAnswer": { "@type": "Answer", "text": "A standard work month has about 160–174 work hours, based on 40 hours/week. The exact count depends on the number of weekdays. Most months have 20–23 workdays × 8 hours = 160–184 hours. The commonly used standard is 173.33 hours/month (2,080 hours/year ÷ 12)." }
      },
      {
        "@type": "Question",
        "name": "How many hours are in February?",
        "acceptedAnswer": { "@type": "Answer", "text": "February has 672 hours in a regular year (28 days × 24 hours) or 696 hours in a leap year (29 days × 24 hours). Leap years occur every 4 years (e.g., 2024, 2028, 2032)." }
      },
      {
        "@type": "Question",
        "name": "How many hours are in a 30-day month?",
        "acceptedAnswer": { "@type": "Answer", "text": "A 30-day month has exactly 720 hours (30 × 24 = 720). Months with 30 days: April, June, September, November." }
      },
      {
        "@type": "Question",
        "name": "How many hours are in a 31-day month?",
        "acceptedAnswer": { "@type": "Answer", "text": "A 31-day month has exactly 744 hours (31 × 24 = 744). Months with 31 days: January, March, May, July, August, October, December." }
      },
      {
        "@type": "Question",
        "name": "How do you convert months to hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert months to hours, multiply the number of days in the month by 24. Formula: hours = days × 24. For an average estimate, multiply months × 730.5 (average hours per month in a non-leap year)." }
      }
    ]
  }
]);
---
<Layout
  title="Hours in a Month — How Many Hours Per Month? | ComputeZap"
  description="How many hours in a month? Average: 730 hours. Exact: 672–744 hours depending on month. Free calculator for work hours, total hours, and every month of the year."
  canonical="/hours-in-a-month"
  schema={schema}
>
