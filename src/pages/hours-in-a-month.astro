<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Hours in a Month</nav>
  <h1>Hours in a Month</h1>
  <p class="hero-sub">How many hours per month — total hours, work hours, and every month of the year</p>
</div>

<div class="calc-wrap">
  <div class="calc-left">
    <div class="card">
      <div class="quick-answer">
        <span class="qa-big">730 hours/month</span>
        <span class="qa-sub">Average — exact: 672 to 744 hours</span>
      </div>

      <div class="card-header">
        <span class="card-step">1</span>
        <h2 class="card-title">Select Month</h2>
      </div>

      <div class="field-group">
        <label class="field-lbl" for="month-select">Month</label>
        <select id="month-select" class="field-select" onchange="calculate()">
          <option value="31">January (31 days)</option>
          <option value="28">February — Regular Year (28 days)</option>
          <option value="29">February — Leap Year (29 days)</option>
          <option value="31">March (31 days)</option>
          <option value="30">April (30 days)</option>
          <option value="31">May (31 days)</option>
          <option value="30">June (30 days)</option>
          <option value="31">July (31 days)</option>
          <option value="31">August (31 days)</option>
          <option value="30">September (30 days)</option>
          <option value="31">October (31 days)</option>
          <option value="30">November (30 days)</option>
          <option value="31">December (31 days)</option>
        </select>
      </div>

      <div class="field-group">
        <label class="field-lbl" for="hours-per-day">Hours per Day (work)</label>
        <input type="number" id="hours-per-day" class="field-input" value="8" min="1" max="24" step="0.5" oninput="calculate()" />
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-step">2</span>
        <h2 class="card-title">Result</h2>
      </div>

      <div class="answer-box">
        <div class="a-label">Total Hours in Month</div>
        <div class="a-value" id="r-total">744</div>
        <div class="a-unit">hours</div>
        <div class="a-sub" id="r-sub">31 days × 24 hours</div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-lbl">Work Hours</span>
