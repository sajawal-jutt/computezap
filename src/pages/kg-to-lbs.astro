      { "@type": "Question", "name": "How many pounds in 1 kg?", "acceptedAnswer": { "@type": "Answer", "text": "1 kilogram equals 2.20462 pounds. To convert kg to lbs, multiply by 2.20462." } },
      { "@type": "Question", "name": "How do I convert kg to lbs?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply kilograms by 2.20462. Formula: lbs = kg × 2.20462. Example: 70 kg × 2.20462 = 154.32 lbs." } },
      { "@type": "Question", "name": "What is 100 kg in pounds?", "acceptedAnswer": { "@type": "Answer", "text": "100 kg = 220.46 lbs. Multiply 100 × 2.20462 = 220.462 pounds." } },
      { "@type": "Question", "name": "What is 70 kg in pounds?", "acceptedAnswer": { "@type": "Answer", "text": "70 kg = 154.32 lbs. Multiply 70 × 2.20462 = 154.324 pounds." } },
      { "@type": "Question", "name": "What is 50 kg in pounds?", "acceptedAnswer": { "@type": "Answer", "text": "50 kg = 110.23 lbs. Multiply 50 × 2.20462 = 110.231 pounds." } },
      { "@type": "Question", "name": "How do I convert lbs to kg?", "acceptedAnswer": { "@type": "Answer", "text": "Divide lbs by 2.20462, or multiply by 0.453592. Formula: kg = lbs ÷ 2.20462. Example: 150 lbs ÷ 2.20462 = 68.04 kg." } },
      { "@type": "Question", "name": "What is 80 kg in pounds?", "acceptedAnswer": { "@type": "Answer", "text": "80 kg = 176.37 lbs. Multiply 80 × 2.20462 = 176.370 pounds." } },
      { "@type": "Question", "name": "What is a stone in kg and lbs?", "acceptedAnswer": { "@type": "Answer", "text": "1 stone = 14 pounds = 6.35029 kg. Stones are used in the UK for body weight." } }
    ]
  }
]);
