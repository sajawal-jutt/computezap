<script is:inline>
var mode = 'kg';

function fmt(v, d) {
  return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString();
}

function fmtSt(lbs) {
  var st = Math.floor(lbs / 14);
  var lb = parseFloat((lbs % 14).toFixed(2));
  return st + ' st ' + lb + ' lb';
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value) || 0;
  var lbs, kg, oz, g;
  if (mode === 'kg') {
    kg = val; lbs = val * 2.20462; oz = lbs * 16; g = val * 1000;
    document.getElementById('r-main').textContent = fmt(lbs, 2);
    document.getElementById('r-unit').textContent = 'lbs';
    document.getElementById('r-sub').textContent = fmt(val, 2) + ' kg = ' + fmt(lbs, 2) + ' lbs';
    document.getElementById('res-lbl').textContent = 'Pounds';
    document.getElementById('s1-lbl').textContent = 'Pounds';
    document.getElementById('s1-val').textContent = fmt(lbs, 2) + ' lbs';
    document.getElementById('s2-lbl').textContent = 'Stones & Pounds';
    document.getElementById('s2-val').textContent = fmtSt(lbs);
    document.getElementById('s3-lbl').textContent = 'Ounces';
    document.getElementById('s3-val').textContent = fmt(oz, 1) + ' oz';
    document.getElementById('s4-lbl').textContent = 'Grams';
    document.getElementById('s4-val').textContent = g.toLocaleString() + ' g';
  } else {
    lbs = val; kg = val * 0.453592; g = kg * 1000;
    document.getElementById('r-main').textContent = fmt(kg, 3);
    document.getElementById('r-unit').textContent = 'kg';
    document.getElementById('r-sub').textContent = fmt(val, 2) + ' lbs = ' + fmt(kg, 3) + ' kg';
    document.getElementById('res-lbl').textContent = 'Kilograms';
    document.getElementById('s1-lbl').textContent = 'Kilograms';
    document.getElementById('s1-val').textContent = fmt(kg, 3) + ' kg';
    document.getElementById('s2-lbl').textContent = 'Grams';
    document.getElementById('s2-val').textContent = fmt(g, 0) + ' g';
    document.getElementById('s3-lbl').textContent = 'Stones & Pounds';
    document.getElementById('s3-val').textContent = fmtSt(val);
    document.getElementById('s4-lbl').textContent = 'Ounces';
    document.getElementById('s4-val').textContent = fmt(val * 16, 1) + ' oz';
  }
}

function setMode(m) {
  mode = m;
  var isKg = m === 'kg';
  document.getElementById('btn-kg').classList.toggle('active', isKg);
  document.getElementById('btn-lb').classList.toggle('active', !isKg);
  document.getElementById('inp-lbl').textContent = isKg ? 'Kilograms (kg)' : 'Pounds (lbs)';
  document.getElementById('inp-sfx').textContent = isKg ? 'kg' : 'lbs';
  var presets = document.getElementById('preset-wrap');
  presets.innerHTML = (isKg ? [1,5,10,50,60,70,80,90,100] : [1,10,50,100,110,150,200])
    .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
  document.getElementById('amount').value = isKg ? 70 : 154;
  convert();
}

function setVal(v) {
  document.getElementById('amount').value = v;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
