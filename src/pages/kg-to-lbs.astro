      <ul>
        <li><strong>60 kg</strong> = 132.28 lbs = 9 st 6 lb</li>
        <li><strong>70 kg</strong> = 154.32 lbs = 11 st 0 lb</li>
        <li><strong>75 kg</strong> = 165.35 lbs = 11 st 11 lb</li>
