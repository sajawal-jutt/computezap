<script is:inline>
  var mode = 'kg';

  document.getElementById('btn-kg').addEventListener('click', function() { setMode('kg'); });
  document.getElementById('btn-lb').addEventListener('click', function() { setMode('lb'); });
  document.getElementById('calc-btn').addEventListener('click', convert);
  document.getElementById('amount').addEventListener('input', convert);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') convert(); });

  document.getElementById('amount').value = 70;
  convert();

  function fmt(v, d) {
    return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString();
  }

  function fmtSt(lbs) {
    var st = Math.floor(lbs / 14);
    var lb = parseFloat((lbs % 14).toFixed(2));
    return st + ' st ' + lb + ' lb';
  }

  function setMode(m) {
    mode = m;
    var isKg = m === 'kg';
    document.getElementById('btn-kg').classList.toggle('active', isKg);
    document.getElementById('btn-lb').classList.toggle('active', !isKg);
    document.getElementById('inp-lbl').textContent = isKg ? 'Kilograms (kg)' : 'Pounds (lbs)';
    document.getElementById('inp-sfx').textContent = isKg ? 'kg' : 'lbs';
    var presets = document.getElementById('preset-wrap');
    presets.innerHTML = (isKg ? [1,5,10,50,60,70,80,90,100] : [1,10,50,100,110,150,200])
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
    document.getElementById('amount').value = isKg ? 70 : 154;
    convert();
  }

  function convert() {
    var val = parseFloat(document.getElementById('amount').value);
    if (isNaN(val) || val < 0) return;
    var lbs, kg, oz, g;
    if (mode === 'kg') {
      kg = val; lbs = val * 2.20462; oz = lbs * 16; g = val * 1000;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' kg =';
      document.getElementById('ans-value').textContent = fmt(lbs, 2);
      document.getElementById('ans-unit').textContent = 'pounds (lbs)';
      document.getElementById('ans-sub').textContent = fmt(val, 2) + ' × 2.20462 = ' + fmt(lbs, 2) + ' lbs';
      document.getElementById('s1-lbl').textContent = 'Stones & Pounds';
      document.getElementById('s1-val').textContent = fmtSt(lbs);
      document.getElementById('s2-lbl').textContent = 'Ounces';
      document.getElementById('s2-val').textContent = fmt(oz, 1) + ' oz';
      document.getElementById('s3-lbl').textContent = 'Grams';
      document.getElementById('s3-val').textContent = g.toLocaleString('en-US') + ' g';
      document.getElementById('s4-lbl').textContent = 'Metric Tons';
      document.getElementById('s4-val').textContent = fmt(val / 1000, 4) + ' t';
    } else {
      lbs = val; kg = val * 0.453592; g = kg * 1000;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' lbs =';
      document.getElementById('ans-value').textContent = fmt(kg, 3);
      document.getElementById('ans-unit').textContent = 'kilograms (kg)';
      document.getElementById('ans-sub').textContent = fmt(val, 2) + ' ÷ 2.20462 = ' + fmt(kg, 3) + ' kg';
      document.getElementById('s1-lbl').textContent = 'Grams';
      document.getElementById('s1-val').textContent = fmt(g, 0) + ' g';
      document.getElementById('s2-lbl').textContent = 'Stones & Pounds';
      document.getElementById('s2-val').textContent = fmtSt(val);
      document.getElementById('s3-lbl').textContent = 'Ounces';
      document.getElementById('s3-val').textContent = fmt(val * 16, 1) + ' oz';
      document.getElementById('s4-lbl').textContent = 'Metric Tons';
      document.getElementById('s4-val').textContent = fmt(kg / 1000, 5) + ' t';
    }
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }

  function setVal(v) {
    document.getElementById('amount').value = v;
    convert();
  }
</script>
</Layout>
