---
import Layout from '../layouts/Layout.astro';

export function getStaticPaths() {
  const vals = [];
  for (let y = 1; y <= 100; y++) vals.push(y);
  [110, 120, 150, 200, 250, 300, 400, 500, 1000].forEach(y => vals.push(y));
  return vals.map(y => ({ params: { yards: String(y) } }));
}

const yards = parseInt(Astro.params.yards);
const meters = Math.round(yards * 0.9144 * 10000) / 10000;
const metersRound = Math.round(yards * 0.9144 * 100) / 100;
const cm = Math.round(yards * 91.44 * 100) / 100;
const feet = yards * 3;
const inches = yards * 36;
const miles = Math.round(yards / 1760 * 10000) / 10000;
const km = Math.round(yards * 0.0009144 * 10000) / 10000;
const mm = Math.round(yards * 914.4);

// nearby yards for cross-links
const allYards = [];
for (let y = 1; y <= 100; y++) allYards.push(y);
[110, 120, 150, 200, 250, 300, 400, 500, 1000].forEach(y => allYards.push(y));
const nearby = allYards.filter(y => y !== yards).sort((a, b) => Math.abs(a - yards) - Math.abs(b - yards)).slice(0, 8);

function yardsContext(y) {
  if (y <= 3)   return 'About the length of a large doorway or car hood';
  if (y <= 10)  return 'Common fabric/carpet purchase — fits a small room or dress';
  if (y <= 25)  return '25 yards = standard US short-course swimming pool length';
  if (y <= 50)  return 'Half the length of an American football field end-to-end';
  if (y <= 100) return '100 yards = one American football field (end zone to end zone)';
  if (y <= 200) return 'Typical short-to-mid iron golf shot distance';
  if (y <= 300) return 'Typical average driver distance on a golf course';
  if (y <= 500) return 'Long-range shot — sniper/military accuracy benchmark';
  return 'Long distance — used in military, surveying, and golf contexts';
}

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": `${yards} Yards to Meters — ${metersRound} m | ComputeZap`,
    "url": `https://computezap.com/${yards}-yards-to-meters`,
    "description": `${yards} yards = ${metersRound} meters. Convert ${yards} yards to meters, cm, feet, and inches instantly.`
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Yards to Meters", "item": "https://computezap.com/yards-to-meters" },
      { "@type": "ListItem", "position": 3, "name": `${yards} Yards to Meters`, "item": `https://computezap.com/${yards}-yards-to-meters` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `How many meters is ${yards} yards?`,
        "acceptedAnswer": { "@type": "Answer", "text": `${yards} yards = ${metersRound} meters. Multiply ${yards} by 0.9144 to convert yards to meters. Full precision: ${yards} × 0.9144 = ${meters} m.` }
      },
      {
        "@type": "Question",
        "name": `What is ${yards} yards in feet?`,
        "acceptedAnswer": { "@type": "Answer", "text": `${yards} yards = ${feet} feet. There are exactly 3 feet in 1 yard, so ${yards} × 3 = ${feet} feet.` }
      },
      {
        "@type": "Question",
        "name": `How do I convert ${yards} yards to meters?`,
        "acceptedAnswer": { "@type": "Answer", "text": `Multiply ${yards} by 0.9144. Formula: ${yards} yd × 0.9144 = ${metersRound} m. One yard is defined as exactly 0.9144 meters (international yard, since 1959).` }
      }
    ]
  }
]);
---
<Layout
  title={`${yards} Yards to Meters — How Many Meters is ${yards} Yards? | ComputeZap`}
  description={`${yards} yards = ${metersRound} meters. Convert ${yards} yards to meters, centimeters, feet, and inches instantly. Free converter with formula.`}
  canonical={`/${yards}-yards-to-meters`}
  schema={schema}
>
<style is:global>
.hero{text-align:center;padding:2rem 1rem 1.5rem}
.hero h1{font-size:2rem;color:#111;margin:.5rem 0 .4rem;font-weight:800;letter-spacing:-.02em}
.hero-sub{color:#64748b;margin:0;font-size:1.05rem}
.breadcrumb{font-size:.82rem;color:#94a3b8;margin-bottom:.75rem}
.breadcrumb a{color:var(--blue);text-decoration:none}
.calc-wrap{display:grid;grid-template-columns:390px 1fr;gap:1.75rem;max-width:1120px;margin:0 auto;padding:0 1rem 3.5rem;align-items:start}
.calc-left{position:sticky;top:1rem}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.card:last-child{margin-bottom:0}
.card h2{font-size:1.05rem;font-weight:700;color:#111;margin:0 0 .9rem}
.content-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.content-card h2{font-size:1.05rem;font-weight:700;color:#111;margin:0 0 .8rem}
.content-card p{color:#444;line-height:1.75;font-size:.93rem;margin:0 0 .7rem}
.content-card p:last-child{margin-bottom:0}

.answer-hero{background:linear-gradient(135deg,#1d4ed8 0%,#2563eb 60%,#3b82f6 100%);border-radius:14px;padding:1.75rem 1.5rem 1.5rem;text-align:center;margin-bottom:1rem;box-shadow:0 6px 24px rgba(37,99,235,.22)}
.a-label{font-size:.68rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem;font-weight:700}
.a-value{font-size:2.8rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.a-unit{font-size:1rem;font-weight:600;color:rgba(255,255,255,.8);margin-top:.3rem}
.a-sub{font-size:.88rem;color:rgba(255,255,255,.7);margin-top:.4rem}

.stats-row{display:grid;grid-template-columns:1fr 1fr;gap:.55rem}
.stat-box{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.85rem .75rem;text-align:center}
.stat-lbl{display:block;font-size:.62rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem;font-weight:700}
.stat-val{display:block;font-size:.95rem;font-weight:800;color:#1e293b}

.ctx-box{background:#f0fdf4;border:1.5px solid #86efac;border-radius:10px;padding:.75rem 1rem;margin-bottom:1rem;font-size:.82rem;color:#15803d;font-weight:600;text-align:center}

.formula-box{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:12px;padding:1rem 1.25rem;margin:.75rem 0;text-align:center}
.formula-text{font-size:1rem;font-weight:800;color:#1e293b;font-family:monospace}
.formula-sub{font-size:.8rem;color:#64748b;margin-top:.3rem}

.tip-box{display:flex;gap:.75rem;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:.9rem 1rem;margin:.85rem 0}
.tip-icon{font-size:1.1rem;flex-shrink:0;margin-top:.05rem}
.tip-box p{margin:0;font-size:.875rem;color:#1e40af;line-height:1.6}

.ref-tbl{width:100%;border-collapse:collapse;font-size:.875rem}
.ref-tbl th{background:#f8fafc;padding:.6rem .85rem;text-align:left;font-size:.68rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid #e2e8f0}
.ref-tbl td{padding:.65rem .85rem;border-bottom:1px solid #f3f4f6;color:#374151}
.ref-tbl tr:last-child td{border-bottom:none}
.ref-tbl tbody tr:hover td{background:#f8faff}
.ref-tbl .hl td{background:#eff6ff;font-weight:700;color:#1d4ed8}
.ref-tbl .hl:hover td{background:#dbeafe}
.ref-tbl a{color:var(--blue);text-decoration:none;font-weight:600}
.ref-tbl a:hover{text-decoration:underline}

.nearby-grid{display:flex;flex-wrap:wrap;gap:.4rem}
.nearby-btn{padding:.35rem .75rem;font-size:.82rem;font-weight:700;background:#f1f5f9;border:1.5px solid #e2e8f0;border-radius:7px;color:var(--blue);text-decoration:none;transition:all .15s}
.nearby-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue);text-decoration:none}

.faq-item{border-bottom:1px solid #f3f4f6;padding:.9rem 0}
.faq-item:last-child{border-bottom:none;padding-bottom:0}
.faq-item h3{font-size:.9rem;color:#111;margin:0 0 .35rem;font-weight:700}
.faq-item p{color:#555;font-size:.865rem;margin:0;line-height:1.65}

.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}
.next-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1rem;border-top:3px solid var(--blue);text-decoration:none;display:block}
.next-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.08);text-decoration:none}
.next-tag{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--blue);margin-bottom:.3rem;display:block}
.next-card h3{font-size:.88rem;font-weight:700;color:#111;margin:0 0 .25rem}
.next-card p{font-size:.78rem;color:#64748b;margin:0;line-height:1.5}

@media(max-width:768px){
  .calc-wrap{grid-template-columns:1fr}
  .calc-left{position:static}
  .hero h1{font-size:1.65rem}
  .a-value{font-size:2.1rem}
  .next-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){.next-grid{grid-template-columns:1fr}}
</style>

<div class="hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/yards-to-meters">Yards to Meters</a> › {yards} Yards to Meters</nav>
  <h1>{yards} Yards to Meters</h1>
  <p class="hero-sub">How many meters is {yards} yards? — instant answer with full breakdown</p>
</div>

<div class="calc-wrap">

  <!-- LEFT -->
  <div class="calc-left">

    <div class="card">
      <div class="answer-hero">
        <div class="a-label">{yards} Yards =</div>
        <div class="a-value">{metersRound}</div>
        <div class="a-unit">meters (m)</div>
        <div class="a-sub">{yards} yd × 0.9144 = {metersRound} m</div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-lbl">Centimeters</span>
          <span class="stat-val">{cm} cm</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">Feet</span>
          <span class="stat-val">{feet} ft</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">Inches</span>
          <span class="stat-val">{inches} in</span>
        </div>
        <div class="stat-box">
          <span class="stat-lbl">Millimeters</span>
          <span class="stat-val">{mm} mm</span>
        </div>
      </div>
    </div>

    <div class="card">
      <h2>Other Nearby Values</h2>
      <div class="nearby-grid">
        {nearby.map(y => (
          <a href={`/${y}-yards-to-meters`} class="nearby-btn">{y} yd</a>
        ))}
      </div>
    </div>

  </div>

  <!-- RIGHT -->
  <div class="calc-right">

    <div class="content-card">
      <h2>How to Convert {yards} Yards to Meters</h2>
      <div class="formula-box">
        <div class="formula-text">{yards} yd × 0.9144 = {metersRound} m</div>
        <div class="formula-sub">1 yard = 0.9144 meters (exact, defined since 1959)</div>
      </div>
      <p><strong>Quick estimate:</strong> Multiply yards by 0.9 for a close approximation → {yards} × 0.9 = {Math.round(yards * 0.9 * 100)/100} m (off by {Math.round(Math.abs(metersRound - yards*0.9)*100)/100} m).</p>
      <p><strong>In feet:</strong> {yards} yards = {feet} feet exactly (1 yard = 3 feet).</p>
      <div class="tip-box">
        <span class="tip-icon">📏</span>
        <p><strong>Context:</strong> {yardsContext(yards)}.</p>
      </div>
    </div>

    <div class="content-card">
      <h2>Yards to Meters — Values Near {yards} yd</h2>
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead>
            <tr><th>Yards (yd)</th><th>Meters (m)</th><th>Feet</th><th>Centimeters</th></tr>
          </thead>
          <tbody>
            {[yards - 5, yards - 2, yards - 1, yards, yards + 1, yards + 2, yards + 5]
              .filter(y => y > 0)
              .map(y => {
                const ym = Math.round(y * 0.9144 * 100) / 100;
                const yft = y * 3;
                const ycm = Math.round(y * 91.44 * 10) / 10;
                return (
                  <tr class={y === yards ? 'hl' : ''}>
                    <td>{y === yards ? <strong>{y} yd ←</strong> : <a href={`/${y}-yards-to-meters`}>{y} yd</a>}</td>
                    <td>{y === yards ? <strong>{ym} m</strong> : `${ym} m`}</td>
                    <td>{yft} ft</td>
                    <td>{ycm} cm</td>
                  </tr>
                );
              })
            }
          </tbody>
        </table>
      </div>
      <p style="margin-top:.75rem;font-size:.82rem;color:#64748b">→ Use the full <a href="/yards-to-meters">yards to meters converter</a> for any value.</p>
    </div>

    <div class="content-card">
      <h2>Common Yards to Meters Reference</h2>
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead>
            <tr><th>Yards</th><th>Meters</th><th>Feet</th><th>Common Use</th></tr>
          </thead>
          <tbody>
            <tr><td><a href="/1-yards-to-meters">1 yd</a></td><td>0.91 m</td><td>3 ft</td><td>Fabric / doorway width</td></tr>
            <tr><td><a href="/5-yards-to-meters">5 yd</a></td><td>4.57 m</td><td>15 ft</td><td>Small carpet area</td></tr>
            <tr><td><a href="/10-yards-to-meters">10 yd</a></td><td>9.14 m</td><td>30 ft</td><td>First down in American football</td></tr>
            <tr><td><a href="/25-yards-to-meters">25 yd</a></td><td>22.86 m</td><td>75 ft</td><td>US short-course pool length</td></tr>
            <tr><td><a href="/50-yards-to-meters">50 yd</a></td><td>45.72 m</td><td>150 ft</td><td>Half football field</td></tr>
            <tr><td><a href="/100-yards-to-meters">100 yd</a></td><td>91.44 m</td><td>300 ft</td><td>Full football field</td></tr>
            <tr><td><a href="/200-yards-to-meters">200 yd</a></td><td>182.88 m</td><td>600 ft</td><td>Typical short iron golf shot</td></tr>
            <tr><td><a href="/300-yards-to-meters">300 yd</a></td><td>274.32 m</td><td>900 ft</td><td>Average driver golf distance</td></tr>
            <tr><td><a href="/500-yards-to-meters">500 yd</a></td><td>457.2 m</td><td>1500 ft</td><td>Long range / military</td></tr>
            <tr><td><a href="/1000-yards-to-meters">1000 yd</a></td><td>914.4 m</td><td>3000 ft</td><td>Nearly 1 km</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="content-card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-item">
        <h3>How many meters is {yards} yards?</h3>
        <p><strong>{yards} yards = {metersRound} meters.</strong> Multiply {yards} by 0.9144 to get the exact value. One yard equals exactly 0.9144 meters by international definition.</p>
      </div>
      <div class="faq-item">
        <h3>What is {yards} yards in feet?</h3>
        <p>{yards} yards = <strong>{feet} feet</strong>. There are exactly 3 feet per yard — so {yards} × 3 = {feet} ft.</p>
      </div>
      <div class="faq-item">
        <h3>Is a yard bigger than a meter?</h3>
        <p>A yard is slightly <strong>smaller</strong> than a meter. 1 yard = 0.9144 m, so a meter is about 9.36% longer than a yard. 1 meter = 1.09361 yards.</p>
      </div>
    </div>

    <div class="content-card">
      <h2>Related Converters</h2>
      <div class="next-grid">
        <a href="/yards-to-meters" class="next-card">
          <span class="next-tag">Length</span>
          <h3>Yards to Meters</h3>
          <p>Convert any yards value to meters instantly</p>
        </a>
        <a href="/meters-to-feet" class="next-card">
          <span class="next-tag">Length</span>
          <h3>Meters to Feet</h3>
          <p>Convert meters to feet and inches</p>
        </a>
        <a href="/cm-to-inches" class="next-card">
          <span class="next-tag">Length</span>
          <h3>cm to Inches</h3>
          <p>Convert centimeters to inches</p>
        </a>
        <a href="/km-to-miles" class="next-card">
          <span class="next-tag">Length</span>
          <h3>km to Miles</h3>
          <p>Convert kilometers to miles</p>
        </a>
        <a href="/kg-to-lbs" class="next-card">
          <span class="next-tag">Weight</span>
          <h3>kg to lbs</h3>
          <p>Convert kilograms to pounds</p>
        </a>
        <a href="/percentage-calculator" class="next-card">
          <span class="next-tag">Math</span>
          <h3>Percentage Calculator</h3>
          <p>Calculate percentages instantly</p>
        </a>
      </div>
    </div>

  </div>
</div>
</Layout>
