---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Fahrenheit to Celsius Converter",
    "url": "https://computezap.com/fahrenheit-to-celsius",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert Fahrenheit to Celsius instantly. Formula: °C = (°F - 32) × 5/9. Free °F to °C converter with full temperature conversion table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Fahrenheit to Celsius", "item": "https://computezap.com/fahrenheit-to-celsius" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do you convert Fahrenheit to Celsius?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert Fahrenheit to Celsius, subtract 32 then multiply by 5/9. Formula: °C = (°F - 32) × 5/9. Example: 98.6°F = (98.6 - 32) × 5/9 = 37°C." }
      },
      {
        "@type": "Question",
        "name": "What is 100°F in Celsius?",
        "acceptedAnswer": { "@type": "Answer", "text": "100°F = 37.78°C. Calculated as (100 - 32) × 5/9 = 68 × 0.5556 = 37.78°C. Note: Normal human body temperature is 98.6°F = 37°C." }
      },
      {
        "@type": "Question",
        "name": "What is 72°F in Celsius?",
        "acceptedAnswer": { "@type": "Answer", "text": "72°F = 22.22°C. Calculated as (72 - 32) × 5/9 = 40 × 0.5556 = 22.22°C. Room temperature is typically 68–77°F (20–25°C)." }
      },
      {
        "@type": "Question",
        "name": "What is 32°F in Celsius?",
        "acceptedAnswer": { "@type": "Answer", "text": "32°F = 0°C. This is the freezing point of water. Calculated as (32 - 32) × 5/9 = 0°C." }
      },
      {
        "@type": "Question",
        "name": "What temperature is the same in Fahrenheit and Celsius?",
        "acceptedAnswer": { "@type": "Answer", "text": "Fahrenheit and Celsius are equal at -40°. Both scales meet at -40°F = -40°C. This is derived by solving (°F - 32) × 5/9 = °F." }
      },
      {
        "@type": "Question",
        "name": "What is the formula to convert Celsius to Fahrenheit?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert Celsius to Fahrenheit: °F = (°C × 9/5) + 32. Example: 100°C = (100 × 9/5) + 32 = 180 + 32 = 212°F (boiling point of water)." }
      }
    ]
  }
]);
