<Layout
  title="Fahrenheit to Celsius Converter — °F to °C | ComputeZap"
  description="Convert Fahrenheit to Celsius instantly. Formula: °C = (°F - 32) × 5/9. Free °F to °C and °C to °F converter with full temperature table including body temp, freezing, boiling."
  canonical="/fahrenheit-to-celsius"
  schema={schema}
