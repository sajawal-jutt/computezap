var tempDescriptions = {
  '-40': 'Same in °F and °C',
  '0':   'Freezing point of water',
  '20':  'Comfortable room temp',
  '37':  'Normal body temperature',
  '38':  'Fever threshold',
  '100': 'Boiling point of water'
};

function setMode(mode) {
  currentMode = mode;
  document.getElementById('btn-f').classList.toggle('active', mode === 'f');
  document.getElementById('btn-c').classList.toggle('active', mode === 'c');
  document.getElementById('input-lbl').textContent = mode === 'f' ? 'Fahrenheit (°F)' : 'Celsius (°C)';
  document.getElementById('input-sfx').textContent = mode === 'f' ? '°F' : '°C';
  document.getElementById('main-input').value = mode === 'f' ? '98.6' : '37';
  convert();
}

function getStatus(c) {
  if (c <= -10)  return 'Freezing';
  if (c <= 0)    return 'Below Zero';
  if (c <= 10)   return 'Very Cold';
  if (c <= 18)   return 'Cold';
  if (c <= 24)   return 'Comfortable';
  if (c <= 30)   return 'Warm';
  if (c < 37)    return 'Hot';
  if (c === 37)  return 'Body Temp';
  if (c < 38)    return 'Slightly High';
  if (c < 40)    return 'Fever';
  return 'High Fever';
}

function fmt(n, dec) {
  return parseFloat(n.toFixed(dec !== undefined ? dec : 2)).toLocaleString('en-US');
}

function convert() {
  var val = parseFloat(document.getElementById('main-input').value);
  if (isNaN(val)) return;

  var f, c;
  if (currentMode === 'f') {
    f = val;
    c = (val - 32) * 5 / 9;
  } else {
    c = val;
    f = (val * 9 / 5) + 32;
  }

  var k = c + 273.15;
  var r = f + 459.67;

  if (currentMode === 'f') {
    document.getElementById('r-label').textContent   = 'Celsius';
    document.getElementById('r-value').textContent   = fmt(c, 2);
    document.getElementById('r-unit').textContent    = '°C';
    document.getElementById('r-sub').textContent     = fmt(f, 2) + '°F = ' + fmt(c, 2) + '°C';
    document.getElementById('r-alt-lbl').textContent = '°F';
    document.getElementById('r-alt').textContent     = fmt(f, 2);
  } else {
    document.getElementById('r-label').textContent   = 'Fahrenheit';
    document.getElementById('r-value').textContent   = fmt(f, 2);
    document.getElementById('r-unit').textContent    = '°F';
    document.getElementById('r-sub').textContent     = fmt(c, 2) + '°C = ' + fmt(f, 2) + '°F';
    document.getElementById('r-alt-lbl').textContent = '°C';
    document.getElementById('r-alt').textContent     = fmt(c, 2);
  }

  document.getElementById('r-kelvin').textContent  = fmt(k, 2);
  document.getElementById('r-rankine').textContent = fmt(r, 2);
  document.getElementById('r-status').textContent  = getStatus(c);
}

convert();
</script>
</Layout>
