            <tr><td>1 fluid ounce</td><td>1 fl oz</td><td>0.03125 qt</td><td>0.0078 gal</td></tr>
            <tr><td>1 cup</td><td>8 fl oz</td><td>0.25 qt</td><td>0.0625 gal</td></tr>
            <tr><td>1 pint</td><td>16 fl oz</td><td>0.5 qt</td><td>0.125 gal</td></tr>
            <tr class="highlight-row"><td><strong>1 quart</strong></td><td><strong>32 fl oz</strong></td><td><strong>1 qt</strong></td><td><strong>0.25 gal</strong></td></tr>
            <tr><td>1 half-gallon</td><td>64 fl oz</td><td>2 qt</td><td>0.5 gal</td></tr>
