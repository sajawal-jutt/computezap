    <!-- Formula -->
    <div class="content-card">
      <h2>Oz to Quarts Formula</h2>
      <div class="formula-box">
        <div class="formula-text">Quarts = Fluid Ounces ÷ 32</div>
        <div class="formula-sub">Because 1 US quart = 32 US fluid ounces</div>
      </div>
      <p><strong>Example:</strong> 48 oz ÷ 32 = <strong>1.5 quarts</strong></p>
      <p><strong>Reverse (quarts to oz):</strong> Multiply quarts × 32. So 2.5 quarts × 32 = 80 oz.</p>
      <div class="tip-box">
        <span class="tip-icon">💡</span>
        <p><strong>Quick trick:</strong> 32 oz = 1 quart. 16 oz = ½ quart. 64 oz = 2 quarts. 128 oz = 1 gallon (4 quarts).</p>
      </div>
    </div>

    <!-- Common Conversions Table -->
    <div class="content-card">
      <h2>Common Oz to Quarts Conversions</h2>
      <div style="overflow-x:auto">
        <table class="conv-table">
          <thead>
