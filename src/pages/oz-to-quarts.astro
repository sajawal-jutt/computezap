</div>

<script is:inline>
function convert() {
  var oz = parseFloat(document.getElementById('oz-input').value);
  if (isNaN(oz) || oz < 0) {
    document.getElementById('r-quarts').textContent = '—';
    document.getElementById('r-sub').textContent = 'Enter a value above';
    return;
  }

  var quarts  = oz / 32;
  var pints   = oz / 16;
  var cups    = oz / 8;
  var gallons = oz / 128;
  var ml      = oz * 29.5735;

  function fmt(n) {
    if (n === 0) return '0';
    if (Number.isInteger(n)) return n.toString();
    // up to 4 significant decimal places, trim trailing zeros
    return parseFloat(n.toFixed(4)).toString();
  }

  document.getElementById('r-quarts').textContent  = fmt(quarts);
  document.getElementById('r-sub').textContent     = oz + ' fl oz = ' + fmt(quarts) + (quarts === 1 ? ' quart' : ' quarts');
  document.getElementById('r-pints').textContent   = fmt(pints);
  document.getElementById('r-cups').textContent    = fmt(cups);
  document.getElementById('r-gallons').textContent = fmt(gallons);
  document.getElementById('r-ml').textContent      = parseFloat(ml.toFixed(2)).toLocaleString();
}

convert();
</script>
</Layout>
