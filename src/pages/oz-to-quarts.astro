        <div class="input-wrap">
          <input type="number" id="oz-input" class="field-input" value="32" min="0" step="1" oninput="convert()" placeholder="32" />
          <span class="input-sfx">fl oz</span>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <span class="card-step">2</span>
        <h2 class="card-title">Result</h2>
      </div>

      <div class="result-hero">
        <div class="r-label">Quarts</div>
        <div class="r-value" id="r-quarts">1</div>
        <div class="r-sub" id="r-sub">32 fl oz = 1 quart</div>
      </div>

      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-lbl">Pints</span>
          <span class="stat-val" id="r-pints">2</span>
        </div>
