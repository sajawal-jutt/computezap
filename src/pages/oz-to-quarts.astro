            <tr><td>4 oz</td><td>0.125 qt</td><td>0.25 pt</td><td>0.5 c</td></tr>
            <tr><td>8 oz</td><td>0.25 qt</td><td>0.5 pt</td><td>1 cup</td></tr>
            <tr><td>12 oz</td><td>0.375 qt</td><td>0.75 pt</td><td>1.5 c</td></tr>
            <tr class="highlight-row"><td><strong>16 oz</strong></td><td><strong>0.5 qt</strong></td><td><strong>1 pint</strong></td><td><strong>2 cups</strong></td></tr>
            <tr><td>24 oz</td><td>0.75 qt</td><td>1.5 pt</td><td>3 cups</td></tr>
            <tr class="highlight-row"><td><strong>32 oz</strong></td><td><strong>1 quart</strong></td><td><strong>2 pints</strong></td><td><strong>4 cups</strong></td></tr>
            <tr><td>40 oz</td><td>1.25 qt</td><td>2.5 pt</td><td>5 cups</td></tr>
            <tr><td>48 oz</td><td>1.5 qt</td><td>3 pt</td><td>6 cups</td></tr>
            <tr><td>56 oz</td><td>1.75 qt</td><td>3.5 pt</td><td>7 cups</td></tr>
            <tr class="highlight-row"><td><strong>64 oz</strong></td><td><strong>2 quarts</strong></td><td><strong>4 pints</strong></td><td><strong>8 cups</strong></td></tr>
            <tr><td>80 oz</td><td>2.5 qt</td><td>5 pt</td><td>10 cups</td></tr>
            <tr><td>96 oz</td><td>3 qt</td><td>6 pt</td><td>12 cups</td></tr>
            <tr class="highlight-row"><td><strong>128 oz</strong></td><td><strong>4 quarts</strong></td><td><strong>8 pints</strong></td><td><strong>16 cups</strong></td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Volume Units Reference -->
    <div class="content-card">
      <h2>US Liquid Volume — Full Reference</h2>
      <p>Understanding how fluid ounces, quarts, pints, cups, and gallons relate to each other:</p>
      <div style="overflow-x:auto">
        <table class="conv-table">
          <thead>
            <tr><th>Unit</th><th>= Fluid Ounces</th><th>= Quarts</th><th>= Gallons</th></tr>
          </thead>
