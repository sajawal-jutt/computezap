---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Time to Decimal Calculator",
    "url": "https://computezap.com/time-to-decimal-calculator",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "description": "Free time to decimal calculator. Convert hours and minutes to decimal format for timesheets, payroll, invoicing, and billing. Includes payroll calculator and full reference table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Time to Decimal Calculator", "item": "https://computezap.com/time-to-decimal-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do I convert hours and minutes to decimal?", "acceptedAnswer": { "@type": "Answer", "text": "Divide the minutes by 60 and add to the hours. Formula: Decimal Hours = Hours + (Minutes ÷ 60). Example: 7 hours 30 minutes = 7 + (30 ÷ 60) = 7.5 decimal hours." } },
      { "@type": "Question", "name": "What is 7 hours 45 minutes in decimal?", "acceptedAnswer": { "@type": "Answer", "text": "7 hours 45 minutes in decimal is 7.75 hours. Calculation: 7 + (45 ÷ 60) = 7 + 0.75 = 7.75." } },
      { "@type": "Question", "name": "What is 8 hours 30 minutes in decimal?", "acceptedAnswer": { "@type": "Answer", "text": "8 hours 30 minutes in decimal is 8.5 hours. Calculation: 8 + (30 ÷ 60) = 8 + 0.5 = 8.5." } },
      { "@type": "Question", "name": "Why do payroll systems use decimal time?", "acceptedAnswer": { "@type": "Answer", "text": "Payroll systems use decimal time because it makes math simpler — you can multiply decimal hours directly by the hourly rate. For example, 7.5 hours at $20/hr = $150." } },
      { "@type": "Question", "name": "What is 7:30 in decimal hours?", "acceptedAnswer": { "@type": "Answer", "text": "7:30 (7 hours 30 minutes) in decimal is 7.5 hours. Calculation: 7 + (30 ÷ 60) = 7.5." } },
      { "@type": "Question", "name": "What is 30 minutes in decimal hours?", "acceptedAnswer": { "@type": "Answer", "text": "30 minutes in decimal hours is 0.5 hours. Calculation: 30 ÷ 60 = 0.5. Other common values: 15 min = 0.25, 45 min = 0.75, 20 min = 0.333." } }
    ]
  }
]);
---
<Layout
  title="Time to Decimal Calculator — Convert Hours & Minutes | ComputeZap"
  description="Free time to decimal calculator. Convert hours and minutes to decimal for timesheets and payroll. Instant results with payroll calculator and full conversion table."
  canonical="/time-to-decimal-calculator"
  schema={schema}
>
<style is:global>
.clock-display{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:.75rem;text-align:center;font-size:2rem;font-weight:800;font-family:monospace;color:var(--blue);margin-bottom:1rem;letter-spacing:4px}
.min-lbl{font-size:.7rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem;display:block}
.min-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:.35rem;margin-bottom:1rem}
.min-btn{padding:.4rem .2rem;border:1.5px solid #dbeafe;border-radius:8px;background:#fff;font-size:.82rem;font-weight:700;cursor:pointer;color:var(--blue);text-align:center;transition:all .15s;font-family:inherit}
.min-btn:hover,.min-btn.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.payroll-box{background:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;padding:1rem;margin-top:.75rem}
.pay-row{display:flex;justify-content:space-between;align-items:center;padding:.4rem 0;border-bottom:1px solid #dcfce7;font-size:.875rem}
.pay-row:last-child{border-bottom:none;font-weight:800;color:#14532d}
.pay-lbl{color:#166534}
.pay-val{font-weight:700;color:#166534}
</style>

<div class="page-hero">
  <nav><a href="/">Home</a> › Time to Decimal Calculator</nav>
  <h1>Time to Decimal Calculator</h1>
  <p>Convert hours & minutes to decimal — instant payroll calculation</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="clock-display" id="time-display">07:30</div>

    <div class="input-group">
      <label for="hours">Hours</label>
      <div class="input-wrap">
        <input type="number" id="hours" value="7" min="0" max="99" step="1" oninput="calcTime()" />
      </div>
    </div>

    <div class="input-group">
      <label for="minutes">Minutes</label>
      <div class="input-wrap">
        <input type="number" id="minutes" value="30" min="0" max="59" step="1" oninput="calcTime()" />
      </div>
    </div>

    <span class="min-lbl">Quick Minutes</span>
    <div class="min-grid">
      {[0,5,10,15,20,25,30,35,40,45,50,55].map(m => (
        <button class="min-btn" id={`mb-${m}`} onclick={`setMinutes(${m})`}>{m}</button>
      ))}
    </div>

    <div class="result-hero">
      <div class="r-label">Decimal Hours</div>
      <div class="r-value"><span id="r-decimal">7.5</span> hrs</div>
      <div class="r-sub" id="r-fmt-sub">07:30 → 7.5 decimal</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Decimal</span><span class="stat-val"><span id="r-decimal2">7.5</span> hrs</span></div>
      <div class="stat-box"><span class="stat-lbl">Time Format</span><span class="stat-val" id="r-fmt">07:30</span></div>
      <div class="stat-box"><span class="stat-lbl">Total Minutes</span><span class="stat-val" id="r-mins">450</span></div>
      <div class="stat-box"><span class="stat-lbl">Total Seconds</span><span class="stat-val" id="r-secs">27,000</span></div>
    </div>

    <div class="input-group" style="margin-top:1rem">
      <label for="hourly">Hourly Rate (payroll)</label>
      <div class="input-wrap">
        <span class="input-pfx">$</span>
        <input type="number" id="hourly" value="25" min="0" step="0.5" oninput="calcTime()" placeholder="Hourly rate" style="padding-left:1.9rem;padding-right:.9rem" />
        <span class="input-sfx">/hr</span>
      </div>
    </div>
    <div class="payroll-box">
      <div class="pay-row"><span class="pay-lbl">Hours worked</span><span class="pay-val" id="pay-hrs">7.5 hrs</span></div>
      <div class="pay-row"><span class="pay-lbl">Hourly rate</span><span class="pay-val" id="pay-rate">$25.00/hr</span></div>
      <div class="pay-row"><span class="pay-lbl">Total pay</span><span class="pay-val" id="pay-total">$187.50</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Convert Time to Decimal</h2>
    <p>Enter the hours and minutes in the fields above. The decimal result appears instantly — ready to enter into payroll systems, invoices, or spreadsheets.</p>
    <div class="formula-box">Decimal Hours = Hours + (Minutes ÷ 60)</div>
    <div class="tip-box">
      <span class="tip-icon">⏱️</span>
      <p><strong>Example:</strong> Worked 9:00 AM to 4:45 PM = 7 hours 45 minutes → 7 + (45 ÷ 60) = <strong>7.75 hours</strong>. At $30/hr = $232.50.</p>
    </div>
    <h3>Formula examples:</h3>
    <ul>
      <li>7 hrs 30 min → 7 + (30 ÷ 60) = <strong>7.5 hours</strong></li>
      <li>8 hrs 15 min → 8 + (15 ÷ 60) = <strong>8.25 hours</strong></li>
      <li>0 hrs 45 min → 0 + (45 ÷ 60) = <strong>0.75 hours</strong></li>
      <li>10 hrs 20 min → 10 + (20 ÷ 60) = <strong>10.333 hours</strong></li>
    </ul>
  </div>

  <div class="card">
    <h2>Common Time to Decimal Conversions</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Time</th><th>Decimal</th><th>Time</th><th>Decimal</th></tr></thead>
        <tbody>
          {[0,1,2,3,4,5,6,7].map(h => (
            <tr>
              <td>{h}h 15m</td><td style="color:var(--blue);font-weight:700">{(h + 0.25).toFixed(2)}</td>
              <td>{h}h 30m</td><td style="color:var(--blue);font-weight:700">{(h + 0.5).toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Minutes to Decimal Reference</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Minutes</th><th>Decimal</th><th>Minutes</th><th>Decimal</th><th>Minutes</th><th>Decimal</th></tr></thead>
        <tbody id="ref-tbody"></tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Why Use Decimal Time?</h2>
    <ul>
      <li><strong>Payroll systems</strong> require decimal hours for accurate salary calculations.</li>
      <li><strong>Freelancers and consultants</strong> invoice clients by decimal hours.</li>
      <li><strong>Project management tools</strong> like Jira and Asana use decimal time tracking.</li>
      <li><strong>Spreadsheet math</strong> is easier — multiply decimal hours by rate directly.</li>
      <li><strong>Time tracking apps</strong> export in decimal format for reporting.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Common Time to Decimal Mistakes</h2>
    <ul>
      <li><strong>Treating minutes as decimal hours directly</strong> — 30 minutes is NOT 0.30 hours. It is 0.50 hours (30 ÷ 60).</li>
      <li><strong>7:15 ≠ 7.15</strong> — 15 minutes = 0.25 decimal hours. So 7:15 = 7.25, NOT 7.15.</li>
      <li><strong>Not separating break time</strong> — if you track 8:00–17:00 with a 30-minute unpaid lunch, billable time is 8.5 hours, not 9 hours.</li>
      <li><strong>Rounding errors on timesheets</strong> — rounding each entry separately accumulates errors. Calculate each time block precisely then sum.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is 7 hours 45 minutes in decimal?</h3>
      <p>7 hours 45 minutes = <strong>7.75 decimal hours</strong>. Calculation: 7 + (45 ÷ 60) = 7.75.</p>
    </div>
    <div class="faq-item">
      <h3>What is 8 hours 30 minutes in decimal?</h3>
      <p>8 hours 30 minutes = <strong>8.5 decimal hours</strong>. Calculation: 8 + (30 ÷ 60) = 8.5.</p>
    </div>
    <div class="faq-item">
      <h3>What is 7:30 in decimal hours?</h3>
      <p>7:30 (7 hours 30 minutes) in decimal is <strong>7.5 hours</strong>. Calculation: 7 + (30 ÷ 60) = 7.5. At $20/hr = $150.</p>
    </div>
    <div class="faq-item">
      <h3>What is 30 minutes in decimal hours?</h3>
      <p>30 minutes in decimal hours is <strong>0.5 hours</strong>. Calculation: 30 ÷ 60 = 0.5. Similarly: 15 min = 0.25, 45 min = 0.75, 20 min = 0.333.</p>
    </div>
    <div class="faq-item">
      <h3>What is 15 minutes in decimal hours?</h3>
      <p>15 minutes in decimal hours is <strong>0.25 hours</strong> (one quarter of an hour). So 8 hours 15 minutes = 8.25 decimal hours.</p>
    </div>
    <div class="faq-item">
      <h3>What is 8:45 in decimal hours?</h3>
      <p>8:45 in decimal is <strong>8.75 hours</strong>. Calculation: 8 + (45 ÷ 60) = 8.75.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Calculate project deadlines and delivery dates.</p>
      </a>
      <a href="/hours-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Year</h3>
        <p>8,760 hours/year — work hours and salary to hourly.</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Tax</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find pre-tax amounts for expense reports.</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Percent Off</h3>
        <p>Calculate discounts for client pricing.</p>
      </a>
      <a href="/hours-in-a-month" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Month</h3>
        <p>730 average hours per month — all months covered.</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Grow your savings with a Certificate of Deposit.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function pad(n) { return String(n).padStart(2,'0'); }
function fmt2(v) { return v.toLocaleString('en-US', { minimumFractionDigits:2, maximumFractionDigits:2 }); }

function calcTime() {
  var h = parseInt(document.getElementById('hours').value) || 0;
  var m = parseInt(document.getElementById('minutes').value) || 0;
  var rate = parseFloat(document.getElementById('hourly').value) || 0;
  if (m > 59) { m = 59; document.getElementById('minutes').value = 59; }

  var decimal = h + m / 60;
  var totalMins = h * 60 + m;
  var totalSecs = totalMins * 60;
  var decStr = decimal.toFixed(4).replace(/\.?0+$/,'') || '0';

  document.getElementById('time-display').textContent = pad(h) + ':' + pad(m);
  document.getElementById('r-decimal').textContent  = decStr;
  document.getElementById('r-decimal2').textContent = decStr;
  document.getElementById('r-fmt').textContent      = pad(h) + ':' + pad(m);
  document.getElementById('r-fmt-sub').textContent  = pad(h) + ':' + pad(m) + ' → ' + decStr + ' decimal';
  document.getElementById('r-mins').textContent     = totalMins.toLocaleString();
  document.getElementById('r-secs').textContent     = totalSecs.toLocaleString();

  var pay = decimal * rate;
  document.getElementById('pay-hrs').textContent  = decStr + ' hrs';
  document.getElementById('pay-rate').textContent = '$' + fmt2(rate) + '/hr';
  document.getElementById('pay-total').textContent = '$' + fmt2(pay);

  document.querySelectorAll('.min-btn').forEach(function(b) { b.classList.remove('active'); });
  var active = document.getElementById('mb-' + m);
  if (active) active.classList.add('active');
}

function setMinutes(m) {
  document.getElementById('minutes').value = m;
  calcTime();
}

function buildTable() {
  var tbody = document.getElementById('ref-tbody');
  var rows = [];
  for (var i = 0; i < 20; i++) {
    var m1 = i * 3, m2 = i * 3 + 1, m3 = i * 3 + 2;
    if (m1 > 59) break;
    var cells = '';
    [m1, m2, m3].forEach(function(m) {
      if (m <= 59) {
        var dec = (m / 60).toFixed(4).replace(/0+$/,'') || '0';
        cells += '<td>' + m + ' min</td><td style="color:var(--blue);font-weight:700">' + dec + '</td>';
      } else { cells += '<td colspan="2"></td>'; }
    });
    rows.push('<tr>' + cells + '</tr>');
  }
  tbody.innerHTML = rows.join('');
}

window.addEventListener('load', function() { calcTime(); buildTable(); });
</script>
</Layout>
