---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Time to Decimal Calculator",
    "url": "https://computezap.com/time-to-decimal-calculator",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Web",
    "description": "Free time to decimal calculator. Convert hours and minutes to decimal format for timesheets, payroll, invoicing, and billing. Includes payroll calculator and full reference table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Time to Decimal Calculator", "item": "https://computezap.com/time-to-decimal-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I convert hours and minutes to decimal?",
        "acceptedAnswer": { "@type": "Answer", "text": "Divide the minutes by 60 and add to the hours. Formula: Decimal Hours = Hours + (Minutes ÷ 60). Example: 7 hours 30 minutes = 7 + (30 ÷ 60) = 7.5 decimal hours." }
      },
      {
        "@type": "Question",
        "name": "What is 7 hours 45 minutes in decimal?",
        "acceptedAnswer": { "@type": "Answer", "text": "7 hours 45 minutes in decimal is 7.75 hours. Calculation: 7 + (45 ÷ 60) = 7 + 0.75 = 7.75." }
      },
      {
        "@type": "Question",
        "name": "What is 8 hours 30 minutes in decimal?",
        "acceptedAnswer": { "@type": "Answer", "text": "8 hours 30 minutes in decimal is 8.5 hours. Calculation: 8 + (30 ÷ 60) = 8 + 0.5 = 8.5." }
      },
      {
        "@type": "Question",
        "name": "Why do payroll systems use decimal time?",
        "acceptedAnswer": { "@type": "Answer", "text": "Payroll systems use decimal time because it makes math simpler — you can multiply decimal hours directly by the hourly rate. For example, 7.5 hours at $20/hr = $150. It's also required by most timesheet and invoicing software." }
      },
      {
        "@type": "Question",
        "name": "What is 7:30 in decimal hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "7:30 (7 hours 30 minutes) in decimal is 7.5 hours. Calculation: 7 + (30 ÷ 60) = 7.5. This is the most common work shift length for part-time employees." }
      },
      {
        "@type": "Question",
        "name": "What is 8:45 in decimal hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "8:45 (8 hours 45 minutes) in decimal is 8.75 hours. Calculation: 8 + (45 ÷ 60) = 8 + 0.75 = 8.75." }
      },
      {
        "@type": "Question",
        "name": "What is 6:15 in decimal hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "6:15 (6 hours 15 minutes) in decimal is 6.25 hours. Calculation: 6 + (15 ÷ 60) = 6 + 0.25 = 6.25." }
      },
      {
        "@type": "Question",
        "name": "What is 30 minutes in decimal hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "30 minutes in decimal hours is 0.5 hours. Calculation: 30 ÷ 60 = 0.5. Other common values: 15 min = 0.25, 45 min = 0.75, 20 min = 0.333." }
      },
      {
        "@type": "Question",
        "name": "What is 15 minutes in decimal hours?",
        "acceptedAnswer": { "@type": "Answer", "text": "15 minutes in decimal hours is 0.25 hours (one quarter hour). Calculation: 15 ÷ 60 = 0.25. So 8 hours 15 minutes = 8.25 decimal hours." }
      }
    ]
  }
]);
---
<Layout
  title="Time to Decimal Calculator — Convert Hours & Minutes | ComputeZap"
  description="Free time to decimal calculator. Convert hours and minutes to decimal for timesheets and payroll. Instant results with payroll calculator and full conversion table."
  canonical="/time-to-decimal-calculator"
  schema={schema}
>
<style>
.hero { text-align:center; padding:2rem 1rem 1.25rem; }
.hero h1 { font-size:2rem; color:#111; margin:.5rem 0 .35rem; font-weight:800; }
.hero-sub { color:#555; margin:0; font-size:1rem; }
.breadcrumb { font-size:.85rem; color:#888; margin-bottom:.75rem; }
.breadcrumb a { color:var(--blue); text-decoration:none; }

.calc-wrap { display:grid; grid-template-columns:360px 1fr; gap:1.5rem; max-width:1100px; margin:0 auto; padding:0 1rem 3rem; align-items:start; }
.calc-left { position:sticky; top:1rem; }
.card { background:#fff; border:1px solid #e5e7eb; border-radius:12px; padding:1.5rem; margin-bottom:1rem; }
.card:last-child { margin-bottom:0; }

.clock-display { background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:.75rem; text-align:center; font-size:2.2rem; font-weight:800; font-family:monospace; color:var(--blue); margin-bottom:1.25rem; letter-spacing:4px; }

.result-box { background:var(--blue); border-radius:14px; padding:1.75rem 1.5rem; text-align:center; margin-bottom:1.25rem; box-shadow:0 4px 20px rgba(37,99,235,.18); }
.res-lbl { font-size:.72rem; color:rgba(255,255,255,.7); text-transform:uppercase; letter-spacing:.09em; margin-bottom:.5rem; }
.res-val { font-size:2.1rem; font-weight:800; color:#fff; line-height:1.2; }
.res-unit { font-size:1rem; font-weight:400; color:rgba(255,255,255,.8); }
.res-sub { font-size:.9rem; color:rgba(255,255,255,.75); margin-top:.3rem; }

.stats-grid { display:grid; grid-template-columns:1fr 1fr; gap:.6rem; margin-bottom:1rem; }
.stat-item { background:#f8fafc; border:1px solid #f1f5f9; border-radius:10px; padding:.9rem .75rem; text-align:center; }
.stat-lbl { display:block; font-size:.68rem; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; margin-bottom:.3rem; font-weight:600; }
.stat-val { display:block; font-size:1rem; font-weight:800; color:#1e293b; }
.stat-val.green { color:#16a34a; }

.payroll-box { background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:1rem; }
.pay-row { display:flex; justify-content:space-between; align-items:center; padding:.4rem 0; border-bottom:1px solid #dcfce7; font-size:.875rem; }
.pay-row:last-child { border-bottom:none; font-weight:800; color:#14532d; }
.pay-lbl { color:#166534; }
.pay-val { font-weight:700; color:#166534; }

.fld-lbl { display:block; font-size:.8rem; font-weight:700; color:#374151; margin-bottom:.4rem; text-transform:uppercase; letter-spacing:.04em; }
.fld-wrap { position:relative; margin-bottom:1rem; }
.fld-pfx { position:absolute; left:.9rem; top:50%; transform:translateY(-50%); color:#94a3b8; font-weight:600; pointer-events:none; }
.txt-input { width:100%; font-size:1rem; padding:.65rem 1rem; border:1.5px solid #e2e8f0; border-radius:8px; color:#111; box-sizing:border-box; }
.txt-input:focus { outline:none; border-color:var(--blue); box-shadow:0 0 0 3px rgba(37,99,235,.1); }
.txt-pfx { padding-left:1.75rem; }

.min-lbl { font-size:.7rem; font-weight:700; color:#94a3b8; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.5rem; display:block; }
.min-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:.35rem; margin-bottom:1rem; }
.min-btn { padding:.4rem .2rem; border:1.5px solid #dbeafe; border-radius:8px; background:#fff; font-size:.82rem; font-weight:700; cursor:pointer; color:var(--blue); text-align:center; transition:all .15s; }
.min-btn:hover, .min-btn.active { background:var(--blue); color:#fff; border-color:var(--blue); }

.rate-row { display:flex; align-items:center; gap:.5rem; }
.rate-row .fld-lbl { margin-bottom:0; white-space:nowrap; min-width:fit-content; }
.rate-row .fld-wrap { flex:1; margin-bottom:0; }

.card h2 { font-size:1.1rem; font-weight:700; color:#111; margin:0 0 .8rem; }
