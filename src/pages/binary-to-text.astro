        <tr><td>T</td><td>84</td><td>01010100</td><td>t</td><td>116</td><td>01110100</td></tr>
        <tr><td>U</td><td>85</td><td>01010101</td><td>u</td><td>117</td><td>01110101</td></tr>
        <tr><td>V</td><td>86</td><td>01010110</td><td>v</td><td>118</td><td>01110110</td></tr>
        <tr><td>W</td><td>87</td><td>01010111</td><td>w</td><td>119</td><td>01110111</td></tr>
        <tr><td>X</td><td>88</td><td>01011000</td><td>x</td><td>120</td><td>01111000</td></tr>
        <tr><td>Y</td><td>89</td><td>01011001</td><td>y</td><td>121</td><td>01111001</td></tr>
        <tr><td>Z</td><td>90</td><td>01011010</td><td>z</td><td>122</td><td>01111010</td></tr>
        <tr><td>0</td><td>48</td><td>00110000</td><td>Space</td><td>32</td><td>00100000</td></tr>
        <tr><td>1</td><td>49</td><td>00110001</td><td>!</td><td>33</td><td>00100001</td></tr>
        <tr><td>2</td><td>50</td><td>00110010</td><td>?</td><td>63</td><td>00111111</td></tr>
        <tr><td>3</td><td>51</td><td>00110011</td><td>.</td><td>46</td><td>00101110</td></tr>
        <tr><td>4</td><td>52</td><td>00110100</td><td>,</td><td>44</td><td>00101100</td></tr>
