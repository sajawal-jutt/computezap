---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Binary to Text Translator",
    "url": "https://computezap.com/binary-to-text",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert binary code to text or text to binary instantly. Enter any 8-bit binary string and get readable text. Free binary to text translator.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Calculators", "item": "https://computezap.com/calculators" },`n      { "@type": "ListItem", "position": 3, "name": "Binary to Text Translator", "item": "https://computezap.com/binary-to-text" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I convert binary to text?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert binary to text: (1) Split the binary string into 8-bit groups. (2) Convert each 8-bit group from base-2 to a decimal number. (3) Match that decimal number to its ASCII character. Example: 01001000 = 72 = 'H', 01101001 = 105 = 'i' → 'Hi'." }
      },
      {
        "@type": "Question",
        "name": "What is 01001000 01100101 01101100 01101100 01101111 in text?",
        "acceptedAnswer": { "@type": "Answer", "text": "01001000 01100101 01101100 01101100 01101111 in text is 'Hello'. Each 8-bit group maps to one ASCII character: 01001000=H, 01100101=e, 01101100=l, 01101100=l, 01101111=o." }
      },
      {
        "@type": "Question",
        "name": "What does binary code look like?",
        "acceptedAnswer": { "@type": "Answer", "text": "Binary code is a series of 0s and 1s. Each character is represented by 8 bits (one byte). For example, the letter 'A' in binary is 01000001, 'B' is 01000010, and space is 00100000. Groups are separated by spaces." }
      },
      {
        "@type": "Question",
        "name": "How do I convert text to binary?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert text to binary: (1) Get the ASCII value of each character using its decimal code. (2) Convert that decimal number to an 8-bit binary string. Example: 'H' = ASCII 72 = 01001000. Use the Text → Binary mode in our translator above." }
      },
      {
        "@type": "Question",
        "name": "What is ASCII?",
        "acceptedAnswer": { "@type": "Answer", "text": "ASCII (American Standard Code for Information Interchange) is a character encoding standard. It assigns numbers 0–127 to characters: 65='A', 97='a', 48='0', 32=space. Binary code for text uses 8 bits per character, mapping to ASCII values." }
      },
      {
        "@type": "Question",
        "name": "What is 01001000 01101001 in text?",
        "acceptedAnswer": { "@type": "Answer", "text": "01001000 01101001 in text is 'Hi'. 01001000 = decimal 72 = 'H', and 01101001 = decimal 105 = 'i'." }
      }
    ]
  }
]);
---
<Layout
  title="Binary to Text Translator — Convert Binary Code to Text | ComputeZap"
  description="Convert binary code to text or text to binary instantly. Enter 8-bit binary groups (e.g. 01001000 01101001 = Hi). Free binary translator with ASCII reference table."
  canonical="/binary-to-text"
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/#calculators">Math</a> › Binary to Text Translator</nav>
  <h1>Binary to Text Translator</h1>
  <p>Convert binary code ↔ text instantly — paste binary, get readable text</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-b2t" onclick="setMode('b2t');return false">Binary → Text</button>
      <button class="mode-btn" id="btn-t2b" onclick="setMode('t2b');return false">Text → Binary</button>
    </div>

    <div class="input-group">
      <label id="inp-lbl">Enter Binary Code:</label>
      <div class="input-wrap">
        <textarea
          id="bin-input"
          rows="4"
          placeholder="e.g. 01001000 01100101 01101100 01101100 01101111"
          style="width:100%;padding:.65rem .9rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.95rem;font-family:monospace;color:#111;resize:vertical;background:#fff;box-sizing:border-box;line-height:1.6"
        ></textarea>
      </div>
    </div>

    <button class="calc-btn" onclick="convert();return false">Translate</button>

    <div id="output-area" style="display:none;margin-top:.75rem">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.4rem">
        <label id="out-lbl" style="font-size:.82rem;font-weight:600;color:#374151;margin:0">Text Output:</label>
        <button onclick="copyResult();return false" id="copy-btn" style="font-size:.75rem;padding:.25rem .65rem;background:#eff6ff;color:#2563eb;border:1px solid #bfdbfe;border-radius:6px;cursor:pointer;font-weight:700">Copy</button>
      </div>
      <textarea
        id="bin-output"
        rows="3"
        readonly
        style="width:100%;padding:.65rem .9rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:.95rem;font-family:monospace;color:#1e293b;background:#f8fafc;resize:vertical;box-sizing:border-box;line-height:1.6"
      ></textarea>
    </div>

    <div id="error-box" style="display:none;background:#fff7ed;border:1.5px solid #fed7aa;border-radius:8px;padding:.75rem 1rem;margin-top:.75rem;font-size:.875rem;color:#c2410c;font-weight:600"></div>
  </div>

  <div class="card">
    <span class="preset-lbl">Try these examples</span>
    <div class="preset-wrap">
      <a href="#" onclick="setPreset('Hi');return false" class="preset-btn">Hi</a>
      <a href="#" onclick="setPreset('Hello');return false" class="preset-btn">Hello</a>
      <a href="#" onclick="setPreset('Hello World');return false" class="preset-btn">Hello World</a>
      <a href="#" onclick="setPreset('ABC');return false" class="preset-btn">ABC</a>
      <a href="#" onclick="setPreset('ComputeZap');return false" class="preset-btn">ComputeZap</a>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Convert Binary to Text</h2>
    <div class="formula-box">
      <div class="formula-text">Binary (8 bits) → Decimal → ASCII Character</div>
      <div class="formula-sub">Each 8-bit group = 1 character. Groups separated by spaces.</div>
    </div>
    <div class="steps-list">
      <li>Split binary string into 8-bit groups (e.g. <code style="background:#f1f5f9;padding:.1rem .3rem;border-radius:4px;font-size:.85rem">01001000 01101001</code>)</li>
      <li>Convert each group from base-2 to decimal (01001000 = 72, 01101001 = 105)</li>
      <li>Look up the ASCII character for each decimal (72 = H, 105 = i)</li>
      <li>Join all characters → <strong>Hi</strong></li>
    </div>
    <div class="answer-box" style="margin-top:.75rem">
      <div class="answer-row"><span class="answer-lbl">01001000</span><span class="answer-val">72 → H</span></div>
      <div class="answer-row"><span class="answer-lbl">01100101</span><span class="answer-val">101 → e</span></div>
      <div class="answer-row"><span class="answer-lbl">01101100</span><span class="answer-val">108 → l</span></div>
      <div class="answer-row"><span class="answer-lbl">01101111</span><span class="answer-val">111 → o</span></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Tip:</strong> Always separate 8-bit groups with a space. If binary groups run together (no spaces), the translator may produce incorrect results.</p>
    </div>
  </div>

  <div class="card">
    <h2>Binary Code — Common Characters</h2>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
