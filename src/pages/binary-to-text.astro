        <tr><td>B</td><td>66</td><td>01000010</td><td>b</td><td>98</td><td>01100010</td></tr>
        <tr><td>C</td><td>67</td><td>01000011</td><td>c</td><td>99</td><td>01100011</td></tr>
        <tr><td>D</td><td>68</td><td>01000100</td><td>d</td><td>100</td><td>01100100</td></tr>
        <tr><td>E</td><td>69</td><td>01000101</td><td>e</td><td>101</td><td>01100101</td></tr>
        <tr><td>F</td><td>70</td><td>01000110</td><td>f</td><td>102</td><td>01100110</td></tr>
        <tr><td>G</td><td>71</td><td>01000111</td><td>g</td><td>103</td><td>01100111</td></tr>
        <tr><td>H</td><td>72</td><td>01001000</td><td>h</td><td>104</td><td>01101000</td></tr>
        <tr><td>I</td><td>73</td><td>01001001</td><td>i</td><td>105</td><td>01101001</td></tr>
        <tr><td>J</td><td>74</td><td>01001010</td><td>j</td><td>106</td><td>01101010</td></tr>
        <tr><td>K</td><td>75</td><td>01001011</td><td>k</td><td>107</td><td>01101011</td></tr>
        <tr><td>L</td><td>76</td><td>01001100</td><td>l</td><td>108</td><td>01101100</td></tr>
        <tr><td>M</td><td>77</td><td>01001101</td><td>m</td><td>109</td><td>01101101</td></tr>
        <tr><td>N</td><td>78</td><td>01001110</td><td>n</td><td>110</td><td>01101110</td></tr>
        <tr><td>O</td><td>79</td><td>01001111</td><td>o</td><td>111</td><td>01101111</td></tr>
        <tr><td>P</td><td>80</td><td>01010000</td><td>p</td><td>112</td><td>01110000</td></tr>
