<script is:inline>
var mode = 'b2t';

function setMode(m) {
  mode = m;
  document.getElementById('btn-b2t').classList.toggle('active', m === 'b2t');
  document.getElementById('btn-t2b').classList.toggle('active', m === 't2b');
  document.getElementById('inp-lbl').textContent = m === 'b2t' ? 'Enter Binary Code:' : 'Enter Text:';
  document.getElementById('out-lbl').textContent = m === 'b2t' ? 'Text Output:' : 'Binary Output:';
  document.getElementById('bin-input').placeholder = m === 'b2t'
    ? 'e.g. 01001000 01100101 01101100 01101100 01101111'
    : 'e.g. Hello World';
  document.getElementById('bin-input').value = '';
  document.getElementById('bin-output').value = '';
  document.getElementById('output-area').style.display = 'none';
  document.getElementById('error-box').style.display = 'none';
}

function convert() {
  var input = document.getElementById('bin-input').value.trim();
  var errorBox = document.getElementById('error-box');
  var outputArea = document.getElementById('output-area');

  errorBox.style.display = 'none';
  if (!input) return;

  var output = '';

  if (mode === 'b2t') {
    var groups = input.trim().split(/\s+/);
    var valid = true;
    var chars = [];
    for (var i = 0; i < groups.length; i++) {
      var g = groups[i];
      if (!/^[01]+$/.test(g)) { valid = false; break; }
      chars.push(String.fromCharCode(parseInt(g, 2)));
    }
    if (!valid || chars.length === 0) {
      errorBox.textContent = 'Invalid binary input. Use only 0s and 1s, separated by spaces (e.g. 01001000 01101001).';
      errorBox.style.display = 'block';
      outputArea.style.display = 'none';
      return;
    }
    output = chars.join('');
  } else {
    output = input.split('').map(function(c) {
      return c.charCodeAt(0).toString(2).padStart(8, '0');
    }).join(' ');
  }

  document.getElementById('bin-output').value = output;
  outputArea.style.display = 'block';
}

function setPreset(text) {
  if (mode === 'b2t') {
    var binary = text.split('').map(function(c) {
      return c.charCodeAt(0).toString(2).padStart(8, '0');
    }).join(' ');
    document.getElementById('bin-input').value = binary;
  } else {
    document.getElementById('bin-input').value = text;
  }
  convert();
}

function copyResult() {
  var out = document.getElementById('bin-output');
  out.select();
  out.setSelectionRange(0, 99999);
  try {
    document.execCommand('copy');
  } catch(e) {
    navigator.clipboard && navigator.clipboard.writeText(out.value);
  }
  var btn = document.getElementById('copy-btn');
  btn.textContent = 'Copied!';
  btn.style.background = '#dcfce7';
  btn.style.color = '#166534';
  btn.style.borderColor = '#86efac';
  setTimeout(function() {
    btn.textContent = 'Copy';
    btn.style.background = '#eff6ff';
    btn.style.color = '#2563eb';
    btn.style.borderColor = '#bfdbfe';
  }, 2000);
}

document.getElementById('bin-input').addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); convert(); }
});
</script>

</Layout>
