---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const vals: number[] = [];
  for (let y = 1; y <= 100; y++) vals.push(y);
  [110, 120, 150, 200, 250, 300, 400, 500, 1000].forEach(y => vals.push(y));
  return vals.map(y => ({ params: { yards: String(y) } }));
}

const yards = parseInt(Astro.params.yards);
const meters = Math.round(yards * 0.9144 * 10000) / 10000;
const metersRound = Math.round(yards * 0.9144 * 100) / 100;
const cm = Math.round(yards * 91.44 * 100) / 100;
const feet = yards * 3;
const inches = yards * 36;
const miles = Math.round(yards / 1760 * 10000) / 10000;
const mm = Math.round(yards * 914.4);

const allYards: number[] = [];
for (let y = 1; y <= 100; y++) allYards.push(y);
[110, 120, 150, 200, 250, 300, 400, 500, 1000].forEach(y => allYards.push(y));
const nearby = allYards.filter(y => y !== yards).sort((a, b) => Math.abs(a - yards) - Math.abs(b - yards)).slice(0, 8);

const tableRows = [1,2,3,5,10,15,20,25,30,40,50,60,70,75,80,90,100,120,150,200,250,300,400,500,1000];

function yardsContext(y: number) {
  if (y <= 3)   return 'About the length of a large doorway or car hood';
  if (y <= 10)  return 'Common fabric/carpet purchase length';
  if (y <= 25)  return '25 yards = standard US short-course pool length';
  if (y <= 50)  return 'Half the length of an American football field';
  if (y <= 100) return '100 yards = one American football field';
  if (y <= 200) return 'Typical short-to-mid iron golf shot distance';
  if (y <= 300) return 'Typical average driver distance on a golf course';
  if (y <= 500) return 'Long-range shot — sniper/military benchmark';
  return 'Long distance — surveying and military contexts';
}

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": `${yards} Yards to Meters — ${metersRound} m | ComputeZap`,
    "url": `https://computezap.com/yards-to-meters/${yards}-yards-to-meters`,
    "description": `${yards} yards = ${metersRound} meters. Convert ${yards} yards to meters, cm, feet, and inches instantly.`
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Yards to Meters", "item": "https://computezap.com/yards-to-meters" },
      { "@type": "ListItem", "position": 3, "name": `${yards} Yards to Meters`, "item": `https://computezap.com/yards-to-meters/${yards}-yards-to-meters` }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": `How many meters is ${yards} yards?`,
        "acceptedAnswer": { "@type": "Answer", "text": `${yards} yards = ${metersRound} meters. Multiply ${yards} by 0.9144 to convert yards to meters.` }
      },
      {
        "@type": "Question",
        "name": `What is ${yards} yards in feet?`,
        "acceptedAnswer": { "@type": "Answer", "text": `${yards} yards = ${feet} feet. There are exactly 3 feet in 1 yard, so ${yards} × 3 = ${feet} feet.` }
      },
      {
        "@type": "Question",
        "name": `How do I convert ${yards} yards to meters?`,
        "acceptedAnswer": { "@type": "Answer", "text": `Multiply ${yards} by 0.9144. Formula: ${yards} yd × 0.9144 = ${metersRound} m. One yard is exactly 0.9144 meters (international yard, since 1959).` }
      }
    ]
  }
]);
---
<Layout
  title={`${yards} Yards to Meters — How Many Meters is ${yards} Yards? | ComputeZap`}
  description={`${yards} yards = ${metersRound} meters. Convert ${yards} yards to meters, centimeters, feet, and inches instantly. Free converter.`}
  canonical={`/yards-to-meters/${yards}-yards-to-meters`}
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/yards-to-meters">Yards to Meters</a> › {yards} Yards to Meters</nav>
  <h1>{yards} Yards to Meters</h1>
  <p>{yards} yards = <strong>{metersRound} meters</strong></p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="answer-hero show">
      <div class="a-label">{yards} Yards =</div>
      <div class="a-value">{metersRound}</div>
      <div class="a-unit">meters (m)</div>
      <div class="a-sub">{yards} yd × 0.9144 = {metersRound} m</div>
    </div>
    <div class="stats-row show">
      <div class="stat-box">
        <span class="stat-lbl">Centimeters</span>
        <span class="stat-val">{cm} cm</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Feet</span>
        <span class="stat-val">{feet} ft</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Inches</span>
        <span class="stat-val">{inches} in</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Millimeters</span>
        <span class="stat-val">{mm} mm</span>
      </div>
    </div>
  </div>

  <div class="card">
    <span class="preset-lbl">Other nearby values</span>
    <div class="preset-wrap">
      {nearby.map(y => (
        <a href={`/yards-to-meters/${y}-yards-to-meters`} class="preset-btn">{y} yd</a>
      ))}
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Convert {yards} Yards to Meters</h2>
    <div class="formula-box">
      <div class="formula-text">{yards} × 0.9144 = {metersRound} m</div>
      <div class="formula-sub">1 yard = 0.9144 meters (exact international definition since 1959)</div>
    </div>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">{yards} yards in meters</span><span class="answer-val">{metersRound} m</span></div>
      <div class="answer-row"><span class="answer-lbl">{yards} yards in cm</span><span class="answer-val">{cm} cm</span></div>
      <div class="answer-row"><span class="answer-lbl">{yards} yards in feet</span><span class="answer-val">{feet} ft</span></div>
      <div class="answer-row"><span class="answer-lbl">{yards} yards in inches</span><span class="answer-val">{inches} in</span></div>
    </div>
    <p>{yardsContext(yards)}.</p>
  </div>

  <div class="card">
    <h2>Yards to Meters Reference Table</h2>
    <table class="conv-table">
      <thead>
        <tr><th>Yards</th><th>Meters</th><th>Feet</th></tr>
      </thead>
      <tbody>
        {tableRows.map(y => {
          const m = Math.round(y * 0.9144 * 100) / 100;
          const ft = y * 3;
          return (
            <tr class={y === yards ? 'hl' : ''}>
              <td><a href={`/yards-to-meters/${y}-yards-to-meters`}>{y} yd</a></td>
              <td>{m} m</td>
              <td>{ft} ft</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many meters is {yards} yards?</h3>
      <p>{yards} yards = {metersRound} meters. Multiply yards by 0.9144 to convert to meters.</p>
    </div>
    <div class="faq-item">
      <h3>What is {yards} yards in feet?</h3>
      <p>{yards} yards = {feet} feet. There are exactly 3 feet in every yard, so {yards} × 3 = {feet} ft.</p>
    </div>
    <div class="faq-item">
      <h3>Is a yard bigger than a meter?</h3>
      <p>No — 1 meter = 1.0936 yards, so a meter is slightly longer than a yard. 1 yard = 0.9144 meters.</p>
    </div>
    <div class="faq-item">
      <h3>How many yards are in a mile?</h3>
      <p>There are 1,760 yards in 1 mile. {yards} yards = {miles} miles.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Converters</h2>
    <div class="next-grid">
      <a href="/yards-to-meters" class="next-card">
        <span class="next-tag">Length</span>
        <h3>Yards to Meters Calculator</h3>
        <p>Convert any yards value to meters</p>
      </a>
      <a href="/meters-to-feet" class="next-card">
        <span class="next-tag">Length</span>
        <h3>Meters to Feet</h3>
        <p>Convert meters to feet and inches</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Length</span>
        <h3>cm to Inches</h3>
        <p>Convert centimeters to inches</p>
      </a>
    </div>
  </div>

</div>
</Layout>
