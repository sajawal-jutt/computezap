<style>
.car-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .75rem; }
@media (max-width: 540px) { .car-grid { grid-template-columns: 1fr; } }

.formula-box { background: #eff6ff; border-left: 3px solid var(--blue); border-radius: 8px; padding: 1rem 1.25rem; margin-bottom: 1rem; }
.formula-text { font-size: .95rem; font-weight: 600; color: var(--gray-900); margin-bottom: .25rem; }
.formula-sub  { font-size: .8rem; color: var(--gray-600); }

.loan-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.loan-table th { background: var(--gray-50); padding: .6rem .75rem; text-align: left; font-size: .8rem; color: var(--gray-600); text-transform: uppercase; letter-spacing: .04em; border-bottom: 2px solid #e2e8f0; }
.loan-table td { padding: .6rem .75rem; border-bottom: 1px solid #e2e8f0; color: var(--gray-700); }
.loan-table tr:last-child td { border-bottom: none; font-weight: 600; }
.loan-table tr:hover td { background: var(--gray-50); }
.loan-table tr.hl-row td { background: #eff6ff; font-weight: 600; }

.faq-list { display: flex; flex-direction: column; gap: 1rem; }
.faq-item h3 { font-size: .95rem; font-weight: 600; color: var(--gray-900); margin-bottom: .3rem; }
.faq-item p  { font-size: .88rem; color: var(--gray-600); line-height: 1.6; margin: 0; }

.tip-box { display: flex; gap: .75rem; padding: .875rem 1rem; border-radius: 8px; margin-top: 1rem; }
.tip-box.tip-blue  { background: #eff6ff; border: 1px solid #bfdbfe; }
.tip-box.tip-green { background: #f0fdf4; border: 1px solid #bbf7d0; }
.tip-icon { font-size: 1.1rem; flex-shrink: 0; }
.tip-box p { margin: 0; font-size: .875rem; color: var(--gray-700); line-height: 1.6; }
</style>

<script is:inline>
function fmt(n) {
  return n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
}

function calcCar() {
  const price   = parseFloat(document.getElementById('price').value)   || 0;
  const down    = parseFloat(document.getElementById('down').value)    || 0;
  const tradein = parseFloat(document.getElementById('tradein').value) || 0;
  const taxPct  = parseFloat(document.getElementById('tax').value)     || 0;
  const apr     = parseFloat(document.getElementById('rate').value);
  const n       = parseInt(document.getElementById('term').value);
  const extra   = parseFloat(document.getElementById('extra').value)   || 0;

  if (!price || !apr || !n || price <= 0 || apr <= 0 || n <= 0) return;

  const salesTax = price * (taxPct / 100);
  const loanAmt  = Math.max(0, price - down - tradein + salesTax);
  const r        = apr / 100 / 12;

  const monthly = r === 0
    ? loanAmt / n
    : loanAmt * r * Math.pow(1 + r, n) / (Math.pow(1 + r, n) - 1);

  const totalPaid     = monthly * n;
  const totalInterest = totalPaid - loanAmt;

  // Payoff date
  const now = new Date();
  const payoff = new Date(now.getFullYear(), now.getMonth() + n, 1);
  const payoffStr = payoff.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });

  // Fill results
  document.getElementById('res-payment').textContent = '$' + fmt(monthly);
  document.getElementById('res-sub').textContent = n + ' months · ' + apr + '% APR';
  document.getElementById('s-loan').textContent     = '$' + fmt(loanAmt);
  document.getElementById('s-interest').textContent = '$' + fmt(totalInterest);
  document.getElementById('s-total').textContent    = '$' + fmt(price + salesTax);
  document.getElementById('s-date').textContent     = payoffStr;

  document.getElementById('b-price').textContent    = '$' + fmt(price);
  document.getElementById('b-down').textContent     = '$' + fmt(down + tradein);
  document.getElementById('b-tax').textContent      = '$' + fmt(salesTax);
  document.getElementById('b-loan').textContent     = '$' + fmt(loanAmt);
  document.getElementById('b-interest').textContent = '$' + fmt(totalInterest);
  document.getElementById('b-total').textContent    = '$' + fmt(totalPaid);

  document.getElementById('res-summary').textContent =
    `Based on a $${fmt(price)} car, $${fmt(down + tradein)} down payment/trade-in, ${apr}% APR and a ${n}-month loan term, your estimated monthly payment is $${fmt(monthly)}. You will pay $${fmt(totalInterest)} in interest over the life of the loan, for a total cost of $${fmt(totalPaid)}.`;

  // Extra payment savings
  const et = document.getElementById('extra-tip');
  if (extra > 0) {
    const result = calcWithExtra(loanAmt, r, monthly + extra);
    const savedMonths   = n - result.months;
    const savedInterest = totalInterest - result.interest;
    document.getElementById('extra-tip-text').textContent =
      `Paying $${fmt(extra)} extra/month saves you $${fmt(savedInterest)} in interest and pays off ${savedMonths} month${savedMonths !== 1 ? 's' : ''} early!`;
    et.style.display = 'flex';
  } else {
    et.style.display = 'none';
  }

  document.getElementById('result-card').style.display = '';
  document.getElementById('res-hero').classList.add('show');
  document.getElementById('res-stats').classList.add('show');

  buildAmort(loanAmt, r, n, monthly);
}

function calcWithExtra(P, r, payment) {
  let balance = P, months = 0, interest = 0;
  while (balance > 0.01 && months < 600) {
    const intPmt = balance * r;
    const prinPmt = Math.min(payment - intPmt, balance);
    interest += intPmt;
    balance -= prinPmt;
    months++;
  }
  return { months, interest };
}

function buildAmort(P, r, n, monthly) {
  let balance = P;
  const tbody = document.getElementById('amort-body');
  tbody.innerHTML = '';

  for (let yr = 1; yr <= Math.ceil(n / 12); yr++) {
    const start = (yr - 1) * 12 + 1;
    const end   = Math.min(yr * 12, n);
    let yPrin = 0, yInt = 0;

    for (let m = start; m <= end; m++) {
      const intPmt  = balance * r;
      const prinPmt = Math.min(monthly - intPmt, balance);
      yInt  += intPmt;
      yPrin += prinPmt;
      balance = Math.max(0, balance - prinPmt);
    }

    const tr = document.createElement('tr');
    tr.innerHTML = `<td>Year ${yr}</td><td>$${fmt(yPrin)}</td><td>$${fmt(yInt)}</td><td>$${fmt(balance)}</td>`;
    tbody.appendChild(tr);
  }

  document.getElementById('amort-card').style.display = '';
}

function setPreset(price, down, tradein, tax, rate, term) {
  document.getElementById('price').value   = price;
  document.getElementById('down').value    = down;
  document.getElementById('tradein').value = tradein;
  document.getElementById('tax').value     = tax;
  document.getElementById('rate').value    = rate;
  document.getElementById('term').value    = term;
  document.getElementById('extra').value   = 0;
  calcCar();
}
</script>

