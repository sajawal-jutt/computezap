---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Mortgage Calculator",
    "url": "https://www.computezap.com/finance/mortgage-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Free mortgage calculator. Enter home price, down payment, interest rate, and loan term to get your monthly payment, total interest, and year-by-year amortization schedule.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Finance Calculators", "item": "https://www.computezap.com/finance/" },
      { "@type": "ListItem", "position": 3, "name": "Mortgage Calculator", "item": "https://www.computezap.com/finance/mortgage-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How is a monthly mortgage payment calculated?",
        "acceptedAnswer": { "@type": "Answer", "text": "Monthly P&I payment uses the formula M = P[r(1+r)^n]/[(1+r)^n-1], where P is the loan amount, r is the monthly interest rate (annual rate ÷ 12), and n is the number of monthly payments (loan term in years × 12). This gives you the principal and interest portion only — add property tax, insurance, and PMI for the full monthly payment." }
      },
      {
        "@type": "Question",
        "name": "What is included in a monthly mortgage payment?",
        "acceptedAnswer": { "@type": "Answer", "text": "A full mortgage payment is often called PITI: Principal (reduces your loan balance), Interest (cost of borrowing), Taxes (property taxes, usually 1/12 of annual bill), and Insurance (homeowners insurance). If your down payment is less than 20%, PMI (Private Mortgage Insurance) is also added until your loan-to-value drops to 80%." }
      },
      {
        "@type": "Question",
        "name": "What is PMI and when can I remove it?",
        "acceptedAnswer": { "@type": "Answer", "text": "PMI (Private Mortgage Insurance) protects the lender if you default. It's required when your down payment is less than 20% of the home price. PMI typically costs 0.5%–1.5% of the loan per year. You can request cancellation once your equity reaches 20% (loan-to-value ≤ 80%), and lenders must automatically cancel it at 22% equity under the Homeowners Protection Act." }
      },
      {
        "@type": "Question",
        "name": "Is a 30-year or 15-year mortgage better?",
        "acceptedAnswer": { "@type": "Answer", "text": "A 15-year mortgage has a higher monthly payment but saves tens of thousands in interest and builds equity twice as fast. A 30-year mortgage has a lower monthly payment, giving more cash flow flexibility, but costs significantly more in total interest. On a $300,000 loan at 6.5%, a 15-year mortgage saves approximately $150,000 in interest compared to a 30-year loan." }
      },
      {
        "@type": "Question",
        "name": "How much down payment do I need?",
        "acceptedAnswer": { "@type": "Answer", "text": "Conventional loans typically require 3%–20% down. FHA loans require 3.5% down with a credit score of 580+. VA loans (veterans) and USDA loans (rural areas) may require 0% down. Putting 20% down avoids PMI, which can save $100–$250/month on a typical home. The more you put down, the lower your loan amount and monthly payment." }
      },
      {
        "@type": "Question",
        "name": "What interest rate should I use?",
        "acceptedAnswer": { "@type": "Answer", "text": "Use the interest rate quoted by your lender for your specific loan. Average 30-year fixed rates vary by credit score, down payment, loan type, and market conditions. Check current rates from multiple lenders or mortgage brokers for the most accurate estimate. Even a 0.5% rate difference on a $300,000 loan changes your payment by about $90/month and $32,000 in total interest." }
      },
      {
        "@type": "Question",
        "name": "What is an amortization schedule?",
        "acceptedAnswer": { "@type": "Answer", "text": "An amortization schedule shows every payment over the life of your loan, breaking down how much goes to principal vs. interest each month. Early payments are mostly interest — on a 30-year loan, the first payment may be 85% interest. Over time, the principal portion grows. The full schedule shows your remaining balance after each payment and your exact payoff date." }
      },
      {
        "@type": "Question",
        "name": "How much house can I afford?",
        "acceptedAnswer": { "@type": "Answer", "text": "A common rule is the 28/36 rule: keep housing costs (mortgage + tax + insurance) under 28% of gross monthly income, and total debt (housing + car + credit cards) under 36%. For example, a household earning $7,000/month should keep total housing payment under $1,960/month. Lenders also consider your credit score, debt-to-income ratio, and savings." }
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How to Calculate a Mortgage Payment",
    "step": [
      { "@type": "HowToStep", "position": 1, "name": "Enter Home Price", "text": "Type the total purchase price of the home." },
      { "@type": "HowToStep", "position": 2, "name": "Set Down Payment", "text": "Enter your down payment as a dollar amount or percentage. 20% avoids PMI." },
      { "@type": "HowToStep", "position": 3, "name": "Choose Loan Term", "text": "Select 30, 20, 15, or 10 years. Shorter terms mean higher payments but less total interest." },
      { "@type": "HowToStep", "position": 4, "name": "Enter Interest Rate", "text": "Use the rate quoted by your lender. Check current rates before estimating." },
      { "@type": "HowToStep", "position": 5, "name": "Add Optional Costs", "text": "Include property tax, home insurance, and HOA for a complete monthly payment estimate." },
      { "@type": "HowToStep", "position": 6, "name": "Review Results", "text": "See your monthly P&I payment, total interest paid, and year-by-year amortization table." }
    ]
  }
]);
---
<Layout
  title="Mortgage Calculator — Monthly Payment & Amortization | ComputeZap"
  description="Free mortgage calculator. Enter home price, down payment, rate, and term to get your monthly payment, total interest, PMI estimate, and full amortization schedule."
  canonical="/finance/mortgage-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/">Home</a> › <a href="/finance/">Finance</a> › <span>Mortgage Calculator</span>
  </nav>
  <h1>Mortgage Calculator</h1>
  <p class="hero-sub">Calculate your monthly payment, total interest, and full amortization schedule</p>
</div>

<div class="calc-center">
  <div class="card">

    <!-- Presets -->
    <div class="preset-row">
      <button class="preset-btn active" onclick="setPreset(300000,10,30,6.5)">$300k / 30yr</button>
      <button class="preset-btn" onclick="setPreset(400000,20,30,6.5)">$400k / 30yr</button>
      <button class="preset-btn" onclick="setPreset(300000,20,15,6.0)">$300k / 15yr</button>
      <button class="preset-btn" onclick="setPreset(500000,20,30,7.0)">$500k / 30yr</button>
    </div>

    <div class="two-col">
      <div class="input-group">
        <label for="homePrice">Home Price</label>
        <div class="input-wrap">
          <span class="input-pfx">$</span>
          <input type="number" id="homePrice" value="300000" min="10000" step="1000" oninput="calcMortgage()" style="padding-left:1.9rem;padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label for="downPmt">Down Payment</label>
        <div class="input-wrap" style="display:flex;gap:.4rem">
          <span class="input-pfx" id="dpPfx" style="position:relative;left:auto;top:auto;transform:none;display:flex;align-items:center;padding:0 .5rem;background:#f1f5f9;border:1.5px solid #e2e8f0;border-radius:8px 0 0 8px;font-size:.9rem;color:#475569;border-right:none">$</span>
          <input type="number" id="downPmt" value="30000" min="0" oninput="calcMortgage()" style="border-radius:0;flex:1;min-width:0" />
          <button id="dpToggle" onclick="toggleDP()" style="padding:.6rem .75rem;background:#f1f5f9;border:1.5px solid #e2e8f0;border-radius:0 8px 8px 0;font-size:.85rem;font-weight:700;color:#475569;cursor:pointer;border-left:none;white-space:nowrap">% ⇄ $</button>
        </div>
        <span id="dpPct" style="font-size:.78rem;color:#64748b;margin-top:.2rem;display:block">= 10.0% of home price</span>
      </div>
    </div>

    <div class="two-col">
      <div class="input-group">
        <label for="loanTerm">Loan Term</label>
        <select id="loanTerm" onchange="calcMortgage()" style="width:100%;padding:.75rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:1rem;background:#fff;color:#111;font-family:inherit">
          <option value="30">30 years</option>
          <option value="20">20 years</option>
          <option value="15">15 years</option>
          <option value="10">10 years</option>
        </select>
      </div>
      <div class="input-group">
        <label for="intRate">Annual Interest Rate</label>
        <div class="input-wrap">
          <input type="number" id="intRate" value="6.5" min="0.1" max="30" step="0.1" oninput="calcMortgage()" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <!-- Optional costs -->
    <details style="margin-top:.25rem">
      <summary style="cursor:pointer;font-size:.88rem;font-weight:700;color:var(--blue);user-select:none;padding:.4rem 0">+ Add Property Tax, Insurance &amp; HOA</summary>
      <div class="two-col" style="margin-top:.75rem">
        <div class="input-group">
          <label for="propTax">Property Tax (% of home/yr)</label>
          <div class="input-wrap">
            <input type="number" id="propTax" value="1.2" min="0" max="5" step="0.1" oninput="calcMortgage()" />
            <span class="input-sfx">%</span>
          </div>
        </div>
        <div class="input-group">
          <label for="homeIns">Home Insurance ($/yr)</label>
          <div class="input-wrap">
            <span class="input-pfx">$</span>
            <input type="number" id="homeIns" value="1200" min="0" step="100" oninput="calcMortgage()" style="padding-left:1.9rem;padding-right:.9rem" />
          </div>
        </div>
      </div>
      <div class="input-group" style="max-width:260px">
        <label for="hoa">HOA Fee ($/month)</label>
        <div class="input-wrap">
          <span class="input-pfx">$</span>
          <input type="number" id="hoa" value="0" min="0" step="10" oninput="calcMortgage()" style="padding-left:1.9rem;padding-right:.9rem" />
        </div>
      </div>
    </details>

    <button class="calc-btn" onclick="calcMortgage()">Calculate Mortgage</button>

    <div class="answer-hero" id="answerHero">
      <div class="answer-label">Monthly Payment (P&amp;I)</div>
      <div class="answer-value" id="monthlyPI">—</div>
      <div class="answer-sub" id="monthlyTotal" style="display:none"></div>
    </div>

    <div class="stats-row" id="statsRow">
      <div class="stat-box">
        <div class="stat-label">Loan Amount</div>
        <div class="stat-val" id="loanAmt">—</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">Down Payment</div>
        <div class="stat-val" id="downAmt">—</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">Total Interest</div>
        <div class="stat-val" id="totalInt">—</div>
      </div>
      <div class="stat-box">
        <div class="stat-label">Total Cost</div>
        <div class="stat-val" id="totalCost">—</div>
      </div>
    </div>

    <!-- PMI + extras breakdown -->
    <div id="extrasRow" style="display:none;margin-top:.75rem;background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:1rem 1.1rem">
      <div style="font-size:.82rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.6rem">Full Monthly Breakdown</div>
      <div id="extrasList" style="display:flex;flex-direction:column;gap:.35rem;font-size:.92rem"></div>
      <div id="pmiNote" style="font-size:.78rem;color:#92400e;margin-top:.6rem;background:#fef3c7;border-radius:6px;padding:.4rem .65rem;display:none">⚠️ PMI applies because down payment is less than 20%. PMI drops off when your equity reaches 20%.</div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <!-- Amortization table -->
  <div class="content-card" id="amortCard" style="display:none">
    <h2>Year-by-Year Amortization</h2>
    <div class="tbl-scroll">
      <table class="payoff-table" id="amortTable">
        <thead>
          <tr>
            <th>Year</th>
            <th>Principal Paid</th>
            <th>Interest Paid</th>
            <th>Total Paid</th>
            <th>Remaining Balance</th>
          </tr>
        </thead>
        <tbody id="amortBody"></tbody>
      </table>
    </div>
  </div>

  <!-- How it works -->
  <div class="content-card">
    <h2>How the Mortgage Calculator Works</h2>
    <p>This calculator uses the standard amortization formula to compute your monthly principal and interest payment:</p>
    <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:.9rem 1.1rem;font-family:monospace;font-size:.95rem;margin:.75rem 0">
      M = P × [r(1+r)ⁿ] ÷ [(1+r)ⁿ − 1]
    </div>
    <ul>
      <li><strong>M</strong> = monthly payment</li>
      <li><strong>P</strong> = loan amount (home price − down payment)</li>
      <li><strong>r</strong> = monthly interest rate (annual rate ÷ 12 ÷ 100)</li>
      <li><strong>n</strong> = total number of payments (years × 12)</li>
    </ul>
    <p>Property tax, home insurance, HOA, and PMI are added on top of this P&amp;I payment to give you the total monthly housing cost.</p>
  </div>

  <!-- What is PITI -->
  <div class="content-card">
    <h2>What Makes Up Your Monthly Payment? (PITI + PMI)</h2>
    <div class="tbl-scroll">
      <table class="payoff-table">
        <thead>
          <tr><th>Component</th><th>What It Is</th><th>Typical Range</th></tr>
        </thead>
        <tbody>
          <tr><td><strong>Principal</strong></td><td>Portion that reduces your loan balance</td><td>Grows over time</td></tr>
          <tr><td><strong>Interest</strong></td><td>Cost of borrowing — paid to lender</td><td>Shrinks over time</td></tr>
          <tr><td><strong>Property Tax</strong></td><td>Annual tax ÷ 12, collected in escrow</td><td>0.5%–2.5% of home/yr</td></tr>
          <tr><td><strong>Insurance</strong></td><td>Homeowners insurance, collected in escrow</td><td>$800–$2,000/yr avg</td></tr>
          <tr><td><strong>PMI</strong></td><td>Required if down payment &lt; 20%</td><td>0.5%–1.5% of loan/yr</td></tr>
          <tr><td><strong>HOA</strong></td><td>Homeowners association fee (if applicable)</td><td>$0–$500+/month</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- 30 vs 15 year comparison -->
  <div class="content-card">
    <h2>30-Year vs 15-Year Mortgage: What's the Difference?</h2>
    <div class="tbl-scroll">
      <table class="payoff-table">
        <thead>
          <tr><th>Factor</th><th>30-Year Fixed</th><th>15-Year Fixed</th></tr>
        </thead>
        <tbody>
          <tr><td>Monthly Payment</td><td>Lower</td><td>Higher (~40% more)</td></tr>
          <tr><td>Total Interest Paid</td><td>Much higher</td><td>Much lower (~50% less)</td></tr>
          <tr><td>Equity Buildup</td><td>Slow</td><td>Twice as fast</td></tr>
          <tr><td>Interest Rate</td><td>Higher</td><td>Usually 0.5–1% lower</td></tr>
          <tr><td>Cash Flow Flexibility</td><td>More (lower payment)</td><td>Less (higher payment)</td></tr>
          <tr><td>Best For</td><td>Max monthly flexibility</td><td>Min total interest cost</td></tr>
        </tbody>
      </table>
    </div>
    <p style="margin-top:.75rem;font-size:.9rem;color:#555">On a $300,000 loan at 6.5%, the 30-year monthly payment is ~$1,896 with ~$382,000 total interest. The 15-year payment is ~$2,613 but total interest is only ~$170,000 — saving over $210,000.</p>
  </div>

  <!-- Down payment table -->
  <div class="content-card">
    <h2>Down Payment Impact on a $350,000 Home (6.5% / 30yr)</h2>
    <div class="tbl-scroll">
      <table class="payoff-table">
        <thead>
          <tr><th>Down Payment</th><th>Down ($)</th><th>Loan Amount</th><th>Monthly P&amp;I</th><th>PMI?</th><th>Total Interest</th></tr>
        </thead>
        <tbody>
          <tr><td>3%</td><td>$10,500</td><td>$339,500</td><td>$2,147</td><td>Yes ~$141/mo</td><td>$432,985</td></tr>
          <tr><td>5%</td><td>$17,500</td><td>$332,500</td><td>$2,103</td><td>Yes ~$138/mo</td><td>$424,074</td></tr>
          <tr><td>10%</td><td>$35,000</td><td>$315,000</td><td>$1,993</td><td>Yes ~$131/mo</td><td>$402,070</td></tr>
          <tr><td>20%</td><td>$70,000</td><td>$280,000</td><td>$1,770</td><td>No</td><td>$357,395</td></tr>
          <tr><td>25%</td><td>$87,500</td><td>$262,500</td><td>$1,660</td><td>No</td><td>$335,058</td></tr>
          <tr><td>30%</td><td>$105,000</td><td>$245,000</td><td>$1,549</td><td>No</td><td>$312,720</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- FAQ -->
  <div class="content-card">
    <h2>Frequently Asked Questions</h2>

    <div class="faq-item">
      <h3>How is a monthly mortgage payment calculated?</h3>
      <p>The formula is M = P × [r(1+r)ⁿ] ÷ [(1+r)ⁿ − 1], where P is the loan amount, r is the monthly interest rate (annual rate ÷ 12), and n is the number of payments (years × 12). This gives the principal and interest portion. Property tax, insurance, and PMI are added on top for the full monthly payment.</p>
    </div>

    <div class="faq-item">
      <h3>What is PMI and when can I remove it?</h3>
      <p>PMI (Private Mortgage Insurance) is required when your down payment is less than 20%. It typically costs 0.5%–1.5% of the loan per year. You can request PMI cancellation once your equity reaches 20%, and lenders must automatically remove it at 22% equity under the federal Homeowners Protection Act.</p>
    </div>

    <div class="faq-item">
      <h3>Is a 30-year or 15-year mortgage better?</h3>
      <p>A 15-year mortgage saves significantly more in total interest and builds equity faster, but the monthly payment is roughly 40% higher. A 30-year mortgage has lower monthly payments for more cash flow flexibility but costs far more in total interest over the life of the loan. Use the preset buttons above to compare both scenarios for your home price.</p>
    </div>

    <div class="faq-item">
      <h3>How much house can I afford?</h3>
      <p>The standard guideline is the 28/36 rule — keep total housing costs (P&amp;I + tax + insurance) under 28% of gross monthly income, and total debt under 36%. A household earning $7,000/month should keep total housing payment under ~$1,960/month. Lenders also evaluate credit score, DTI ratio, employment history, and savings.</p>
    </div>

    <div class="faq-item">
      <h3>What interest rate should I enter?</h3>
      <p>Use the rate quoted by your lender or mortgage broker. Current 30-year fixed rates vary by credit score, loan type, and market conditions. Even a 0.5% difference on a $300,000 loan changes your payment by ~$90/month and ~$32,000 in total interest — always shop multiple lenders.</p>
    </div>

    <div class="faq-item">
      <h3>Does this calculator include taxes and insurance?</h3>
      <p>Yes — click "Add Property Tax, Insurance &amp; HOA" to include these. The default P&amp;I calculation shows principal and interest only. Add your estimated property tax rate (1%–2% is common in most US states), annual insurance premium (~$1,200 average), and HOA if applicable for your complete monthly payment.</p>
    </div>

    <div class="faq-item">
      <h3>What is an amortization schedule?</h3>
      <p>Amortization shows how each payment is split between principal and interest over time. Early in a 30-year loan, most of your payment is interest — on a $300,000 loan at 6.5%, your first payment of $1,896 is roughly $1,625 interest and only $271 principal. Over time this reverses. The table above shows your balance at the end of each year.</p>
    </div>

    <div class="faq-item">
      <h3>Can I pay off my mortgage early?</h3>
      <p>Yes — any extra payment goes directly toward principal, reducing future interest. Use our <a href="/finance/mortgage-payoff-calculator">Mortgage Payoff Calculator</a> to see exactly how many years you save and total interest reduction from extra monthly payments. Even $100–$200/month extra can save years and tens of thousands in interest.</p>
    </div>
  </div>

  <!-- Embed widget -->
  <div class="content-card">
    <h2>Embed This Calculator on Your Site</h2>
    <p>Add a free, live Mortgage Calculator to your blog or website. Just copy this code:</p>
    <div style="background:#0f172a;border-radius:8px;padding:1rem 1.1rem;margin:.75rem 0;overflow-x:auto">
      <code id="embedCode" style="color:#e2e8f0;font-size:.8rem;font-family:monospace;white-space:pre-wrap;word-break:break-all">&lt;iframe src="https://www.computezap.com/embed/mortgage-calculator" width="100%" height="620" style="border:none;max-width:440px;" title="Mortgage Calculator by ComputeZap" loading="lazy"&gt;&lt;/iframe&gt;</code>
    </div>
    <button class="calc-btn" style="max-width:220px" onclick="copyEmbedCode()">Copy Embed Code</button>
    <p style="font-size:.85rem;color:#64748b;margin-top:.5rem">Free to use on any website. The widget links back to ComputeZap.</p>
  </div>

  <!-- Related tools -->
  <div class="content-card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/finance/mortgage-payoff-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        Mortgage Payoff Calculator
      </a>
      <a href="/finance/biweekly-mortgage-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        Biweekly Mortgage Calculator
      </a>
      <a href="/finance/amortization-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        Amortization Calculator
      </a>
      <a href="/finance/apr-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        APR Calculator
      </a>
    </div>
  </div>

</div>

<script is:inline>
var dpMode = '$'; // '$' or '%'

function fmt(n) {
  return '$' + Math.round(n).toLocaleString('en-US');
}

function toggleDP() {
  var hp = parseFloat(document.getElementById('homePrice').value) || 300000;
  var dp = parseFloat(document.getElementById('downPmt').value) || 0;
  var pfx = document.getElementById('dpPfx');

  if (dpMode === '$') {
    // switch to %
    dpMode = '%';
    var pct = hp > 0 ? (dp / hp * 100) : 10;
    document.getElementById('downPmt').value = Math.round(pct * 10) / 10;
    pfx.textContent = '%';
  } else {
    // switch to $
    dpMode = '$';
    var amt = hp * (dp / 100);
    document.getElementById('downPmt').value = Math.round(amt);
    pfx.textContent = '$';
  }
  calcMortgage();
}

function setPreset(price, downPct, term, rate) {
  dpMode = '$';
  document.getElementById('dpPfx').textContent = '$';
  document.getElementById('homePrice').value = price;
  document.getElementById('downPmt').value = Math.round(price * downPct / 100);
  document.getElementById('loanTerm').value = term;
  document.getElementById('intRate').value = rate;

  document.querySelectorAll('.preset-btn').forEach(function(b) { b.classList.remove('active'); });
  event.target.classList.add('active');
  calcMortgage();
}

function calcMortgage() {
  var hp  = parseFloat(document.getElementById('homePrice').value);
  var dpRaw = parseFloat(document.getElementById('downPmt').value);
  var term = parseInt(document.getElementById('loanTerm').value);
  var rate = parseFloat(document.getElementById('intRate').value);
  var propTaxPct = parseFloat(document.getElementById('propTax').value) || 0;
  var homeIns  = parseFloat(document.getElementById('homeIns').value) || 0;
  var hoa = parseFloat(document.getElementById('hoa').value) || 0;

  if (!hp || hp <= 0 || !rate || rate <= 0 || isNaN(dpRaw)) return;

  var dpAmt = dpMode === '$' ? dpRaw : hp * (dpRaw / 100);
  dpAmt = Math.max(0, Math.min(dpAmt, hp - 1000));
  var dpPct = hp > 0 ? dpAmt / hp * 100 : 0;

  // Update helper text
  if (dpMode === '$') {
    document.getElementById('dpPct').textContent = '= ' + dpPct.toFixed(1) + '% of home price';
  } else {
    document.getElementById('dpPct').textContent = '= ' + fmt(dpAmt) + ' down payment';
  }

  var loan = hp - dpAmt;
  var r = rate / 100 / 12;
  var n = term * 12;

  var monthly;
  if (r === 0) {
    monthly = loan / n;
  } else {
    monthly = loan * (r * Math.pow(1 + r, n)) / (Math.pow(1 + r, n) - 1);
  }

  var totalPaid = monthly * n;
  var totalInt  = totalPaid - loan;

  // Optional costs
  var taxMonthly = hp * (propTaxPct / 100) / 12;
  var insMonthly = homeIns / 12;
  var pmi = 0;
  var showPMI = dpPct < 20;
  if (showPMI) {
    pmi = loan * 0.01 / 12; // 1% per year estimate
  }
  var totalMonthly = monthly + taxMonthly + insMonthly + hoa + pmi;

  // Main answer
  var ah = document.getElementById('answerHero');
  ah.classList.add('show');
  document.getElementById('monthlyPI').textContent = fmt(monthly);

  var hasExtras = taxMonthly > 0 || insMonthly > 0 || hoa > 0 || showPMI;
  var mtEl = document.getElementById('monthlyTotal');
  if (hasExtras) {
    mtEl.style.display = '';
    mtEl.textContent = 'Total with tax + insurance' + (showPMI ? ' + PMI' : '') + ': ' + fmt(totalMonthly) + '/mo';
  } else {
    mtEl.style.display = 'none';
  }

  // Stats row
  var sr = document.getElementById('statsRow');
  sr.classList.add('show');
  document.getElementById('loanAmt').textContent  = fmt(loan);
  document.getElementById('downAmt').textContent  = fmt(dpAmt) + ' (' + dpPct.toFixed(1) + '%)';
  document.getElementById('totalInt').textContent = fmt(totalInt);
  document.getElementById('totalCost').textContent = fmt(totalPaid + dpAmt);

  // Extras breakdown
  var extrasRow = document.getElementById('extrasRow');
  if (hasExtras) {
    extrasRow.style.display = '';
    var lines = [
      { label: 'Principal & Interest', val: monthly },
      { label: 'Property Tax', val: taxMonthly },
      { label: 'Home Insurance', val: insMonthly },
      { label: 'HOA', val: hoa },
      { label: 'PMI (est. 1%/yr)', val: pmi, hide: !showPMI },
    ];
    var html = '';
    lines.forEach(function(l) {
      if (l.hide) return;
      if (l.val <= 0 && l.label !== 'Principal & Interest') return;
      html += '<div style="display:flex;justify-content:space-between"><span style="color:#475569">' + l.label + '</span><span style="font-weight:600">' + fmt(l.val) + '/mo</span></div>';
    });
    html += '<div style="display:flex;justify-content:space-between;border-top:1px solid #e2e8f0;margin-top:.5rem;padding-top:.5rem"><span style="font-weight:700">Total Monthly</span><span style="font-weight:800;color:var(--blue)">' + fmt(totalMonthly) + '/mo</span></div>';
    document.getElementById('extrasList').innerHTML = html;
    document.getElementById('pmiNote').style.display = showPMI ? '' : 'none';
  } else {
    extrasRow.style.display = 'none';
  }

  // Amortization table
  buildAmort(loan, r, n, monthly);
}

function buildAmort(loan, r, n, monthly) {
  var balance = loan;
  var tbody = document.getElementById('amortBody');
  var rows = '';
  var years = n / 12;

  for (var yr = 1; yr <= years; yr++) {
    var yrPrincipal = 0, yrInterest = 0;
    var months = Math.min(12, n - (yr - 1) * 12);
    for (var m = 0; m < months; m++) {
      var intPmt = balance * r;
      var prinPmt = Math.min(monthly - intPmt, balance);
      yrInterest  += intPmt;
      yrPrincipal += prinPmt;
      balance -= prinPmt;
      if (balance < 0.01) balance = 0;
    }
    rows += '<tr><td>' + yr + '</td><td>' + fmt(yrPrincipal) + '</td><td>' + fmt(yrInterest) + '</td><td>' + fmt(yrPrincipal + yrInterest) + '</td><td>' + fmt(balance) + '</td></tr>';
    if (balance <= 0) break;
  }

  tbody.innerHTML = rows;
  document.getElementById('amortCard').style.display = '';
}

function copyEmbedCode() {
  var text = document.getElementById('embedCode').textContent;
  navigator.clipboard.writeText(text).then(function() {
    var btn = event.target;
    var original = btn.textContent;
    btn.textContent = 'Copied!';
    setTimeout(function() { btn.textContent = original; }, 2000);
  });
}

// Init on load
calcMortgage();
</script>

</Layout>
