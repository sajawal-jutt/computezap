---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Mortgage Payoff Calculator",
    "url": "https://www.computezap.com/finance/mortgage-payoff-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Calculate how extra mortgage payments reduce your loan term and total interest. See exactly how many months and dollars you save by paying extra each month.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Mortgage Payoff Calculator", "item": "https://www.computezap.com/finance/mortgage-payoff-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do extra mortgage payments reduce my loan?", "acceptedAnswer": { "@type": "Answer", "text": "Extra payments go directly toward the principal balance, which reduces the amount of interest that accrues each month. Over time, this shortens the loan term and reduces total interest paid — often by tens of thousands of dollars on a typical 30-year mortgage." } },
      { "@type": "Question", "name": "How much interest do I save by paying extra on my mortgage?", "acceptedAnswer": { "@type": "Answer", "text": "The savings depend on your loan balance, interest rate, and extra payment amount. On a $300,000 mortgage at 6.5%, paying an extra $200/month saves approximately $68,000 in interest and pays off the loan about 6 years early." } },
      { "@type": "Question", "name": "Is it better to make extra principal payments or invest the money?", "acceptedAnswer": { "@type": "Answer", "text": "It depends on your mortgage interest rate vs. expected investment returns. If your mortgage rate is 7% and stock market returns average 7-10%, investing may yield more over time. But paying off the mortgage is a guaranteed return and risk-free — a personal finance decision based on your risk tolerance and goals." } },
      { "@type": "Question", "name": "What is mortgage amortization?", "acceptedAnswer": { "@type": "Answer", "text": "Amortization is the process of paying off a loan through regular payments. Each payment covers interest first, then reduces the principal. Early in a mortgage, most of the payment is interest. Over time, more goes toward principal. A 30-year amortization schedule has 360 monthly payments." } },
      { "@type": "Question", "name": "Do I need to notify my lender about extra payments?", "acceptedAnswer": { "@type": "Answer", "text": "Yes — specify that extra amounts are for 'principal only.' Without this instruction, some lenders may apply extra money toward next month's payment rather than reducing principal directly." } },
      { "@type": "Question", "name": "Is there a prepayment penalty?", "acceptedAnswer": { "@type": "Answer", "text": "Some mortgages include prepayment penalty clauses, especially adjustable-rate or older fixed-rate loans. Check your loan documents or ask your lender before making large extra payments." } }
    ]
  }
]);
---
<Layout
  title="Mortgage Payoff Calculator — Extra Payment Savings | ComputeZap"
  description="Free mortgage payoff calculator. See how extra monthly payments cut years off your loan and save tens of thousands in interest. Instant payoff date comparison."
  canonical="/finance/mortgage-payoff-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › Mortgage Payoff Calculator</nav>
  <h1>Mortgage Payoff Calculator</h1>
  <p>See how extra payments save you years and thousands in interest</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="input-group">
      <label for="balance">Loan Balance</label>
      <div class="input-wrap">
        <span class="input-pfx">$</span>
        <input type="number" id="balance" value="300000" min="0" step="1000" style="padding-left:1.9rem;padding-right:.9rem" oninput="calculate()" />
      </div>
    </div>

    <div class="input-group">
      <label for="rate">Annual Interest Rate</label>
      <div class="input-wrap">
        <input type="number" id="rate" value="6.5" min="0" max="30" step="0.1" oninput="calculate()" />
        <span class="input-sfx">%</span>
      </div>
    </div>

    <div class="input-group">
      <label for="payment">Monthly Payment</label>
      <div class="input-wrap">
        <span class="input-pfx">$</span>
        <input type="number" id="payment" value="1896" min="1" step="1" style="padding-left:1.9rem;padding-right:.9rem" oninput="calculate()" />
      </div>
    </div>

    <div class="input-group">
      <label for="extra">Extra Monthly Payment</label>
      <div class="input-wrap">
        <span class="input-pfx">$</span>
        <input type="number" id="extra" value="200" min="0" step="50" style="padding-left:1.9rem;padding-right:.9rem;background:#fffbeb;border-color:#fcd34d" oninput="calculate()" />
      </div>
    </div>

    <div class="result-hero">
      <div class="r-label">Time Saved</div>
      <div class="r-value" id="r-main">—</div>
      <div class="r-sub" id="r-sub">Enter loan details above to see savings</div>
    </div>

    <div class="result-divider">
      <div class="result-half">
        <span class="rh-label">Time Saved</span>
        <span class="rh-value" id="r-time-saved">—</span>
        <span class="rh-sub">vs standard payment</span>
      </div>
      <div class="result-half warn">
        <span class="rh-label">Interest Saved</span>
        <span class="rh-value" id="r-int-saved">—</span>
        <span class="rh-sub">total over loan life</span>
      </div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Standard Payoff</span><span class="stat-val" id="r-std-date">—</span></div>
      <div class="stat-box"><span class="stat-lbl">New Payoff Date</span><span class="stat-val" id="r-ext-date">—</span></div>
      <div class="stat-box"><span class="stat-lbl">Standard Interest</span><span class="stat-val" id="r-std-int">—</span></div>
      <div class="stat-box"><span class="stat-lbl">New Total Interest</span><span class="stat-val" id="r-ext-int">—</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Standard vs. Extra Payment Comparison</h2>
    <div class="compare-grid">
      <div class="compare-col">
        <div class="cmp-head">
          <span class="cmp-icon">📅</span>
          <span class="cmp-title">Standard Payment</span>
        </div>
        <div class="cmp-row"><span class="cmp-lbl">Monthly</span><span class="cmp-val" id="c-std-pay">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Loan Term</span><span class="cmp-val" id="c-std-mo">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Payoff Date</span><span class="cmp-val" id="c-std-date">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Total Paid</span><span class="cmp-val" id="c-std-total">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Total Interest</span><span class="cmp-val" id="c-std-int">—</span></div>
      </div>
      <div class="compare-col highlight">
        <div class="cmp-head">
          <span class="cmp-icon">💰</span>
          <span class="cmp-title">With Extra Payment</span>
        </div>
        <div class="cmp-row"><span class="cmp-lbl">Monthly</span><span class="cmp-val" id="c-ext-pay">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Loan Term</span><span class="cmp-val" id="c-ext-mo">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Payoff Date</span><span class="cmp-val" id="c-ext-date">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Total Paid</span><span class="cmp-val" id="c-ext-total">—</span></div>
        <div class="cmp-row"><span class="cmp-lbl">Total Interest</span><span class="cmp-val" id="c-ext-int">—</span></div>
      </div>
    </div>
    <div class="save-banner">
      <span class="save-banner-lbl">Your Interest Savings</span>
      <span class="save-banner-val" id="save-val">Add extra payment above to see savings</span>
    </div>
  </div>

  <div class="card">
    <h2>How Extra Mortgage Payments Work</h2>
    <p>When you make an extra payment on your mortgage, it goes <strong>directly to the principal</strong> — reducing your loan balance immediately. A lower balance means less interest accrues next month, so more of every future payment goes to principal too. This compounding effect accelerates payoff significantly.</p>
    <div class="formula-box">
      <div class="formula-text">Monthly interest = balance × (annual rate ÷ 12 ÷ 100)</div>
      <div class="formula-text">Principal paid = monthly payment − interest</div>
      <div class="formula-text">New balance = old balance − principal paid − extra payment</div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Key insight:</strong> An extra $200/month on a $300K mortgage at 6.5% saves approximately $68,000 in interest and pays off the loan about 6 years early. The earlier in the loan you start extra payments, the more you save.</p>
    </div>
  </div>

  <div class="card">
    <h2>Strategies to Pay Off Your Mortgage Faster</h2>
    <p>Every strategy below reduces your principal faster — cutting interest and shortening the loan term.</p>
    <ul>
      <li><strong>Round up your payment</strong> — if your payment is $1,847, round up to $1,900 or $2,000. Even $53 extra per month adds up to significant savings over 30 years.</li>
      <li><strong>Make biweekly payments</strong> — paying half your monthly amount every two weeks means 26 half-payments (= 13 full payments) per year instead of 12. That one extra payment per year cuts years off the loan.</li>
      <li><strong>Apply windfalls to principal</strong> — tax refunds, bonuses, and inheritances applied directly to your mortgage principal shave years off your loan term.</li>
      <li><strong>Refinance to a shorter term</strong> — switching from a 30-year to a 15-year mortgage at a lower rate dramatically cuts total interest, though monthly payments will be higher.</li>
      <li><strong>Never skip extra payments</strong> — consistency matters most. Even one extra payment per year for 30 years cuts meaningful time off the loan.</li>
    </ul>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do extra mortgage payments reduce my loan?</h3>
      <p>Extra payments go directly to the principal balance. A lower principal means less interest accrues each month — so more of future regular payments also go to principal. This acceleration shortens your loan term and reduces total interest paid.</p>
    </div>
    <div class="faq-item">
      <h3>Do I need to notify my lender about extra payments?</h3>
      <p>Yes — specify that the extra amount is for <strong>"principal only."</strong> Without this instruction, some lenders may apply extra money toward next month's payment (which still includes interest) rather than reducing principal directly.</p>
    </div>
    <div class="faq-item">
      <h3>Is there a prepayment penalty?</h3>
      <p>Some mortgages include prepayment penalty clauses, especially adjustable-rate or older fixed-rate loans. Check your loan documents or ask your lender before making large extra payments.</p>
    </div>
    <div class="faq-item">
      <h3>What is mortgage amortization?</h3>
      <p>Amortization is how loan payments are split between interest and principal over time. Early payments are mostly interest; later payments are mostly principal. Extra payments shift more toward principal immediately, accelerating the payoff.</p>
    </div>
    <div class="faq-item">
      <h3>Should I pay extra on my mortgage or invest?</h3>
      <p>Paying extra gives a guaranteed return equal to your mortgage rate. Investing may yield higher returns but involves market risk. If your mortgage rate is above 6–7%, paying down debt is often the better risk-adjusted choice. Below 5%, investing typically wins over the long term.</p>
    </div>
    <div class="faq-item">
      <h3>How much can I save with $100 extra per month?</h3>
      <p>On a $300,000 mortgage at 6.5%, an extra $100/month saves roughly $38,000 in interest and cuts 3–4 years off the loan. Enter your specific numbers above to see your exact savings.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Finance Calculators</h2>
    <div class="next-grid">
      <a href="/biweekly-mortgage-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Biweekly Mortgage Calculator</h3>
        <p>Save years and thousands by paying every two weeks.</p>
      </a>
      <a href="/debt-snowball-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Debt Snowball Calculator</h3>
        <p>Pay off all your debts — see your exact debt-free date.</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Calculate Certificate of Deposit interest earnings.</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Tax</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find the original pre-tax price from any total.</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Calculate the final price after any discount.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
(function() {
  function fmtMoney(v) { return '$' + Math.round(v).toLocaleString(); }
  function fmtDate(months) {
    var d = new Date();
    d.setMonth(d.getMonth() + Math.round(months));
    return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }
  function fmtMonths(m) {
    var y = Math.floor(m / 12), mo = Math.round(m % 12);
    if (y === 0) return mo + ' mo';
    if (mo === 0) return y + ' yr';
    return y + ' yr ' + mo + ' mo';
  }
  function set(id, v) { var el = document.getElementById(id); if (el) el.textContent = v; }

  function amortize(balance, mr, payment) {
    if (mr === 0) return { months: Math.ceil(balance / payment), interest: 0 };
    var b = balance, totalInt = 0, months = 0;
    var minPay = b * mr / (1 - Math.pow(1 + mr, -360));
    if (payment < minPay * 0.9999) return null;
    while (b > 0.01 && months < 600) {
      var interest = b * mr;
      totalInt += interest;
      var principal = Math.min(payment - interest, b);
      b -= principal;
      months++;
      if (principal <= 0) break;
    }
    return { months: months, interest: totalInt };
  }

  window.calculate = function() {
    var balance = parseFloat(document.getElementById('balance').value) || 0;
    var rate = parseFloat(document.getElementById('rate').value) || 0;
    var payment = parseFloat(document.getElementById('payment').value) || 0;
    var extra = parseFloat(document.getElementById('extra').value) || 0;
    if (balance <= 0 || rate <= 0 || payment <= 0) return;

    var mr = rate / 100 / 12;
    var std = amortize(balance, mr, payment);
    var ext = extra > 0 ? amortize(balance, mr, payment + extra) : null;

    if (!std) {
      set('r-main', 'Payment Too Low');
      set('r-sub', 'Increase your monthly payment to cover interest');
      return;
    }

    var savedMo = ext ? std.months - ext.months : 0;
    var savedInt = ext ? std.interest - ext.interest : 0;
    var extMo = ext ? ext.months : std.months;
    var extInt = ext ? ext.interest : std.interest;

    if (ext && savedMo > 0) {
      set('r-main', fmtMonths(savedMo));
      set('r-sub', 'Saved — New payoff: ' + fmtDate(extMo));
    } else {
      set('r-main', fmtDate(std.months));
      set('r-sub', 'Payoff in ' + fmtMonths(std.months) + ' — add extra payment to see savings');
    }

    set('r-time-saved', savedMo > 0 ? fmtMonths(savedMo) : '—');
    set('r-int-saved', savedInt > 0 ? fmtMoney(savedInt) : '—');
    set('r-std-date', fmtDate(std.months));
    set('r-ext-date', ext ? fmtDate(extMo) : '—');
    set('r-std-int', fmtMoney(std.interest));
    set('r-ext-int', fmtMoney(extInt));

    set('c-std-pay', fmtMoney(payment) + '/mo');
    set('c-std-mo', fmtMonths(std.months));
    set('c-std-date', fmtDate(std.months));
    set('c-std-total', fmtMoney(payment * std.months));
    set('c-std-int', fmtMoney(std.interest));

    if (ext) {
      set('c-ext-pay', fmtMoney(payment + extra) + '/mo');
      set('c-ext-mo', fmtMonths(ext.months));
      set('c-ext-date', fmtDate(ext.months));
      set('c-ext-total', fmtMoney((payment + extra) * ext.months));
      set('c-ext-int', fmtMoney(extInt));
      set('save-val', fmtMoney(savedInt) + ' saved in interest');
    } else {
      set('c-ext-pay', '—'); set('c-ext-mo', '—'); set('c-ext-date', '—');
      set('c-ext-total', '—'); set('c-ext-int', '—');
      set('save-val', 'Add extra payment above to see savings');
    }
  };

  window.addEventListener('load', calculate);
})();
</script>
</Layout>
