<script is:inline>
var mode = 'c';

function fmt(v, d) {
  if (d === undefined) d = 4;
  return parseFloat(v.toFixed(d)).toString();
}

function convert() {
  var a = parseFloat(document.getElementById('inp-a').value);
  var b = parseFloat(document.getElementById('inp-b').value);
  var c = parseFloat(document.getElementById('inp-c').value);
  var err = document.getElementById('err-msg');
  var result, aFin, bFin, cFin;

  try {
    if (mode === 'c') {
      if (isNaN(a) || isNaN(b) || a <= 0 || b <= 0) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(a * a + b * b);
      aFin = a; bFin = b; cFin = result;
    } else if (mode === 'a') {
      if (isNaN(b) || isNaN(c) || b <= 0 || c <= 0 || c <= b) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(c * c - b * b);
      aFin = result; bFin = b; cFin = c;
    } else {
      if (isNaN(a) || isNaN(c) || a <= 0 || c <= 0 || c <= a) { err.classList.add('show'); return; }
      err.classList.remove('show');
      result = Math.sqrt(c * c - a * a);
      aFin = a; bFin = result; cFin = c;
    }

    var area = (aFin * bFin) / 2;
    var perim = aFin + bFin + cFin;
    var alpha = Math.atan(aFin / bFin) * (180 / Math.PI);
    var beta = 90 - alpha;

    var label = mode === 'c' ? 'Hypotenuse c' : (mode === 'a' ? 'Leg a' : 'Leg b');
    var varName = mode === 'c' ? 'c' : (mode === 'a' ? 'a' : 'b');

    document.getElementById('r-main').textContent = fmt(result);
    document.getElementById('res-lbl').textContent = label;
    document.getElementById('r-sub').textContent = fmt(aFin) + '² + ' + fmt(bFin) + '² = ' + fmt(cFin) + '²';
    document.getElementById('s1-lbl').textContent = label;
    document.getElementById('s1-val').textContent = varName + ' = ' + fmt(result);
    document.getElementById('s-area').textContent = fmt(area, 2) + ' sq units';
    document.getElementById('s-perim').textContent = fmt(perim, 2);
    document.getElementById('s-angle').textContent = fmt(alpha, 2) + '° / ' + fmt(beta, 2) + '°';
  } catch(e) {
    err.classList.add('show');
  }
}

function setMode(m) {
  mode = m;
  ['c','a','b'].forEach(function(x){
    document.getElementById('btn-'+x).classList.toggle('active', x === m);
  });
  var showC = m !== 'c';
  var showA = m !== 'a';
  var showB = m !== 'b';

  document.getElementById('lbl-a').style.display = showA ? '' : 'none';
  document.getElementById('inp-a').parentElement.style.display = showA ? '' : 'none';
  document.getElementById('lbl-b').style.display = showB ? '' : 'none';
  document.getElementById('inp-b').parentElement.style.display = showB ? '' : 'none';
  document.getElementById('lbl-c').style.display = showC ? '' : 'none';
  document.getElementById('wrap-c').style.display = showC ? '' : 'none';

  if (m === 'c') { document.getElementById('inp-a').value = 3; document.getElementById('inp-b').value = 4; }
  else if (m === 'a') { document.getElementById('inp-b').value = 4; document.getElementById('inp-c').value = 5; }
  else { document.getElementById('inp-a').value = 3; document.getElementById('inp-c').value = 5; }
  convert();
}

function setTriple(a, b) {
  setMode('c');
  document.getElementById('inp-a').value = a;
  document.getElementById('inp-b').value = b;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
