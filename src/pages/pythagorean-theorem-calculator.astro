import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Pythagorean Theorem Calculator",
    "url": "https://computezap.com/pythagorean-theorem-calculator",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Calculate any side of a right triangle using a² + b² = c². Find hypotenuse, legs, area, perimeter, and angles instantly.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Pythagorean Theorem Calculator", "item": "https://computezap.com/pythagorean-theorem-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "What is the Pythagorean theorem?", "acceptedAnswer": { "@type": "Answer", "text": "The Pythagorean theorem states that in a right triangle, the square of the hypotenuse (c) equals the sum of squares of the two legs (a and b). Formula: a² + b² = c²." } },
      { "@type": "Question", "name": "How do I find the hypotenuse?", "acceptedAnswer": { "@type": "Answer", "text": "To find the hypotenuse c, use: c = √(a² + b²). For example, if a = 3 and b = 4, then c = √(9 + 16) = √25 = 5." } },
      { "@type": "Question", "name": "How do I find a missing leg?", "acceptedAnswer": { "@type": "Answer", "text": "To find leg a when you know b and c: a = √(c² − b²). Example: if b = 4 and c = 5, then a = √(25 − 16) = √9 = 3." } },
      { "@type": "Question", "name": "What are the most common Pythagorean triples?", "acceptedAnswer": { "@type": "Answer", "text": "Common Pythagorean triples (a, b, c) where all three are whole numbers: 3-4-5, 5-12-13, 8-15-17, 7-24-25, 20-21-29. Multiples of these also work: 6-8-10, 9-12-15." } }
    ]
  }
]);
