---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Ounces in a Pound Calculator",
    "url": "https://www.computezap.com/converters/ounces-in-a-pound",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "How many ounces in a pound? 1 pound = 16 ounces. Free oz to lbs and lbs to oz converter with full conversion table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Ounces in a Pound", "item": "https://www.computezap.com/converters/ounces-in-a-pound" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many ounces in a pound?", "acceptedAnswer": { "@type": "Answer", "text": "There are exactly 16 ounces in 1 pound. 1 lb = 16 oz, 2 lbs = 32 oz, 0.5 lbs = 8 oz." } },
      { "@type": "Question", "name": "How do you convert pounds to ounces?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply pounds by 16. Formula: oz = lbs × 16. Example: 2.5 lbs × 16 = 40 oz." } },
      { "@type": "Question", "name": "How do you convert ounces to pounds?", "acceptedAnswer": { "@type": "Answer", "text": "Divide ounces by 16. Formula: lbs = oz ÷ 16. Example: 24 oz ÷ 16 = 1.5 lbs." } },
      { "@type": "Question", "name": "How many ounces in a half pound?", "acceptedAnswer": { "@type": "Answer", "text": "There are 8 ounces in a half pound (0.5 lb). A quarter pound = 4 oz, three-quarter pound = 12 oz." } },
      { "@type": "Question", "name": "Is a fluid ounce the same as an ounce?", "acceptedAnswer": { "@type": "Answer", "text": "No. Fluid ounces (fl oz) measure volume. Regular ounces (oz) measure weight. When converting to pounds, always use weight ounces (oz)." } },
      { "@type": "Question", "name": "How many ounces in a pound of gold?", "acceptedAnswer": { "@type": "Answer", "text": "Gold uses Troy weight: 1 Troy pound = 12 Troy ounces. For everyday use, 1 standard pound = 16 standard ounces always." } }
    ]
  }
]);
---
<Layout
  title="Ounces in a Pound — How Many Oz in a lb? | ComputeZap"
  description="How many ounces in a pound? 1 pound = 16 ounces exactly. Free lbs to oz and oz to lbs converter with full conversion table from 1 oz to 10 lbs."
  canonical="/converters/ounces-in-a-pound"
  schema={schema}
>
<!-- Styles loaded from global.css (Design Standard v2) -->

<div class="page-hero">
  <nav><a href="/">Home</a> › Ounces in a Pound</nav>
  <h1>Ounces in a Pound</h1>
  <p>1 pound = 16 ounces — convert lbs to oz or oz to lbs instantly</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-lbs">lbs → oz</button>
      <button class="mode-btn" id="btn-oz">oz → lbs</button>
    </div>
    <div class="input-group">
      <label id="inp-lbl">Pounds (lb)</label>
      <div class="input-wrap">
        <input type="number" id="amount" value="1" min="0" step="0.1" />
        <span class="input-sfx" id="inp-sfx">lb</span>
      </div>
    </div>
    <span class="preset-lbl">Quick values</span>
    <div class="preset-wrap" id="preset-wrap">
      <button class="preset-btn" onclick="setVal(0.5)">½ lb</button>
      <button class="preset-btn" onclick="setVal(1)">1</button>
      <button class="preset-btn" onclick="setVal(2)">2</button>
      <button class="preset-btn" onclick="setVal(5)">5</button>
      <button class="preset-btn" onclick="setVal(10)">10</button>
    </div>
    <button class="calc-btn" id="calc-btn">Convert</button>
    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">1 lb =</div>
      <div class="a-value" id="ans-value">16</div>
      <div class="a-unit" id="ans-unit">ounces (oz)</div>
      <div class="a-sub" id="ans-sub">1 × 16 = 16 oz</div>
    </div>
    <div class="stats-row" id="stats">
      <div class="stat-box">
        <span class="stat-lbl">Grams</span>
        <span class="stat-val" id="s1-val">453.59 g</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Kilograms</span>
        <span class="stat-val" id="s2-val">0.4536 kg</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl" id="s3-lbl">Pounds</span>
        <span class="stat-val" id="s3-val">1 lb</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Milligrams</span>
        <span class="stat-val" id="s4-val">453,592 mg</span>
      </div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="content-card">
    <h2>How Many Ounces in a Pound?</h2>
    <p>There are exactly <strong>16 ounces in 1 pound</strong>. This is a fixed US customary and Imperial measurement — no rounding required.</p>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">1 pound</span><span class="answer-val">= 16 oz</span></div>
      <div class="answer-row"><span class="answer-lbl">½ pound</span><span class="answer-val">= 8 oz</span></div>
      <div class="answer-row"><span class="answer-lbl">¼ pound</span><span class="answer-val">= 4 oz</span></div>
      <div class="answer-row"><span class="answer-lbl">1 pound</span><span class="answer-val">= 453.59 grams</span></div>
    </div>
  </div>

  <div class="two-col">
    <div class="content-card">
      <h2>Pounds to Ounces</h2>
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead><tr><th>Pounds (lb)</th><th>Ounces (oz)</th><th>Grams</th></tr></thead>
          <tbody>
            {[
              [0.25,'4','113.4'],
              [0.5,'8','226.8'],
              [0.75,'12','340.2'],
              [1,'16','453.6'],
              [1.5,'24','680.4'],
              [2,'32','907.2'],
              [2.5,'40','1,134'],
              [3,'48','1,361'],
              [4,'64','1,814'],
              [5,'80','2,268'],
              [10,'160','4,536'],
            ].map(([lb, oz, g]) => (
              <tr onclick={`setVal(${lb})`} class={lb === 1 ? 'hi' : ''}>
                <td class="acc">{lb === 0.25 ? '¼ lb' : lb === 0.5 ? '½ lb' : lb === 0.75 ? '¾ lb' : lb + ' lb'}</td>
                <td>{oz} oz</td>
                <td>{g} g</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <div class="content-card">
      <h2>Ounces to Pounds</h2>
      <div style="overflow-x:auto">
        <table class="ref-tbl">
          <thead><tr><th>Ounces (oz)</th><th>Pounds (lb)</th><th>Grams</th></tr></thead>
          <tbody>
            <tr><td class="acc">1 oz</td><td>0.0625 lb</td><td>28.35 g</td></tr>
            <tr><td class="acc">2 oz</td><td>0.125 lb</td><td>56.70 g</td></tr>
            <tr><td class="acc">4 oz</td><td>0.25 lb (¼ lb)</td><td>113.4 g</td></tr>
            <tr><td class="acc">6 oz</td><td>0.375 lb</td><td>170.1 g</td></tr>
            <tr class="hi"><td class="acc">8 oz</td><td>0.5 lb (½ lb)</td><td>226.8 g</td></tr>
            <tr><td class="acc">10 oz</td><td>0.625 lb</td><td>283.5 g</td></tr>
            <tr><td class="acc">12 oz</td><td>0.75 lb (¾ lb)</td><td>340.2 g</td></tr>
            <tr class="hi"><td class="acc">16 oz</td><td>1 lb</td><td>453.6 g</td></tr>
            <tr><td class="acc">24 oz</td><td>1.5 lb</td><td>680.4 g</td></tr>
            <tr class="hi"><td class="acc">32 oz</td><td>2 lb</td><td>907.2 g</td></tr>
            <tr><td class="acc">48 oz</td><td>3 lb</td><td>1,361 g</td></tr>
            <tr><td class="acc">80 oz</td><td>5 lb</td><td>2,268 g</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="content-card">
    <h2>US Weight Units Reference</h2>
    <div class="tip-box">
      <span class="tip-icon">⚖️</span>
      <p><strong>Formula:</strong> lbs → oz: multiply by 16 &nbsp;|&nbsp; oz → lbs: divide by 16</p>
    </div>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Unit</th><th>= Ounces</th><th>= Pounds</th><th>= Grams</th></tr></thead>
        <tbody>
          <tr><td>1 ounce (oz)</td><td>1 oz</td><td>0.0625 lb</td><td>28.35 g</td></tr>
          <tr><td>1 quarter pound</td><td>4 oz</td><td>0.25 lb</td><td>113.4 g</td></tr>
          <tr><td>1 half pound</td><td>8 oz</td><td>0.5 lb</td><td>226.8 g</td></tr>
          <tr class="hi"><td><strong>1 pound (lb)</strong></td><td><strong>16 oz</strong></td><td><strong>1 lb</strong></td><td><strong>453.6 g</strong></td></tr>
          <tr><td>1 kilogram</td><td>35.27 oz</td><td>2.205 lb</td><td>1,000 g</td></tr>
          <tr><td>1 stone</td><td>224 oz</td><td>14 lb</td><td>6,350 g</td></tr>
          <tr><td>1 US ton</td><td>32,000 oz</td><td>2,000 lb</td><td>907,185 g</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="content-card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many ounces in a pound?</h3>
      <p>There are exactly <strong>16 ounces</strong> in 1 pound. So 1 lb = 16 oz, 2 lbs = 32 oz, 5 lbs = 80 oz.</p>
    </div>
    <div class="faq-item">
      <h3>How do you convert pounds to ounces?</h3>
      <p>Multiply pounds by 16. Formula: oz = lbs × 16. Example: 3.5 lbs × 16 = <strong>56 oz</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do you convert ounces to pounds?</h3>
      <p>Divide ounces by 16. Formula: lbs = oz ÷ 16. Example: 40 oz ÷ 16 = <strong>2.5 lbs</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How many ounces in a half pound?</h3>
      <p><strong>8 ounces</strong>. Half a pound = 0.5 lb = 8 oz = 226.8 grams. A quarter pound = 4 oz.</p>
    </div>
    <div class="faq-item">
      <h3>Is a fluid ounce the same as an ounce?</h3>
      <p>No. Fluid ounces (fl oz) measure volume for liquids. Regular ounces (oz) measure weight. When converting to pounds, always use weight ounces (oz).</p>
    </div>
    <div class="faq-item">
      <h3>How many ounces in a pound of gold?</h3>
      <p>Gold uses Troy weight: <strong>1 Troy pound = 12 Troy ounces</strong>. For everyday use (cooking, shipping, body weight), 1 standard pound = 16 standard ounces always.</p>
    </div>
  </div>

  <div class="content-card">
    <h2>Related Converters</h2>
    <div class="next-grid">
      <a href="/kg-to-lbs" class="next-card">
        <span class="next-tag">Weight</span>
        <h3>kg to lbs</h3>
        <p>Convert kilograms to pounds instantly.</p>
      </a>
      <a href="/oz-to-quarts" class="next-card">
        <span class="next-tag">Volume</span>
        <h3>Oz to Quarts</h3>
        <p>Convert fluid ounces to quarts — 1 quart = 32 oz.</p>
      </a>
      <a href="/liters-to-gallons" class="next-card">
        <span class="next-tag">Volume</span>
        <h3>Liters to Gallons</h3>
        <p>Convert liters to US or UK gallons.</p>
      </a>
      <a href="/cups-to-tablespoons" class="next-card">
        <span class="next-tag">Kitchen</span>
        <h3>Cups to Tablespoons</h3>
        <p>How many tablespoons in a cup.</p>
      </a>
      <a href="/celsius-to-fahrenheit" class="next-card">
        <span class="next-tag">Temperature</span>
        <h3>Celsius to °F</h3>
        <p>Convert temperature for cooking.</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Length</span>
        <h3>cm to Inches</h3>
        <p>Convert centimeters to inches instantly.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
  var mode = 'lbs';

  document.getElementById('btn-lbs').addEventListener('click', function() { setMode('lbs'); });
  document.getElementById('btn-oz').addEventListener('click', function() { setMode('oz'); });
  document.getElementById('calc-btn').addEventListener('click', convert);
  document.getElementById('amount').addEventListener('input', convert);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') convert(); });

  document.getElementById('amount').value = 1;
  convert();

  function fmt(v, d) { return parseFloat(v.toFixed(d !== undefined ? d : 4)).toLocaleString('en-US'); }

  function setMode(m) {
    mode = m;
    var isLbs = m === 'lbs';
    document.getElementById('btn-lbs').classList.toggle('active', isLbs);
    document.getElementById('btn-oz').classList.toggle('active', !isLbs);
    document.getElementById('inp-lbl').textContent = isLbs ? 'Pounds (lb)' : 'Ounces (oz)';
    document.getElementById('inp-sfx').textContent = isLbs ? 'lb' : 'oz';
    var presets = document.getElementById('preset-wrap');
    presets.innerHTML = (isLbs ? [0.5,1,2,5,10] : [8,16,32,64,128])
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+(v===0.5?'½ lb':v)+'</button>'; }).join('');
    document.getElementById('amount').value = isLbs ? 1 : 16;
    convert();
  }

  function convert() {
    var val = parseFloat(document.getElementById('amount').value);
    if (isNaN(val) || val < 0) return;
    var lbs, oz;
    if (mode === 'lbs') {
      lbs = val; oz = val * 16;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' lb =';
      document.getElementById('ans-value').textContent = fmt(oz, 4);
      document.getElementById('ans-unit').textContent = 'ounces (oz)';
      document.getElementById('ans-sub').textContent = fmt(val,2) + ' × 16 = ' + fmt(oz,4) + ' oz';
      document.getElementById('s3-lbl').textContent = 'Pounds';
      document.getElementById('s3-val').textContent = fmt(lbs, 4) + ' lb';
    } else {
      oz = val; lbs = val / 16;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' oz =';
      document.getElementById('ans-value').textContent = fmt(lbs, 6);
      document.getElementById('ans-unit').textContent = 'pounds (lb)';
      document.getElementById('ans-sub').textContent = fmt(val,2) + ' ÷ 16 = ' + fmt(lbs,6) + ' lb';
      document.getElementById('s3-lbl').textContent = 'Ounces';
      document.getElementById('s3-val').textContent = fmt(oz, 2) + ' oz';
    }
    var grams = lbs * 453.59237;
    var kg = lbs * 0.45359237;
    var mg = lbs * 453592.37;
    document.getElementById('s1-val').textContent = fmt(grams, 2) + ' g';
    document.getElementById('s2-val').textContent = fmt(kg, 4) + ' kg';
    document.getElementById('s4-val').textContent = Math.round(mg).toLocaleString('en-US') + ' mg';
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }

  function setVal(v) { document.getElementById('amount').value = v; convert(); }
</script>
</Layout>
