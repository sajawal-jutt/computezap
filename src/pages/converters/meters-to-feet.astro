<script is:inline>
  var mode = 'm';

  document.getElementById('btn-m').addEventListener('click', function() { setMode('m'); });
  document.getElementById('btn-ft').addEventListener('click', function() { setMode('ft'); });
  document.getElementById('calc-btn').addEventListener('click', convert);
  document.getElementById('amount').addEventListener('input', convert);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') convert(); });

  document.getElementById('amount').value = 1.8;
  convert();

  function fmt(v, d) { return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString(); }

  function toFeetInches(totalFeet) {
    var ft = Math.floor(totalFeet);
    var inches = parseFloat(((totalFeet - ft) * 12).toFixed(2));
    return ft + '′ ' + inches + '″';
  }

  function setMode(m) {
    mode = m;
    var isM = m === 'm';
    document.getElementById('btn-m').classList.toggle('active', isM);
    document.getElementById('btn-ft').classList.toggle('active', !isM);
    document.getElementById('inp-lbl').textContent = isM ? 'Meters (m)' : 'Feet (ft)';
    document.getElementById('inp-sfx').textContent = isM ? 'm' : 'ft';
    var presets = document.getElementById('preset-wrap');
    presets.innerHTML = (isM ? [1,1.5,1.7,1.8,2,5,10] : [1,3,5,6,10,20,100])
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
    document.getElementById('s1-lbl').textContent = isM ? 'Feet & Inches' : 'Meters';
    document.getElementById('s2-lbl').textContent = isM ? 'Inches' : 'Centimeters';
    document.getElementById('s3-lbl').textContent = isM ? 'Centimeters' : 'Inches';
    document.getElementById('s4-lbl').textContent = 'Yards';
    document.getElementById('amount').value = isM ? 1.8 : 6;
    convert();
  }

  function convert() {
    var val = parseFloat(document.getElementById('amount').value);
    if (isNaN(val) || val < 0) return;
    var m, ft, inches, cm, yd;
    if (mode === 'm') {
      m = val; ft = val * 3.28084; inches = val * 39.3701; cm = val * 100; yd = val * 1.09361;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' m =';
      document.getElementById('ans-value').textContent = fmt(ft, 3);
      document.getElementById('ans-unit').textContent = 'feet (ft)';
      document.getElementById('ans-sub').textContent = fmt(val,2) + ' × 3.28084 = ' + fmt(ft,3) + ' ft (' + toFeetInches(ft) + ')';
      document.getElementById('s1-val').textContent = toFeetInches(ft);
      document.getElementById('s2-val').textContent = fmt(inches, 2) + ' in';
      document.getElementById('s3-val').textContent = fmt(cm, 2) + ' cm';
      document.getElementById('s4-val').textContent = fmt(yd, 3) + ' yd';
    } else {
      ft = val; m = val * 0.3048; inches = val * 12; cm = m * 100; yd = val / 3;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' ft =';
      document.getElementById('ans-value').textContent = fmt(m, 4);
      document.getElementById('ans-unit').textContent = 'meters (m)';
      document.getElementById('ans-sub').textContent = fmt(val,2) + ' × 0.3048 = ' + fmt(m,4) + ' m';
      document.getElementById('s1-val').textContent = fmt(m, 4) + ' m';
      document.getElementById('s2-val').textContent = fmt(cm, 2) + ' cm';
      document.getElementById('s3-val').textContent = fmt(inches, 2) + ' in';
      document.getElementById('s4-val').textContent = fmt(yd, 3) + ' yd';
    }
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }

  function setVal(v) { document.getElementById('amount').value = v; convert(); }
</script>
</Layout>
