@media(max-width:768px){.page-hero h1{font-size:1.65rem}.a-value{font-size:2.1rem}.next-grid{grid-template-columns:1fr 1fr}}
@media(max-width:480px){.next-grid{grid-template-columns:1fr}}
</style>

