    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How do you convert Celsius to Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply the Celsius temperature by 9/5 (or 1.8), then add 32. Formula: °F = (°C × 1.8) + 32. Example: 100°C × 1.8 + 32 = 212°F." } },
      { "@type": "Question", "name": "What is 37 degrees Celsius in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "37°C = 98.6°F. This is normal human body temperature. Formula: 37 × 1.8 + 32 = 98.6°F." } },
      { "@type": "Question", "name": "What is 0 degrees Celsius in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "0°C = 32°F. This is the freezing point of water." } },
      { "@type": "Question", "name": "What is 100 degrees Celsius in Fahrenheit?", "acceptedAnswer": { "@type": "Answer", "text": "100°C = 212°F. This is the boiling point of water at sea level." } },
