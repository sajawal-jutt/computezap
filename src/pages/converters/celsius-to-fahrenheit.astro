<script is:inline>
  var mode = 'c';

  document.getElementById('btn-c').addEventListener('click', function() { setMode('c'); });
  document.getElementById('btn-f').addEventListener('click', function() { setMode('f'); });
  document.getElementById('calc-btn').addEventListener('click', convert);
  document.getElementById('amount').addEventListener('input', convert);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') convert(); });

  document.getElementById('amount').value = 100;
  convert();

  function fmt(v, d) { return parseFloat(v.toFixed(d !== undefined ? d : 2)).toString(); }

  function getLabel(c) {
    if (c <= -273.15) return 'Absolute zero';
    if (c <= -40) return 'Extreme cold';
    if (c < 0) return 'Below freezing';
    if (c === 0) return 'Freezing point';
    if (c < 10) return 'Very cold';
    if (c < 18) return 'Cold';
    if (c < 24) return 'Comfortable';
    if (c < 30) return 'Warm';
    if (c < 37) return 'Hot';
    if (c === 37) return 'Body temp';
    if (c < 38) return 'Low-grade fever';
    if (c < 40) return 'Fever';
    if (c < 60) return 'Very hot';
    if (c === 100) return 'Boiling point';
    if (c > 100) return 'Superheated';
    return 'Hot';
  }

  function setMode(m) {
    mode = m;
    var isC = m === 'c';
    document.getElementById('btn-c').classList.toggle('active', isC);
    document.getElementById('btn-f').classList.toggle('active', !isC);
    document.getElementById('inp-lbl').textContent = isC ? 'Temperature in Celsius (°C)' : 'Temperature in Fahrenheit (°F)';
    document.getElementById('inp-sfx').textContent = isC ? '°C' : '°F';
    var presets = document.getElementById('preset-wrap');
    presets.innerHTML = (isC ? [-40,0,20,37,100] : [-40,32,68,98.6,212])
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
    document.getElementById('amount').value = isC ? 100 : 212;
    document.getElementById('s4-lbl').textContent = isC ? 'Fahrenheit' : 'Celsius';
    convert();
  }

  function convert() {
    var val = parseFloat(document.getElementById('amount').value);
    if (isNaN(val)) return;
    var c, f, k, r;
    if (mode === 'c') {
      c = val; f = (val * 9/5) + 32; k = val + 273.15; r = (val + 273.15) * 9/5;
      document.getElementById('ans-label').textContent = fmt(val, 1) + '°C =';
      document.getElementById('ans-value').textContent = fmt(f, 2);
      document.getElementById('ans-unit').textContent = '°F (Fahrenheit)';
      document.getElementById('ans-sub').textContent = '(' + fmt(val,1) + ' × 9/5) + 32 = ' + fmt(f,2) + '°F · ' + getLabel(c);
      document.getElementById('s4-val').textContent = fmt(f, 2) + '°F';
    } else {
      f = val; c = (val - 32) * 5/9; k = c + 273.15; r = val + 459.67;
      document.getElementById('ans-label').textContent = fmt(val, 1) + '°F =';
      document.getElementById('ans-value').textContent = fmt(c, 2);
      document.getElementById('ans-unit').textContent = '°C (Celsius)';
      document.getElementById('ans-sub').textContent = '(' + fmt(val,1) + ' − 32) ÷ 1.8 = ' + fmt(c,2) + '°C · ' + getLabel(c);
      document.getElementById('s4-val').textContent = fmt(c, 2) + '°C';
    }
    document.getElementById('s1-val').textContent = fmt(k, 2) + ' K';
    document.getElementById('s2-val').textContent = fmt(r, 2) + ' °R';
    document.getElementById('s3-val').textContent = getLabel(c);
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }

  function setVal(v) { document.getElementById('amount').value = v; convert(); }
</script>
</Layout>
