---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Markup Calculator",
    "url": "https://computezap.com/markup-calculator",
    "description": "Free markup calculator. Find selling price from cost and markup %, or calculate markup % from cost and selling price. Instant results.",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Percentage Calculator", "item": "https://computezap.com/percentage-calculator" },
      { "@type": "ListItem", "position": 3, "name": "Markup Calculator", "item": "https://computezap.com/markup-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is markup vs margin?",
        "acceptedAnswer": { "@type": "Answer", "text": "Markup is calculated on cost: Markup% = ((Selling - Cost) ÷ Cost) × 100. Margin is calculated on revenue: Margin% = ((Selling - Cost) ÷ Selling) × 100. A 50% markup gives a 33.3% margin." }
      },
      {
        "@type": "Question",
        "name": "How do I calculate selling price with markup?",
        "acceptedAnswer": { "@type": "Answer", "text": "Selling Price = Cost × (1 + Markup% ÷ 100). Example: Cost $40 with 50% markup = $40 × 1.50 = $60 selling price." }
      },
      {
        "@type": "Question",
        "name": "What is a good markup percentage?",
        "acceptedAnswer": { "@type": "Answer", "text": "It depends on the industry. Retail typically uses 50-100% markup. Grocery stores use 10-25%. Jewelry and luxury goods can be 200-300%. Software and digital products often have very high markups due to low marginal cost." }
      },
      {
        "@type": "Question",
        "name": "How do I calculate markup % from cost and selling price?",
        "acceptedAnswer": { "@type": "Answer", "text": "Markup % = ((Selling Price - Cost) ÷ Cost) × 100. Example: Cost $40, Selling Price $60 → ((60-40) ÷ 40) × 100 = 50% markup." }
      }
    ]
  }
]);
---
<Layout
  title="Markup Calculator — Find Selling Price from Cost + Markup % | ComputeZap"
  description="Free markup calculator. Find selling price from cost and markup %, or calculate markup % from cost and price. Includes markup vs margin comparison table."
  canonical="/markup-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › <a href="/percentage-calculator">Percentage</a> › Markup Calculator</nav>
  <h1>Markup Calculator</h1>
  <p>Find selling price from cost + markup %, or calculate markup % from cost and selling price</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-m1">Find Selling Price</button>
      <button class="mode-btn" id="btn-m2">Find Markup %</button>
    </div>

    <div id="inputs-1">
      <div class="input-group">
        <label>Cost Price ($)</label>
        <div class="input-wrap">
          <input type="number" id="cost1" placeholder="40" min="0" step="0.01" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Markup Percentage</label>
        <div class="input-wrap">
          <input type="number" id="markup1" placeholder="50" min="0" step="0.1" />
          <span class="input-sfx">%</span>
        </div>
      </div>
    </div>

    <div id="inputs-2" style="display:none">
      <div class="input-group">
        <label>Cost Price ($)</label>
        <div class="input-wrap">
          <input type="number" id="cost2" placeholder="40" min="0" step="0.01" style="padding-right:.9rem" />
        </div>
      </div>
      <div class="input-group">
        <label>Selling Price ($)</label>
        <div class="input-wrap">
          <input type="number" id="sell2" placeholder="60" min="0" step="0.01" style="padding-right:.9rem" />
        </div>
      </div>
    </div>

    <button class="calc-btn" id="calc-btn">Calculate</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">Selling Price</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit"></div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box"><span class="stat-lbl" id="s1-lbl">Cost</span><span class="stat-val" id="s1-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s2-lbl">Selling Price</span><span class="stat-val" id="s2-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl">Profit</span><span class="stat-val" id="s3-val">—</span></div>
      <div class="stat-box"><span class="stat-lbl" id="s4-lbl">Margin %</span><span class="stat-val" id="s4-val">—</span></div>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Markup Formula</h2>
    <div class="formula-box">
      <div class="formula-text">Selling Price = Cost × (1 + Markup% ÷ 100)</div>
      <div class="formula-sub">Example: Cost $40, Markup 50% → $40 × 1.50 = <strong>$60 selling price</strong></div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Markup % = ((Selling − Cost) ÷ Cost) × 100</div>
      <div class="formula-sub">Example: Cost $40, Selling $60 → ((60−40) ÷ 40) × 100 = <strong>50% markup</strong></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Markup vs Margin:</strong> Markup % is always higher than margin % for the same product. Cost $40, Sell $60 → Markup = 50% but Margin = 33.3%. Don't confuse them in business negotiations!</p>
    </div>
    <div class="compare-grid">
      <div class="compare-card">
        <h3>Markup</h3>
        <p>Based on <strong>cost</strong>.<br/>((Sell − Cost) ÷ Cost) × 100<br/>Used by wholesalers & manufacturers.</p>
      </div>
      <div class="compare-card">
        <h3>Margin</h3>
        <p>Based on <strong>revenue</strong>.<br/>((Sell − Cost) ÷ Sell) × 100<br/>Used by retailers & accountants.</p>
      </div>
    </div>
  </div>

  <div class="card">
    <h2>Markup vs Margin Reference Table</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Markup %</th><th>Selling Price (Cost $100)</th><th>Profit</th><th>Margin %</th></tr></thead>
        <tbody>
          {[
            ['10%', '$110', '$10', '9.09%'],
            ['20%', '$120', '$20', '16.67%'],
            ['25%', '$125', '$25', '20%'],
            ['33%', '$133', '$33', '24.8%'],
            ['50%', '$150', '$50', '33.33%'],
            ['67%', '$167', '$67', '40.12%'],
            ['100%', '$200', '$100', '50%'],
            ['150%', '$250', '$150', '60%'],
            ['200%', '$300', '$200', '66.67%'],
            ['300%', '$400', '$300', '75%'],
          ].map(([markup, sell, profit, margin]) => (
            <tr>
              <td class="acc">{markup}</td>
              <td>{sell}</td>
              <td>{profit}</td>
              <td>{margin}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Common Industry Markup Rates</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead><tr><th>Industry</th><th>Typical Markup</th><th>Typical Margin</th></tr></thead>
        <tbody>
          <tr><td>Grocery / Supermarket</td><td class="acc">10–25%</td><td>9–20%</td></tr>
          <tr><td>Clothing / Apparel</td><td class="acc">100–300%</td><td>50–75%</td></tr>
          <tr><td>Electronics</td><td class="acc">15–50%</td><td>13–33%</td></tr>
          <tr><td>Jewelry</td><td class="acc">100–300%</td><td>50–75%</td></tr>
          <tr><td>Furniture</td><td class="acc">100–200%</td><td>50–67%</td></tr>
          <tr><td>Software / Digital</td><td class="acc">200–1000%+</td><td>67–91%</td></tr>
          <tr><td>Restaurants</td><td class="acc">200–300%</td><td>67–75%</td></tr>
          <tr><td>Auto Parts</td><td class="acc">25–100%</td><td>20–50%</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is markup vs margin?</h3>
      <p>Markup is based on cost: <strong>((Selling − Cost) ÷ Cost) × 100</strong>. Margin is based on selling price: <strong>((Selling − Cost) ÷ Selling) × 100</strong>. A 50% markup equals a 33.3% margin. Markup is always higher than margin for the same transaction.</p>
    </div>
    <div class="faq-item">
      <h3>How do I calculate selling price with 30% markup?</h3>
      <p>Selling Price = Cost × 1.30. If cost is $50: $50 × 1.30 = <strong>$65</strong>. The profit is $15, and the gross margin is 23.1%.</p>
    </div>
    <div class="faq-item">
      <h3>What is a good markup percentage?</h3>
      <p>It depends on the industry. Retail typically uses 50–100% markup. Grocery stores use 10–25%. Jewelry and luxury goods can be 200–300%. Software and digital products often have very high markups due to low marginal cost.</p>
    </div>
    <div class="faq-item">
      <h3>How do I convert markup % to margin %?</h3>
      <p>Margin % = Markup% ÷ (1 + Markup% ÷ 100). For a 50% markup: 50 ÷ (1 + 0.50) = 50 ÷ 1.50 = <strong>33.3% margin</strong>.</p>
    </div>
    <div class="faq-item">
      <h3>How do I convert margin % to markup %?</h3>
      <p>Markup % = Margin% ÷ (1 − Margin% ÷ 100). For a 40% margin: 40 ÷ (1 − 0.40) = 40 ÷ 0.60 = <strong>66.7% markup</strong>.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/margin-calculator" class="next-card">
        <span class="next-tag">Business</span>
        <h3>Margin Calculator</h3>
        <p>Calculate profit margin % from revenue and cost</p>
      </a>
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>Percentage Calculator</h3>
        <p>Find X% of Y — three calculators in one</p>
      </a>
      <a href="/percentage-increase-calculator" class="next-card">
        <span class="next-tag">Percentage</span>
        <h3>% Increase Calculator</h3>
        <p>Calculate percentage increase between two values</p>
      </a>
      <a href="/percent-off-calculator" class="next-card">
        <span class="next-tag">Shopping</span>
        <h3>Percent Off Calculator</h3>
        <p>Find sale price after a percentage discount</p>
      </a>
      <a href="/reverse-sales-tax-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Reverse Sales Tax</h3>
        <p>Find original price before tax was added</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Calculate certificate of deposit earnings</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 1;

document.getElementById('btn-m1').addEventListener('click', function() { setMode(1); });
document.getElementById('btn-m2').addEventListener('click', function() { setMode(2); });
document.getElementById('calc-btn').addEventListener('click', calculate);
document.getElementById('cost1').addEventListener('input', calculate);
document.getElementById('markup1').addEventListener('input', calculate);
document.getElementById('cost2').addEventListener('input', calculate);
document.getElementById('sell2').addEventListener('input', calculate);
document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

function fmt(n) {
  if (n === Math.floor(n)) return '$' + n.toLocaleString();
  return '$' + parseFloat(n.toFixed(2)).toLocaleString(undefined, {minimumFractionDigits:2, maximumFractionDigits:2});
}
function fmtPct(n) { return parseFloat(n.toFixed(2)) + '%'; }

function setMode(m) {
  mode = m;
  document.getElementById('btn-m1').classList.toggle('active', m === 1);
  document.getElementById('btn-m2').classList.toggle('active', m === 2);
  document.getElementById('inputs-1').style.display = m === 1 ? 'block' : 'none';
  document.getElementById('inputs-2').style.display = m === 2 ? 'block' : 'none';
  document.getElementById('answer').classList.remove('show');
  document.getElementById('stats').classList.remove('show');
}

function calculate() {
  if (mode === 1) calcSellPrice();
  else calcMarkup();
}

function calcSellPrice() {
  var cost = parseFloat(document.getElementById('cost1').value);
  var markup = parseFloat(document.getElementById('markup1').value);
  if (isNaN(cost) || isNaN(markup)) return;
  var sell = cost * (1 + markup / 100);
  var profit = sell - cost;
  var margin = (profit / sell) * 100;
  document.getElementById('ans-label').textContent = 'Selling Price';
  document.getElementById('ans-value').textContent = fmt(sell);
  document.getElementById('ans-unit').textContent = 'Cost ' + fmt(cost) + ' + ' + markup + '% markup';
  document.getElementById('ans-sub').textContent = fmt(cost) + ' × ' + parseFloat((1 + markup/100).toFixed(4)) + ' = ' + fmt(sell);
  document.getElementById('s1-lbl').textContent = 'Cost';
  document.getElementById('s1-val').textContent = fmt(cost);
  document.getElementById('s2-lbl').textContent = 'Selling Price';
  document.getElementById('s2-val').textContent = fmt(sell);
  document.getElementById('s3-val').textContent = fmt(profit);
  document.getElementById('s4-lbl').textContent = 'Margin %';
  document.getElementById('s4-val').textContent = fmtPct(margin);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}

function calcMarkup() {
  var cost = parseFloat(document.getElementById('cost2').value);
  var sell = parseFloat(document.getElementById('sell2').value);
  if (isNaN(cost) || isNaN(sell) || cost === 0) return;
  var markup = ((sell - cost) / cost) * 100;
  var margin = ((sell - cost) / sell) * 100;
  var profit = sell - cost;
  document.getElementById('ans-label').textContent = 'Markup %';
  document.getElementById('ans-value').textContent = fmtPct(markup);
  document.getElementById('ans-unit').textContent = 'Profit: ' + fmt(profit) + ' | Margin: ' + fmtPct(margin);
  document.getElementById('ans-sub').textContent = '((' + fmt(sell) + ' − ' + fmt(cost) + ') ÷ ' + fmt(cost) + ') × 100';
  document.getElementById('s1-lbl').textContent = 'Cost';
  document.getElementById('s1-val').textContent = fmt(cost);
  document.getElementById('s2-lbl').textContent = 'Selling Price';
  document.getElementById('s2-val').textContent = fmt(sell);
  document.getElementById('s3-val').textContent = fmt(profit);
  document.getElementById('s4-lbl').textContent = 'Margin %';
  document.getElementById('s4-val').textContent = fmtPct(margin);
  document.getElementById('answer').classList.add('show');
  document.getElementById('stats').classList.add('show');
}
</script>
</Layout>
