---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Yards to Meters Calculator",
    "url": "https://computezap.com/yards-to-meters",
    "description": "Free yards to meters converter. Convert yards to meters, cm, feet, and inches instantly. Works both ways.",
    "applicationCategory": "UtilitiesApplication",
    "operatingSystem": "Any"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Yards to Meters", "item": "https://computezap.com/yards-to-meters" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How many meters is 1 yard?",
        "acceptedAnswer": { "@type": "Answer", "text": "1 yard = 0.9144 meters exactly. This is the international definition of the yard since 1959." }
      },
      {
        "@type": "Question",
        "name": "How do you convert yards to meters?",
        "acceptedAnswer": { "@type": "Answer", "text": "Multiply the yard value by 0.9144. Example: 100 yards × 0.9144 = 91.44 meters. For a quick estimate, multiply by 0.9." }
      },
      {
        "@type": "Question",
        "name": "Is a yard bigger than a meter?",
        "acceptedAnswer": { "@type": "Answer", "text": "No. 1 yard = 0.9144 meters, so a yard is slightly shorter than a meter. 1 meter = 1.09361 yards." }
      }
    ]
  }
]);
---
<Layout
  title="Yards to Meters Calculator — Convert yd to m Instantly | ComputeZap"
  description="Convert yards to meters instantly. Free yards-to-meters calculator. Also converts to cm, feet, and inches. Works in both directions."
  canonical="/yards-to-meters"
  schema={schema}
>
<style is:global>
.ytm-hero{text-align:center;padding:2rem 1rem 1rem}
.ytm-hero h1{font-size:1.9rem;font-weight:800;letter-spacing:-.03em;color:#111;margin:0 0 .35rem}
.ytm-hero p{color:#64748b;font-size:1rem;margin:0}
.ytm-hero nav{font-size:.82rem;color:#94a3b8;margin-bottom:.75rem}

.calc-center{max-width:620px;margin:0 auto;padding:0 1rem 2rem}
.content-wrap{max-width:900px;margin:0 auto;padding:0 1rem 3.5rem}

.card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.content-card{background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:1.5rem;margin-bottom:1rem;box-shadow:0 1px 4px rgba(0,0,0,.04)}
.content-card h2{font-size:1.05rem;font-weight:700;color:#111;margin:0 0 .8rem}
.content-card p{color:#444;line-height:1.75;font-size:.93rem;margin:0 0 .7rem}
.content-card p:last-child{margin-bottom:0}

.mode-wrap{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin-bottom:1.25rem}
.mode-btn{padding:.55rem;font-size:.85rem;font-weight:600;border:1.5px solid #e2e8f0;border-radius:8px;background:#f8fafc;color:#64748b;cursor:pointer;transition:all .15s;text-align:center}
.mode-btn.active{background:var(--blue);color:#fff;border-color:var(--blue)}

.input-group{margin-bottom:1rem}
.input-group label{display:block;font-size:.82rem;font-weight:600;color:#374151;margin-bottom:.4rem}
.input-group input{width:100%;padding:.65rem .9rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:1rem;font-family:inherit;color:#111;transition:border-color .15s;box-sizing:border-box}
.input-group input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.1)}

.calc-btn{width:100%;padding:.8rem;background:var(--blue);color:#fff;border:none;border-radius:8px;font-size:1rem;font-weight:700;cursor:pointer;transition:background .15s;margin-bottom:1rem}
.calc-btn:hover{background:#1d4ed8}

.answer-hero{background:linear-gradient(135deg,#1d4ed8 0%,#2563eb 60%,#3b82f6 100%);border-radius:14px;padding:1.75rem 1.5rem 1.25rem;text-align:center;margin-bottom:1rem;box-shadow:0 6px 24px rgba(37,99,235,.22);display:none}
.answer-hero.show{display:block}
.a-label{font-size:.68rem;color:rgba(255,255,255,.65);text-transform:uppercase;letter-spacing:.1em;margin-bottom:.4rem;font-weight:700}
.a-value{font-size:2.8rem;font-weight:900;color:#fff;line-height:1;letter-spacing:-.02em}
.a-unit{font-size:1rem;font-weight:600;color:rgba(255,255,255,.8);margin-top:.3rem}
.a-sub{font-size:.85rem;color:rgba(255,255,255,.7);margin-top:.4rem}

.stats-row{display:none;grid-template-columns:1fr 1fr;gap:.55rem}
.stats-row.show{display:grid}
.stat-box{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.85rem .75rem;text-align:center}
.stat-lbl{display:block;font-size:.62rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.25rem;font-weight:700}
.stat-val{display:block;font-size:.95rem;font-weight:800;color:#1e293b}

.formula-box{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:.85rem 1rem;text-align:center;font-family:monospace;font-weight:800;color:#1e293b;font-size:.95rem;margin:.6rem 0 1rem}

.ref-tbl{width:100%;border-collapse:collapse;font-size:.875rem}
.ref-tbl th{background:#f8fafc;padding:.6rem .85rem;text-align:left;font-size:.68rem;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.05em;border-bottom:2px solid #e2e8f0}
.ref-tbl td{padding:.65rem .85rem;border-bottom:1px solid #f3f4f6;color:#374151}
.ref-tbl tr:last-child td{border-bottom:none}
.ref-tbl tbody tr:hover td{background:#f8faff}
.ref-tbl a{color:var(--blue);text-decoration:none;font-weight:600}
.ref-tbl a:hover{text-decoration:underline}

.faq-item{border-bottom:1px solid #f3f4f6;padding:.9rem 0}
.faq-item:last-child{border-bottom:none;padding-bottom:0}
.faq-item h3{font-size:.9rem;color:#111;margin:0 0 .35rem;font-weight:700}
.faq-item p{color:#555;font-size:.865rem;margin:0;line-height:1.65}

.next-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.75rem}
.next-card{background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:1rem;border-top:3px solid var(--blue);text-decoration:none;display:block}
.next-card:hover{box-shadow:0 4px 12px rgba(0,0,0,.08);text-decoration:none}
.next-tag{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--blue);margin-bottom:.3rem;display:block}
.next-card h3{font-size:.88rem;font-weight:700;color:#111;margin:0 0 .25rem}
.next-card p{font-size:.78rem;color:#64748b;margin:0;line-height:1.5}

@media(max-width:768px){
  .a-value{font-size:2.1rem}
  .next-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){.next-grid{grid-template-columns:1fr}}
</style>

<div class="ytm-hero">
  <nav>
    <a href="/" style="color:var(--blue);text-decoration:none">Home</a> › Yards to Meters
  </nav>
  <h1>Yards to Meters Calculator</h1>
  <p>Convert yards to meters — or meters to yards. Instant results with cm, feet, and inches.</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-yd">Yards → Meters</button>
      <button class="mode-btn" id="btn-m">Meters → Yards</button>
    </div>

    <div id="grp-yd" class="input-group">
      <label for="inp-yd">Yards (yd)</label>
      <input type="number" id="inp-yd" placeholder="e.g. 100" min="0" step="any" />
    </div>
    <div id="grp-m" class="input-group" style="display:none">
      <label for="inp-m">Meters (m)</label>
      <input type="number" id="inp-m" placeholder="e.g. 91.44" min="0" step="any" />
    </div>

    <button class="calc-btn" id="calc-btn">Convert</button>

    <div class="answer-hero" id="answer">
      <div class="a-label" id="ans-label">yards =</div>
      <div class="a-value" id="ans-value">—</div>
      <div class="a-unit" id="ans-unit">meters</div>
      <div class="a-sub" id="ans-sub"></div>
    </div>

    <div class="stats-row" id="stats">
      <div class="stat-box">
        <span class="stat-lbl" id="s1-lbl">Centimeters</span>
        <span class="stat-val" id="s1-val">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl" id="s2-lbl">Feet</span>
        <span class="stat-val" id="s2-val">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl" id="s3-lbl">Inches</span>
        <span class="stat-val" id="s3-val">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl" id="s4-lbl">Millimeters</span>
        <span class="stat-val" id="s4-val">—</span>
      </div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="content-card">
    <h2>Yards to Meters Formula</h2>
    <p><strong>Yards → Meters:</strong> multiply yards by <strong>0.9144</strong></p>
    <div class="formula-box">meters = yards × 0.9144</div>
    <p><strong>Meters → Yards:</strong> multiply meters by <strong>1.09361</strong></p>
    <div class="formula-box">yards = meters × 1.09361</div>
    <p>The yard has been defined as exactly 0.9144 meters since the International Yard and Pound Agreement of 1959. One yard = 3 feet = 36 inches = 91.44 cm.</p>
  </div>

  <div class="content-card">
    <h2>Yards to Meters — Quick Reference Table</h2>
    <div style="overflow-x:auto">
      <table class="ref-tbl">
        <thead>
          <tr><th>Yards</th><th>Meters</th><th>Feet</th><th>Centimeters</th></tr>
        </thead>
        <tbody>
          <tr><td><a href="/1-yards-to-meters">1 yd</a></td><td>0.91 m</td><td>3 ft</td><td>91.44 cm</td></tr>
          <tr><td><a href="/2-yards-to-meters">2 yd</a></td><td>1.83 m</td><td>6 ft</td><td>182.88 cm</td></tr>
          <tr><td><a href="/3-yards-to-meters">3 yd</a></td><td>2.74 m</td><td>9 ft</td><td>274.32 cm</td></tr>
          <tr><td><a href="/5-yards-to-meters">5 yd</a></td><td>4.57 m</td><td>15 ft</td><td>457.2 cm</td></tr>
          <tr><td><a href="/10-yards-to-meters">10 yd</a></td><td>9.14 m</td><td>30 ft</td><td>914.4 cm</td></tr>
          <tr><td><a href="/25-yards-to-meters">25 yd</a></td><td>22.86 m</td><td>75 ft</td><td>2286 cm</td></tr>
          <tr><td><a href="/50-yards-to-meters">50 yd</a></td><td>45.72 m</td><td>150 ft</td><td>4572 cm</td></tr>
          <tr><td><a href="/100-yards-to-meters">100 yd</a></td><td>91.44 m</td><td>300 ft</td><td>9144 cm</td></tr>
          <tr><td><a href="/200-yards-to-meters">200 yd</a></td><td>182.88 m</td><td>600 ft</td><td>18288 cm</td></tr>
          <tr><td><a href="/300-yards-to-meters">300 yd</a></td><td>274.32 m</td><td>900 ft</td><td>27432 cm</td></tr>
          <tr><td><a href="/500-yards-to-meters">500 yd</a></td><td>457.2 m</td><td>1500 ft</td><td>45720 cm</td></tr>
          <tr><td><a href="/1000-yards-to-meters">1000 yd</a></td><td>914.4 m</td><td>3000 ft</td><td>91440 cm</td></tr>
        </tbody>
      </table>
    </div>
    <p style="margin-top:.75rem;font-size:.82rem;color:#64748b">→ <a href="/yards-pages">Browse all 109 yards to meters pages</a></p>
  </div>

  <div class="content-card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many meters is 1 yard?</h3>
      <p>1 yard = <strong>0.9144 meters</strong> exactly. This international definition has been in place since 1959.</p>
    </div>
    <div class="faq-item">
      <h3>How many meters is 100 yards?</h3>
      <p>100 yards = <strong>91.44 meters</strong>. This is the length of an American football field from end zone to end zone.</p>
    </div>
    <div class="faq-item">
      <h3>Is a yard bigger than a meter?</h3>
      <p>No. A yard (0.9144 m) is slightly <strong>shorter</strong> than a meter. A meter is about 9.36% longer than a yard. 1 meter = 1.09361 yards.</p>
    </div>
    <div class="faq-item">
      <h3>How many yards in a kilometer?</h3>
      <p>1 kilometer = <strong>1,093.61 yards</strong>. Multiply km by 1093.61 to get yards, or divide yards by 1093.61 to get km.</p>
    </div>
  </div>

  <div class="content-card">
    <h2>Related Converters</h2>
    <div class="next-grid">
      <a href="/meters-to-feet" class="next-card">
        <span class="next-tag">Length</span>
        <h3>Meters to Feet</h3>
        <p>Convert meters to feet and inches</p>
      </a>
      <a href="/cm-to-inches" class="next-card">
        <span class="next-tag">Length</span>
        <h3>cm to Inches</h3>
        <p>Convert centimeters to inches</p>
      </a>
      <a href="/km-to-miles" class="next-card">
        <span class="next-tag">Length</span>
        <h3>km to Miles</h3>
        <p>Convert kilometers to miles</p>
      </a>
      <a href="/kg-to-lbs" class="next-card">
        <span class="next-tag">Weight</span>
        <h3>kg to lbs</h3>
        <p>Kilograms to pounds converter</p>
      </a>
      <a href="/celsius-to-fahrenheit" class="next-card">
        <span class="next-tag">Temp</span>
        <h3>Celsius to Fahrenheit</h3>
        <p>Temperature converter</p>
      </a>
      <a href="/percentage-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Percentage Calculator</h3>
        <p>Calculate percentages instantly</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
  var mode = 'yd';

  document.getElementById('btn-yd').addEventListener('click', function() { setMode('yd'); });
  document.getElementById('btn-m').addEventListener('click', function() { setMode('m'); });
  document.getElementById('calc-btn').addEventListener('click', calculate);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') calculate(); });

  /* pre-fill 100 yards on load */
  document.getElementById('inp-yd').value = 100;
  calculate();

  function setMode(m) {
    mode = m;
    document.getElementById('btn-yd').classList.toggle('active', m === 'yd');
    document.getElementById('btn-m').classList.toggle('active', m === 'm');
    document.getElementById('grp-yd').style.display = m === 'yd' ? '' : 'none';
    document.getElementById('grp-m').style.display = m === 'm' ? '' : 'none';
    document.getElementById('answer').classList.remove('show');
    document.getElementById('stats').classList.remove('show');
  }

  function calculate() {
    if (mode === 'yd') {
      var yd = parseFloat(document.getElementById('inp-yd').value);
      if (isNaN(yd) || yd < 0) return;
      var m = Math.round(yd * 0.9144 * 10000) / 10000;
      var cm = Math.round(yd * 91.44 * 100) / 100;
      var ft = yd * 3;
      var inch = yd * 36;
      var mm = Math.round(yd * 914.4);
      document.getElementById('ans-label').textContent = yd + ' yards =';
      document.getElementById('ans-value').textContent = m;
      document.getElementById('ans-unit').textContent = 'meters (m)';
      document.getElementById('ans-sub').textContent = yd + ' yd × 0.9144 = ' + m + ' m';
      document.getElementById('s1-lbl').textContent = 'Centimeters';
      document.getElementById('s1-val').textContent = cm + ' cm';
      document.getElementById('s2-lbl').textContent = 'Feet';
      document.getElementById('s2-val').textContent = ft + ' ft';
      document.getElementById('s3-lbl').textContent = 'Inches';
      document.getElementById('s3-val').textContent = inch + ' in';
      document.getElementById('s4-lbl').textContent = 'Millimeters';
      document.getElementById('s4-val').textContent = mm + ' mm';
    } else {
      var m2 = parseFloat(document.getElementById('inp-m').value);
      if (isNaN(m2) || m2 < 0) return;
      var yd2 = Math.round(m2 * 1.09361 * 10000) / 10000;
      var ft2 = Math.round(m2 * 3.28084 * 100) / 100;
      var inch2 = Math.round(m2 * 39.3701 * 10) / 10;
      var cm2 = Math.round(m2 * 100 * 100) / 100;
      document.getElementById('ans-label').textContent = m2 + ' meters =';
      document.getElementById('ans-value').textContent = yd2;
      document.getElementById('ans-unit').textContent = 'yards (yd)';
      document.getElementById('ans-sub').textContent = m2 + ' m × 1.09361 = ' + yd2 + ' yd';
      document.getElementById('s1-lbl').textContent = 'Centimeters';
      document.getElementById('s1-val').textContent = cm2 + ' cm';
      document.getElementById('s2-lbl').textContent = 'Feet';
      document.getElementById('s2-val').textContent = ft2 + ' ft';
      document.getElementById('s3-lbl').textContent = 'Inches';
      document.getElementById('s3-val').textContent = inch2 + ' in';
      document.getElementById('s4-lbl').textContent = 'Kilometers';
      document.getElementById('s4-val').textContent = (Math.round(m2 / 1000 * 10000) / 10000) + ' km';
    }
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }
</script>
</Layout>
