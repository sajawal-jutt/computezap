---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": "Terms & Conditions — ComputeZap",
    "url": "https://computezap.com/terms",
    "description": "ComputeZap Terms & Conditions — the rules and limitations that govern your use of our free online calculators and converters."
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com/" },
      { "@type": "ListItem", "position": 2, "name": "Terms & Conditions", "item": "https://computezap.com/terms" }
    ]
  }
]);
---
<Layout
  title="Terms & Conditions — ComputeZap"
  description="ComputeZap Terms & Conditions — understand the rules governing your use of our free calculators, converters, and tools."
  canonical="/terms"
  schema={schema}
>
  <div class="page-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> › <span>Terms & Conditions</span>
    </nav>
    <h1>Terms &amp; Conditions</h1>
    <p class="hero-sub">Last updated: July 1, 2026</p>
  </div>

  <div class="content-wrap">

    <div class="content-card">
      <h2>Agreement to Terms</h2>
      <p>By accessing or using ComputeZap (<a href="https://computezap.com">computezap.com</a>), you agree to be bound by these Terms & Conditions. If you do not agree with any part of these terms, please do not use our website.</p>
    </div>

    <div class="content-card">
      <h2>Use of Tools — Informational Purposes Only</h2>
      <p>All calculators, converters, and tools on ComputeZap are provided for <strong>general informational and educational purposes only</strong>. Results produced by our tools:</p>
      <ul>
        <li>Are <strong>estimates only</strong> — not guaranteed to be accurate for every situation</li>
        <li>Do <strong>not constitute financial, legal, tax, medical, or professional advice</strong> of any kind</li>
        <li>Should <strong>not be relied upon as the sole basis for any financial, health, or legal decision</strong></li>
        <li>May not account for your specific circumstances, jurisdiction, or individual variables</li>
      </ul>
      <p>For any important decision — especially involving finance, health, taxes, or legal matters — always consult a qualified professional.</p>
    </div>

    <div class="content-card">
      <h2>No Warranties</h2>
      <p>ComputeZap is provided on an <strong>"as is" and "as available" basis</strong> without any warranties of any kind, either express or implied. We do not warrant that:</p>
      <ul>
        <li>The tools will be error-free or produce perfectly accurate results in all cases</li>
        <li>The website will be uninterrupted or free from technical issues</li>
        <li>Any errors or bugs will be corrected immediately</li>
      </ul>
      <p>We make reasonable efforts to maintain accuracy and correct errors when reported, but we cannot guarantee perfection.</p>
    </div>

    <div class="content-card">
      <h2>Limitation of Liability</h2>
      <p>To the fullest extent permitted by law, ComputeZap and its owner (Hafiz Muhammad Sajawal) shall not be liable for any direct, indirect, incidental, special, or consequential damages arising from your use of — or reliance on — any calculator, tool, or information on this website.</p>
      <p>This includes, but is not limited to, financial losses, errors in calculation, or decisions made based on results from our tools.</p>
    </div>

    <div class="content-card">
      <h2>Intellectual Property</h2>
      <p>All content on ComputeZap — including but not limited to text, code, formulas, designs, and tool implementations — is owned by ComputeZap and protected by applicable intellectual property laws.</p>
      <p>You may not copy, reproduce, distribute, or create derivative works from our content without explicit written permission.</p>
    </div>

    <div class="content-card">
      <h2>Acceptable Use</h2>
      <p>You agree not to use ComputeZap to:</p>
      <ul>
        <li>Scrape, copy, or systematically extract content or tool code for commercial use</li>
        <li>Attempt to disrupt or interfere with the website's operation</li>
        <li>Use our tools for any unlawful purpose</li>
        <li>Misrepresent results from our calculators as professionally verified advice</li>
      </ul>
    </div>

    <div class="content-card">
      <h2>Third-Party Links</h2>
      <p>ComputeZap may contain links to external websites. These links are provided for reference only. We are not responsible for the content, accuracy, or practices of any third-party website. Visiting external links is at your own risk.</p>
    </div>

    <div class="content-card">
      <h2>Changes to Terms</h2>
      <p>We reserve the right to update these Terms & Conditions at any time. Changes will be reflected by the updated date at the top of this page. Continued use of ComputeZap after any updates constitutes acceptance of the revised terms.</p>
    </div>

    <div class="content-card">
      <h2>Governing Law</h2>
      <p>These Terms & Conditions shall be governed by the applicable laws of Pakistan, without regard to conflict of law principles. Any disputes arising from the use of ComputeZap shall be resolved under those laws.</p>
    </div>

    <div class="content-card">
      <h2>Contact</h2>
      <p>Questions about these Terms? Contact us:</p>
      <p><strong>Email:</strong> <a href="mailto:support@computezap.com">support@computezap.com</a></p>
    </div>

  </div>
</Layout>
