---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Compound Interest Calculator",
    "url": "https://computezap.com/compound-interest-calculator",
    "applicationCategory": "FinanceApplication",
    "operatingSystem": "Web",
    "description": "Calculate compound interest with monthly contributions. See how your money grows year by year — includes Rule of 72 and year-by-year growth table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Finance", "item": "https://computezap.com/finance" },
      { "@type": "ListItem", "position": 3, "name": "Compound Interest Calculator", "item": "https://computezap.com/compound-interest-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is compound interest?",
        "acceptedAnswer": { "@type": "Answer", "text": "Compound interest is interest calculated on both the initial principal and accumulated interest from previous periods. Unlike simple interest, compounding causes money to grow exponentially over time." }
      },
      {
        "@type": "Question",
        "name": "What is the Rule of 72?",
        "acceptedAnswer": { "@type": "Answer", "text": "Divide 72 by your annual interest rate to estimate how many years it takes to double your money. At 7%, money doubles every 10.3 years (72 ÷ 7). It's a quick mental math shortcut that's surprisingly accurate." }
      },
      {
        "@type": "Question",
        "name": "How does compounding frequency affect growth?",
        "acceptedAnswer": { "@type": "Answer", "text": "More frequent compounding means slightly higher returns. Daily compounding earns slightly more than monthly, which earns more than annually. However, the rate matters far more than the frequency." }
      },
      {
        "@type": "Question",
        "name": "What is a realistic interest rate to use?",
        "acceptedAnswer": { "@type": "Answer", "text": "High-yield savings accounts offer 4–5%, the S&P 500 averages ~10% historically, CDs typically offer 4–5%. For long-term projections, 7% is commonly used as it accounts for inflation." }
      }
    ]
  }
]);
---
<Layout
  title="Compound Interest Calculator — Year-by-Year Growth | ComputeZap"
  description="Calculate compound interest with monthly contributions. See how your money grows year by year — includes Rule of 72 and growth table. Free compound interest calculator."
  canonical="/compound-interest-calculator"
  schema={schema}
>

<style>
  .ci-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  @media (max-width: 500px) { .ci-grid { grid-template-columns: 1fr; } }
  .freq-lbl { font-size: .82rem; font-weight: 600; color: #374151; margin-bottom: .4rem; display: block; }
  .freq-row { display: flex; gap: .4rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .freq-btn { padding: 6px 14px; border: 1.5px solid #e2e8f0; border-radius: 8px; background: #fff; color: #64748b; font-size: .82rem; cursor: pointer; font-family: inherit; transition: all .15s; }
  .freq-btn.active { background: var(--blue); color: #fff; border-color: var(--blue); }
  .freq-btn:hover:not(.active) { border-color: var(--blue); }
  .growth-tbl { width: 100%; border-collapse: collapse; font-size: .85rem; }
  .growth-tbl th, .growth-tbl td { padding: 8px 12px; text-align: right; border-bottom: 1px solid #e2e8f0; }
  .growth-tbl th { background: var(--gray-100); font-weight: 600; }
  .growth-tbl td:first-child, .growth-tbl th:first-child { text-align: left; }
  .growth-tbl tr:hover td { background: var(--gray-50); }
  .growth-tbl .ms-row td { background: #eff6ff; font-weight: 600; }
</style>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/#finance">Finance</a> › Compound Interest Calculator</nav>
  <h1>Compound Interest Calculator</h1>
  <p>See how your money grows over time with the power of compounding</p>
</div>

<div class="calc-center">

  <!-- Inputs -->
  <div class="card">
    <div class="ci-grid">
      <div class="input-group">
        <label>Starting Amount ($)</label>
        <div class="input-wrap">
          <input type="number" id="principal" min="0" step="100" value="10000" placeholder="10000" oninput="calcCI()" />
          <span class="input-sfx">$</span>
        </div>
      </div>
      <div class="input-group">
        <label>Annual Interest Rate (%)</label>
        <div class="input-wrap">
          <input type="number" id="rate" min="0" max="100" step="0.1" value="7" placeholder="7" oninput="calcCI()" />
          <span class="input-sfx">%</span>
        </div>
      </div>
      <div class="input-group">
        <label>Time Period (Years)</label>
        <div class="input-wrap">
          <input type="number" id="years" min="1" max="100" step="1" value="30" placeholder="30" oninput="calcCI()" />
          <span class="input-sfx">yrs</span>
        </div>
      </div>
      <div class="input-group">
        <label>Monthly Contribution ($)</label>
        <div class="input-wrap">
          <input type="number" id="monthly" min="0" step="50" value="500" placeholder="0" oninput="calcCI()" />
          <span class="input-sfx">$/mo</span>
        </div>
      </div>
    </div>
    <span class="freq-lbl">Compound Frequency</span>
    <div class="freq-row">
      <button class="freq-btn" onclick="setFreq(this,'daily')">Daily</button>
      <button class="freq-btn active" onclick="setFreq(this,'monthly')">Monthly</button>
      <button class="freq-btn" onclick="setFreq(this,'quarterly')">Quarterly</button>
      <button class="freq-btn" onclick="setFreq(this,'semiannual')">Semi-Annually</button>
      <button class="freq-btn" onclick="setFreq(this,'annual')">Annually</button>
    </div>
    <button class="calc-btn" onclick="calcCI()">Calculate</button>
  </div>

  <!-- Result -->
  <div class="card" id="result-card" style="display:none">
    <div class="answer-hero show">
      <div class="a-label">Final Balance</div>
      <div class="a-value" id="res-final">—</div>
      <div class="a-sub" id="res-sub">—</div>
    </div>
    <div class="stats-row show">
      <div class="stat-box">
        <span class="stat-lbl">Starting Amount</span>
        <span class="stat-val" id="s-principal">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Total Contributions</span>
        <span class="stat-val" id="s-contrib">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Interest Earned</span>
        <span class="stat-val" id="s-interest">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Interest % of Total</span>
        <span class="stat-val" id="s-pct">—</span>
      </div>
    </div>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">Starting amount</span><span class="answer-val" id="b-principal">—</span></div>
      <div class="answer-row"><span class="answer-lbl">Monthly contribution</span><span class="answer-val" id="b-monthly">—</span></div>
      <div class="answer-row"><span class="answer-lbl">Total contributions</span><span class="answer-val" id="b-contrib">—</span></div>
      <div class="answer-row"><span class="answer-lbl">Interest earned</span><span class="answer-val" id="b-interest">—</span></div>
      <div class="answer-row"><span class="answer-lbl">Final balance</span><span class="answer-val" id="b-final">—</span></div>
    </div>
    <div class="tip-box" id="tip-box" style="display:none">
      <span class="tip-icon" id="tip-icon">💡</span>
      <p id="tip-text">—</p>
    </div>
  </div>

  <!-- Presets -->
  <div class="card">
    <span class="preset-lbl">Quick scenarios</span>
    <div class="preset-wrap">
      <a href="#" onclick="setPreset(10000,7,30,500,'monthly');return false" class="preset-btn">S&P 500 Avg</a>
      <a href="#" onclick="setPreset(5000,4.75,5,200,'monthly');return false" class="preset-btn">HYSA 5yr</a>
      <a href="#" onclick="setPreset(1000,10,20,0,'annual');return false" class="preset-btn">$1K @ 10%</a>
      <a href="#" onclick="setPreset(50000,6,25,1000,'monthly');return false" class="preset-btn">Retirement</a>
    </div>
  </div>

  <!-- Growth table -->
  <div class="card" id="growth-card" style="display:none">
    <h3 style="margin-bottom:1rem">Year-by-Year Growth</h3>
    <div style="overflow-x:auto">
      <table class="growth-tbl">
        <thead>
          <tr><th>Year</th><th>Balance</th><th>Interest Earned</th><th>Total Contributed</th></tr>
        </thead>
        <tbody id="growth-body"></tbody>
      </table>
    </div>
  </div>

</div>

<div class="content-wrap">

  <div class="card">
    <h2>What Is Compound Interest?</h2>
    <p>Compound interest is interest calculated on both your initial principal <em>and</em> the accumulated interest from previous periods. Every period, your balance grows — and the next period's interest is calculated on that larger balance.</p>
    <p>This creates exponential growth over time. The longer the period and the higher the rate, the more dramatic the effect. Even small monthly contributions can build into life-changing wealth over decades.</p>
  </div>

  <div class="card">
    <h2>Rule of 72 — Doubling Time</h2>
    <p>Divide <strong>72</strong> by the annual interest rate to estimate how long it takes to double your money.</p>
    <div style="overflow-x:auto;margin-top:.75rem">
      <table class="conv-table">
        <thead><tr><th>Annual Rate</th><th>Rule of 72 Estimate</th><th>Actual Years</th></tr></thead>
        <tbody>
          <tr><td>3%</td><td>24.0 years</td><td>23.4 years</td></tr>
          <tr><td>4%</td><td>18.0 years</td><td>17.7 years</td></tr>
          <tr><td>5%</td><td>14.4 years</td><td>14.2 years</td></tr>
          <tr class="hl"><td>6%</td><td>12.0 years</td><td>11.9 years</td></tr>
          <tr class="hl"><td>7%</td><td>10.3 years</td><td>10.2 years</td></tr>
          <tr><td>8%</td><td>9.0 years</td><td>9.0 years</td></tr>
          <tr><td>10%</td><td>7.2 years</td><td>7.3 years</td></tr>
          <tr><td>12%</td><td>6.0 years</td><td>6.1 years</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Compounding Frequency Comparison</h2>
    <p>How much does frequency matter? $10,000 at 10% for 10 years:</p>
    <div style="overflow-x:auto;margin-top:.75rem">
      <table class="conv-table">
        <thead><tr><th>Frequency</th><th>Final Amount</th><th>Interest Earned</th><th>Effective Annual Rate</th></tr></thead>
        <tbody>
          <tr><td>Annually</td><td>$25,937</td><td>$15,937</td><td>10.000%</td></tr>
          <tr><td>Semi-Annually</td><td>$26,533</td><td>$16,533</td><td>10.250%</td></tr>
          <tr><td>Quarterly</td><td>$26,851</td><td>$16,851</td><td>10.381%</td></tr>
          <tr class="hl"><td>Monthly</td><td>$27,070</td><td>$17,070</td><td>10.471%</td></tr>
          <tr><td>Daily</td><td>$27,183</td><td>$17,183</td><td>10.516%</td></tr>
        </tbody>
      </table>
    </div>
    <p style="margin-top:.75rem;font-size:.85rem;color:#64748b">The difference between monthly and daily is minimal. Rate and time matter far more than frequency.</p>
  </div>

  <div class="card">
    <h2>Realistic Interest Rate Reference</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Investment Type</th><th>Typical Rate</th><th>Risk Level</th></tr></thead>
        <tbody>
          <tr><td>High-Yield Savings (HYSA)</td><td>4.0 – 5.0%</td><td>Very Low</td></tr>
          <tr><td>Certificates of Deposit (CD)</td><td>4.5 – 5.5%</td><td>Very Low</td></tr>
          <tr><td>Treasury Bonds (T-Bills)</td><td>4.0 – 5.5%</td><td>Low</td></tr>
          <tr><td>Corporate Bonds</td><td>4.5 – 7.0%</td><td>Low – Medium</td></tr>
          <tr class="hl"><td>S&P 500 (historical avg)</td><td>~10% nominal / ~7% real</td><td>Medium</td></tr>
          <tr><td>Total Stock Market Index</td><td>~9 – 10%</td><td>Medium</td></tr>
          <tr><td>Real Estate (REITs)</td><td>7 – 12%</td><td>Medium – High</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is the compound interest formula?</h3>
      <p>The formula is <strong>A = P(1 + r/n)^(nt)</strong> where P = principal, r = annual rate (decimal), n = compounds per year, t = time in years. With regular contributions, a month-by-month loop is used for accuracy.</p>
    </div>
    <div class="faq-item">
      <h3>What is the difference between simple and compound interest?</h3>
      <p>Simple interest is calculated only on the principal: <strong>A = P × (1 + rt)</strong>. Compound interest earns interest on previous interest. Over long periods the difference is huge — $10,000 at 7% for 30 years: simple = $31,000 vs compound = $76,123.</p>
    </div>
    <div class="faq-item">
      <h3>Does compound interest work against me on debt?</h3>
      <p>Yes. Credit cards (20–30% APR) and high-interest loans compound against you. A $5,000 credit card balance at 25% APR costs $1,374 in interest in just one year. Paying off high-interest debt is often the best "investment" you can make.</p>
    </div>
    <div class="faq-item">
      <h3>How often does the S&P 500 compound?</h3>
      <p>Stock market returns compound continuously as prices change daily. For calculator purposes, monthly or annual compounding gives a very accurate projection. The S&P 500 has averaged ~10% annually over the last century (about 7% after inflation).</p>
    </div>
    <div class="faq-item">
      <h3>Why does starting early matter so much?</h3>
      <p>At 7%, money doubles every 10.3 years. Starting at 25 gives you 3 more doublings than starting at 35. $10,000 invested at 25 becomes ~$200,000 by 65. The same $10,000 at 35 only becomes ~$100,000. Those 10 years cost you $100,000.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Finance Calculators</h2>
    <div class="next-grid">
      <a href="/savings-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Savings Calculator</h3>
        <p>Calculate balance, time to reach a goal, or monthly savings needed</p>
      </a>
      <a href="/roth-ira-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Roth IRA Calculator</h3>
        <p>Calculate your tax-free Roth IRA balance at retirement with milestones</p>
      </a>
      <a href="/401k-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>401K Calculator</h3>
        <p>Estimate 401k balance including employer match and salary growth</p>
      </a>
      <a href="/cd-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>CD Calculator</h3>
        <p>Calculate Certificate of Deposit earnings with compound interest</p>
      </a>
      <a href="/apr-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>APR Calculator</h3>
        <p>Find the true annual cost of any loan including origination fees</p>
      </a>
      <a href="/amortization-calculator" class="next-card">
        <span class="next-tag">Finance</span>
        <h3>Amortization Calculator</h3>
        <p>Full loan payment schedule — extra payment savings and payoff date</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
  var currentFreq = 'monthly';

  function setFreq(btn, f) {
    currentFreq = f;
    document.querySelectorAll('.freq-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');
    calcCI();
  }

  function setPreset(p, r, y, m, f) {
    document.getElementById('principal').value = p;
    document.getElementById('rate').value = r;
    document.getElementById('years').value = y;
    document.getElementById('monthly').value = m;
    currentFreq = f;
    var labels = { daily: 'Daily', monthly: 'Monthly', quarterly: 'Quarterly', semiannual: 'Semi-Annually', annual: 'Annually' };
    document.querySelectorAll('.freq-btn').forEach(function(b) {
      b.classList.remove('active');
      if (b.textContent.trim() === labels[f]) b.classList.add('active');
    });
    calcCI();
  }

  function fmt(n) { return '$' + Math.round(n).toLocaleString(); }
  function fmtS(n) {
    if (n >= 1000000) return '$' + (n / 1000000).toFixed(2) + 'M';
    if (n >= 10000)   return '$' + (n / 1000).toFixed(1) + 'K';
    return '$' + Math.round(n).toLocaleString();
  }

  function getEMR(rate, freq) {
    var r = rate / 100;
    if (freq === 'daily')      return Math.pow(1 + r / 365, 365 / 12) - 1;
    if (freq === 'monthly')    return r / 12;
    if (freq === 'quarterly')  return Math.pow(1 + r / 4, 1 / 3) - 1;
    if (freq === 'semiannual') return Math.pow(1 + r / 2, 1 / 6) - 1;
    if (freq === 'annual')     return Math.pow(1 + r, 1 / 12) - 1;
    return r / 12;
  }

  function calcCI() {
    var p   = parseFloat(document.getElementById('principal').value) || 0;
    var r   = parseFloat(document.getElementById('rate').value)      || 0;
    var y   = parseInt(document.getElementById('years').value)       || 0;
    var mo  = parseFloat(document.getElementById('monthly').value)   || 0;
    if (p < 0 || r < 0 || y < 1 || y > 100) return;

    var emr = getEMR(r, currentFreq);
    var bal = p, totalInt = 0, totalC = p;
    var rows = [];

    for (var m = 0; m < y * 12; m++) {
      var i = bal * emr;
      totalInt += i; bal += i + mo; totalC += mo;
      if ((m + 1) % 12 === 0) rows.push({ year: (m + 1) / 12, bal: bal, int: totalInt, contrib: totalC });
    }

    var pct = bal > 0 ? (totalInt / bal * 100) : 0;
    var dbl = r > 0 ? (Math.log(2) / Math.log(1 + r / 100)).toFixed(1) : '∞';
    var freqL = { daily: 'daily', monthly: 'monthly', quarterly: 'quarterly', semiannual: 'semi-annually', annual: 'annually' };

    document.getElementById('res-final').textContent  = fmt(bal);
    document.getElementById('res-sub').textContent    = 'After ' + y + ' year' + (y !== 1 ? 's' : '') + ' at ' + r + '% compounded ' + (freqL[currentFreq] || 'monthly');
    document.getElementById('s-principal').textContent = fmt(p);
    document.getElementById('s-contrib').textContent   = fmt(totalC);
    document.getElementById('s-interest').textContent  = fmt(totalInt);
    document.getElementById('s-pct').textContent       = pct.toFixed(1) + '%';
    document.getElementById('b-principal').textContent = fmt(p);
    document.getElementById('b-monthly').textContent   = fmt(mo) + '/mo';
    document.getElementById('b-contrib').textContent   = fmt(totalC);
    document.getElementById('b-interest').textContent  = fmt(totalInt);
    document.getElementById('b-final').textContent     = fmt(bal);

    var tip = document.getElementById('tip-box');
    var tipIcon = document.getElementById('tip-icon');
    var tipText = document.getElementById('tip-text');
    tip.style.display = '';
    if (r === 0) {
      tip.className = 'tip-box tip-orange'; tipIcon.textContent = '⚠️';
      tipText.textContent = 'At 0% your money never grows. Try 7% for a long-term stock market estimate, or 4.75% for a high-yield savings account.';
    } else if (mo >= p * 0.05) {
      tip.className = 'tip-box tip-green'; tipIcon.textContent = '💡';
      tipText.textContent = 'Your $' + mo.toLocaleString() + '/mo contributions add $' + (mo * 12).toLocaleString() + '/yr — a big driver of growth. Rule of 72: at ' + r + '%, money doubles every ' + dbl + ' years.';
    } else {
      tip.className = 'tip-box tip-green'; tipIcon.textContent = '💡';
      tipText.textContent = 'Rule of 72: at ' + r + '%, money doubles every ' + dbl + ' years. Your $' + p.toLocaleString() + ' will double around year ' + Math.ceil(parseFloat(dbl)) + '.';
    }

    var html = '';
    rows.forEach(function(d) {
      var ms = d.year === 1 || d.year % 5 === 0 || d.year === y;
      html += '<tr' + (ms ? ' class="ms-row"' : '') + '>' +
        '<td>Year ' + d.year + '</td>' +
        '<td>' + fmt(d.bal) + '</td>' +
        '<td>' + fmt(d.int) + '</td>' +
        '<td>' + fmt(d.contrib) + '</td></tr>';
    });
    document.getElementById('growth-body').innerHTML = html;
    document.getElementById('growth-card').style.display = '';
    document.getElementById('result-card').style.display = '';
  }

  calcCI();
</script>

</Layout>
