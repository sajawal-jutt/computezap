---
import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Concrete Calculator",
    "url": "https://computezap.com/concrete-calculator",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Calculate how much concrete you need for slabs, footings, columns, and circular pads. Results in cubic yards, cubic feet, and number of bags (60 lb and 80 lb).",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Concrete Calculator", "item": "https://computezap.com/concrete-calculator" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "How do I calculate how much concrete I need?",
        "acceptedAnswer": { "@type": "Answer", "text": "Multiply length × width × thickness (all in feet) to get cubic feet, then divide by 27 to get cubic yards. Example: a 10×10 ft slab at 4 inches thick = 10 × 10 × 0.333 = 33.3 cubic feet ÷ 27 = 1.23 cubic yards. Always add 10% for waste." }
      },
      {
        "@type": "Question",
        "name": "How many bags of concrete do I need?",
        "acceptedAnswer": { "@type": "Answer", "text": "A 60 lb bag yields 0.45 cubic feet. An 80 lb bag yields 0.60 cubic feet. Divide your total cubic feet by the bag yield. For a 10×10 ft slab at 4 inches: 33.3 cu ft ÷ 0.45 = 74 bags of 60 lb, or 33.3 ÷ 0.60 = 56 bags of 80 lb." }
      },
      {
        "@type": "Question",
        "name": "How thick should a concrete slab be?",
        "acceptedAnswer": { "@type": "Answer", "text": "Standard thicknesses: sidewalks and patios = 4 inches; driveways (cars) = 4–6 inches; driveways (heavy trucks) = 6 inches; garage floors = 4–6 inches; footings = consult local building codes (typically 8–12 inches). Always check local requirements." }
      },
      {
        "@type": "Question",
        "name": "How many cubic yards are in a concrete truck?",
        "acceptedAnswer": { "@type": "Answer", "text": "A standard ready-mix concrete truck holds 8–10 cubic yards. For large projects over 1 yard, ordering ready-mix is usually more economical than mixing bags. Small projects under 1 yard are typically done with bags." }
      },
      {
        "@type": "Question",
        "name": "How much does concrete cost per cubic yard?",
        "acceptedAnswer": { "@type": "Answer", "text": "Ready-mix concrete costs $125–$200 per cubic yard (2024 prices) depending on region and mix type. Delivery and finishing labor adds $50–$100+ per yard. Pre-mixed bags cost about $5–$8 each — significantly more per cubic yard but practical for small jobs." }
      },
      {
        "@type": "Question",
        "name": "Why add 10% extra concrete?",
        "acceptedAnswer": { "@type": "Answer", "text": "Always order 10% more concrete than calculated. Reasons: uneven sub-base uses more material, spillage during pour, forms not perfectly level, and you want extra to ensure you don't run short mid-pour. Running out of concrete mid-pour creates cold joints that weaken the slab." }
      }
    ]
  }
]);
---
<Layout
  title="Concrete Calculator — Cubic Yards, Bags &amp; Slabs | ComputeZap"
  description="Calculate how much concrete you need for slabs, footings, columns, and circular pads. Get results in cubic yards, cubic feet, and number of 60lb or 80lb bags."
  canonical="/concrete-calculator"
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › Concrete Calculator</nav>
  <h1>Concrete Calculator</h1>
  <p>Calculate cubic yards, cubic feet, and bags needed for any concrete project</p>
</div>

<div class="calc-center">

  <div class="card">
    <div class="mode-wrap" style="margin-bottom:1.25rem">
      <button class="mode-btn active" id="btn-slab"     onclick="setShape('slab');return false">Slab / Patio</button>
      <button class="mode-btn"        id="btn-footing"  onclick="setShape('footing');return false">Footing / Wall</button>
      <button class="mode-btn"        id="btn-circle"   onclick="setShape('circle');return false">Circular Slab</button>
      <button class="mode-btn"        id="btn-column"   onclick="setShape('column');return false">Column / Tube</button>
    </div>

    <!-- SLAB -->
    <div id="inp-slab">
      <div class="apr-grid">
        <div class="input-group">
          <label>Length (feet)</label>
          <div class="input-wrap">
            <input type="number" id="slab-l" min="0" step="0.5" placeholder="e.g. 10" oninput="calcConcrete()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
        <div class="input-group">
          <label>Width (feet)</label>
          <div class="input-wrap">
            <input type="number" id="slab-w" min="0" step="0.5" placeholder="e.g. 10" oninput="calcConcrete()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
        <div class="input-group">
          <label>Thickness (inches)</label>
          <div class="input-wrap">
            <input type="number" id="slab-t" min="0" step="0.5" placeholder="e.g. 4" oninput="calcConcrete()" value="4" />
            <span class="input-sfx">in</span>
          </div>
        </div>
        <div class="input-group">
          <label>Concrete price ($/yard) <span style="font-weight:400;color:var(--text-2)">(optional)</span></label>
          <div class="input-wrap">
            <input type="number" id="price" min="0" step="5" placeholder="e.g. 150" oninput="calcConcrete()" />
            <span class="input-sfx">$/yd</span>
          </div>
        </div>
      </div>
    </div>

    <!-- FOOTING -->
    <div id="inp-footing" style="display:none">
      <div class="apr-grid">
        <div class="input-group">
          <label>Length (feet)</label>
          <div class="input-wrap">
            <input type="number" id="foot-l" min="0" step="0.5" placeholder="e.g. 20" oninput="calcConcrete()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
        <div class="input-group">
          <label>Width (inches)</label>
          <div class="input-wrap">
            <input type="number" id="foot-w" min="0" step="0.5" placeholder="e.g. 12" oninput="calcConcrete()" />
            <span class="input-sfx">in</span>
          </div>
        </div>
        <div class="input-group">
          <label>Depth (inches)</label>
          <div class="input-wrap">
            <input type="number" id="foot-d" min="0" step="0.5" placeholder="e.g. 8" oninput="calcConcrete()" />
            <span class="input-sfx">in</span>
          </div>
        </div>
        <div class="input-group">
          <label>Concrete price ($/yard) <span style="font-weight:400;color:var(--text-2)">(optional)</span></label>
          <div class="input-wrap">
            <input type="number" id="price-foot" min="0" step="5" placeholder="e.g. 150" oninput="calcConcrete()" />
            <span class="input-sfx">$/yd</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CIRCLE -->
    <div id="inp-circle" style="display:none">
      <div class="apr-grid">
        <div class="input-group">
          <label>Diameter (feet)</label>
          <div class="input-wrap">
            <input type="number" id="circ-d" min="0" step="0.5" placeholder="e.g. 10" oninput="calcConcrete()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
        <div class="input-group">
          <label>Thickness (inches)</label>
          <div class="input-wrap">
            <input type="number" id="circ-t" min="0" step="0.5" placeholder="e.g. 4" oninput="calcConcrete()" value="4" />
            <span class="input-sfx">in</span>
          </div>
        </div>
        <div class="input-group">
          <label>Concrete price ($/yard) <span style="font-weight:400;color:var(--text-2)">(optional)</span></label>
          <div class="input-wrap">
            <input type="number" id="price-circ" min="0" step="5" placeholder="e.g. 150" oninput="calcConcrete()" />
            <span class="input-sfx">$/yd</span>
          </div>
        </div>
      </div>
    </div>

    <!-- COLUMN -->
    <div id="inp-column" style="display:none">
      <div class="apr-grid">
        <div class="input-group">
          <label>Diameter (inches)</label>
          <div class="input-wrap">
            <input type="number" id="col-d" min="0" step="0.5" placeholder="e.g. 10" oninput="calcConcrete()" />
            <span class="input-sfx">in</span>
          </div>
        </div>
        <div class="input-group">
          <label>Height / Depth (feet)</label>
          <div class="input-wrap">
            <input type="number" id="col-h" min="0" step="0.5" placeholder="e.g. 4" oninput="calcConcrete()" />
            <span class="input-sfx">ft</span>
          </div>
        </div>
        <div class="input-group">
          <label>Number of columns</label>
          <div class="input-wrap">
            <input type="number" id="col-n" min="1" step="1" placeholder="e.g. 4" oninput="calcConcrete()" value="1" />
            <span class="input-sfx">cols</span>
          </div>
        </div>
        <div class="input-group">
          <label>Concrete price ($/yard) <span style="font-weight:400;color:var(--text-2)">(optional)</span></label>
          <div class="input-wrap">
            <input type="number" id="price-col" min="0" step="5" placeholder="e.g. 150" oninput="calcConcrete()" />
            <span class="input-sfx">$/yd</span>
          </div>
        </div>
      </div>
    </div>

    <div style="margin-top:1rem;display:flex;align-items:center;gap:0.6rem">
      <input type="checkbox" id="waste-chk" onchange="calcConcrete()" checked style="width:18px;height:18px;cursor:pointer" />
      <label for="waste-chk" style="cursor:pointer;font-size:0.9rem">Add 10% waste factor <span style="color:var(--text-2)">(recommended)</span></label>
    </div>
  </div>

  <div class="card" id="result-card" style="display:none">
    <div class="answer-hero show">
      <div class="a-label" id="res-label">Concrete Needed</div>
      <div class="a-value" id="res-yards">—</div>
      <div class="a-unit">cubic yards</div>
      <div class="a-sub" id="res-sub">—</div>
    </div>
    <div class="stats-row show">
      <div class="stat-box">
        <span class="stat-lbl">Cubic yards</span>
        <span class="stat-val" id="s-yards">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">Cubic feet</span>
        <span class="stat-val" id="s-feet">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">60 lb bags</span>
        <span class="stat-val" id="s-60">—</span>
      </div>
      <div class="stat-box">
        <span class="stat-lbl">80 lb bags</span>
        <span class="stat-val" id="s-80">—</span>
      </div>
    </div>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">Volume (no waste)</span><span class="answer-val" id="b-base">—</span></div>
      <div class="answer-row"><span class="answer-lbl">+ 10% waste</span><span class="answer-val" id="b-waste">—</span></div>
      <div class="answer-row"><span class="answer-lbl">Total volume</span><span class="answer-val" id="b-total">—</span></div>
      <div class="answer-row"><span class="answer-lbl">60 lb bags needed</span><span class="answer-val" id="b-60">—</span></div>
      <div class="answer-row"><span class="answer-lbl">80 lb bags needed</span><span class="answer-val" id="b-80">—</span></div>
      <div class="answer-row" id="cost-row" style="display:none"><span class="answer-lbl">Estimated concrete cost</span><span class="answer-val" id="b-cost">—</span></div>
    </div>
  </div>

  <div class="card">
    <span class="preset-lbl">Common projects</span>
    <div class="preset-wrap">
      <a href="#" onclick="quickSet('slab',10,10,4);return false" class="preset-btn">10×10 Patio 4in</a>
      <a href="#" onclick="quickSet('slab',20,20,4);return false" class="preset-btn">20×20 Patio 4in</a>
      <a href="#" onclick="quickSet('slab',12,24,4);return false" class="preset-btn">Driveway 12×24</a>
      <a href="#" onclick="quickSet('slab',20,40,6);return false" class="preset-btn">Driveway 20×40 6in</a>
      <a href="#" onclick="quickSet('slab',12,12,4);return false" class="preset-btn">12×12 Shed floor</a>
      <a href="#" onclick="quickSet('slab',4,50,4);return false" class="preset-btn">Sidewalk 4×50</a>
      <a href="#" onclick="quickSet('footing',20,12,8);return false" class="preset-btn">Footing 20ft long</a>
      <a href="#" onclick="quickSet('column',10,4,4);return false" class="preset-btn">4 Deck posts 10in</a>
    </div>
  </div>

</div>

<div class="content-wrap">

  <div class="card">
    <h2>Coverage Reference Table</h2>
    <p style="margin-bottom:0.75rem;color:var(--text-2);font-size:0.9rem">How many square feet does 1 cubic yard cover at different thicknesses?</p>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
        <tr><th>Thickness</th><th>1 Cubic Yard Covers</th><th>Common Use</th></tr>
      </thead>
      <tbody>
        <tr><td>2 inches</td><td>162 sq ft</td><td>Topping slabs, thin overlays</td></tr>
        <tr><td>3 inches</td><td>108 sq ft</td><td>Light-duty paths</td></tr>
        <tr class="hl"><td>4 inches</td><td>81 sq ft</td><td>Sidewalks, patios, garage floors</td></tr>
        <tr><td>5 inches</td><td>65 sq ft</td><td>Light driveways</td></tr>
        <tr class="hl"><td>6 inches</td><td>54 sq ft</td><td>Driveways (cars &amp; trucks)</td></tr>
        <tr><td>8 inches</td><td>40 sq ft</td><td>Heavy equipment slabs, footings</td></tr>
        <tr><td>10 inches</td><td>32 sq ft</td><td>Deep footings, retaining walls</td></tr>
        <tr><td>12 inches</td><td>27 sq ft</td><td>Heavy structural footings</td></tr>
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <h2>Bag Count Reference Table</h2>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
        <tr><th>Cubic Yards</th><th>Cubic Feet</th><th>60 lb Bags</th><th>80 lb Bags</th><th>Order Ready-Mix?</th></tr>
      </thead>
      <tbody>
        <tr><td>0.25 yd³</td><td>6.75 cu ft</td><td>15 bags</td><td>12 bags</td><td>No — use bags</td></tr>
        <tr><td>0.5 yd³</td><td>13.5 cu ft</td><td>30 bags</td><td>23 bags</td><td>No — use bags</td></tr>
        <tr class="hl"><td>1 yd³</td><td>27 cu ft</td><td>60 bags</td><td>45 bags</td><td>Borderline</td></tr>
        <tr><td>2 yd³</td><td>54 cu ft</td><td>120 bags</td><td>90 bags</td><td>✅ Consider ready-mix</td></tr>
        <tr><td>3 yd³</td><td>81 cu ft</td><td>180 bags</td><td>135 bags</td><td>✅ Ready-mix recommended</td></tr>
        <tr><td>5 yd³</td><td>135 cu ft</td><td>300 bags</td><td>225 bags</td><td>✅ Ready-mix</td></tr>
        <tr><td>10 yd³</td><td>270 cu ft</td><td>600 bags</td><td>450 bags</td><td>✅ Ready-mix only</td></tr>
      </tbody>
    </table>
    </div>
    <div class="tip-box">
      <span class="tip-icon">🚛</span>
      <p><strong>Ready-mix vs bags:</strong> For projects over 1 cubic yard, ready-mix concrete is usually more cost-effective. A truck delivers $125–$200/yard. Bags cost ~$5–8 each = $300–$480 per cubic yard — 2–3× more expensive, plus mixing labor.</p>
    </div>
  </div>

  <div class="card">
    <h2>Recommended Slab Thickness by Project</h2>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
        <tr><th>Project</th><th>Thickness</th><th>Notes</th></tr>
      </thead>
      <tbody>
        <tr><td>Sidewalk / Walkway</td><td>4 inches</td><td>Standard residential</td></tr>
        <tr class="hl"><td>Patio</td><td>4 inches</td><td>4 in min; 6 in if near trees</td></tr>
        <tr><td>Garage floor</td><td>4–6 inches</td><td>6 in for heavier vehicles</td></tr>
        <tr><td>Residential driveway</td><td>4–6 inches</td><td>6 in recommended</td></tr>
        <tr><td>Truck / RV driveway</td><td>6 inches</td><td>Rebar required</td></tr>
        <tr><td>Shed floor</td><td>3.5–4 inches</td><td>Vapor barrier underneath</td></tr>
        <tr class="hl"><td>Pool deck</td><td>4 inches</td><td>Non-slip finish required</td></tr>
        <tr><td>Foundation footing</td><td>8–12 inches</td><td>Per structural engineer</td></tr>
        <tr><td>Deck footing (tube)</td><td>10–12 in dia</td><td>Below frost line depth</td></tr>
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <h2>How to Calculate Concrete — Formulas</h2>
    <div class="formula-box">
      <div class="formula-text">Slab: Cubic Yards = (L × W × T) ÷ 27</div>
      <div class="formula-sub">L = length (ft), W = width (ft), T = thickness in feet (inches ÷ 12)</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Circle: Cubic Yards = (π × r² × T) ÷ 27</div>
      <div class="formula-sub">r = radius in feet (diameter ÷ 2), T = thickness in feet</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Column: Cubic Yards = (π × r² × H × n) ÷ 27</div>
      <div class="formula-sub">r = radius in feet, H = height (ft), n = number of columns</div>
    </div>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">10×10 slab, 4 in</span><span class="answer-val">1.23 yd³ (+ 10% = 1.35 yd³)</span></div>
      <div class="answer-row"><span class="answer-lbl">20×20 patio, 4 in</span><span class="answer-val">4.94 yd³ (+ 10% = 5.43 yd³)</span></div>
      <div class="answer-row"><span class="answer-lbl">12×24 driveway, 6 in</span><span class="answer-val">5.33 yd³ (+ 10% = 5.87 yd³)</span></div>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How do I calculate how much concrete I need?</h3>
      <p>Multiply length (ft) × width (ft) × thickness (ft) to get cubic feet, then divide by 27 to get cubic yards. Convert inches to feet by dividing by 12. Always add 10% for waste. Use the calculator above for instant results.</p>
    </div>
    <div class="faq-item">
      <h3>How many bags of concrete do I need for a 10×10 slab?</h3>
      <p>A 10×10 ft slab at 4 inches thick = 33.3 cubic feet + 10% waste = 36.7 cubic feet. That's 82 bags of 60 lb (0.45 cu ft each) or 62 bags of 80 lb (0.60 cu ft each). Use the calculator for your exact dimensions.</p>
    </div>
    <div class="faq-item">
      <h3>How many cubic yards are in a truck?</h3>
      <p>A standard ready-mix concrete truck holds 8–10 cubic yards. Minimum orders are often 1 cubic yard with a short-load fee. For projects under 1 yard, bags are usually more practical.</p>
    </div>
    <div class="faq-item">
      <h3>Why add 10% for waste?</h3>
      <p>Concrete volume calculations assume perfectly level, square forms. In reality: sub-base is uneven, some concrete spills, and you need extra to ensure you don't run short mid-pour. Running out creates cold joints that can crack. Always order extra.</p>
    </div>
    <div class="faq-item">
      <h3>How thick does a concrete driveway need to be?</h3>
      <p>4 inches is the minimum for residential driveways with passenger cars. 6 inches is recommended for trucks, SUVs, or heavier vehicles. Add rebar or fiber reinforcement for driveways thicker than 4 inches.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/square-footage-calculator" class="next-card">
        <span class="next-tag">Math</span>
        <h3>Square Footage Calculator</h3>
        <p>Calculate area in sq ft — rectangle, circle, triangle</p>
      </a>
      <a href="/yards-to-meters" class="next-card">
        <span class="next-tag">Converter</span>
        <h3>Yards to Meters</h3>
        <p>Convert yards to meters — 1 yd = 0.9144 m</p>
      </a>
      <a href="/kg-to-lbs" class="next-card">
        <span class="next-tag">Weight</span>
        <h3>kg to lbs</h3>
        <p>Convert kilograms to pounds</p>
      </a>
    </div>
  </div>

</div>

<style>
.apr-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}
@media (max-width: 600px) {
  .apr-grid { grid-template-columns: 1fr; }
}
</style>

<script is:inline>
var shape = 'slab';

function setShape(s) {
  shape = s;
  ['slab','footing','circle','column'].forEach(function(id) {
    document.getElementById('btn-' + id).classList.toggle('active', id === s);
    document.getElementById('inp-' + id).style.display = id === s ? 'block' : 'none';
  });
  document.getElementById('result-card').style.display = 'none';
  calcConcrete();
}

function getCubicFt() {
  var waste = document.getElementById('waste-chk').checked ? 1.10 : 1.0;
  if (shape === 'slab') {
    var l = parseFloat(document.getElementById('slab-l').value);
    var w = parseFloat(document.getElementById('slab-w').value);
    var t = parseFloat(document.getElementById('slab-t').value);
    if (isNaN(l) || isNaN(w) || isNaN(t) || l <= 0 || w <= 0 || t <= 0) return null;
    return { base: l * w * (t / 12), waste: waste, price: parseFloat(document.getElementById('price').value) || 0 };
  }
  if (shape === 'footing') {
    var l = parseFloat(document.getElementById('foot-l').value);
    var w = parseFloat(document.getElementById('foot-w').value);
    var d = parseFloat(document.getElementById('foot-d').value);
    if (isNaN(l) || isNaN(w) || isNaN(d) || l <= 0 || w <= 0 || d <= 0) return null;
    return { base: l * (w / 12) * (d / 12), waste: waste, price: parseFloat(document.getElementById('price-foot').value) || 0 };
  }
  if (shape === 'circle') {
    var d = parseFloat(document.getElementById('circ-d').value);
    var t = parseFloat(document.getElementById('circ-t').value);
    if (isNaN(d) || isNaN(t) || d <= 0 || t <= 0) return null;
    var r = d / 2;
    return { base: Math.PI * r * r * (t / 12), waste: waste, price: parseFloat(document.getElementById('price-circ').value) || 0 };
  }
  if (shape === 'column') {
    var d = parseFloat(document.getElementById('col-d').value);
    var h = parseFloat(document.getElementById('col-h').value);
    var n = parseFloat(document.getElementById('col-n').value) || 1;
    if (isNaN(d) || isNaN(h) || d <= 0 || h <= 0) return null;
    var r = (d / 12) / 2;
    return { base: Math.PI * r * r * h * n, waste: waste, price: parseFloat(document.getElementById('price-col').value) || 0 };
  }
  return null;
}

function calcConcrete() {
  var data = getCubicFt();
  if (!data) { document.getElementById('result-card').style.display = 'none'; return; }

  var baseCuFt  = data.base;
  var totalCuFt = baseCuFt * data.waste;
  var baseYds   = baseCuFt / 27;
  var totalYds  = totalCuFt / 27;
  var bags60    = Math.ceil(totalCuFt / 0.45);
  var bags80    = Math.ceil(totalCuFt / 0.60);

  var shapeLabels = { slab: 'Slab / Patio', footing: 'Footing / Wall', circle: 'Circular Slab', column: 'Column / Tube' };
  document.getElementById('res-label').textContent = shapeLabels[shape] + ' — Concrete Needed';
  document.getElementById('res-yards').textContent = totalYds.toFixed(2);
  document.getElementById('res-sub').textContent =
    totalCuFt.toFixed(2) + ' cu ft' +
    (data.waste > 1 ? ' (includes 10% waste)' : '') +
    ' | ' + bags60 + ' bags × 60 lb or ' + bags80 + ' bags × 80 lb';

  document.getElementById('s-yards').textContent = totalYds.toFixed(2) + ' yd³';
  document.getElementById('s-feet').textContent  = totalCuFt.toFixed(2) + ' cu ft';
  document.getElementById('s-60').textContent    = bags60 + ' bags';
  document.getElementById('s-80').textContent    = bags80 + ' bags';

  document.getElementById('b-base').textContent  = baseYds.toFixed(3) + ' yd³ (' + baseCuFt.toFixed(2) + ' cu ft)';
  document.getElementById('b-waste').textContent = data.waste > 1
    ? '+' + (baseCuFt * 0.10).toFixed(2) + ' cu ft'
    : 'Not added';
  document.getElementById('b-total').textContent = totalYds.toFixed(3) + ' yd³ (' + totalCuFt.toFixed(2) + ' cu ft)';
  document.getElementById('b-60').textContent    = bags60 + ' bags (0.45 cu ft each)';
  document.getElementById('b-80').textContent    = bags80 + ' bags (0.60 cu ft each)';

  var costRow = document.getElementById('cost-row');
  if (data.price > 0) {
    var cost = totalYds * data.price;
    document.getElementById('b-cost').textContent = '$' + Math.round(cost).toLocaleString() + ' (material only)';
    costRow.style.display = 'flex';
  } else {
    costRow.style.display = 'none';
  }

  document.getElementById('result-card').style.display = 'block';
}

function quickSet(s, a, b, c) {
  setShape(s);
  if (s === 'slab') {
    document.getElementById('slab-l').value = a;
    document.getElementById('slab-w').value = b;
    document.getElementById('slab-t').value = c;
  } else if (s === 'footing') {
    document.getElementById('foot-l').value = a;
    document.getElementById('foot-w').value = b;
    document.getElementById('foot-d').value = c;
  } else if (s === 'column') {
    document.getElementById('col-d').value = a;
    document.getElementById('col-h').value = b;
    document.getElementById('col-n').value = c;
  }
  calcConcrete();
}
</script>

