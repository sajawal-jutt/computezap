---
import Layout from '../layouts/Layout.astro';

const groups = [
  { label: "40–59 kg", weights: [40, 45, 50, 55] },
  { label: "60–69 kg", weights: [60, 61, 62, 63, 64, 65, 66, 67, 68, 69] },
  { label: "70–79 kg", weights: [70, 71, 72, 73, 74, 75, 76, 77, 78, 79] },
  { label: "80–89 kg", weights: [80, 81, 82, 83, 84, 85, 86, 87, 88, 89] },
  { label: "90–99 kg", weights: [90, 91, 92, 93, 94, 95, 96, 97, 98, 99] },
  { label: "100–200 kg", weights: [100, 105, 110, 115, 120, 125, 130, 135, 140, 150, 175, 200] },
];

function toLbs(kg: number) {
  const lbs = kg * 2.20462;
  return Math.round(lbs * 100) / 100;
}
function toStones(kg: number) {
  const lbs = kg * 2.20462;
  const st = Math.floor(lbs / 14);
  const rem = Math.round((lbs % 14) * 10) / 10;
  return `${st} st ${rem} lb`;
}

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "All kg to lbs Conversion Pages — ComputeZap",
    "url": "https://www.computezap.com/kg-pages",
    "description": "Browse all 56 kg to lbs conversion pages — 40 kg to 200 kg. Every page shows pounds, stones, grams, and ounces.",
    "isPartOf": { "@id": "https://www.computezap.com/#website" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "kg to lbs Converter", "item": "https://www.computezap.com/kg-to-lbs" },
      { "@type": "ListItem", "position": 3, "name": "All kg to lbs Pages", "item": "https://www.computezap.com/kg-pages" }
    ]
  }
]);
---
<Layout
  title="All kg to lbs Conversion Pages — 40 kg to 200 kg | ComputeZap"
  description="Browse all 56 kg to lbs pages — 40 kg to 200 kg. Every page shows the exact pounds, stones, grams, and ounces conversion. Fast and free."
  canonical="/kg-pages"
  schema={schema}
>
<style is:global>
.kp-hero{text-align:center;padding:2rem 1rem 1.5rem;border-bottom:1px solid #e5e7eb;margin-bottom:1.75rem}
.kp-hero h1{font-size:1.85rem;font-weight:800;color:#111;margin:0 0 .4rem;letter-spacing:-.4px}
.kp-hero p{color:#555;font-size:.95rem;margin:0 0 1rem}
.kp-cta{display:inline-flex;align-items:center;gap:.4rem;background:var(--blue);color:#fff;padding:.55rem 1.25rem;border-radius:8px;font-size:.88rem;font-weight:700;text-decoration:none;transition:background .15s}
.kp-cta:hover{background:#1d4ed8;text-decoration:none;color:#fff}

.kp-stats{display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;justify-content:center;font-size:.82rem;color:#64748b;font-weight:600;margin-bottom:1.75rem}
.kp-stats span{display:flex;align-items:center;gap:.25rem}

.kg-block{margin-bottom:2rem}
.kg-title{font-size:.8rem;font-weight:800;text-transform:uppercase;letter-spacing:.08em;color:#64748b;margin:0 0 .75rem;display:flex;align-items:center;gap:.5rem}
.kg-title::after{content:'';flex:1;height:1px;background:#e5e7eb}
.kg-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(155px,1fr));gap:.45rem}
.kg-link{background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;padding:.6rem .85rem;text-decoration:none;display:flex;flex-direction:column;gap:.1rem;transition:border-color .12s,background .12s}
.kg-link:hover{border-color:var(--blue);background:#eff6ff;text-decoration:none}
.kl-label{font-size:.78rem;color:#64748b;font-weight:500}
.kl-lbs{font-size:.95rem;font-weight:800;color:#111}
.kl-stones{font-size:.72rem;color:#2563eb;font-weight:600}

@media(max-width:480px){.kg-grid{grid-template-columns:repeat(auto-fill,minmax(135px,1fr))}.kp-hero h1{font-size:1.5rem}}
</style>

<div class="kp-hero">
  <h1>All kg to lbs Conversion Pages</h1>
  <p>56 specific weights — 40 kg to 200 kg. Every page shows pounds, stones, grams, and ounces.</p>
  <a href="/kg-to-lbs" class="kp-cta">⚖️ Any Weight? Use the Converter →</a>
</div>

<div class="kp-stats">
  <span>✓ 56 pages</span>
  <span>✓ 40 kg – 200 kg</span>
  <span>✓ lbs, stones, grams, oz</span>
  <span>✓ 1 kg = 2.20462 lbs</span>
</div>

{groups.map(group => (
  <div class="kg-block">
    <p class="kg-title">⚖️ {group.label}</p>
    <div class="kg-grid">
      {group.weights.map(kg => (
        <a href={`/kg-to-lbs/${kg}-kg-to-lbs`} class="kg-link">
          <span class="kl-label">{kg} kg to lbs</span>
          <span class="kl-lbs">{toLbs(kg)} lbs</span>
          <span class="kl-stones">{toStones(kg)}</span>
        </a>
      ))}
    </div>
  </div>
))}

</Layout>
