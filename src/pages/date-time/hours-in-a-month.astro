---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Hours in a Month Calculator",
    "url": "https://computezap.com/date-time/hours-in-a-month",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Calculate exactly how many hours are in any month. Default month has 730 average hours. Shows work hours, minutes, seconds, and weekday count per month.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Hours in a Month", "item": "https://computezap.com/date-time/hours-in-a-month" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many hours are in a month?", "acceptedAnswer": { "@type": "Answer", "text": "The average number of hours in a month is 730 hours (365 days / 12 months x 24 hours/day). A 30-day month has 720 hours, a 31-day month has 744 hours, and February has 672 hours (28 days) or 696 hours (leap year, 29 days)." } },
      { "@type": "Question", "name": "How many work hours are in a month?", "acceptedAnswer": { "@type": "Answer", "text": "A typical work month has about 160-184 work hours based on 8 hours per day x approximately 20-23 weekdays. The most commonly used figure is 173 work hours per month (2,080 annual work hours / 12 months)." } },
      { "@type": "Question", "name": "How many hours are in a 30-day month?", "acceptedAnswer": { "@type": "Answer", "text": "A 30-day month has exactly 720 hours (30 days x 24 hours/day). This applies to April, June, September, and November." } },
      { "@type": "Question", "name": "How many hours are in a 31-day month?", "acceptedAnswer": { "@type": "Answer", "text": "A 31-day month has exactly 744 hours (31 days x 24 hours/day). This applies to January, March, May, July, August, October, and December." } },
      { "@type": "Question", "name": "How many minutes are in a month?", "acceptedAnswer": { "@type": "Answer", "text": "A 30-day month has 43,200 minutes. A 31-day month has 44,640 minutes. The average month has 43,800 minutes (730 hours x 60 minutes/hour)." } }
    ]
  }
]);
---
<Layout
  title="Hours in a Month — 730 Hours Average | ComputeZap"
  description="How many hours are in a month? 730 average hours per month. A 30-day month has 720 hours, 31-day has 744. Shows work hours, minutes, and seconds per month."
  canonical="/date-time/hours-in-a-month"
  schema={schema}
>

<div class="page-hero">
  <nav><a href="/">Home</a> › Hours in a Month</nav>
  <h1>Hours in a Month</h1>
  <p>How many hours are in a month? 720, 730, or 744 — it depends on the month</p>
</div>

<div class="calc-center">
  <div class="card">

    <div class="quick-answer">
      <span class="qa-big">730 hours/month</span>
      <span class="qa-sub">average based on 365 days / 12 x 24 hrs</span>
    </div>

    <div class="input-group">
      <label for="month-select">Select Month Type</label>
      <div class="input-wrap">
        <select id="month-select" onchange="calculate()" style="width:100%;padding:.65rem 1rem;border:1.5px solid #d1d5db;border-radius:8px;font-size:1rem;font-family:inherit;background:#fff;color:#111">
          <option value="30">30-day month (Apr, Jun, Sep, Nov)</option>
          <option value="31" selected>31-day month (Jan, Mar, May, Jul, Aug, Oct, Dec)</option>
          <option value="28">28-day month (February, non-leap year)</option>
          <option value="29">29-day month (February, leap year)</option>
        </select>
      </div>
    </div>

    <div class="input-group">
      <label for="hours-per-day">Hours Per Day</label>
      <div class="input-wrap">
        <input type="number" id="hours-per-day" value="24" min="1" max="24" step="1" oninput="calculate()" />
        <span class="input-sfx">hrs/day</span>
      </div>
    </div>

    <div class="result-hero">
      <div class="r-label">Hours in This Month</div>
      <div class="r-value"><span id="r-total">744</span> hrs</div>
      <div class="r-sub" id="r-sub">31 days x 24 hrs/day</div>
    </div>

    <div class="stats-row show">
      <div class="stat-box"><span class="stat-lbl">Work Hours</span><span class="stat-val" id="r-work">~184 hrs</span></div>
      <div class="stat-box"><span class="stat-lbl">Minutes</span><span class="stat-val" id="r-minutes">44,640</span></div>
      <div class="stat-box"><span class="stat-lbl">Seconds</span><span class="stat-val" id="r-seconds">2,678,400</span></div>
      <div class="stat-box"><span class="stat-lbl">Weekdays</span><span class="stat-val" id="r-weekdays">~23</span></div>
    </div>

  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>Hours per Month by Calendar Month</h2>
    <p>The exact number of hours in a month depends on how many days that month has. All months have exactly 24 hours per day.</p>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Month</th><th>Days</th><th>Total Hours</th><th>Work Hours</th></tr></thead>
        <tbody>
          {[
            ['January',31,744,'~184'],
            ['February',28,672,'~160'],
            ['February (leap)',29,696,'~168'],
            ['March',31,744,'~184'],
            ['April',30,720,'~176'],
            ['May',31,744,'~184'],
            ['June',30,720,'~176'],
            ['July',31,744,'~184'],
            ['August',31,744,'~184'],
            ['September',30,720,'~176'],
            ['October',31,744,'~184'],
            ['November',30,720,'~176'],
            ['December',31,744,'~184'],
          ].map(([m, d, h, wh]) => (
            <tr>
              <td>{m}</td>
              <td>{d}</td>
              <td style="color:var(--blue);font-weight:700">{h}</td>
              <td>{wh}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Where Does 730 Hours Come From?</h2>
    <p>The <strong>average hours per month</strong> of 730 hours is calculated as:</p>
    <div class="formula-box">730 = 365 days/year / 12 months x 24 hours/day</div>
    <p>This is the standard figure used in HR, payroll, and salary-to-hourly conversions. When someone asks "how many hours does a salaried employee work per month?" the answer is typically 173 work hours (2,080 annual / 12) for a standard 40-hr week schedule.</p>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Salary to hourly:</strong> Divide your monthly salary by 173 (work hours) to get your effective hourly rate. Example: $5,000/month / 173 hrs = ~$28.90/hr.</p>
    </div>
  </div>

  <div class="card">
    <h2>Work Hours Per Month — Standard Schedules</h2>
    <div style="overflow-x:auto">
      <table class="conv-table">
        <thead><tr><th>Schedule</th><th>Hours/Week</th><th>Avg Hours/Month</th><th>Annual Hours</th></tr></thead>
        <tbody>
          {[
            ['Part-time (half)','20 hrs','~86.7 hrs','1,040 hrs'],
            ['Part-time (3/4)','30 hrs','~130 hrs','1,560 hrs'],
            ['Standard full-time','40 hrs','~173 hrs','2,080 hrs'],
            ['Extended hours','45 hrs','~195 hrs','2,340 hrs'],
            ['Heavy overtime','50 hrs','~216.7 hrs','2,600 hrs'],
          ].map(([sched, wk, mo, yr]) => (
            <tr>
              <td>{sched}</td><td>{wk}</td>
              <td style="color:var(--blue);font-weight:700">{mo}</td>
              <td>{yr}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>How many hours are in a month?</h3>
      <p>The average is <strong>730 hours</strong> per month. By specific month: 31-day months = 744 hours, 30-day months = 720 hours, February = 672 hours (non-leap) or 696 hours (leap year).</p>
    </div>
    <div class="faq-item">
      <h3>How many work hours are in a month?</h3>
      <p>Approximately <strong>173 work hours</strong> per month for a standard 40-hour/week job (2,080 annual hours / 12). Exact count varies by month based on how many weekdays it contains.</p>
    </div>
    <div class="faq-item">
      <h3>How many hours are in a 30-day month?</h3>
      <p>Exactly <strong>720 hours</strong>. Calculation: 30 x 24 = 720. April, June, September, and November all have 30 days.</p>
    </div>
    <div class="faq-item">
      <h3>How many hours are in a 31-day month?</h3>
      <p>Exactly <strong>744 hours</strong>. Calculation: 31 x 24 = 744. January, March, May, July, August, October, and December have 31 days.</p>
    </div>
    <div class="faq-item">
      <h3>How many minutes are in a month?</h3>
      <p>An average month has <strong>43,800 minutes</strong> (730 x 60). A 30-day month has 43,200 minutes, and a 31-day month has 44,640 minutes.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Calculators</h2>
    <div class="next-grid">
      <a href="/hours-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Year</h3>
        <p>8,760 total hours per year and work hours.</p>
      </a>
      <a href="/minutes-in-a-day" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Minutes in a Day</h3>
        <p>1,440 minutes in a day — fully explained.</p>
      </a>
      <a href="/seconds-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Seconds in a Year</h3>
        <p>31,536,000 seconds in a year — exact count.</p>
      </a>
      <a href="/weeks-in-a-year" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Weeks in a Year</h3>
        <p>52 weeks and 1-2 extra days per year.</p>
      </a>
      <a href="/time-to-decimal-calculator" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Time to Decimal</h3>
        <p>Convert hours and minutes to decimal for payroll.</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Find the exact date any number of days from today.</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
function calculate() {
  var days   = parseInt(document.getElementById('month-select').value) || 30;
  var hrsDay = parseFloat(document.getElementById('hours-per-day').value) || 24;
  if (hrsDay > 24) hrsDay = 24;

  var total    = days * hrsDay;
  var weekdays = Math.round(days * (5/7));
  var workHrs  = weekdays * 8;
  var mins     = total * 60;
  var secs     = total * 3600;

  document.getElementById('r-total').textContent    = total.toLocaleString();
  document.getElementById('r-sub').textContent      = days + ' days x ' + hrsDay + ' hrs/day';
  document.getElementById('r-work').textContent     = '~' + workHrs.toLocaleString() + ' hrs';
  document.getElementById('r-minutes').textContent  = mins.toLocaleString();
  document.getElementById('r-seconds').textContent  = secs.toLocaleString();
  document.getElementById('r-weekdays').textContent = '~' + weekdays;
}

calculate();
</script>
</Layout>
