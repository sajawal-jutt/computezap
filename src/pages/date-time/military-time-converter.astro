---
import Layout from '../../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Military Time Converter",
    "url": "https://computezap.com/date-time/military-time-converter",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert military time to standard time or standard time to military time instantly. 1300 = 1:00 PM, 0800 = 8:00 AM. Free military time chart included.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "Date & Time", "item": "https://computezap.com/date-time" },
      { "@type": "ListItem", "position": 3, "name": "Military Time Converter", "item": "https://computezap.com/date-time/military-time-converter" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What is 1300 in military time?",
        "acceptedAnswer": { "@type": "Answer", "text": "1300 in military time is 1:00 PM. Military time uses a 24-hour clock starting from 0000 (midnight). Hours 13–23 are PM hours — subtract 12 to get the standard PM time: 1300 − 12 = 1:00 PM." }
      },
      {
        "@type": "Question",
        "name": "What is 0800 in military time?",
        "acceptedAnswer": { "@type": "Answer", "text": "0800 in military time is 8:00 AM. Hours 0100–1159 in military time are AM hours and match standard time directly. 0800 = 8:00 AM." }
      },
      {
        "@type": "Question",
        "name": "How do you convert military time to regular time?",
        "acceptedAnswer": { "@type": "Answer", "text": "To convert military time to standard time: (1) If the hour is 0000, it's 12:00 AM (midnight). (2) If the hour is 0100–1159, it's the same in AM. (3) If the hour is 1200, it's 12:00 PM (noon). (4) If the hour is 1300–2359, subtract 12 to get the PM hour. Examples: 0930 = 9:30 AM, 1430 = 2:30 PM, 2200 = 10:00 PM." }
      },
      {
        "@type": "Question",
        "name": "What is midnight in military time?",
        "acceptedAnswer": { "@type": "Answer", "text": "Midnight is 0000 in military time (also written as 2400 at end of day). 12:00 AM = 0000 hours. One minute after midnight = 0001." }
      },
      {
        "@type": "Question",
        "name": "What is noon in military time?",
        "acceptedAnswer": { "@type": "Answer", "text": "Noon (12:00 PM) in military time is 1200 hours. This is the one exception to the pattern — 1200 military = 12:00 PM, not 0:00 PM." }
      },
      {
        "@type": "Question",
        "name": "How do you say military time out loud?",
        "acceptedAnswer": { "@type": "Answer", "text": "Military time is spoken as: 0800 = 'zero eight hundred hours', 1300 = 'thirteen hundred hours', 1430 = 'fourteen thirty hours', 0930 = 'zero nine thirty hours'. The word 'hours' is said after the time." }
      }
    ]
  }
]);

const timeTable = [
  { mil: '0000', std: '12:00 AM', label: 'Midnight' },
  { mil: '0100', std: '1:00 AM', label: '' },
  { mil: '0200', std: '2:00 AM', label: '' },
  { mil: '0300', std: '3:00 AM', label: '' },
  { mil: '0400', std: '4:00 AM', label: '' },
  { mil: '0500', std: '5:00 AM', label: '' },
  { mil: '0600', std: '6:00 AM', label: '' },
  { mil: '0700', std: '7:00 AM', label: '' },
  { mil: '0800', std: '8:00 AM', label: '' },
  { mil: '0900', std: '9:00 AM', label: '' },
  { mil: '1000', std: '10:00 AM', label: '' },
  { mil: '1100', std: '11:00 AM', label: '' },
  { mil: '1200', std: '12:00 PM', label: 'Noon' },
  { mil: '1300', std: '1:00 PM', label: '' },
  { mil: '1400', std: '2:00 PM', label: '' },
  { mil: '1500', std: '3:00 PM', label: '' },
  { mil: '1600', std: '4:00 PM', label: '' },
  { mil: '1700', std: '5:00 PM', label: '' },
  { mil: '1800', std: '6:00 PM', label: '' },
  { mil: '1900', std: '7:00 PM', label: '' },
  { mil: '2000', std: '8:00 PM', label: '' },
  { mil: '2100', std: '9:00 PM', label: '' },
  { mil: '2200', std: '10:00 PM', label: '' },
  { mil: '2300', std: '11:00 PM', label: '' },
];
---
<Layout
  title="Military Time Converter — Convert Military Time to Standard Time | ComputeZap"
  description="Convert military time to standard time or vice versa instantly. 1300 = 1:00 PM, 0800 = 8:00 AM, 2200 = 10:00 PM. Full 24-hour military time chart included."
  canonical="/date-time/military-time-converter"
  schema={schema}
>

<div class="page-hero">
  <nav class="breadcrumb"><a href="/">Home</a> › <a href="/#date-time">Date & Time</a> › Military Time Converter</nav>
  <h1>Military Time Converter</h1>
  <p>Convert military time ↔ standard 12-hour time instantly</p>
</div>

<div class="calc-center">
  <div class="card">
    <div class="mode-wrap">
      <button class="mode-btn active" id="btn-m2s" onclick="setMode('m2s');return false">Military → Standard</button>
      <button class="mode-btn" id="btn-s2m" onclick="setMode('s2m');return false">Standard → Military</button>
    </div>

    <div id="input-m2s">
      <div class="input-group">
        <label>Military Time (0000–2359):</label>
        <div class="input-wrap">
          <input type="text" id="mil-input" maxlength="4" placeholder="e.g. 1430" oninput="convertM2S()" style="letter-spacing:.15em;font-size:1.1rem;font-weight:700" />
          <span class="input-sfx">hrs</span>
        </div>
      </div>
    </div>

    <div id="input-s2m" style="display:none">
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:.5rem;margin-bottom:.85rem">
        <div class="input-group" style="margin-bottom:0">
          <label>Hour</label>
          <div class="input-wrap">
            <input type="number" id="std-hr" min="1" max="12" placeholder="12" oninput="convertS2M()" />
          </div>
        </div>
        <div class="input-group" style="margin-bottom:0">
          <label>Minute</label>
          <div class="input-wrap">
            <input type="number" id="std-min" min="0" max="59" placeholder="00" oninput="convertS2M()" />
          </div>
        </div>
        <div class="input-group" style="margin-bottom:0">
          <label>AM / PM</label>
          <select id="std-ampm" onchange="convertS2M()" style="width:100%;padding:.65rem .9rem;border:1.5px solid #e2e8f0;border-radius:8px;font-size:1rem;font-family:inherit;color:#111;background:#fff;box-sizing:border-box">
            <option value="AM">AM</option>
            <option value="PM">PM</option>
          </select>
        </div>
      </div>
    </div>

    <div class="answer-hero show" id="result-hero">
      <div class="a-label" id="res-label">Military Time</div>
      <div class="a-value" id="res-value">—</div>
      <div class="a-unit" id="res-unit">Enter a time above</div>
    </div>
  </div>

  <div class="card">
    <span class="preset-lbl">Common times</span>
    <div class="preset-wrap">
      <a href="#" onclick="setPreset('0000');return false" class="preset-btn">0000 Midnight</a>
      <a href="#" onclick="setPreset('0600');return false" class="preset-btn">0600</a>
      <a href="#" onclick="setPreset('0800');return false" class="preset-btn">0800</a>
      <a href="#" onclick="setPreset('0930');return false" class="preset-btn">0930</a>
      <a href="#" onclick="setPreset('1200');return false" class="preset-btn">1200 Noon</a>
      <a href="#" onclick="setPreset('1300');return false" class="preset-btn">1300</a>
      <a href="#" onclick="setPreset('1430');return false" class="preset-btn">1430</a>
      <a href="#" onclick="setPreset('1700');return false" class="preset-btn">1700</a>
      <a href="#" onclick="setPreset('1800');return false" class="preset-btn">1800</a>
      <a href="#" onclick="setPreset('2100');return false" class="preset-btn">2100</a>
      <a href="#" onclick="setPreset('2200');return false" class="preset-btn">2200</a>
      <a href="#" onclick="setPreset('2359');return false" class="preset-btn">2359</a>
    </div>
  </div>
</div>

<div class="content-wrap">

  <div class="card">
    <h2>How to Convert Military Time</h2>
    <div class="formula-box">
      <div class="formula-text">Military → Standard: If hour ≥ 13, subtract 12 → PM</div>
      <div class="formula-sub">1430 → 14 − 12 = 2, minutes 30 → 2:30 PM</div>
    </div>
    <div class="formula-box">
      <div class="formula-text">Standard → Military: If PM, add 12 to hour</div>
      <div class="formula-sub">2:30 PM → 2 + 12 = 14, minutes 30 → 1430</div>
    </div>
    <div class="answer-box">
      <div class="answer-row"><span class="answer-lbl">0000</span><span class="answer-val">12:00 AM (Midnight)</span></div>
      <div class="answer-row"><span class="answer-lbl">0800</span><span class="answer-val">8:00 AM</span></div>
      <div class="answer-row"><span class="answer-lbl">1200</span><span class="answer-val">12:00 PM (Noon)</span></div>
      <div class="answer-row"><span class="answer-lbl">1300</span><span class="answer-val">1:00 PM</span></div>
      <div class="answer-row"><span class="answer-lbl">1800</span><span class="answer-val">6:00 PM</span></div>
      <div class="answer-row"><span class="answer-lbl">2359</span><span class="answer-val">11:59 PM</span></div>
    </div>
    <div class="tip-box">
      <span class="tip-icon">💡</span>
      <p><strong>Easy rule:</strong> Hours 0100–1159 = AM (same number). Hours 1300–2359 = PM (subtract 12). 0000 = midnight, 1200 = noon.</p>
    </div>
  </div>

  <div class="card">
    <h2>Military Time Chart — All 24 Hours</h2>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
        <tr><th>Military</th><th>Standard</th><th>Note</th><th>Military</th><th>Standard</th><th>Note</th></tr>
      </thead>
      <tbody>
        {timeTable.slice(0, 12).map((r, i) => (
          <tr class={r.mil === '0000' || r.mil === '1200' ? 'hl' : ''}>
            <td><strong>{r.mil}</strong></td>
            <td>{r.std}</td>
            <td style="color:#94a3b8;font-size:.8rem">{r.label}</td>
            <td><strong>{timeTable[i + 12].mil}</strong></td>
            <td>{timeTable[i + 12].std}</td>
            <td style="color:#94a3b8;font-size:.8rem">{timeTable[i + 12].label}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <h2>How to Say Military Time</h2>
    <div style="overflow-x:auto">
    <table class="conv-table">
      <thead>
        <tr><th>Military</th><th>Say It As</th><th>Standard</th></tr>
      </thead>
      <tbody>
        <tr><td>0800</td><td>"Zero eight hundred hours"</td><td>8:00 AM</td></tr>
        <tr><td>0930</td><td>"Zero nine thirty hours"</td><td>9:30 AM</td></tr>
        <tr><td>1200</td><td>"Twelve hundred hours"</td><td>12:00 PM</td></tr>
        <tr class="hl"><td>1300</td><td>"Thirteen hundred hours"</td><td>1:00 PM</td></tr>
        <tr><td>1430</td><td>"Fourteen thirty hours"</td><td>2:30 PM</td></tr>
        <tr><td>1800</td><td>"Eighteen hundred hours"</td><td>6:00 PM</td></tr>
        <tr><td>2100</td><td>"Twenty-one hundred hours"</td><td>9:00 PM</td></tr>
        <tr><td>2359</td><td>"Twenty-three fifty-nine hours"</td><td>11:59 PM</td></tr>
      </tbody>
    </table>
    </div>
  </div>

  <div class="card">
    <h2>Frequently Asked Questions</h2>
    <div class="faq-item">
      <h3>What is 1300 in military time?</h3>
      <p>1300 military time = 1:00 PM. Subtract 12 from hours above 12: 13 − 12 = 1. So 1300 = 1:00 PM.</p>
    </div>
    <div class="faq-item">
      <h3>What is 1400 in military time?</h3>
      <p>1400 military time = 2:00 PM. 14 − 12 = 2, no minutes → 2:00 PM.</p>
    </div>
    <div class="faq-item">
      <h3>What is 1500 in military time?</h3>
      <p>1500 military time = 3:00 PM. 15 − 12 = 3 → 3:00 PM.</p>
    </div>
    <div class="faq-item">
      <h3>What is 2000 in military time?</h3>
      <p>2000 military time = 8:00 PM. 20 − 12 = 8 → 8:00 PM.</p>
    </div>
    <div class="faq-item">
      <h3>Who uses military time?</h3>
      <p>Military time (24-hour clock) is used by the military, hospitals, airlines, emergency services, railways, and most countries outside the US. It eliminates AM/PM confusion — critical in medical and operational contexts.</p>
    </div>
    <div class="faq-item">
      <h3>What is the difference between 12-hour and 24-hour time?</h3>
      <p>12-hour time uses 1–12 with AM/PM. 24-hour (military) time uses 0000–2359 with no AM/PM. 24-hour time is unambiguous — there's no confusion between 12:00 AM and 12:00 PM.</p>
    </div>
  </div>

  <div class="card">
    <h2>Related Tools</h2>
    <div class="next-grid">
      <a href="/time-to-decimal-calculator" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Time to Decimal</h3>
        <p>Convert hours and minutes to decimal hours</p>
      </a>
      <a href="/date-time/hours-in-a-week" class="next-card">
        <span class="next-tag">Time</span>
        <h3>Hours in a Week</h3>
        <p>168 hours in a week — full breakdown</p>
      </a>
      <a href="/days-from-today" class="next-card">
        <span class="next-tag">Date</span>
        <h3>Days From Today</h3>
        <p>Calculate what date is N days from today</p>
      </a>
    </div>
  </div>

</div>

<script is:inline>
var mode = 'm2s';

function setMode(m) {
  mode = m;
  document.getElementById('btn-m2s').classList.toggle('active', m === 'm2s');
  document.getElementById('btn-s2m').classList.toggle('active', m === 's2m');
  document.getElementById('input-m2s').style.display = m === 'm2s' ? 'block' : 'none';
  document.getElementById('input-s2m').style.display = m === 's2m' ? 'block' : 'none';
  document.getElementById('res-value').textContent = '—';
  document.getElementById('res-unit').textContent = 'Enter a time above';
  document.getElementById('res-label').textContent = m === 'm2s' ? 'Standard Time' : 'Military Time';
}

function convertM2S() {
  var val = document.getElementById('mil-input').value.replace(/\D/g, '');
  if (val.length < 3) {
    document.getElementById('res-value').textContent = '—';
    document.getElementById('res-unit').textContent = 'Enter 3–4 digits';
    return;
  }
  var h, m;
  if (val.length === 3) { h = parseInt(val[0]); m = parseInt(val.slice(1)); }
  else { h = parseInt(val.slice(0, 2)); m = parseInt(val.slice(2)); }

  if (h > 23 || m > 59) {
    document.getElementById('res-value').textContent = 'Invalid';
    document.getElementById('res-unit').textContent = 'Hours 00–23, Minutes 00–59';
    return;
  }

  var period, stdH;
  if (h === 0) { period = 'AM'; stdH = 12; }
  else if (h < 12) { period = 'AM'; stdH = h; }
  else if (h === 12) { period = 'PM'; stdH = 12; }
  else { period = 'PM'; stdH = h - 12; }

  var minStr = m < 10 ? '0' + m : '' + m;
  document.getElementById('res-label').textContent = 'Standard Time';
  document.getElementById('res-value').textContent = stdH + ':' + minStr + ' ' + period;
  document.getElementById('res-unit').textContent = val.padStart(4, '0') + ' hours → ' + stdH + ':' + minStr + ' ' + period;
}

function convertS2M() {
  var h = parseInt(document.getElementById('std-hr').value);
  var m = parseInt(document.getElementById('std-min').value) || 0;
  var ampm = document.getElementById('std-ampm').value;

  if (isNaN(h) || h < 1 || h > 12) {
    document.getElementById('res-value').textContent = '—';
    document.getElementById('res-unit').textContent = 'Enter hour (1–12)';
    return;
  }
  if (m < 0 || m > 59) {
    document.getElementById('res-value').textContent = '—';
    document.getElementById('res-unit').textContent = 'Minutes must be 0–59';
    return;
  }

  var milH;
  if (ampm === 'AM') { milH = h === 12 ? 0 : h; }
  else { milH = h === 12 ? 12 : h + 12; }

  var hStr = milH < 10 ? '0' + milH : '' + milH;
  var mStr = m < 10 ? '0' + m : '' + m;
  var milTime = hStr + mStr;

  document.getElementById('res-label').textContent = 'Military Time';
  document.getElementById('res-value').textContent = milTime;
  document.getElementById('res-unit').textContent = h + ':' + mStr + ' ' + ampm + ' → ' + milTime + ' hours';
}

function setPreset(mil) {
  if (mode !== 'm2s') setMode('m2s');
  document.getElementById('mil-input').value = mil;
  convertM2S();
}

document.getElementById('mil-input').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') convertM2S();
});
</script>

</Layout>
