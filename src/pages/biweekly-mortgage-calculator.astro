</div>

<script is:inline>
(function () {
  // Set default start month to current month
  var now = new Date();
  var mm = String(now.getMonth() + 1).padStart(2, '0');
  var yyyy = now.getFullYear();
  document.getElementById('start-month').value = yyyy + '-' + mm;

  function fmt(n) {
    return '$' + Math.round(n).toLocaleString('en-US');
  }
  function fmtDec(n) {
    return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function calcMonthlyPayment(principal, annualRate, termMonths) {
    var r = annualRate / 100 / 12;
    if (r === 0) return principal / termMonths;
    return principal * (r * Math.pow(1 + r, termMonths)) / (Math.pow(1 + r, termMonths) - 1);
  }

  function addMonths(dateStr, months) {
    var parts = dateStr.split('-');
    var d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, 1);
    d.setMonth(d.getMonth() + months);
    return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }

  function addBiweeklyPeriods(dateStr, periods) {
    var parts = dateStr.split('-');
    var d = new Date(parseInt(parts[0]), parseInt(parts[1]) - 1, 1);
    d.setDate(d.getDate() + periods * 14);
    return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
  }

  function simulateMonthly(principal, annualRate, termMonths) {
    var r = annualRate / 100 / 12;
    var pmt = calcMonthlyPayment(principal, annualRate, termMonths);
    var balance = principal;
    var totalInterest = 0;
    var months = 0;
    var yearlyBalances = {};

    while (balance > 0.01 && months < termMonths + 12) {
      var interest = balance * r;
      totalInterest += interest;
      var principalPaid = pmt - interest;
      if (principalPaid > balance) principalPaid = balance;
      balance -= principalPaid;
      months++;
      var yr = Math.floor((months - 1) / 12) + 1;
      if (months % 12 === 0 || balance <= 0.01) {
        yearlyBalances[yr] = Math.max(0, balance);
      }
    }
    return { months: months, totalInterest: totalInterest, monthlyPayment: pmt, yearlyBalances: yearlyBalances };
  }

  function simulateBiweekly(principal, annualRate) {
    var monthlyPmt = calcMonthlyPayment(principal, annualRate, 30 * 12);
    // In biweekly: use monthly for standard term calc
    var bwPmt = monthlyPmt / 2;
    var r = annualRate / 100 / 26; // rate per biweekly period
    var balance = principal;
    var totalInterest = 0;
    var periods = 0;
    var yearlyBalances = {};

    while (balance > 0.01 && periods < 26 * 100) {
      var interest = balance * r;
      totalInterest += interest;
      var principalPaid = bwPmt - interest;
      if (principalPaid > balance) principalPaid = balance;
      balance -= principalPaid;
      periods++;
      // Every 26 periods = 1 year
      var yr = Math.floor((periods - 1) / 26) + 1;
      if (periods % 26 === 0 || balance <= 0.01) {
        yearlyBalances[yr] = Math.max(0, balance);
      }
    }
    return { periods: periods, totalInterest: totalInterest, bwPayment: bwPmt, yearlyBalances: yearlyBalances };
  }

  window.calculate = function () {
    var principal = parseFloat(document.getElementById('loan-amount').value) || 0;
    var rate = parseFloat(document.getElementById('interest-rate').value) || 0;
    var term = parseInt(document.getElementById('loan-term').value) || 30;
    var startMonth = document.getElementById('start-month').value || (new Date().getFullYear() + '-' + String(new Date().getMonth() + 1).padStart(2, '0'));

    if (principal <= 0 || rate <= 0 || term <= 0) return;

    var termMonths = term * 12;
    var monthly = simulateMonthly(principal, rate, termMonths);
    var bw = simulateBiweekly(principal, rate);

    var monthsSaved = monthly.months - Math.round(bw.periods / 26 * 12);
    var yearsSaved = monthsSaved / 12;
    var interestSaved = monthly.totalInterest - bw.totalInterest;

    var bwMonths = Math.round(bw.periods / 26 * 12);
    var bwYears = Math.floor(bwMonths / 12);
    var bwRemMonths = bwMonths % 12;
    var monthlyYears = Math.floor(monthly.months / 12);
    var monthlyRemMonths = monthly.months % 12;

    var bwPaidPerYear = bw.bwPayment * 26;
    var monthlyPaidPerYear = monthly.monthlyPayment * 12;

    var bwTotalPaid = bw.totalInterest + principal;
    var monthlyTotalPaid = monthly.totalInterest + principal;

    var bwDate = addBiweeklyPeriods(startMonth, bw.periods);
    var monthlyDate = addMonths(startMonth, monthly.months);

    // Hero
    var ySaved = yearsSaved >= 1
      ? (Math.floor(yearsSaved) + ' yr' + (Math.floor(yearsSaved) !== 1 ? 's' : '') + (monthsSaved % 12 > 0 ? ' ' + (monthsSaved % 12) + ' mo' : ''))
      : (monthsSaved + ' months');
    document.getElementById('r-years-saved').textContent = ySaved;
    document.getElementById('r-payoff-compare').textContent = 'Payoff: ' + bwDate + ' vs ' + monthlyDate + ' (monthly)';
    document.getElementById('r-interest-saved').textContent = fmt(interestSaved);
    document.getElementById('r-biweekly-payment').textContent = fmtDec(bw.bwPayment);
    document.getElementById('r-monthly-payment').textContent = fmtDec(monthly.monthlyPayment);
    document.getElementById('r-months-saved').textContent = monthsSaved + ' mo';
    document.getElementById('r-biweekly-date').textContent = bwDate;
    document.getElementById('r-monthly-date').textContent = monthlyDate;

    // Compare columns
    document.getElementById('cmp-monthly-pmt').textContent = fmtDec(monthly.monthlyPayment);
    document.getElementById('cmp-monthly-yr').textContent = fmt(monthlyPaidPerYear);
    document.getElementById('cmp-monthly-int').textContent = fmt(monthly.totalInterest);
    document.getElementById('cmp-monthly-total').textContent = fmt(monthlyTotalPaid);
    document.getElementById('cmp-monthly-date').textContent = monthlyDate;
    document.getElementById('cmp-monthly-term').textContent = monthlyYears + ' yrs ' + (monthlyRemMonths > 0 ? monthlyRemMonths + ' mo' : '');

    document.getElementById('cmp-bw-pmt').textContent = fmtDec(bw.bwPayment);
    document.getElementById('cmp-bw-yr').textContent = fmt(bwPaidPerYear);
    document.getElementById('cmp-bw-int').textContent = fmt(bw.totalInterest);
    document.getElementById('cmp-bw-total').textContent = fmt(bwTotalPaid);
    document.getElementById('cmp-bw-date').textContent = bwDate;
    document.getElementById('cmp-bw-term').textContent = bwYears + ' yrs ' + (bwRemMonths > 0 ? bwRemMonths + ' mo' : '');

    document.getElementById('save-banner-val').textContent = fmt(interestSaved) + ' saved';

    // Yearly table
    var tbody = document.getElementById('yearly-table');
    var maxYr = Math.max(
      Math.max.apply(null, Object.keys(monthly.yearlyBalances).map(Number)),
      Math.max.apply(null, Object.keys(bw.yearlyBalances).map(Number))
    );
    var rows = '';
    var bwPayoffYr = Math.ceil(bw.periods / 26);
    for (var y = 1; y <= maxYr; y++) {
      var mBal = monthly.yearlyBalances[y] !== undefined ? monthly.yearlyBalances[y] : 0;
      var bBal = bw.yearlyBalances[y] !== undefined ? bw.yearlyBalances[y] : 0;
      var diff = mBal - bBal;
      var isBwPayoff = (bw.yearlyBalances[y] !== undefined && bw.yearlyBalances[y] <= 0.01);
      var isMoPayoff = (monthly.yearlyBalances[y] !== undefined && monthly.yearlyBalances[y] <= 0.01);
      var rowClass = isBwPayoff ? ' class="highlight-row"' : '';
      rows += '<tr' + rowClass + '>'
        + '<td>Year ' + y + (isBwPayoff ? ' ✅ Biweekly Payoff' : '') + (isMoPayoff ? ' ✅ Monthly Payoff' : '') + '</td>'
        + '<td>' + (mBal <= 0.01 ? '<span style="color:#15803d;font-weight:700">Paid Off</span>' : fmt(mBal)) + '</td>'
        + '<td>' + (bBal <= 0.01 ? '<span style="color:#15803d;font-weight:700">Paid Off ✅</span>' : fmt(bBal)) + '</td>'
        + '<td>' + (diff > 0.01 ? '<span style="color:#15803d">+' + fmt(diff) + ' ahead</span>' : '—') + '</td>'
        + '</tr>';
      if (mBal <= 0.01 && bBal <= 0.01) break;
    }
    tbody.innerHTML = rows;
  };

  calculate();
})();
</script>
</Layout>
