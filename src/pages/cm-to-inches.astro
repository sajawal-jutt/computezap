<Layout
  title="cm to Inches Converter — Centimeters to Inches | ComputeZap"
  description="Convert cm to inches instantly. 1 cm = 0.3937 inches. Free centimeter to inch converter with height chart. Also shows feet and millimeters."
  canonical="/cm-to-inches"
  schema={schema}
>
<style is:global>
