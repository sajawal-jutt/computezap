import Layout from '../layouts/Layout.astro';

const schema = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "cm to Inches Converter",
    "url": "https://computezap.com/cm-to-inches",
    "applicationCategory": "UtilityApplication",
    "operatingSystem": "Web",
    "description": "Convert centimeters to inches instantly. 1 cm = 0.3937 inches. Free cm to inches converter with height chart and reference table.",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://computezap.com" },
      { "@type": "ListItem", "position": 2, "name": "cm to Inches", "item": "https://computezap.com/cm-to-inches" }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      { "@type": "Question", "name": "How many inches in 1 cm?", "acceptedAnswer": { "@type": "Answer", "text": "1 centimeter = 0.393701 inches. To convert cm to inches, multiply by 0.393701." } },
      { "@type": "Question", "name": "How do I convert cm to inches?", "acceptedAnswer": { "@type": "Answer", "text": "Multiply centimeters by 0.393701. Formula: inches = cm × 0.393701. Example: 30 cm × 0.393701 = 11.81 inches." } },
      { "@type": "Question", "name": "What is 170 cm in feet and inches?", "acceptedAnswer": { "@type": "Answer", "text": "170 cm = 5 feet 6.93 inches (approximately 5'7\"). Multiply 170 × 0.393701 = 66.93 inches, then divide by 12 to get 5 feet remainder 6.93 inches." } },
      { "@type": "Question", "name": "What is 1 inch in cm?", "acceptedAnswer": { "@type": "Answer", "text": "1 inch = 2.54 centimeters exactly. This is the exact international definition of the inch." } },
      { "@type": "Question", "name": "What is 5 feet in cm?", "acceptedAnswer": { "@type": "Answer", "text": "5 feet = 152.4 cm. Multiply 5 × 30.48 (one foot in cm) = 152.4 cm." } },
      { "@type": "Question", "name": "What is 180 cm in feet?", "acceptedAnswer": { "@type": "Answer", "text": "180 cm = 5 feet 10.87 inches (approximately 5'11\"). 180 × 0.393701 = 70.87 inches = 5 ft 10.87 in." } }
    ]
  }
]);
---
<Layout
  title="cm to Inches Converter — Centimeters to Inches | ComputeZap"
  description="Convert cm to inches instantly. 1 cm = 0.3937 inches. Free centimeter to inch converter with height chart. Also shows feet and millimeters."
  canonical="/cm-to-inches"
  schema={schema}
>
<style>
.hero{text-align:center;padding:2rem 1rem 1.25rem}
.hero h1{font-size:2rem;color:#111;margin:.5rem 0 .35rem;font-weight:800}
.hero-sub{color:#555;margin:0;font-size:1rem}
.breadcrumb{font-size:.85rem;color:#888;margin-bottom:.75rem}
.breadcrumb a{color:var(--blue);text-decoration:none}
.calc-wrap{display:grid;grid-template-columns:360px 1fr;gap:1.5rem;max-width:1100px;margin:0 auto;padding:0 1rem 3rem;align-items:start}
.calc-left{position:sticky;top:1rem}
.card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.5rem;margin-bottom:1rem}
.card:last-child{margin-bottom:0}
.mode-wrap{display:grid;grid-template-columns:1fr 1fr;gap:.4rem;margin-bottom:1.25rem}
.mode-btn{background:#f8fafc;color:#64748b;border:1.5px solid #e2e8f0;border-radius:8px;padding:.5rem;font-size:.82rem;font-weight:700;cursor:pointer;text-align:center;transition:all .15s}
.mode-btn.active{background:var(--blue);color:#fff;border-color:var(--blue)}
.result-box{background:var(--blue);border-radius:14px;padding:1.75rem 1.5rem;text-align:center;margin-bottom:1.25rem;box-shadow:0 4px 20px rgba(37,99,235,.18)}
.res-lbl{font-size:.72rem;color:rgba(255,255,255,.7);text-transform:uppercase;letter-spacing:.09em;margin-bottom:.5rem}
.res-val{font-size:2.1rem;font-weight:800;color:#fff;line-height:1.2}
.res-sub{font-size:.95rem;color:rgba(255,255,255,.8);margin-top:.3rem}
.stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;margin-bottom:0}
.stat-item{background:#f8fafc;border:1px solid #f1f5f9;border-radius:10px;padding:.9rem .75rem;text-align:center}
.stat-lbl{display:block;font-size:.68rem;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em;margin-bottom:.3rem;font-weight:600}
.stat-val{display:block;font-size:1.1rem;font-weight:800;color:#1e293b}
.stat-primary{background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:12px;padding:1rem 1.25rem;text-align:center;margin-bottom:.6rem}
.stat-big{display:block;font-size:2rem;font-weight:900;color:#2563eb;line-height:1.1}
.stat-secondary{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:.75rem 1.25rem;text-align:center;margin-bottom:.6rem}
.stat-med{display:block;font-size:1.4rem;font-weight:800;color:#1e293b;line-height:1.1}
.fld-lbl{display:block;font-size:.8rem;font-weight:700;color:#374151;margin-bottom:.4rem;text-transform:uppercase;letter-spacing:.04em}
.fld-wrap{position:relative;margin-bottom:1rem}
.fld-sfx{position:absolute;right:.9rem;top:50%;transform:translateY(-50%);color:#94a3b8;font-weight:600;pointer-events:none;font-size:.9rem}
.txt-input{width:100%;font-size:1.1rem;padding:.7rem 3rem .7rem 1rem;border:1.5px solid #e2e8f0;border-radius:8px;color:#111;box-sizing:border-box;font-family:inherit;background:#fff}
.txt-input:focus{outline:none;border-color:var(--blue);box-shadow:0 0 0 3px rgba(37,99,235,.1)}
.preset-lbl{font-size:.7rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.05em;margin-bottom:.5rem;display:block}
.preset-wrap{display:flex;flex-wrap:wrap;gap:.4rem;margin-bottom:.5rem}
.preset-btn{background:#fff;color:var(--blue);border:1.5px solid #dbeafe;border-radius:20px;padding:.28rem .75rem;font-size:.82rem;font-weight:700;cursor:pointer;transition:all .15s}
.preset-btn:hover{background:var(--blue);color:#fff;border-color:var(--blue)}
.card h2{font-size:1.1rem;font-weight:700;color:#111;margin:0 0 .8rem}
.card h3{font-size:.95rem;font-weight:700;color:#111;margin:.75rem 0 .4rem}
.card p{color:#444;line-height:1.75;font-size:.95rem;margin:0 0 .7rem}
.card p:last-child{margin-bottom:0}
.card ul{color:#444;line-height:1.85;font-size:.95rem;padding-left:1.25rem;margin:.5rem 0 0}
.formula-box{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:.75rem 1rem;font-family:monospace;font-size:.88rem;color:#1e293b;margin:.6rem 0}
.tip-box{display:flex;gap:.75rem;background:#eff6ff;border:1px solid #bfdbfe;border-radius:10px;padding:.9rem 1rem;margin:.75rem 0}
