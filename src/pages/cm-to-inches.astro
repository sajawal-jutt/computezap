        <input type="number" id="amount" class="txt-input" value="170" min="0" step="0.1" oninput="convert()" />
        <span class="fld-sfx" id="inp-sfx">cm</span>
      </div>
      <span class="preset-lbl">Quick values</span>
      <div class="preset-wrap" id="preset-wrap">
        <button class="preset-btn" onclick="setVal(10)">10</button>
        <button class="preset-btn" onclick="setVal(30)">30</button>
        <button class="preset-btn" onclick="setVal(60)">60</button>
        <button class="preset-btn" onclick="setVal(100)">100</button>
        <button class="preset-btn" onclick="setVal(150)">150</button>
        <button class="preset-btn" onclick="setVal(160)">160</button>
        <button class="preset-btn" onclick="setVal(165)">165</button>
        <button class="preset-btn" onclick="setVal(170)">170</button>
        <button class="preset-btn" onclick="setVal(175)">175</button>
        <button class="preset-btn" onclick="setVal(180)">180</button>
      </div>
    </div>
    <div class="card">
      <div class="result-box">
        <div class="res-lbl" id="res-lbl">Inches</div>
        <div class="res-val"><span id="r-main">66.93</span> <span style="font-size:1.1rem;opacity:.85" id="r-unit">in</span></div>
        <div class="res-sub" id="r-sub">170 cm = 66.93 inches</div>
      </div>
      <div class="stat-primary">
        <span class="stat-lbl" id="s1-lbl">Inches</span>
        <span class="stat-big" id="s1-val">66.93 in</span>
      </div>
      <div class="stat-secondary">
        <span class="stat-lbl" id="s2-lbl">Feet & Inches</span>
        <span class="stat-med" id="s2-val">5′ 6.93″</span>
      </div>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-lbl" id="s3-lbl">Feet (decimal)</span>
          <span class="stat-val" id="s3-val">5.577 ft</span>
        </div>
        <div class="stat-item">
          <span class="stat-lbl" id="s4-lbl">Millimeters</span>
          <span class="stat-val" id="s4-val">1700 mm</span>
        </div>
      </div>
    </div>
  </div>

  <div class="calc-right">
    <div class="card">
      <h2>How Many Inches in a Centimeter?</h2>
      <p>There are <strong>0.393701 inches in 1 centimeter</strong>. Conversely, 1 inch = 2.54 cm exactly — this is the international definition of the inch set in 1959.</p>
      <div class="answer-box">
        <div class="answer-row"><span class="answer-lbl">1 cm</span><span class="answer-val">= 0.3937 inches</span></div>
        <div class="answer-row"><span class="answer-lbl">1 inch</span><span class="answer-val">= 2.54 cm</span></div>
        <div class="answer-row"><span class="answer-lbl">1 foot</span><span class="answer-val">= 30.48 cm</span></div>
        <div class="answer-row"><span class="answer-lbl">1 meter</span><span class="answer-val">= 39.37 inches</span></div>
      </div>
      <div class="formula-box">inches = cm × 0.393701 &nbsp;|&nbsp; cm = inches × 2.54</div>
    </div>

    <div class="card">
      <h2>cm to Inches Height Chart</h2>
      <p>Click any row to load into the converter above.</p>
      <table class="ref-tbl">
        <thead><tr><th>cm</th><th>Inches</th><th>Feet & Inches</th></tr></thead>
        <tbody>
          {[
            [150,'59.06 in',"4' 11.1\""],
            [155,'61.02 in',"5' 1.0\""],
            [160,'62.99 in',"5' 3.0\""],
            [163,'64.17 in',"5' 4.2\""],
            [165,'64.96 in',"5' 4.96\""],
            [168,'66.14 in',"5' 6.1\""],
            [170,'66.93 in',"5' 6.9\""],
            [172,'67.72 in',"5' 7.7\""],
            [175,'68.90 in',"5' 8.9\""],
            [178,'70.08 in',"5' 10.1\""],
            [180,'70.87 in',"5' 10.9\""],
            [183,'72.05 in',"6' 0.0\""],
            [185,'72.83 in',"6' 0.8\""],
            [190,'74.80 in',"6' 2.8\""],
          ].map(([cm, inches, ft]) => (
            <tr onclick={`setVal(${cm})`} class={cm === 170 ? 'hi' : ''}>
              <td>{cm} cm</td><td class="acc">{inches}</td><td>{ft}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="card">
      <h2>How to Convert cm to Inches</h2>
      <p>To convert centimeters to inches, multiply the cm value by <strong>0.393701</strong>. To get feet and inches, first divide the total inches by 12 to get whole feet, then the remainder is the inches.</p>
      <div class="tip-box">
        <span class="tip-icon">📏</span>
        <p><strong>Quick estimate:</strong> Divide cm by 2.54 (or multiply by 0.4) for a fast approximation. For 170 cm: 170 ÷ 2.54 = 66.93 inches = 5 feet 6.9 inches.</p>
      </div>
      <h3>Common length conversions</h3>
      <ul>
        <li><strong>Screen sizes</strong> — a 55-inch TV is 139.7 cm; a 65-inch TV is 165.1 cm</li>
        <li><strong>Paper</strong> — A4 paper is 29.7 cm × 21 cm (11.69 × 8.27 inches)</li>
        <li><strong>Ruler</strong> — 30 cm ruler = 11.81 inches (close to 12 inches / 1 foot)</li>
        <li><strong>Standard door</strong> — 203 cm = 6 feet 8 inches (80 inches)</li>
      </ul>
    </div>

    <div class="content-card">
      <h2>When You Need cm to Inches Conversion</h2>
      <ul>
        <li><strong>Height conversion</strong> — most of the world measures height in cm; the US uses feet and inches. This is the most searched use case for this converter.</li>
        <li><strong>Screen & display sizes</strong> — TV and monitor sizes are listed in inches in the US; specs from other countries use cm or mm.</li>
        <li><strong>Fabric & sewing</strong> — US patterns use inches; European and Asian patterns use cm. Convert for accurate cutting.</li>
        <li><strong>Construction & DIY</strong> — lumber and hardware dimensions switch between metric and imperial depending on the country of origin.</li>
        <li><strong>Shipping & packaging</strong> — international package dimensions may be in cm; US carriers quote rates by inch dimensions.</li>
      </ul>
    </div>

    <div class="card">
      <h2>Frequently Asked Questions</h2>
      <div class="faq-item">
        <h3>How many inches in 1 cm?</h3>
        <p>1 centimeter = <strong>0.393701 inches</strong>. Equivalently, 1 inch = 2.54 cm exactly.</p>
      </div>
      <div class="faq-item">
        <h3>What is 170 cm in feet and inches?</h3>
        <p>170 cm = <strong>5 feet 6.93 inches</strong> (approximately 5'7"). Total: 66.93 inches.</p>
      </div>
      <div class="faq-item">
        <h3>What is 180 cm in feet?</h3>
        <p>180 cm = <strong>5 feet 10.87 inches</strong> (approximately 5'11"). Total: 70.87 inches.</p>
      </div>
      <div class="faq-item">
        <h3>What is 160 cm in feet and inches?</h3>
        <p>160 cm = <strong>5 feet 2.99 inches</strong> (approximately 5'3"). Total: 62.99 inches.</p>
      </div>
      <div class="faq-item">
        <h3>How do I convert inches to cm?</h3>
        <p>Multiply inches by 2.54. Formula: <strong>cm = inches × 2.54</strong>. Example: 12 inches × 2.54 = 30.48 cm. Use the in → cm mode above.</p>
      </div>
      <div class="faq-item">
        <h3>What is 5 feet in cm?</h3>
        <p>5 feet = 60 inches = <strong>152.4 cm</strong>. One foot = 30.48 cm, so 5 × 30.48 = 152.4 cm.</p>
      </div>
      <div class="faq-item">
        <h3>What is 6 feet in cm?</h3>
        <p>6 feet = 72 inches = <strong>182.88 cm</strong>. Six × 30.48 = 182.88 cm.</p>
      </div>
    </div>

    <div class="content-card">
      <h2>Related Converters</h2>
      <div class="next-grid">
        <a href="/kg-to-lbs" class="next-card">
          <span class="next-tag">Weight</span>
          <h3>kg to lbs</h3>
          <p>Convert kilograms to pounds instantly.</p>
        </a>
        <a href="/celsius-to-fahrenheit" class="next-card">
          <span class="next-tag">Temperature</span>
          <h3>Celsius to °F</h3>
          <p>Convert temperature between Celsius and Fahrenheit.</p>
        </a>
        <a href="/square-footage-calculator" class="next-card">
          <span class="next-tag">Area</span>
          <h3>Square Footage</h3>
          <p>Calculate area in square feet for any room or space.</p>
        </a>
        <a href="/liters-to-gallons" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Liters to Gallons</h3>
          <p>Convert liters to US or Imperial gallons.</p>
        </a>
        <a href="/oz-to-quarts" class="next-card">
          <span class="next-tag">Volume</span>
          <h3>Oz to Quarts</h3>
          <p>Convert fluid ounces to quarts — 1 quart = 32 oz.</p>
        </a>
        <a href="/cups-to-tablespoons" class="next-card">
          <span class="next-tag">Kitchen</span>
          <h3>Cups to Tablespoons</h3>
          <p>How many tablespoons in a cup — all fractions covered.</p>
        </a>
      </div>
    </div>
  </div>
</div>

<script is:inline>
var mode = 'cm';

function fmt(v, d) {
  return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString();
}

function fmtFt(inches) {
  var ft = Math.floor(inches / 12);
  var inn = parseFloat((inches % 12).toFixed(2));
  return ft + '′ ' + inn + '″';
}

function convert() {
  var val = parseFloat(document.getElementById('amount').value) || 0;
  var inches, cm, ft, mm;
  if (mode === 'cm') {
    cm = val; inches = val * 0.393701; ft = inches / 12; mm = val * 10;
    document.getElementById('r-main').textContent = fmt(inches, 2);
    document.getElementById('r-unit').textContent = 'in';
    document.getElementById('r-sub').textContent = fmt(val, 1) + ' cm = ' + fmt(inches, 2) + ' inches';
    document.getElementById('res-lbl').textContent = 'Inches';
    document.getElementById('s1-lbl').textContent = 'Inches';
    document.getElementById('s1-val').textContent = fmt(inches, 2) + ' in';
    document.getElementById('s2-lbl').textContent = 'Feet & Inches';
    document.getElementById('s2-val').textContent = fmtFt(inches);
    document.getElementById('s3-lbl').textContent = 'Feet (decimal)';
    document.getElementById('s3-val').textContent = fmt(ft, 3) + ' ft';
    document.getElementById('s4-lbl').textContent = 'Millimeters';
    document.getElementById('s4-val').textContent = fmt(mm, 0) + ' mm';
  } else {
    inches = val; cm = val * 2.54; ft = val / 12; mm = cm * 10;
    document.getElementById('r-main').textContent = fmt(cm, 2);
    document.getElementById('r-unit').textContent = 'cm';
    document.getElementById('r-sub').textContent = fmt(val, 2) + ' in = ' + fmt(cm, 2) + ' cm';
    document.getElementById('res-lbl').textContent = 'Centimeters';
    document.getElementById('s1-lbl').textContent = 'Centimeters';
    document.getElementById('s1-val').textContent = fmt(cm, 2) + ' cm';
    document.getElementById('s2-lbl').textContent = 'Feet (decimal)';
    document.getElementById('s2-val').textContent = fmt(ft, 3) + ' ft';
    document.getElementById('s3-lbl').textContent = 'Feet & Inches';
    document.getElementById('s3-val').textContent = fmtFt(val);
    document.getElementById('s4-lbl').textContent = 'Millimeters';
    document.getElementById('s4-val').textContent = fmt(mm, 0) + ' mm';
  }
}

function setMode(m) {
  mode = m;
  var isCm = m === 'cm';
  document.getElementById('btn-cm').classList.toggle('active', isCm);
  document.getElementById('btn-in').classList.toggle('active', !isCm);
  document.getElementById('inp-lbl').textContent = isCm ? 'Centimeters (cm)' : 'Inches (in)';
  document.getElementById('inp-sfx').textContent = isCm ? 'cm' : 'in';
  var presets = document.getElementById('preset-wrap');
  presets.innerHTML = (isCm ? [10,30,60,100,150,160,165,170,175,180] : [1,6,12,24,36,60,66,70,72])
    .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
  document.getElementById('amount').value = isCm ? 170 : 67;
  convert();
}

function setVal(v) {
  document.getElementById('amount').value = v;
  convert();
}

window.addEventListener('load', convert);
</script>
</Layout>
