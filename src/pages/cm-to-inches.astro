<script is:inline>
  var mode = 'cm';

  document.getElementById('btn-cm').addEventListener('click', function() { setMode('cm'); });
  document.getElementById('btn-in').addEventListener('click', function() { setMode('in'); });
  document.getElementById('calc-btn').addEventListener('click', convert);
  document.getElementById('amount').addEventListener('input', convert);
  document.addEventListener('keydown', function(e) { if (e.key === 'Enter') convert(); });

  document.getElementById('amount').value = 170;
  convert();

  function fmt(v, d) { return parseFloat(v.toFixed(d !== undefined ? d : 4)).toString(); }

  function fmtFt(inches) {
    var ft = Math.floor(inches / 12);
    var inn = parseFloat((inches % 12).toFixed(2));
    return ft + '′ ' + inn + '″';
  }

  function setMode(m) {
    mode = m;
    var isCm = m === 'cm';
    document.getElementById('btn-cm').classList.toggle('active', isCm);
    document.getElementById('btn-in').classList.toggle('active', !isCm);
    document.getElementById('inp-lbl').textContent = isCm ? 'Centimeters (cm)' : 'Inches (in)';
    document.getElementById('inp-sfx').textContent = isCm ? 'cm' : 'in';
    var presets = document.getElementById('preset-wrap');
    presets.innerHTML = (isCm ? [10,30,100,160,165,170,175,180] : [1,6,12,24,36,60,66,70,72])
      .map(function(v){ return '<button class="preset-btn" onclick="setVal('+v+')">'+v+'</button>'; }).join('');
    document.getElementById('amount').value = isCm ? 170 : 67;
    convert();
  }

  function convert() {
    var val = parseFloat(document.getElementById('amount').value);
    if (isNaN(val) || val < 0) return;
    var inches, cm, ft, mm, m;
    if (mode === 'cm') {
      cm = val; inches = val * 0.393701; ft = inches / 12; mm = val * 10; m = val / 100;
      document.getElementById('ans-label').textContent = fmt(val, 1) + ' cm =';
      document.getElementById('ans-value').textContent = fmt(inches, 2);
      document.getElementById('ans-unit').textContent = 'inches (in)';
      document.getElementById('ans-sub').textContent = fmt(val, 1) + ' × 0.393701 = ' + fmt(inches, 2) + ' in';
      document.getElementById('s1-lbl').textContent = 'Feet & Inches';
      document.getElementById('s1-val').textContent = fmtFt(inches);
      document.getElementById('s2-lbl').textContent = 'Feet (decimal)';
      document.getElementById('s2-val').textContent = fmt(ft, 3) + ' ft';
      document.getElementById('s3-lbl').textContent = 'Millimeters';
      document.getElementById('s3-val').textContent = fmt(mm, 0) + ' mm';
      document.getElementById('s4-lbl').textContent = 'Meters';
      document.getElementById('s4-val').textContent = fmt(m, 4) + ' m';
    } else {
      inches = val; cm = val * 2.54; ft = val / 12; mm = cm * 10; m = cm / 100;
      document.getElementById('ans-label').textContent = fmt(val, 2) + ' in =';
      document.getElementById('ans-value').textContent = fmt(cm, 2);
      document.getElementById('ans-unit').textContent = 'centimeters (cm)';
      document.getElementById('ans-sub').textContent = fmt(val, 2) + ' × 2.54 = ' + fmt(cm, 2) + ' cm';
      document.getElementById('s1-lbl').textContent = 'Feet & Inches';
      document.getElementById('s1-val').textContent = fmtFt(val);
      document.getElementById('s2-lbl').textContent = 'Feet (decimal)';
      document.getElementById('s2-val').textContent = fmt(ft, 3) + ' ft';
      document.getElementById('s3-lbl').textContent = 'Millimeters';
      document.getElementById('s3-val').textContent = fmt(mm, 0) + ' mm';
      document.getElementById('s4-lbl').textContent = 'Meters';
      document.getElementById('s4-val').textContent = fmt(m, 4) + ' m';
    }
    document.getElementById('answer').classList.add('show');
    document.getElementById('stats').classList.add('show');
  }

  function setVal(v) { document.getElementById('amount').value = v; convert(); }
</script>
</Layout>
