.tip-box p{margin:0;font-size:.875rem;color:#1e40af}
.answer-box{background:#f8fafc;border:1.5px solid #e2e8f0;border-radius:10px;padding:.75rem 1rem;margin:.75rem 0}
.answer-row{display:flex;justify-content:space-between;align-items:center;padding:.35rem 0;border-bottom:1px solid #f1f5f9;font-size:.95rem}
.answer-row:last-child{border-bottom:none}
.answer-lbl{color:#64748b;font-weight:600}
.answer-val{color:#2563eb;font-weight:800}
.ref-tbl{width:100%;border-collapse:collapse;font-size:.875rem}
.ref-tbl th{background:#f8fafc;padding:.45rem .75rem;text-align:left;font-size:.72rem;color:#64748b;font-weight:700;text-transform:uppercase;letter-spacing:.04em;border-bottom:1px solid #e5e7eb}
.ref-tbl td{padding:.5rem .75rem;border-bottom:1px solid #f3f4f6;color:#444;cursor:pointer}
.ref-tbl tr:last-child td{border-bottom:none}
.ref-tbl .acc{color:var(--blue);font-weight:700}
.ref-tbl .hi td{background:#eff6ff;color:#1e40af;font-weight:600}
.faq-item{border-bottom:1px solid #f3f4f6;padding:.85rem 0}
.faq-item:last-child{border-bottom:none;padding-bottom:0}
.faq-item h3{font-size:.92rem;color:#111;margin:0 0 .35rem;font-weight:600}
.faq-item p{color:#555;font-size:.875rem;margin:0;line-height:1.65}
.content-card{background:#fff;border:1px solid #e5e7eb;border-radius:12px;padding:1.5rem;margin-bottom:1rem}
.content-card h2{font-size:1.1rem;font-weight:700;color:#111;margin:0 0 .8rem}
.content-card ul{color:#444;line-height:1.85;font-size:.95rem;padding-left:1.25rem;margin:0}
