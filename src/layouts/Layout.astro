---
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: string;
  ogImage?: string;
}
const { title, description, canonical, schema, ogImage } = Astro.props;
const url = canonical || Astro.url.pathname;
const fullUrl = `https://www.computezap.com${url}`;
const image = ogImage || 'https://www.computezap.com/og-default.png';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="xKaASkr-xoBY3EnfoZje1CQDSZgfKA8akarHQnhiLVs" />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={fullUrl} />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:url"         content={fullUrl} />
  <meta property="og:title"       content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image"       content={image} />
  <meta property="og:site_name"   content="ComputeZap" />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={image} />

  <!-- Site Schema -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://www.computezap.com/#website",
        "name": "ComputeZap",
        "url": "https://www.computezap.com",
        "description": "Free online calculators and unit converters — fast, accurate, no signup required.",
        "potentialAction": {
          "@type": "SearchAction",
          "target": "https://www.computezap.com/?s={search_term_string}",
          "query-input": "required name=search_term_string"
        }
      },
      {
        "@type": "Organization",
        "@id": "https://www.computezap.com/#organization",
        "name": "ComputeZap",
        "url": "https://www.computezap.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.computezap.com/og-default.png"
        },
        "description": "Free online calculators and unit converters for finance, math, cooking, and everyday use.",
        "foundingDate": "2026",
        "contactPoint": {
          "@type": "ContactPoint",
          "contactType": "customer support",
          "email": "mail.sajawaljutt@gmail.com"
        }
      }
    ]
  }
  </script>

  <!-- Page-specific Schema -->
  {schema && <script type="application/ld+json" set:html={schema} />}

  <!-- Preconnect for faster resource loading -->
  <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
  <link rel="dns-prefetch" href="https://www.googletagmanager.com" />
  <link rel="preconnect" href="https://www.google-analytics.com" crossorigin />

  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body>
  <nav>
    <div class="nav-inner">
      <a href="/" class="logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M13 2L4 14H10L8 22L20 10H14L17 2H13Z" fill="#2563eb"/>
        </svg>
        <span class="logo-text">compute<strong>zap</strong></span>
      </a>
      <ul id="navMenu">
        <li><a href="/converters/">Converters</a></li>
        <li><a href="/calculators/">Calculators</a></li>
        <li><a href="/finance/">Finance</a></li>
        <li><a href="/health/">Health</a></li>
        <li><a href="/date-time/">Date &amp; Time</a></li>
      </ul>
      <button id="navToggle" class="nav-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="navMenu">☰</button>
    </div>
  </nav>

  <main>
    <slot />
  </main>

  <div style="background:#fff;border-top:1px solid #e5e7eb;padding:2rem 1.5rem">
    <div style="max-width:1120px;margin:0 auto">
      <p style="font-size:.7rem;font-weight:800;text-transform:uppercase;letter-spacing:.1em;color:#94a3b8;text-align:center;margin-bottom:1rem">Why trust ComputeZap?</p>
      <div class="eeat-grid">
        <div style="display:flex;align-items:flex-start;gap:.6rem;padding:.85rem 1rem;background:#f8fafc;border-radius:10px;border:1px solid #f1f5f9">
          <span style="width:22px;height:22px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem;color:#16a34a;font-weight:800">✓</span>
          <span style="font-size:.82rem;color:#374151;line-height:1.5">Formulas verified against official standards</span>
        </div>
        <div style="display:flex;align-items:flex-start;gap:.6rem;padding:.85rem 1rem;background:#f8fafc;border-radius:10px;border:1px solid #f1f5f9">
          <span style="width:22px;height:22px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem;color:#16a34a;font-weight:800">✓</span>
          <span style="font-size:.82rem;color:#374151;line-height:1.5">Runs entirely in your browser — no data sent anywhere</span>
        </div>
        <div style="display:flex;align-items:flex-start;gap:.6rem;padding:.85rem 1rem;background:#f8fafc;border-radius:10px;border:1px solid #f1f5f9">
          <span style="width:22px;height:22px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem;color:#16a34a;font-weight:800">✓</span>
          <span style="font-size:.82rem;color:#374151;line-height:1.5">Instant results — accurate to 6 decimal places</span>
        </div>
        <div style="display:flex;align-items:flex-start;gap:.6rem;padding:.85rem 1rem;background:#f8fafc;border-radius:10px;border:1px solid #f1f5f9">
          <span style="width:22px;height:22px;background:#dcfce7;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:.75rem;color:#16a34a;font-weight:800">✓</span>
          <span style="font-size:.82rem;color:#374151;line-height:1.5">Free forever — no signup, no ads between results</span>
        </div>
      </div>
    </div>
  </div>

  <footer>
    <div class="footer-inner">
      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/finance/">Finance</a>
        <a href="/date-time/">Date &amp; Time</a>
        <a href="/converters/">Converters</a>
        <a href="/calculators/">Calculators</a>
        <a href="/health/">Health</a>
      </div>
      <div class="footer-links">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms</a>
        <a href="/disclaimer">Disclaimer</a>
      </div>
      <p style="font-size:.82rem;color:#94a3b8;text-align:center;margin-top:.5rem">© 2026 ComputeZap — Free Online Calculators &amp; Converters</p>
    </div>
  </footer>

  <!-- Mobile nav toggle -->
  <script is:inline>
    (function() {
      var btn = document.getElementById('navToggle');
      var menu = document.getElementById('navMenu');
      if (!btn || !menu) return;
      btn.addEventListener('click', function() {
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.textContent = open ? '✕' : '☰';
      });
      menu.addEventListener('click', function(e) {
        if (e.target.tagName === 'A') {
          menu.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
          btn.textContent = '☰';
        }
      });
    })();
  </script>

  <!-- Google Analytics — fully deferred to avoid TBT -->
  <script is:inline>
    window.addEventListener('load', function() {
      var s = document.createElement('script');
      s.src = 'https://www.googletagmanager.com/gtag/js?id=G-HKNEP4FGVH';
      s.async = true;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HKNEP4FGVH', { send_page_view: true });
    });
  </script>
</body>
</html>
